<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGMETA · RF015 · Reporte de caja (PDF): cierres realizados, sus diferencias y responsables.
     Plantilla principal: membrete, resumen y los subreportes de cada tabla. Los datos llegan como
     parametros (JRDataSource por tabla) desde ReportePdf.java; la plantilla no tiene logica de negocio. -->
<jasperReport name="reporte_caja" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="28" bottomMargin="28">
	<style name="base" default="true" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000"/>
	<style name="fichaEtiqueta" fontName="Liberation Sans" fontSize="7.5" bold="true" vTextAlign="Middle">
		<box leftPadding="6"/>
	</style>
	<style name="fichaValor" fontName="Liberation Sans" fontSize="7.5" vTextAlign="Middle"/>
	<style name="resEtiqueta" mode="Opaque" backcolor="#E6E6E6" fontName="Liberation Sans" fontSize="7.0" bold="true" vTextAlign="Middle">
		<box leftPadding="6"><bottomPen lineWidth="0.5" lineColor="#808080"/></box>
	</style>
	<style name="resValor" fontName="Liberation Sans" fontSize="12.0" bold="true" vTextAlign="Middle">
		<box leftPadding="6"/>
	</style>
	<style name="resDetalle" fontName="Liberation Sans" fontSize="7.0" forecolor="#4D4D4D" vTextAlign="Top">
		<box leftPadding="6"/>
	</style>
	<style name="pie" fontName="Liberation Sans" fontSize="7.0" forecolor="#4D4D4D" vTextAlign="Middle"/>
	<parameter name="NOMBRE_REPORTE" class="java.lang.String"/>
	<parameter name="PERIODO" class="java.lang.String"/>
	<parameter name="EMITIDO" class="java.lang.String"/>
	<parameter name="GENERADO_POR" class="java.lang.String"/>
	<parameter name="IND1_TITULO" class="java.lang.String"/>
	<parameter name="IND1_VALOR" class="java.lang.String"/>
	<parameter name="IND1_DETALLE" class="java.lang.String"/>
	<parameter name="IND2_TITULO" class="java.lang.String"/>
	<parameter name="IND2_VALOR" class="java.lang.String"/>
	<parameter name="IND2_DETALLE" class="java.lang.String"/>
	<parameter name="IND3_TITULO" class="java.lang.String"/>
	<parameter name="IND3_VALOR" class="java.lang.String"/>
	<parameter name="IND3_DETALLE" class="java.lang.String"/>
	<parameter name="IND4_TITULO" class="java.lang.String"/>
	<parameter name="IND4_VALOR" class="java.lang.String"/>
	<parameter name="IND4_DETALLE" class="java.lang.String"/>
	<parameter name="SUB_CIERRES" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_MEDIO_PAGO" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_CAJERO" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="DS_CIERRES" class="net.sf.jasperreports.engine.JRDataSource"/>
	<parameter name="DS_MEDIO_PAGO" class="net.sf.jasperreports.engine.JRDataSource"/>
	<parameter name="DS_CAJERO" class="net.sf.jasperreports.engine.JRDataSource"/>
	<title height="140">
		<element kind="staticText" x="0" y="4" width="320" height="20" fontSize="16.0" bold="true"><text><![CDATA[GRUPO META]]></text></element>
		<element kind="staticText" x="0" y="25" width="320" height="12" fontSize="8.0" forecolor="#333333"><text><![CDATA[Sistema de Gestión Empresarial SIGMETA]]></text></element>
		<element kind="staticText" x="0" y="37" width="320" height="12" fontSize="8.0" forecolor="#333333"><text><![CDATA[Reporte de uso interno · Importes en soles (S/)]]></text></element>
		<element kind="frame" x="325" y="0" width="210" height="58">
			<box><pen lineWidth="0.75" lineColor="#000000"/></box>
			<element kind="textField" mode="Opaque" x="0" y="0" width="210" height="15" backcolor="#E6E6E6" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$P{NOMBRE_REPORTE}.toUpperCase()]]></expression>
				<box><bottomPen lineWidth="0.75" lineColor="#000000"/></box>
			</element>
			<element kind="staticText" x="0" y="18" width="52" height="12" style="fichaEtiqueta"><text><![CDATA[Periodo:]]></text></element>
			<element kind="textField" x="52" y="18" width="154" height="12" style="fichaValor"><expression><![CDATA[$P{PERIODO}]]></expression></element>
			<element kind="staticText" x="0" y="30" width="52" height="12" style="fichaEtiqueta"><text><![CDATA[Emisión:]]></text></element>
			<element kind="textField" x="52" y="30" width="154" height="12" style="fichaValor"><expression><![CDATA[$P{EMITIDO}]]></expression></element>
			<element kind="staticText" x="0" y="42" width="52" height="12" style="fichaEtiqueta"><text><![CDATA[Usuario:]]></text></element>
			<element kind="textField" x="52" y="42" width="154" height="12" style="fichaValor" textAdjust="ScaleFont"><expression><![CDATA[$P{GENERADO_POR}]]></expression></element>
		</element>
		<element kind="line" x="0" y="66" width="535" height="1"><pen lineWidth="1.0" lineColor="#000000"/></element>
		<element kind="staticText" x="0" y="74" width="535" height="12" fontSize="8.0" bold="true"><text><![CDATA[RESUMEN DEL PERIODO]]></text></element>
		<element kind="frame" x="0" y="88" width="134" height="46">
			<box><pen lineWidth="0.5" lineColor="#808080"/></box>
			<element kind="textField" x="0" y="0" width="134" height="13" style="resEtiqueta" blankWhenNull="true"><expression><![CDATA[$P{IND1_TITULO}]]></expression></element>
			<element kind="textField" x="0" y="14" width="134" height="17" style="resValor" blankWhenNull="true"><expression><![CDATA[$P{IND1_VALOR}]]></expression></element>
			<element kind="textField" x="0" y="31" width="134" height="12" style="resDetalle" blankWhenNull="true"><expression><![CDATA[$P{IND1_DETALLE}]]></expression></element>
		</element>
		<element kind="frame" x="134" y="88" width="134" height="46">
			<box><pen lineWidth="0.5" lineColor="#808080"/></box>
			<element kind="textField" x="0" y="0" width="134" height="13" style="resEtiqueta" blankWhenNull="true"><expression><![CDATA[$P{IND2_TITULO}]]></expression></element>
			<element kind="textField" x="0" y="14" width="134" height="17" style="resValor" blankWhenNull="true"><expression><![CDATA[$P{IND2_VALOR}]]></expression></element>
			<element kind="textField" x="0" y="31" width="134" height="12" style="resDetalle" blankWhenNull="true"><expression><![CDATA[$P{IND2_DETALLE}]]></expression></element>
		</element>
		<element kind="frame" x="268" y="88" width="134" height="46">
			<box><pen lineWidth="0.5" lineColor="#808080"/></box>
			<element kind="textField" x="0" y="0" width="134" height="13" style="resEtiqueta" blankWhenNull="true"><expression><![CDATA[$P{IND3_TITULO}]]></expression></element>
			<element kind="textField" x="0" y="14" width="134" height="17" style="resValor" blankWhenNull="true"><expression><![CDATA[$P{IND3_VALOR}]]></expression></element>
			<element kind="textField" x="0" y="31" width="134" height="12" style="resDetalle" blankWhenNull="true"><expression><![CDATA[$P{IND3_DETALLE}]]></expression></element>
		</element>
		<element kind="frame" x="402" y="88" width="133" height="46">
			<box><pen lineWidth="0.5" lineColor="#808080"/></box>
			<element kind="textField" x="0" y="0" width="133" height="13" style="resEtiqueta" blankWhenNull="true"><expression><![CDATA[$P{IND4_TITULO}]]></expression></element>
			<element kind="textField" x="0" y="14" width="133" height="17" style="resValor" blankWhenNull="true"><expression><![CDATA[$P{IND4_VALOR}]]></expression></element>
			<element kind="textField" x="0" y="31" width="133" height="12" style="resDetalle" blankWhenNull="true"><expression><![CDATA[$P{IND4_DETALLE}]]></expression></element>
		</element>
	</title>
	<detail>
		<band height="58">
			<element kind="subreport" positionType="Float" x="0" y="6" width="535" height="10">
				<dataSourceExpression><![CDATA[$P{DS_CIERRES}]]></dataSourceExpression>
				<expression><![CDATA[$P{SUB_CIERRES}]]></expression>
			</element>
			<element kind="subreport" positionType="Float" x="0" y="24" width="535" height="10">
				<dataSourceExpression><![CDATA[$P{DS_MEDIO_PAGO}]]></dataSourceExpression>
				<expression><![CDATA[$P{SUB_MEDIO_PAGO}]]></expression>
			</element>
			<element kind="subreport" positionType="Float" x="0" y="42" width="535" height="10">
				<dataSourceExpression><![CDATA[$P{DS_CAJERO}]]></dataSourceExpression>
				<expression><![CDATA[$P{SUB_CAJERO}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="22">
		<element kind="line" x="0" y="5" width="535" height="1"><pen lineWidth="0.5" lineColor="#000000"/></element>
		<element kind="textField" x="0" y="9" width="130" height="12" style="pie"><expression><![CDATA["Grupo Meta - SIGMETA"]]></expression></element>
		<element kind="textField" x="130" y="9" width="290" height="12" style="pie" hTextAlign="Center"><expression><![CDATA[$P{NOMBRE_REPORTE} + " - " + $P{PERIODO}]]></expression></element>
		<element kind="textField" x="420" y="9" width="85" height="12" style="pie" hTextAlign="Right"><expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></expression></element>
		<element kind="textField" x="505" y="9" width="30" height="12" style="pie" evaluationTime="Report"><expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression></element>
	</pageFooter>
	<summary height="30">
		<element kind="staticText" x="0" y="10" width="535" height="18" style="pie"><text><![CDATA[Notas: importes en soles (S/). Los cobros de ventas anuladas y lo devuelto con notas de crédito se compensan con egresos de caja. Documento generado por SIGMETA.]]></text></element>
	</summary>
</jasperReport>

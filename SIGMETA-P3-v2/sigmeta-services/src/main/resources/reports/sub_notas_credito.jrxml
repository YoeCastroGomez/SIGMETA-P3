<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGMETA · RF015 + RF013 · Reporte comercial: notas de crédito emitidas en el periodo (subreporte). Datos: sp_reporte_notas_credito. -->
<jasperReport name="sub_notas_credito" language="java" pageWidth="535" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="base" default="true" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000"/>
	<style name="seccion" fontName="Liberation Sans" fontSize="9.0" bold="true" forecolor="#000000" vTextAlign="Bottom">
		<box bottomPadding="2"><bottomPen lineWidth="0.75" lineColor="#000000"/></box>
	</style>
	<style name="nota" fontName="Liberation Sans" fontSize="7.0" forecolor="#4D4D4D"/>
	<style name="th" mode="Opaque" backcolor="#E6E6E6" forecolor="#000000" fontName="Liberation Sans" fontSize="7.5" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#808080"/></box>
	</style>
	<style name="td" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
	</style>
	<style name="vacio" fontName="Liberation Sans" fontSize="8.0" forecolor="#4D4D4D" hTextAlign="Center" vTextAlign="Middle">
		<box><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
	</style>
	<style name="tot" mode="Opaque" backcolor="#F2F2F2" fontName="Liberation Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#808080"/></box>
	</style>
	<field name="nota" class="java.lang.String"/>
	<field name="fechaTexto" class="java.lang.String"/>
	<field name="comprobante" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="motivo" class="java.lang.String"/>
	<field name="total" class="java.lang.Number"/>
	<field name="estadoTexto" class="java.lang.String"/>
	<variable name="suma" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{total} == null ? 0d : $F{total}.doubleValue()]]></expression>
	</variable>
	<group name="tabla" minHeightToStartNewPage="90" reprintHeaderOnEachPage="true">
		<expression><![CDATA[1]]></expression>
		<groupHeader>
			<band height="48">
				<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[5. NOTAS DE CRÉDITO EMITIDAS]]></text></element>
				<element kind="staticText" x="0" y="18" width="535" height="11" style="nota"><text><![CDATA[Seguimiento de cada nota: comprobante que corrige, motivo, monto, estado y quién la autorizó.]]></text></element>
				<element kind="staticText" x="0" y="32" width="68" height="16" style="th"><text><![CDATA[Nota]]></text></element>
				<element kind="staticText" x="68" y="32" width="50" height="16" style="th"><text><![CDATA[Emisión]]></text></element>
				<element kind="staticText" x="118" y="32" width="68" height="16" style="th"><text><![CDATA[Corrige]]></text></element>
				<element kind="staticText" x="186" y="32" width="105" height="16" style="th"><text><![CDATA[Cliente]]></text></element>
				<element kind="staticText" x="291" y="32" width="122" height="16" style="th"><text><![CDATA[Motivo]]></text></element>
				<element kind="staticText" x="413" y="32" width="52" height="16" style="th" hTextAlign="Right"><text><![CDATA[Total (S/)]]></text></element>
				<element kind="staticText" x="465" y="32" width="70" height="16" style="th"><text><![CDATA[Estado]]></text></element>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="15">
			<element kind="textField" stretchType="ContainerHeight" x="0" y="0" width="68" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{nota}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="68" y="0" width="50" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{fechaTexto}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="118" y="0" width="68" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{comprobante}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="186" y="0" width="105" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{cliente}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="291" y="0" width="122" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{motivo}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="413" y="0" width="52" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{total}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="465" y="0" width="70" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{estadoTexto}]]></expression></element>
		</band>
	</detail>
	<summary height="16">
		<element kind="staticText" x="0" y="0" width="413" height="16" style="tot"><text><![CDATA[Total de notas de crédito del periodo]]></text></element>
		<element kind="textField" x="413" y="0" width="52" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{suma}]]></expression></element>
		<element kind="staticText" x="465" y="0" width="70" height="16" style="tot"><text><![CDATA[]]></text></element>
	</summary>
	<noData height="42">
		<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[5. NOTAS DE CRÉDITO EMITIDAS]]></text></element>
		<element kind="staticText" x="0" y="22" width="535" height="18" style="vacio"><text><![CDATA[No se emitieron notas de crédito en el periodo.]]></text></element>
	</noData>
</jasperReport>

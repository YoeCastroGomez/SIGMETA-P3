<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGMETA · RF015 · Reporte de caja: diferencias por cajero (subreporte). Datos: sp_reporte_caja_por_cajero. -->
<jasperReport name="sub_cajero" language="java" pageWidth="535" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="base" default="true" fontName="DejaVu Sans" fontSize="8.0" forecolor="#1D1D1F"/>
	<style name="seccion" fontName="DejaVu Sans" fontSize="10.0" bold="true" forecolor="#1D1D1F" vTextAlign="Middle">
		<box leftPadding="6"><leftPen lineWidth="3.0" lineColor="#D9822B"/></box>
	</style>
	<style name="nota" fontName="DejaVu Sans" fontSize="7.0" italic="true" forecolor="#7A7A7A"/>
	<style name="th" mode="Opaque" backcolor="#F3EDE6" forecolor="#5A3A1A" fontName="DejaVu Sans" fontSize="7.5" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.75" lineColor="#C9B8A6"/></box>
	</style>
	<style name="td" fontName="DejaVu Sans" fontSize="8.0" forecolor="#1D1D1F" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#E6E1DB"/></box>
		<conditionalStyle mode="Opaque" backcolor="#FBF8F4">
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<style name="tdAlerta" fontName="DejaVu Sans" fontSize="8.0" forecolor="#1D1D1F" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#E6E1DB"/></box>
		<conditionalStyle mode="Opaque" backcolor="#FBF8F4">
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
		</conditionalStyle>
		<conditionalStyle forecolor="#B42318">
			<conditionExpression><![CDATA[$F{diferenciaNeta} != null && $F{diferenciaNeta}.doubleValue() < -0.005]]></conditionExpression>
		</conditionalStyle>
	</style>
	<style name="tot" mode="Opaque" backcolor="#F7F1EA" fontName="DejaVu Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><topPen lineWidth="1.0" lineColor="#B8A28C"/></box>
	</style>
	<style name="vacio" fontName="DejaVu Sans" fontSize="8.0" italic="true" forecolor="#7A7A7A" hTextAlign="Center" vTextAlign="Middle">
		<box><pen lineWidth="0.5" lineColor="#E6E1DB"/></box>
	</style>
	<field name="cajero" class="java.lang.String"/>
	<field name="cierres" class="java.lang.Number"/>
	<field name="conFaltante" class="java.lang.Number"/>
	<field name="conSobrante" class="java.lang.Number"/>
	<field name="faltantes" class="java.lang.Number"/>
	<field name="sobrantes" class="java.lang.Number"/>
	<field name="diferenciaNeta" class="java.lang.Number"/>
	<variable name="sumCierres" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{cierres} == null ? 0d : $F{cierres}.doubleValue()]]></expression>
	</variable>
	<variable name="sumConFaltante" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{conFaltante} == null ? 0d : $F{conFaltante}.doubleValue()]]></expression>
	</variable>
	<variable name="sumConSobrante" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{conSobrante} == null ? 0d : $F{conSobrante}.doubleValue()]]></expression>
	</variable>
	<variable name="sumFaltantes" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{faltantes} == null ? 0d : $F{faltantes}.doubleValue()]]></expression>
	</variable>
	<variable name="sumSobrantes" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{sobrantes} == null ? 0d : $F{sobrantes}.doubleValue()]]></expression>
	</variable>
	<variable name="sumNeta" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{diferenciaNeta} == null ? 0d : $F{diferenciaNeta}.doubleValue()]]></expression>
	</variable>
	<group name="tabla" minHeightToStartNewPage="90" reprintHeaderOnEachPage="true">
		<expression><![CDATA[1]]></expression>
		<groupHeader>
			<band height="48">
				<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[Diferencias por cajero]]></text></element>
				<element kind="staticText" x="9" y="17" width="526" height="11" style="nota"><text><![CDATA[Solo cierres vigentes. Faltante = el cajero declaró menos de lo calculado.]]></text></element>
				<element kind="staticText" x="0" y="32" width="115" height="16" style="th"><text><![CDATA[Cajero]]></text></element>
				<element kind="staticText" x="115" y="32" width="55" height="16" style="th" hTextAlign="Right"><text><![CDATA[Cierres]]></text></element>
				<element kind="staticText" x="170" y="32" width="70" height="16" style="th" hTextAlign="Right"><text><![CDATA[Con faltante]]></text></element>
				<element kind="staticText" x="240" y="32" width="70" height="16" style="th" hTextAlign="Right"><text><![CDATA[Con sobrante]]></text></element>
				<element kind="staticText" x="310" y="32" width="70" height="16" style="th" hTextAlign="Right"><text><![CDATA[Faltantes]]></text></element>
				<element kind="staticText" x="380" y="32" width="70" height="16" style="th" hTextAlign="Right"><text><![CDATA[Sobrantes]]></text></element>
				<element kind="staticText" x="450" y="32" width="85" height="16" style="th" hTextAlign="Right"><text><![CDATA[Diferencia neta]]></text></element>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="15">
			<element kind="textField" stretchType="ContainerHeight" x="0" y="0" width="115" height="15" style="td" blankWhenNull="true"><expression><![CDATA[$F{cajero}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="115" y="0" width="55" height="15" style="td" hTextAlign="Right" pattern="#,##0" blankWhenNull="true"><expression><![CDATA[$F{cierres}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="170" y="0" width="70" height="15" style="td" hTextAlign="Right" pattern="#,##0" blankWhenNull="true"><expression><![CDATA[$F{conFaltante}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="240" y="0" width="70" height="15" style="td" hTextAlign="Right" pattern="#,##0" blankWhenNull="true"><expression><![CDATA[$F{conSobrante}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="310" y="0" width="70" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{faltantes}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="380" y="0" width="70" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{sobrantes}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="450" y="0" width="85" height="15" style="tdAlerta" hTextAlign="Right" pattern="#,##0.00" bold="true" blankWhenNull="true"><expression><![CDATA[$F{diferenciaNeta}]]></expression></element>
		</band>
	</detail>
	<summary height="16">
		<element kind="staticText" x="0" y="0" width="115" height="16" style="tot"><text><![CDATA[Total]]></text></element>
		<element kind="textField" x="115" y="0" width="55" height="16" style="tot" hTextAlign="Right" pattern="#,##0"><expression><![CDATA[$V{sumCierres}]]></expression></element>
		<element kind="textField" x="170" y="0" width="70" height="16" style="tot" hTextAlign="Right" pattern="#,##0"><expression><![CDATA[$V{sumConFaltante}]]></expression></element>
		<element kind="textField" x="240" y="0" width="70" height="16" style="tot" hTextAlign="Right" pattern="#,##0"><expression><![CDATA[$V{sumConSobrante}]]></expression></element>
		<element kind="textField" x="310" y="0" width="70" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumFaltantes}]]></expression></element>
		<element kind="textField" x="380" y="0" width="70" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumSobrantes}]]></expression></element>
		<element kind="textField" x="450" y="0" width="85" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumNeta}]]></expression></element>
	</summary>
	<noData height="42">
		<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[Diferencias por cajero]]></text></element>
		<element kind="staticText" x="0" y="22" width="535" height="18" style="vacio"><text><![CDATA[Sin cierres vigentes en el periodo.]]></text></element>
	</noData>
</jasperReport>

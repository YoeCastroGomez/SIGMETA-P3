<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGMETA · RF015 · Reporte de caja: cierres de caja del periodo (subreporte). Datos: sp_reporte_caja_cierres. -->
<jasperReport name="sub_cierres" language="java" pageWidth="535" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="base" default="true" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000"/>
	<style name="seccion" fontName="Liberation Sans" fontSize="9.0" bold="true" forecolor="#000000" vTextAlign="Bottom">
		<box bottomPadding="2"><bottomPen lineWidth="0.75" lineColor="#000000"/></box>
	</style>
	<style name="nota" fontName="Liberation Sans" fontSize="7.0" forecolor="#4D4D4D"/>
	<style name="th" mode="Opaque" backcolor="#E6E6E6" forecolor="#000000" fontName="Liberation Sans" fontSize="7.5" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#808080"/></box>
	</style>
	<style name="td" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
	</style>
	<style name="tdAlerta" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
		<conditionalStyle forecolor="#A50000">
			<conditionExpression><![CDATA[$F{diferencia} != null && $F{diferencia}.doubleValue() < -0.005]]></conditionExpression>
		</conditionalStyle>
	</style>
	<style name="vacio" fontName="Liberation Sans" fontSize="8.0" forecolor="#4D4D4D" hTextAlign="Center" vTextAlign="Middle">
		<box><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
	</style>
	<field name="cajaTexto" class="java.lang.String"/>
	<field name="cajero" class="java.lang.String"/>
	<field name="fechaCierreTexto" class="java.lang.String"/>
	<field name="montoCalculado" class="java.lang.Number"/>
	<field name="montoDeclarado" class="java.lang.Number"/>
	<field name="diferencia" class="java.lang.Number"/>
	<field name="estadoTexto" class="java.lang.String"/>
	<group name="tabla" minHeightToStartNewPage="90" reprintHeaderOnEachPage="true">
		<expression><![CDATA[1]]></expression>
		<groupHeader>
			<band height="48">
				<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[1. CIERRES DE CAJA]]></text></element>
				<element kind="staticText" x="0" y="18" width="535" height="11" style="nota"><text><![CDATA[Diferencia = monto declarado − monto calculado. En rojo, los cierres con faltante.]]></text></element>
				<element kind="staticText" x="0" y="32" width="45" height="16" style="th"><text><![CDATA[Caja]]></text></element>
				<element kind="staticText" x="45" y="32" width="85" height="16" style="th"><text><![CDATA[Cajero]]></text></element>
				<element kind="staticText" x="130" y="32" width="95" height="16" style="th"><text><![CDATA[Cierre]]></text></element>
				<element kind="staticText" x="225" y="32" width="70" height="16" style="th" hTextAlign="Right"><text><![CDATA[Calculado]]></text></element>
				<element kind="staticText" x="295" y="32" width="70" height="16" style="th" hTextAlign="Right"><text><![CDATA[Declarado]]></text></element>
				<element kind="staticText" x="365" y="32" width="65" height="16" style="th" hTextAlign="Right"><text><![CDATA[Diferencia]]></text></element>
				<element kind="staticText" x="430" y="32" width="105" height="16" style="th"><text><![CDATA[Estado]]></text></element>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="15">
			<element kind="textField" stretchType="ContainerHeight" x="0" y="0" width="45" height="15" style="td" blankWhenNull="true"><expression><![CDATA[$F{cajaTexto}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="45" y="0" width="85" height="15" style="td" blankWhenNull="true"><expression><![CDATA[$F{cajero}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="130" y="0" width="95" height="15" style="td" blankWhenNull="true"><expression><![CDATA[$F{fechaCierreTexto}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="225" y="0" width="70" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{montoCalculado}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="295" y="0" width="70" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{montoDeclarado}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="365" y="0" width="65" height="15" style="tdAlerta" hTextAlign="Right" pattern="#,##0.00" bold="true" blankWhenNull="true"><expression><![CDATA[$F{diferencia}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="430" y="0" width="105" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{estadoTexto}]]></expression></element>
		</band>
	</detail>
	<noData height="42">
		<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[1. CIERRES DE CAJA]]></text></element>
		<element kind="staticText" x="0" y="22" width="535" height="18" style="vacio"><text><![CDATA[No hubo cierres en el periodo.]]></text></element>
	</noData>
</jasperReport>

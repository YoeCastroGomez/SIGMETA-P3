<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGMETA · RF015 · Reporte de caja: dinero por medio de pago (subreporte). Datos: sp_reporte_caja_por_medio_pago. -->
<jasperReport name="sub_medio_pago" language="java" pageWidth="535" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="base" default="true" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000"/>
	<style name="seccion" fontName="Liberation Sans" fontSize="9.0" bold="true" forecolor="#000000" vTextAlign="Bottom">
		<box bottomPadding="2"><bottomPen lineWidth="0.75" lineColor="#000000"/></box>
	</style>
	<style name="th" mode="Opaque" backcolor="#E6E6E6" forecolor="#000000" fontName="Liberation Sans" fontSize="7.5" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#808080"/></box>
	</style>
	<style name="td" fontName="Liberation Sans" fontSize="8.0" forecolor="#000000" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
	</style>
	<style name="tot" mode="Opaque" backcolor="#EFEFEF" fontName="Liberation Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#808080"/><topPen lineWidth="1.0" lineColor="#000000"/></box>
	</style>
	<style name="vacio" fontName="Liberation Sans" fontSize="8.0" forecolor="#4D4D4D" hTextAlign="Center" vTextAlign="Middle">
		<box><pen lineWidth="0.5" lineColor="#A6A6A6"/></box>
	</style>
	<field name="medioTexto" class="java.lang.String"/>
	<field name="cobrosContado" class="java.lang.Number"/>
	<field name="cobrosCredito" class="java.lang.Number"/>
	<field name="ingresos" class="java.lang.Number"/>
	<field name="egresos" class="java.lang.Number"/>
	<field name="neto" class="java.lang.Number"/>
	<variable name="sumContado" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{cobrosContado} == null ? 0d : $F{cobrosContado}.doubleValue()]]></expression>
	</variable>
	<variable name="sumCredito" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{cobrosCredito} == null ? 0d : $F{cobrosCredito}.doubleValue()]]></expression>
	</variable>
	<variable name="sumIngresos" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{ingresos} == null ? 0d : $F{ingresos}.doubleValue()]]></expression>
	</variable>
	<variable name="sumEgresos" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{egresos} == null ? 0d : $F{egresos}.doubleValue()]]></expression>
	</variable>
	<variable name="sumNeto" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{neto} == null ? 0d : $F{neto}.doubleValue()]]></expression>
	</variable>
	<group name="tabla" minHeightToStartNewPage="90" reprintHeaderOnEachPage="true">
		<expression><![CDATA[1]]></expression>
		<groupHeader>
			<band height="38">
				<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[2. DINERO POR MEDIO DE PAGO]]></text></element>
				<element kind="staticText" x="0" y="22" width="115" height="16" style="th"><text><![CDATA[Medio de pago]]></text></element>
				<element kind="staticText" x="115" y="22" width="85" height="16" style="th" hTextAlign="Right"><text><![CDATA[Cobros contado]]></text></element>
				<element kind="staticText" x="200" y="22" width="85" height="16" style="th" hTextAlign="Right"><text><![CDATA[Cobros crédito]]></text></element>
				<element kind="staticText" x="285" y="22" width="80" height="16" style="th" hTextAlign="Right"><text><![CDATA[Ingresos]]></text></element>
				<element kind="staticText" x="365" y="22" width="80" height="16" style="th" hTextAlign="Right"><text><![CDATA[Egresos]]></text></element>
				<element kind="staticText" x="445" y="22" width="90" height="16" style="th" hTextAlign="Right"><text><![CDATA[Neto (S/)]]></text></element>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="15">
			<element kind="textField" stretchType="ContainerHeight" x="0" y="0" width="115" height="15" style="td" blankWhenNull="true"><expression><![CDATA[$F{medioTexto}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="115" y="0" width="85" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{cobrosContado}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="200" y="0" width="85" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{cobrosCredito}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="285" y="0" width="80" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{ingresos}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="365" y="0" width="80" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{egresos}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="445" y="0" width="90" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" bold="true" blankWhenNull="true"><expression><![CDATA[$F{neto}]]></expression></element>
		</band>
	</detail>
	<summary height="16">
		<element kind="staticText" x="0" y="0" width="115" height="16" style="tot"><text><![CDATA[Total]]></text></element>
		<element kind="textField" x="115" y="0" width="85" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumContado}]]></expression></element>
		<element kind="textField" x="200" y="0" width="85" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumCredito}]]></expression></element>
		<element kind="textField" x="285" y="0" width="80" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumIngresos}]]></expression></element>
		<element kind="textField" x="365" y="0" width="80" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumEgresos}]]></expression></element>
		<element kind="textField" x="445" y="0" width="90" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumNeto}]]></expression></element>
	</summary>
	<noData height="42">
		<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[2. DINERO POR MEDIO DE PAGO]]></text></element>
		<element kind="staticText" x="0" y="22" width="535" height="18" style="vacio"><text><![CDATA[No hubo movimientos de caja en el periodo.]]></text></element>
	</noData>
</jasperReport>

<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGMETA · RF015 · Reporte de abastecimiento: productos sin movimiento (subreporte). Datos: sp_reporte_productos_sin_movimiento. -->
<jasperReport name="sub_sin_movimiento" language="java" pageWidth="535" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<style name="base" default="true" fontName="DejaVu Sans" fontSize="8.0" forecolor="#1D1D1F"/>
	<style name="seccion" fontName="DejaVu Sans" fontSize="10.0" bold="true" forecolor="#1D1D1F" vTextAlign="Middle">
		<box leftPadding="6"><leftPen lineWidth="3.0" lineColor="#D9822B"/></box>
	</style>
	<style name="nota" fontName="DejaVu Sans" fontSize="7.0" italic="true" forecolor="#7A7A7A"/>
	<style name="th" mode="Opaque" backcolor="#F3EDE6" forecolor="#5A3A1A" fontName="DejaVu Sans" fontSize="7.5" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.75" lineColor="#C9B8A6"/></box>
	</style>
	<style name="td" fontName="DejaVu Sans" fontSize="8.0" forecolor="#1D1D1F" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#E6E1DB"/></box>
		<conditionalStyle mode="Opaque" backcolor="#FBF8F4">
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<style name="tot" mode="Opaque" backcolor="#F7F1EA" fontName="DejaVu Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"><topPen lineWidth="1.0" lineColor="#B8A28C"/></box>
	</style>
	<style name="vacio" fontName="DejaVu Sans" fontSize="8.0" italic="true" forecolor="#7A7A7A" hTextAlign="Center" vTextAlign="Middle">
		<box><pen lineWidth="0.5" lineColor="#E6E1DB"/></box>
	</style>
	<field name="codigoInterno" class="java.lang.String"/>
	<field name="producto" class="java.lang.String"/>
	<field name="stockActual" class="java.lang.Number"/>
	<field name="valorInmovilizado" class="java.lang.Number"/>
	<field name="ultimaSalidaTexto" class="java.lang.String"/>
	<variable name="sumValor" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{valorInmovilizado} == null ? 0d : $F{valorInmovilizado}.doubleValue()]]></expression>
	</variable>
	<group name="tabla" minHeightToStartNewPage="90" reprintHeaderOnEachPage="true">
		<expression><![CDATA[1]]></expression>
		<groupHeader>
			<band height="48">
				<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[Productos sin movimiento]]></text></element>
				<element kind="staticText" x="9" y="17" width="526" height="11" style="nota"><text><![CDATA[Con existencias y sin ninguna salida en el periodo: capital inmovilizado (máximo 50).]]></text></element>
				<element kind="staticText" x="0" y="32" width="80" height="16" style="th"><text><![CDATA[Código]]></text></element>
				<element kind="staticText" x="80" y="32" width="225" height="16" style="th"><text><![CDATA[Producto]]></text></element>
				<element kind="staticText" x="305" y="32" width="70" height="16" style="th" hTextAlign="Right"><text><![CDATA[En almacén]]></text></element>
				<element kind="staticText" x="375" y="32" width="85" height="16" style="th" hTextAlign="Right"><text><![CDATA[Valor al costo]]></text></element>
				<element kind="staticText" x="460" y="32" width="75" height="16" style="th" hTextAlign="Center"><text><![CDATA[Última salida]]></text></element>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="15">
			<element kind="textField" stretchType="ContainerHeight" x="0" y="0" width="80" height="15" style="td" bold="true" blankWhenNull="true"><expression><![CDATA[$F{codigoInterno}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="80" y="0" width="225" height="15" style="td" textAdjust="StretchHeight" blankWhenNull="true"><expression><![CDATA[$F{producto}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="305" y="0" width="70" height="15" style="td" hTextAlign="Right" pattern="#,##0.###" blankWhenNull="true"><expression><![CDATA[$F{stockActual}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="375" y="0" width="85" height="15" style="td" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"><expression><![CDATA[$F{valorInmovilizado}]]></expression></element>
			<element kind="textField" stretchType="ContainerHeight" x="460" y="0" width="75" height="15" style="td" hTextAlign="Center" blankWhenNull="true"><expression><![CDATA[$F{ultimaSalidaTexto}]]></expression></element>
		</band>
	</detail>
	<summary height="16">
		<element kind="staticText" x="0" y="0" width="375" height="16" style="tot"><text><![CDATA[Capital inmovilizado]]></text></element>
		<element kind="textField" x="375" y="0" width="85" height="16" style="tot" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$V{sumValor}]]></expression></element>
		<element kind="staticText" x="460" y="0" width="75" height="16" style="tot"><text><![CDATA[]]></text></element>
	</summary>
	<noData height="42">
		<element kind="staticText" x="0" y="0" width="535" height="16" style="seccion"><text><![CDATA[Productos sin movimiento]]></text></element>
		<element kind="staticText" x="0" y="22" width="535" height="18" style="vacio"><text><![CDATA[Todos los productos con stock tuvieron salidas en el periodo.]]></text></element>
	</noData>
</jasperReport>

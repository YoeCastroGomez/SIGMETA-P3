<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pe.edu.pucp</groupId>
        <artifactId>sigmeta</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sigmeta-services</artifactId>
    <dependencies>
        <dependency>
            <groupId>pe.edu.pucp</groupId>
            <artifactId>sigmeta-dao</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- RF015: reportes PDF con JasperReports (motor, exportador PDF y fuentes DejaVu para tildes y ñ) -->
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-pdf</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-fonts</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>
    </dependencies>
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- RF015: compila las plantillas JasperReports (.jrxml -> .jasper) en el build, despues de compilar
                 las clases. Se ejecuta en una JVM aparte para que el compilador vea las librerias de JasperReports.
                 Los .jasper quedan en target/classes/reports y viajan dentro del .war. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compilar-plantillas-jasper</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>pe.edu.pucp.sigmeta.boimpl.reporte.CompilarPlantillas</argument>
                                <argument>${project.basedir}/src/main/resources/reports</argument>
                                <argument>${project.build.outputDirectory}/reports</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
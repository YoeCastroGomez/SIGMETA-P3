@page "/proveedores/nuevo"
@page "/proveedores/editar/{Id:int}"
@inject ApiJava Api
@inject NavigationManager Nav
@using SigmetaWeb.Components.Pages.Catalogo

<PageTitle>@Titulo · SIGMETA</PageTitle>

<Encabezado Rf="RF004" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/proveedores">Volver a la lista</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (proveedor is null)
{
    <p class="text-muted">Cargando proveedor...</p>
}
else
{
    @* novalidate: sin globos del navegador. Cada error sale en rojo debajo de su campo mientras se escribe
       (estándar RNF004, ValidacionEnVivo); los del BO (RUC repetido...) en el aviso rojo de arriba. *@
    <EditForm Model="@proveedor" OnSubmit="Guardar" novalidate>
        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">Identificación</h2>
            <div class="row">
                <div class="col-md-4">
                    <Campo Etiqueta="RUC" Id="ruc" Obligatorio="true" Ayuda="Único, 11 dígitos." Error="@(v.Error("ruc", Errores()))">
                        <InputText id="ruc" class="@(v.Clase("ruc", Errores()))" maxlength="11" inputmode="numeric"
                                   @bind-Value="proveedor.Ruc" @oninput="@(e => v.Escribiendo("ruc", e))" />
                    </Campo>
                </div>
                <div class="col-md-8">
                    <Campo Etiqueta="Razón social" Id="razonSocial" Obligatorio="true" Error="@(v.Error("razonSocial", Errores()))">
                        <InputText id="razonSocial" class="@(v.Clase("razonSocial", Errores()))" maxlength="150"
                                   @bind-Value="proveedor.RazonSocial" @oninput="@(e => v.Escribiendo("razonSocial", e))" />
                    </Campo>
                </div>
                <div class="col-12">
                    <Campo Etiqueta="Rubro" Id="rubro">
                        <InputText id="rubro" class="form-control" maxlength="100" @bind-Value="proveedor.Rubro" />
                    </Campo>
                </div>
            </div>
        </div>

        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">Datos de contacto</h2>
            <div class="row">
                <div class="col-12">
                    <Campo Etiqueta="Dirección" Id="direccion">
                        <InputText id="direccion" class="form-control" maxlength="200" @bind-Value="proveedor.Contacto.Direccion" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Teléfono" Id="telefono" Ayuda="Dígitos, espacios, + y -." Error="@(v.Error("telefono", Errores()))">
                        <InputText id="telefono" type="tel" class="@(v.Clase("telefono", Errores()))" maxlength="20"
                                   @bind-Value="proveedor.Contacto.Telefono" @oninput="@(e => v.Escribiendo("telefono", e))" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Correo" Id="correo" Error="@(v.Error("correo", Errores()))">
                        <InputText id="correo" type="email" class="@(v.Clase("correo", Errores()))" maxlength="120"
                                   @bind-Value="proveedor.Contacto.Correo" @oninput="@(e => v.Escribiendo("correo", e))" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Persona de contacto" Id="contacto">
                        <InputText id="contacto" class="form-control" maxlength="100" @bind-Value="proveedor.Contacto.NombreContacto" />
                    </Campo>
                </div>
            </div>
        </div>

        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">Condición comercial</h2>
            <div class="row">
                <div class="col-md-4">
                    <Campo Etiqueta="Plazo de entrega (días)" Id="plazo" Error="@(v.Error("plazo", Errores()))">
                        <InputNumber id="plazo" class="@(v.Clase("plazo", Errores()))" onkeydown="@ValidacionEnVivo.SoloPositivos"
                                     @bind-Value="proveedor.PlazoEntregaDias" @oninput="@(e => v.Escribiendo("plazo", e))" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Condición de pago" Id="condicion" Obligatorio="true">
                        <InputSelect id="condicion" class="form-select" @bind-Value="proveedor.CondicionPago">
                            <option value="CONTADO">Contado</option>
                            <option value="CREDITO">Crédito</option>
                        </InputSelect>
                    </Campo>
                </div>
                @if (!EsNuevo)
                {
                    <div class="col-md-4">
                        <div class="small text-muted">Estado</div>
                        <Estado Texto="@(proveedor.Estado ? "Activo" : "Inactivo")" />
                        <div class="small text-muted">La desactivación se realiza desde la lista.</div>
                    </div>
                }
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
                <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="/proveedores">Cancelar</a>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Proveedor? proveedor;
    private string? error;
    private bool guardando;
    private bool EsNuevo => Id is null;
    private string Titulo => EsNuevo ? "Nuevo proveedor" : "Editar proveedor";

    protected override async Task OnParametersSetAsync()
    {
        error = null;
        if (EsNuevo)
        {
            proveedor = new Proveedor();
            return;
        }
        proveedor = null;
        try
        {
            proveedor = await Api.Get<Proveedor>($"proveedores/{Id}");
            if (proveedor is null)
                error = $"No existe el proveedor con ID {Id}.";
            else
                proveedor.Contacto ??= new DatosContactoProveedor();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    // ---------------- Validación en pantalla (RNF004) ----------------
    // Mismas reglas que ProveedorBOImpl.validarDatos y Validador. El BO vuelve a validar todo, y lo que solo él
    // sabe (RUC o razón social repetidos) sale en el aviso rojo de arriba.
    private readonly ValidacionEnVivo v = new();

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (proveedor is null)
        {
            return e;
        }
        if (ValidacionEnVivo.ErrorRuc(v.Texto("ruc", proveedor.Ruc).Trim()) is { } ruc)
        {
            e["ruc"] = ruc;
        }
        if (string.IsNullOrWhiteSpace(v.Texto("razonSocial", proveedor.RazonSocial)))
        {
            e["razonSocial"] = "La razón social es obligatoria.";
        }
        if (ValidacionEnVivo.ErrorTelefono(v.Texto("telefono", proveedor.Contacto.Telefono)) is { } telefono)
        {
            e["telefono"] = telefono;
        }
        if (ValidacionEnVivo.ErrorCorreo(v.Texto("correo", proveedor.Contacto.Correo)) is { } correo)
        {
            e["correo"] = correo;
        }
        var plazo = v.Numero("plazo", proveedor.PlazoEntregaDias);
        if (plazo is null)
        {
            e["plazo"] = "Escriba el plazo de entrega en días (0 si entrega el mismo día).";
        }
        else if (plazo < 0)
        {
            e["plazo"] = "El plazo de entrega no puede ser negativo.";
        }
        else if (ValidacionEnVivo.MasDecimales(plazo.Value, 0))
        {
            e["plazo"] = "El plazo de entrega debe ser un número entero de días.";
        }
        return e;
    }

    private async Task Guardar()
    {
        if (proveedor is null) return;
        error = null;
        if (!v.Intentar(Errores()))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        guardando = true;
        try
        {
            if (EsNuevo)
                await Api.Post<Proveedor>("proveedores", proveedor);
            else
                await Api.Put<Proveedor>($"proveedores/{Id}", proveedor);
            Nav.NavigateTo("/proveedores");
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}

@page "/proveedores"
@inject ApiJava Api
@using SigmetaWeb.Components.Pages.Catalogo

<PageTitle>Proveedores · SIGMETA</PageTitle>

@* RF004: consulta REST real con el ticket del Administrador (ApiJava). *@
<Encabezado Rf="RF004" Titulo="Proveedores"
            Subtitulo="Un proveedor desactivado conserva su historial, pero no puede elegirse en compras nuevas.">
    <a class="btn btn-primary" href="/proveedores/nuevo">Nuevo proveedor</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end" @onsubmit="Buscar" @onsubmit:preventDefault>
        <Campo Etiqueta="RUC" Id="fRuc" Clase="col-sm-6 col-md-3">
            <input id="fRuc" class="form-control" maxlength="11" @bind="filtroRuc" />
        </Campo>
        <Campo Etiqueta="Razón social" Id="fRazon" Clase="col-sm-6 col-md">
            <input id="fRazon" class="form-control" maxlength="150" @bind="filtroRazonSocial" />
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-3">
            <select id="fEstado" class="form-select" @bind="filtroEstado">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
            </select>
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark" disabled="@cargando">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar" disabled="@cargando">Limpiar</button>
        </div>
    </form>
</div>

@if (cargando && proveedores is null)
{
    <p class="text-muted">Cargando proveedores...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>RUC</th>
                        <th>Razón social</th>
                        <th>Rubro</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (proveedores is null || proveedores.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron proveedores.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in proveedores)
                        {
                            <tr>
                                <td>@p.Ruc</td>
                                <td><strong>@p.RazonSocial</strong></td>
                                <td>@(p.Rubro ?? "—")</td>
                                <td><Estado Texto="@(p.Estado ? "Activo" : "Inactivo")" /></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 text-nowrap">
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"/proveedores/editar/{p.Id}")">Editar</a>
                                        @if (p.Estado)
                                        {
                                            @if (confirmarId == p.Id)
                                            {
                                                <button type="button" class="btn btn-sm btn-danger" disabled="@cargando"
                                                        @onclick="() => Desactivar(p)">Confirmar baja</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => confirmarId = null">Cancelar</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => confirmarId = p.Id">Desactivar</button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Proveedor>? proveedores;
    private string filtroRuc = "";
    private string filtroRazonSocial = "";
    private string filtroEstado = "";
    private string? error;
    private string? exito;
    private int? confirmarId;
    private bool cargando;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Buscar()
    {
        exito = null;
        confirmarId = null;
        await Cargar();
    }

    private async Task Limpiar()
    {
        filtroRuc = filtroRazonSocial = filtroEstado = "";
        exito = null;
        confirmarId = null;
        await Cargar();
    }

    private string RutaBusqueda()
    {
        var filtros = new List<string>();
        if (!string.IsNullOrWhiteSpace(filtroRuc))
            filtros.Add("ruc=" + Uri.EscapeDataString(filtroRuc.Trim()));
        if (!string.IsNullOrWhiteSpace(filtroRazonSocial))
            filtros.Add("razonSocial=" + Uri.EscapeDataString(filtroRazonSocial.Trim()));
        if (!string.IsNullOrEmpty(filtroEstado))
            filtros.Add("estado=" + filtroEstado);
        return "proveedores" + (filtros.Count == 0 ? "" : "?" + string.Join("&", filtros));
    }

    private async Task Cargar()
    {
        error = null;
        cargando = true;
        try
        {
            proveedores = await Api.Get<List<Proveedor>>(RutaBusqueda()) ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            proveedores ??= new();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Desactivar(Proveedor proveedor)
    {
        error = null;
        exito = null;
        cargando = true;
        try
        {
            await Api.Delete($"proveedores/{proveedor.Id}");
            confirmarId = null;
            // Recargar la consulta para reflejar la baja lógica desde MySQL.
            proveedores = await Api.Get<List<Proveedor>>(RutaBusqueda()) ?? new();
            exito = $"Se desactivó el proveedor {proveedor.RazonSocial}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}

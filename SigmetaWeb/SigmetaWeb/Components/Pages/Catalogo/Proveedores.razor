@page "/proveedores"

<PageTitle>Proveedores · SIGMETA</PageTitle>

@* RF004 · Lista de proveedores. Solo visual (Lab 9): los filtros y botones no hacen nada. *@
<Encabezado Rf="RF004" Titulo="Proveedores"
            Subtitulo="Un proveedor desactivado conserva su historial, pero no puede elegirse en compras nuevas.">
    <a class="btn btn-primary" href="/proveedores/nuevo">Nuevo proveedor</a>
</Encabezado>

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <Campo Etiqueta="RUC" Id="fRuc" Clase="col-sm-6 col-md-3">
            <input id="fRuc" class="form-control" maxlength="11" />
        </Campo>
        <Campo Etiqueta="Razón social" Id="fRazon" Clase="col-sm-6 col-md">
            <input id="fRazon" class="form-control" maxlength="150" />
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-3">
            <select id="fEstado" class="form-select">
                <option>Todos</option>
                <option>Activos</option>
                <option>Inactivos</option>
            </select>
        </Campo>
        <div class="col-auto">
            <button class="btn btn-dark">Buscar</button>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>RUC</th>
                    <th>Razón social</th>
                    <th>Rubro</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in MuestrasCatalogo.Proveedores)
                {
                    <tr>
                        <td>@p.Ruc</td>
                        <td><strong>@p.RazonSocial</strong></td>
                        <td>@(p.Rubro ?? "—")</td>
                        <td><Estado Texto="@(p.Activo ? "Activo" : "Inactivo")" /></td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/proveedores/editar/{p.Id}")">Editar</a>
                                @if (p.Activo)
                                {
                                    <button class="btn btn-sm btn-outline-danger">Desactivar</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@page "/cotizaciones"

<PageTitle>Cotizaciones · SIGMETA</PageTitle>

@* RF007 · Lista de cotizaciones. Solo visual (Lab 9): los filtros y botones no hacen nada. Importes solo en soles.
   Los botones de cada fila siguen el ciclo de CotizacionBOImpl:
   REGISTRADA -> Editar, Enviar, Anular · ENVIADA -> Aceptar, Rechazar, Anular · RECHAZADA o VENCIDA -> Anular ·
   ACEPTADA -> ninguno (no se puede anular). *@
<Encabezado Rf="RF007" Titulo="Cotizaciones"
            Subtitulo="Solo una cotización registrada se modifica. Una cotización aceptada puede pasar a orden de compra del cliente.">
    <a class="btn btn-primary" href="/cotizaciones/nueva">Nueva cotización</a>
</Encabezado>

@if (anulando is not null)
{
    @* RF007: anular pide un motivo (anulación lógica). *@
    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Anular cotización @anulando.Numero</h2>
        <Campo Etiqueta="Motivo de anulación" Id="motivo" Obligatorio="true">
            <input id="motivo" class="form-control" maxlength="255" />
        </Campo>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
            <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="Cerrar">Cancelar</button>
                <button class="btn btn-outline-danger" @onclick="Cerrar">Anular</button>
            </div>
        </div>
    </div>
}

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <Campo Etiqueta="Cliente" Id="fCliente" Clase="col-sm-6 col-md">
            <select id="fCliente" class="form-select">
                <option>Todos</option>
                @foreach (var c in MuestrasCatalogo.Clientes)
                {
                    <option>@c</option>
                }
            </select>
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-3">
            <select id="fEstado" class="form-select">
                <option>Todos</option>
                @foreach (var e in MuestrasCatalogo.EstadosCotizacion)
                {
                    <option>@MuestrasCatalogo.Texto(e)</option>
                }
            </select>
        </Campo>
        <div class="col-auto">
            <button class="btn btn-dark">Buscar</button>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Vigencia</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in MuestrasCatalogo.Cotizaciones)
                {
                    <tr>
                        <td><strong>@c.Numero</strong></td>
                        <td>@c.Cliente</td>
                        <td>@c.FechaEmision</td>
                        <td>@c.FechaVigencia</td>
                        <td class="text-end">S/ @c.Total.ToString("N2")</td>
                        <td><Estado Texto="@MuestrasCatalogo.Texto(c.Estado)" /></td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 text-nowrap">
                                @if (c.Estado == "REGISTRADA")
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/cotizaciones/editar/{c.Id}")">Editar</a>
                                    <button class="btn btn-sm btn-primary">Enviar</button>
                                }
                                @if (c.Estado == "ENVIADA")
                                {
                                    <button class="btn btn-sm btn-primary">Aceptar</button>
                                    <button class="btn btn-sm btn-outline-danger">Rechazar</button>
                                }
                                @if (c.Estado is "REGISTRADA" or "ENVIADA" or "RECHAZADA" or "VENCIDA")
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Anular(c)">Anular</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // Solo controla qué cotización se muestra en el bloque de anulación (Lab 9: no se anula nada).
    private CotizacionFila? anulando;

    private void Anular(CotizacionFila cotizacion) => anulando = cotizacion;
    private void Cerrar() => anulando = null;
}

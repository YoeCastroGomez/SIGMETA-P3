@page "/cotizaciones"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Administrador")]
@using SigmetaWeb.Components.Pages.Ventas
@using SigmetaWeb.Components.Pages.Clientes
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Cotizaciones · SIGMETA</PageTitle>

@* RF007 · Lista de cotizaciones. PATRÓN UX de listas (ver Shared/ComponentesFlujo.cs):
     - <FiltrosLista>: tarjeta propia, separada de la lista: búsqueda, cliente y chips por estado con su cantidad.
       El filtro cliente + estado lo hace el BO (CotizacionBO.buscar): GET /api/cotizaciones?cliente=&estado=
     - <AccionesFila>: un botón principal del mismo ancho (el siguiente paso del ciclo) y el menú «⋯» con lo demás.
     - «Enviar» abre la cotización como documento (CotizacionEnviar.razor): se imprime o guarda en PDF y se marca enviada.
     - El resultado de cada acción sale en una <Notificacion> flotante: no mueve la tabla.
     - Filtros y página quedan en la dirección: al volver de una cotización la lista está igual.
   Datos reales del Java:
   - GET  /api/cotizaciones (?cliente=ID y/o ?estado=ESTADO)    buscar(cliente, estado) del BO; ANULADA trae las anuladas
   - POST /api/cotizaciones/{id}/enviar | aceptar | rechazar     ciclo REGISTRADA -> ENVIADA -> ACEPTADA o RECHAZADA
   - POST /api/cotizaciones/{id}/anular {"motivo": ...}          anulación lógica con motivo (Vendedor o Administrador)
   - GET  /api/ordenes                                           (Vendedor) qué cotizaciones aceptadas ya tienen orden *@
<Encabezado Rf="RF007" Titulo="Cotizaciones">
    @if (EsVendedor)
    {
        <a class="btn btn-primary" href="@($"/cotizaciones/nueva?volver={Volver.Parametro(RutaActual)}")">+ Nueva cotización</a>
    }
</Encabezado>

<Notificacion Mensaje="@aviso" Error="@avisoError" TextoAccion="@avisoAccion" Ruta="@avisoRuta" AlCerrar="CerrarAviso" />

<ModalMotivo Visible="@(anulando is not null)" Titulo="@($"Anular {anulando?.Numero}")" TextoConfirmar="Anular"
             Ocupado="@trabajando" Maximo="255" Ejemplo="Ejemplo: el cliente ya no requiere los productos."
             AlConfirmar="ConfirmarAnulacion" AlCancelar="() => anulando = null">
    <p class="mb-0 text-muted">Ya no se podrá enviar, aceptar ni convertir en orden.</p>
</ModalMotivo>

@* Respuesta del cliente a una cotización enviada: Aceptó o Rechazó en una sola ventana *@
@if (respondiendo is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="tituloRespuesta">
        <div class="modal-dialog modal-dialog-centered respuesta">
            <div class="modal-content">
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h5 fw-bold mb-1" id="tituloRespuesta">Respuesta del cliente</h2>
                            <div class="text-muted small">@respondiendo.Numero · @respondiendo.Cliente</div>
                        </div>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => respondiendo = null"></button>
                    </div>
                    <div class="monto-respuesta">S/ @respondiendo.Total.ToString("N2")</div>
                    <div class="opciones-respuesta">
                        <button type="button" class="opcion acepto" disabled="@trabajando" @onclick="Aceptar">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                            Aceptó
                        </button>
                        <button type="button" class="opcion rechazo" disabled="@trabajando" @onclick="Rechazar">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
                            Rechazó
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<FiltrosLista @bind-Busqueda="busqueda" @bind-Busqueda:after="AlBuscar" Placeholder="Número, cliente o RUC/DNI"
              Opciones="@Chips" Estado="@filtroEstado" EstadoChanged="CambiarEstado" HayFiltros="@HayFiltros" AlLimpiar="Limpiar">
    <Campo Etiqueta="Cliente" Id="fCliente" Clase="col-sm-6 col-md-3">
        <select id="fCliente" class="form-select" value="@filtroCliente" @onchange="CambiarCliente">
            <option value="0">Todos</option>
            @foreach (var c in clientes)
            {
                <option value="@c.Id">@c.NombreMostrado</option>
            }
        </select>
    </Campo>
</FiltrosLista>

<div class="card mb-3">
    @if (cotizaciones is null)
    {
        <p class="text-muted p-3 mb-0">Cargando cotizaciones...</p>
    }
    else
    {
        var filtradas = Filtradas;
        var pagina = Pagina(filtradas).ToList();
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table table-hover align-middle mb-0 tabla-lista">
                <thead>
                    <tr>
                        <th>Cotización</th>
                        <th>Cliente</th>
                        <th>Vigencia</th>
                        <th class="text-end">Total (S/)</th>
                        <th>Estado</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                @if (HayFiltros)
                                {
                                    <ListaVacia Titulo="Ninguna cotización coincide con los filtros." AlQuitarFiltros="Limpiar" />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Todavía no hay cotizaciones."
                                                TextoAccion="@(EsVendedor ? "Registrar la primera cotización" : null)" Ruta="/cotizaciones/nueva" />
                                }
                            </td>
                        </tr>
                    }
                    @for (var i = 0; i < pagina.Count; i++)
                    {
                        var c = pagina[i];
                        var dias = DiasParaVencer(c);
                        // en las últimas filas el menú se abre hacia arriba para no salirse de la tabla
                        var haciaArriba = pagina.Count > 3 && i >= pagina.Count - 2;
                        <tr @key="c.Id">
                            <td>
                                <a class="numero" href="@RutaCotizacion(c)">@c.Numero</a>
                                <div class="sub">@TextosVentas.Fecha(c.FechaEmision)</div>
                            </td>
                            <td>@c.Cliente</td>
                            <td class="text-nowrap">
                                @TextosVentas.Fecha(c.FechaVigencia)
                                @if (dias is int d)
                                {
                                    <div class="sub vence @(d <= 1 ? "urgente" : "")">
                                        @(d == 0 ? "Vence hoy" : d == 1 ? "Vence mañana" : $"Vence en {d} días")
                                    </div>
                                }
                            </td>
                            <td class="text-end fw-semibold">@c.Total.ToString("N2")</td>
                            <td>
                                <Estado Texto="@TextosVentas.Texto(c.Estado)" />
                                @if (c.Estado == "ACEPTADA" && conOrden.TryGetValue(c.Id, out var numOrden))
                                {
                                    <div class="sub">@numOrden</div>
                                }
                            </td>
                            <td class="acciones">
                                <AccionesFila Principal="@Principal(c)" Otras="@Secundarias(c)" Ocupado="@trabajando" HaciaArriba="@haciaArriba" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" PaginaActual="@paginaActual" PaginaActualChanged="CambiarPagina"
                    @bind-TamanoPagina="tamanoPagina" />
    }
</div>


@page "/cotizaciones"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Administrador")]
@using SigmetaWeb.Components.Pages.Ventas
@using SigmetaWeb.Components.Pages.Clientes
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Cotizaciones · SIGMETA</PageTitle>

@* RF007 · Lista de cotizaciones. PATRÓN UX de listas (ver Shared/ComponentesFlujo.cs):
     - Chips por estado con su cantidad. El filtro cliente + estado lo hace el BO (CotizacionBO.buscar):
       cada chip pide GET /api/cotizaciones?cliente=&estado= al Java (filtro combinado del RF007).
     - Búsqueda rápida por número, cliente o documento sobre lo que devolvió el Java.
     - Una acción principal por fila según el estado del ciclo: Enviar -> Aceptar -> Generar orden.
     - Las acciones que no se deshacen piden confirmación (Rechazar) o motivo (Anular) y dicen qué pasa.
     - Filtros y página quedan en la dirección: al volver de una cotización la lista está igual.
   Datos reales del Java:
   - GET  /api/cotizaciones (?cliente=ID y/o ?estado=ESTADO)    buscar(cliente, estado) del BO; ANULADA trae las anuladas
   - POST /api/cotizaciones/{id}/enviar | aceptar | rechazar     ciclo REGISTRADA -> ENVIADA -> ACEPTADA o RECHAZADA
   - POST /api/cotizaciones/{id}/anular {"motivo": ...}          anulación lógica con motivo (Vendedor o Administrador)
   - GET  /api/ordenes                                           (Vendedor) qué cotizaciones aceptadas ya tienen orden *@
<Encabezado Rf="RF007" Titulo="Cotizaciones"
            Subtitulo="Cotizaciones emitidas a los clientes. Importes en soles.">
    @if (EsVendedor)
    {
        <a class="btn btn-primary" href="@($"/cotizaciones/nueva?volver={Volver.Parametro(RutaActual)}")">+ Nueva cotización</a>
    }
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<SiguientePaso Mensaje="@exito" Detalle="@exitoDetalle" TextoAccion="@exitoAccion" Ruta="@exitoRuta" AlCerrar="CerrarAviso" />

<ModalMotivo Visible="@(anulando is not null)" Titulo="@($"Anular la cotización {anulando?.Numero}")" TextoConfirmar="Anular cotización"
             Ocupado="@trabajando" Maximo="255" Ejemplo="Ejemplo: el cliente ya no requiere los productos."
             AlConfirmar="ConfirmarAnulacion" AlCancelar="() => anulando = null">
    <p class="mb-2">La cotización <strong>@anulando?.Numero</strong> de @anulando?.Cliente:</p>
    <ul class="small mb-0">
        <li>Deja de valer: ya no se podrá enviar, aceptar ni convertir en orden.</li>
        <li>Se conserva con su motivo; aparece en el filtro «Anuladas».</li>
    </ul>
</ModalMotivo>

<Confirmacion Visible="@(rechazando is not null)" Titulo="@($"Registrar rechazo de {rechazando?.Numero}")"
              TextoConfirmar="El cliente la rechazó" AlConfirmar="ConfirmarRechazo" AlCancelar="() => rechazando = null">
    <p class="mb-0">La cotización quedará <strong>rechazada</strong> y no se podrá aceptar después. Si el cliente pide otra propuesta,
        registre una cotización nueva.</p>
</Confirmacion>

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Número o documento" Id="fTexto" Clase="col-sm-6 col-md-3">
            <input id="fTexto" class="form-control" maxlength="80" @bind="textoElegido" />
        </Campo>
        <Campo Etiqueta="Cliente" Id="fCliente" Clase="col-sm-6 col-md">
            <select id="fCliente" class="form-select" @bind="clienteElegido">
                <option value="0">Todos</option>
                @foreach (var c in clientes)
                {
                    <option value="@c.Id">@c.NombreMostrado · @c.NumeroDocumento</option>
                }
            </select>
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-3">
            <select id="fEstado" class="form-select" @bind="estadoElegido">
                @foreach (var o in Chips)
                {
                    <option value="@o.Valor">@o.Texto</option>
                }
            </select>
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </form>
</div>

@if (cotizaciones is null)
{
    <p class="text-muted">Cargando cotizaciones...</p>
}
else
{
    var filtradas = Filtradas;
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Cotización</th>
                        <th>Cliente</th>
                        <th>Vigencia</th>
                        <th class="text-end">Total (S/)</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                @if (HayFiltros)
                                {
                                    <ListaVacia Titulo="Ninguna cotización coincide con los filtros." Detalle="Pruebe con otro estado, cliente o texto."
                                                AlQuitarFiltros="Limpiar" />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Todavía no hay cotizaciones."
                                                TextoAccion="@(EsVendedor ? "Registrar la primera cotización" : null)" Ruta="/cotizaciones/nueva" />
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var c in Pagina(filtradas))
                    {
                        var dias = DiasParaVencer(c);
                        <tr @key="c.Id">
                            <td>
                                <a class="fw-semibold text-decoration-none" href="@RutaCotizacion(c)">@c.Numero</a>
                                <div class="small text-muted">Emitida el @TextosVentas.Fecha(c.FechaEmision)</div>
                            </td>
                            <td>@c.Cliente<div class="small text-muted">@c.DocumentoCliente</div></td>
                            <td class="text-nowrap">
                                @TextosVentas.Fecha(c.FechaVigencia)
                                @if (dias is int d)
                                {
                                    <div class="small @(d <= 1 ? "text-danger fw-semibold" : "text-warning-emphasis")">
                                        @(d == 0 ? "Vence hoy" : d == 1 ? "Vence mañana" : $"Vence en {d} días")
                                    </div>
                                }
                            </td>
                            <td class="text-end fw-semibold">@c.Total.ToString("N2")</td>
                            <td>
                                <Estado Texto="@TextosVentas.Texto(c.Estado)" />
                                @if (c.Estado == "ACEPTADA" && conOrden.TryGetValue(c.Id, out var numOrden))
                                {
                                    <div class="small text-muted mt-1">Orden @numOrden</div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center justify-content-end gap-1 text-nowrap">
                                    @if (EsVendedor && c.Estado == "REGISTRADA")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@trabajando" @onclick="() => Enviar(c)">Enviar</button>
                                        <a class="btn btn-sm btn-outline-secondary" href="@RutaCotizacion(c)">Editar</a>
                                    }
                                    else if (EsVendedor && c.Estado == "ENVIADA")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@trabajando" @onclick="() => Aceptar(c)">Aceptó</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@trabajando" @onclick="() => rechazando = c">Rechazó</button>
                                    }
                                    else if (EsVendedor && c.Estado == "ACEPTADA" && !conOrden.ContainsKey(c.Id))
                                    {
                                        @* RF007: la orden de compra del cliente sale de una cotización aceptada; una sola orden activa *@
                                        <a class="btn btn-sm btn-primary" href="@($"/ordenes/nueva?cotizacion={c.Id}")">Generar orden</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@RutaCotizacion(c)">Ver</a>
                                    }
                                    @if ((EsVendedor || Rol == "Administrador") && c.Estado is "REGISTRADA" or "ENVIADA" or "RECHAZADA" or "VENCIDA")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => AbrirAnulacion(c)">Anular</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" PaginaActual="@paginaActual" PaginaActualChanged="CambiarPagina"
                    @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";
    private bool EsVendedor => Rol == "Vendedor";

    // Filtros en la dirección: /cotizaciones?cliente=3&estado=ENVIADA&q=acme&pagina=2
    [SupplyParameterFromQuery(Name = "cliente")] public int? ClienteQ { get; set; }
    [SupplyParameterFromQuery(Name = "estado")] public string? EstadoQ { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? BusquedaQ { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int? PaginaQ { get; set; }
    // Aviso de éxito con el patrón único (AvisoGuardado): el formulario vuelve aquí con ?guardado=…&ref=…
    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<CotizacionDatos>? cotizaciones;       // lo que devolvió el BO con los filtros cliente + estado
    private List<CotizacionDatos> vigentes = new();   // del cliente, sin filtro de estado (para contar)
    private int anuladas;                             // del cliente (el BO las trae solo con estado=ANULADA)
    private List<Cliente> clientes = new();
    private Dictionary<int, string> conOrden = new(); // cotizaciones con orden vigente -> número de la orden
    private int filtroCliente;
    private string filtroEstado = "";
    private string busqueda = "";
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private string? urlPropia;
    private (int Cliente, string Estado)? cargado;

    private string? error;
    private string? exito;
    private string? exitoDetalle;
    private string? exitoAccion;
    private string? exitoRuta;
    private bool avisoLeido;
    private bool trabajando;
    private CotizacionDatos? anulando;
    private CotizacionDatos? rechazando;

    private string RutaActual => "/" + Nav.ToBaseRelativePath(Nav.Uri);
    private string RutaCotizacion(CotizacionDatos c) => $"/cotizaciones/editar/{c.Id}?volver={Volver.Parametro(RutaActual)}";
    private bool HayFiltros => filtroCliente > 0 || filtroEstado != "" || !string.IsNullOrWhiteSpace(busqueda);
    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);

    // Las que todavía se pueden mover y vencen dentro de 3 días
    private static int? DiasParaVencer(CotizacionDatos c) =>
        c.Estado is "REGISTRADA" or "ENVIADA" && c.FechaVigencia is DateOnly f && f >= Hoy && f.DayNumber - Hoy.DayNumber <= 3
            ? f.DayNumber - Hoy.DayNumber
            : null;

    private List<CotizacionDatos> Filtradas => (cotizaciones ?? new())
        .Where(c => Busqueda.Coincide(busqueda, c.Numero, c.Cliente, c.DocumentoCliente))
        .OrderByDescending(c => c.FechaEmision).ThenByDescending(c => c.Id)
        .ToList();

    private IReadOnlyList<OpcionChip> Chips
    {
        get
        {
            int Cuantas(string e) => vigentes.Count(c => c.Estado == e);
            return new List<OpcionChip>
            {
                new("", "Vigentes", vigentes.Count),
                new("REGISTRADA", "Registradas", Cuantas("REGISTRADA")),
                new("ENVIADA", "Enviadas", Cuantas("ENVIADA"), "azul"),
                new("ACEPTADA", "Aceptadas", Cuantas("ACEPTADA"), "verde"),
                new("RECHAZADA", "Rechazadas", Cuantas("RECHAZADA"), "rojo"),
                new("VENCIDA", "Vencidas", Cuantas("VENCIDA"), "ambar"),
                new("ANULADA", "Anuladas", anuladas, "rojo")
            };
        }
    }

    private IEnumerable<CotizacionDatos> Pagina(List<CotizacionDatos> lista)
    {
        if (tamanoPagina == 0) return lista;
        var total = Math.Max(1, (int)Math.Ceiling((double)lista.Count / tamanoPagina));
        return lista.Skip((Math.Clamp(paginaActual, 1, total) - 1) * tamanoPagina).Take(tamanoPagina);
    }

    // ---------------- Carga (los filtros cliente y estado los aplica el BO) ----------------

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await Api.Get<List<Cliente>>("clientes") ?? new();   // para el filtro por cliente
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!avisoLeido)
        {
            avisoLeido = true;
            exito = AvisoGuardado.Texto(Guardado, "la cotización", Referencia);
            if (exito is not null && Guardado is AvisoGuardado.Nuevo or AvisoGuardado.Editado)
            {
                exitoDetalle = null;
            }
        }
        if (urlPropia is not null && Nav.Uri == urlPropia)
        {
            return;   // el cambio de dirección lo hizo esta misma pantalla
        }
        filtroCliente = ClienteQ ?? 0;
        filtroEstado = EstadoQ ?? "";
        busqueda = BusquedaQ ?? "";
        CopiarFiltrosAlFormulario();
        paginaActual = Math.Max(1, PaginaQ ?? 1);
        await Cargar();
    }

    private async Task Cargar(bool forzar = false)
    {
        if (!forzar && cargado == (filtroCliente, filtroEstado) && cotizaciones is not null) return;
        var cliente = filtroCliente > 0 ? $"cliente={filtroCliente}" : "";
        string Ruta(string estado) => "cotizaciones" + (cliente == "" && estado == "" ? ""
            : "?" + string.Join("&", new[] { cliente, estado == "" ? "" : $"estado={estado}" }.Where(p => p != "")));
        try
        {
            // RF007: los conteos (vigentes y anuladas del cliente) y la lista filtrada salen del BO
            vigentes = await Api.Get<List<CotizacionDatos>>(Ruta("")) ?? new();
            var listaAnuladas = await Api.Get<List<CotizacionDatos>>(Ruta("ANULADA")) ?? new();
            anuladas = listaAnuladas.Count;
            cotizaciones = filtroEstado == "" ? vigentes
                : filtroEstado == "ANULADA" ? listaAnuladas
                : await Api.Get<List<CotizacionDatos>>(Ruta(filtroEstado)) ?? new();
            if (EsVendedor)
            {
                // RF007: una cotización tiene una sola orden activa; si ya la tiene no se ofrece "Generar orden"
                var ordenes = await Api.Get<List<OrdenDatos>>("ordenes") ?? new();
                conOrden = ordenes.Where(o => o.Estado != "ANULADA" && !o.Anulado)
                    .GroupBy(o => o.IdCotizacion).ToDictionary(g => g.Key, g => g.First().Numero ?? "");
            }
            cargado = (filtroCliente, filtroEstado);
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            cotizaciones ??= new();
        }
    }

    private void SincronizarUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["cliente"] = filtroCliente > 0 ? filtroCliente : (object?)null,
            ["estado"] = filtroEstado == "" ? null : filtroEstado,
            ["q"] = string.IsNullOrWhiteSpace(busqueda) ? null : busqueda.Trim(),
            ["pagina"] = paginaActual > 1 ? paginaActual : (object?)null,
            ["guardado"] = null,
            ["ref"] = null
        });
        if (uri == Nav.Uri) return;
        urlPropia = uri;
        Nav.NavigateTo(uri, replace: true);
    }

    // Filtros estándar: lo elegido en el formulario se aplica al pulsar Buscar (igual que en el resto de la aplicación)
    private string textoElegido = "";
    private int clienteElegido;
    private string estadoElegido = "";

    private void CopiarFiltrosAlFormulario()
    {
        textoElegido = busqueda;
        clienteElegido = filtroCliente;
        estadoElegido = filtroEstado;
    }

    private async Task Buscar()
    {
        busqueda = textoElegido.Trim();
        filtroCliente = clienteElegido;
        filtroEstado = estadoElegido;
        paginaActual = 1;
        await Cargar();
        SincronizarUrl();
    }

    private void CambiarPagina(int pagina)
    {
        paginaActual = pagina;
        SincronizarUrl();
    }

    private async Task Limpiar()
    {
        filtroCliente = 0;
        filtroEstado = "";
        busqueda = "";
        CopiarFiltrosAlFormulario();
        paginaActual = 1;
        await Cargar();
        SincronizarUrl();
    }

    private void CerrarAviso()
    {
        exito = exitoDetalle = exitoAccion = exitoRuta = null;
    }

    // ---------------- Ciclo de la cotización ----------------

    private Task Enviar(CotizacionDatos c) => Accion(c, "enviar", $"La cotización {c.Numero} quedó enviada.",
        null);

    private Task Aceptar(CotizacionDatos c) => Accion(c, "aceptar", $"La cotización {c.Numero} quedó aceptada.",
        null,
        "Generar orden", $"/ordenes/nueva?cotizacion={c.Id}");

    private async Task ConfirmarRechazo()
    {
        var c = rechazando;
        rechazando = null;
        if (c is null) return;
        await Accion(c, "rechazar", $"La cotización {c.Numero} quedó rechazada.", null);
    }

    // POST /api/cotizaciones/{id}/enviar | aceptar | rechazar
    private async Task Accion(CotizacionDatos c, string accion, string mensaje, string? detalle, string? textoAccion = null, string? ruta = null)
    {
        error = null;
        CerrarAviso();
        trabajando = true;
        try
        {
            await Api.Post<CotizacionDatos>($"cotizaciones/{c.Id}/{accion}", null);
            exito = mensaje;
            exitoDetalle = detalle;
            exitoAccion = textoAccion;
            exitoRuta = ruta;
            await Cargar(forzar: true);
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "La cotización venció el 2026-11-10"
        }
        finally
        {
            trabajando = false;
        }
    }

    private void AbrirAnulacion(CotizacionDatos c)
    {
        error = null;
        CerrarAviso();
        anulando = c;
    }

    // POST /api/cotizaciones/{id}/anular {"motivo": ...}
    private async Task ConfirmarAnulacion(string motivo)
    {
        if (anulando is null) return;
        trabajando = true;
        try
        {
            await Api.Post<object>($"cotizaciones/{anulando.Id}/anular", new AnulacionDatos { Motivo = motivo });
            exito = $"Se anuló la cotización {anulando.Numero}.";
            exitoDetalle = null;
            anulando = null;
            await Cargar(forzar: true);
        }
        catch (ErrorApi e)
        {
            anulando = null;
            error = e.Message;   // por ejemplo "No se puede anular una cotización aceptada"
        }
        finally
        {
            trabajando = false;
        }
    }
}

@page "/cotizaciones/nueva"
@page "/cotizaciones/editar/{Id:int}"
@using SigmetaWeb.Components.Pages.Ventas
@using SigmetaWeb.Components.Pages.Clientes
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>@Titulo · SIGMETA</PageTitle>

@* RF007 · Formulario de cotización: cabecera y líneas (Vendedor).
   Nueva: POST /api/cotizaciones. Editar: GET /api/cotizaciones/{Id} para cargarla y PUT /api/cotizaciones/{Id}.
   Los productos se agregan con el BuscadorProducto de RF005 (código exacto, lector de barras o parte del nombre).
   El subtotal, el IGV y el total los calcula el BO al guardar; aquí se muestran como referencia mientras se edita.
   Los mensajes del BO (cliente desactivado, vigencia anterior a la emisión, cotización sin líneas...) salen en el aviso rojo. *@
<Encabezado Rf="RF007" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/cotizaciones">Volver a la lista</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (cotizacion is null)
{
    <p class="text-muted">Cargando cotización...</p>
}
else
{
    @if (!Editable)
    {
        <div class="alert alert-secondary">
            Esta cotización está <strong>@TextosVentas.Texto(cotizacion.Estado)</strong>: solo se modifica una cotización registrada.
        </div>
    }

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Cabecera</h2>
        <div class="row">
            @* RF007: el número lo ingresa el usuario (CotizacionBOImpl lo exige, máx. 20). *@
            <div class="col-md-4">
                @* Estándar RNF004: cada error sale en rojo debajo de su cuadro mientras se escribe (ValidacionEnVivo);
                   los del BO (cliente desactivado...) en el aviso rojo de arriba. *@
                <Campo Etiqueta="Número" Id="numero" Obligatorio="true" Error="@(v.Error("numero", Errores()))">
                    <input id="numero" class="@(v.Clase("numero", Errores()))" maxlength="20" placeholder="COT-2026-0010"
                           @bind="cotizacion.Numero" @bind:event="oninput" @bind:after="@(() => v.Tocado("numero"))" disabled="@(!Editable)" />
                </Campo>
            </div>
            <div class="col-md-4 mb-3">
                @* Solo lectura: toda cotización nueva empieza REGISTRADA y solo cambia con los botones de la lista. *@
                <div class="small text-muted text-uppercase">Estado</div>
                <div class="fw-semibold mt-1"><Estado Texto="@TextosVentas.Texto(cotizacion.Estado ?? "REGISTRADA")" /></div>
            </div>
            @if (!EsNuevo)
            {
                <div class="col-md-4 mb-3">
                    <div class="small text-muted text-uppercase">Registrada por</div>
                    <div class="fw-semibold mt-1">@cotizacion.UsuarioRegistro <span class="small text-muted">@TextosVentas.FechaHora(cotizacion.FechaRegistro)</span></div>
                </div>
            }
            <div class="col-12"></div>
            <div class="col-md-6">
                <Campo Etiqueta="Cliente" Id="cliente" Obligatorio="true" Ayuda="Solo clientes activos." Error="@(v.Error("cliente", Errores()))">
                    <select id="cliente" class="@(v.Clase("cliente", Errores(), "form-select"))"
                            @bind="cotizacion.IdCliente" @bind:after="@(() => v.Tocado("cliente"))" disabled="@(!Editable)">
                        <option value="0">Seleccione…</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.Id">@c.NombreMostrado · @Cliente.Texto(c.TipoDocumento) @c.NumeroDocumento</option>
                        }
                    </select>
                </Campo>
            </div>
            <div class="col-md-3">
                <Campo Etiqueta="Fecha de emisión" Id="fechaEmision" Obligatorio="true" Error="@(v.Error("fechaEmision", Errores()))">
                    <input id="fechaEmision" type="date" class="@(v.Clase("fechaEmision", Errores()))"
                           @bind="cotizacion.FechaEmision" @bind:format="yyyy-MM-dd" @bind:after="@(() => v.Tocado("fechaEmision"))" disabled="@(!Editable)" />
                </Campo>
            </div>
            <div class="col-md-3">
                <Campo Etiqueta="Vigencia hasta" Id="fechaVigencia" Obligatorio="true" Ayuda="No antes de la emisión."
                       Error="@(v.Error("fechaVigencia", Errores(), "fechaEmision"))">
                    <input id="fechaVigencia" type="date" class="@(v.Clase("fechaVigencia", Errores(), "form-control", "fechaEmision"))"
                           @bind="cotizacion.FechaVigencia" @bind:format="yyyy-MM-dd" @bind:after="@(() => v.Tocado("fechaVigencia"))" disabled="@(!Editable)" />
                </Campo>
            </div>
            <div class="col-12">
                <Campo Etiqueta="Observaciones" Id="observaciones">
                    <input id="observaciones" class="form-control" maxlength="255"
                           @bind="cotizacion.Observaciones" disabled="@(!Editable)" />
                </Campo>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-3">Líneas</h2>
            @if (Editable)
            {
                @* RF005: buscador compartido de Claudia. Con código exacto (o lector) el producto se agrega solo. *@
                <BuscadorProducto Etiqueta="Agregar producto" Id="buscadorCotizacion" AlElegir="AgregarProducto" />
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 3rem;">#</th>
                        <th>Producto</th>
                        <th style="width: 8rem;">Cantidad</th>
                        <th style="width: 9rem;">Precio unit. (S/)</th>
                        <th style="width: 9rem;">Descuento (S/)</th>
                        <th class="text-end">Importe (S/)</th>
                        @if (Editable) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @if (cotizacion.Lineas.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Agregue al menos un producto con el buscador.</td></tr>
                    }
                    @for (var i = 0; i < cotizacion.Lineas.Count; i++)
                    {
                        var l = cotizacion.Lineas[i];
                        var n = v.Clave(l);
                        <tr @key="l">
                            <td>@(i + 1)</td>
                            <td><span class="small text-muted">@l.CodigoProducto</span><br />@l.Producto</td>
                            @if (Editable)
                            {
                                <td>
                                    <input type="number" step="0.001" class="@(v.Clase(n + "cantidad", Errores(), "form-control form-control-sm text-end"))" aria-label="Cantidad"
                                           onkeydown="@ValidacionEnVivo.SoloPositivos" @bind="l.Cantidad" @bind:event="oninput" @bind:after="@(() => v.Tocado(n + "cantidad"))" />
                                    <ErrorCampo Mensaje="@(v.Error(n + "cantidad", Errores()))" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" class="@(v.Clase(n + "precio", Errores(), "form-control form-control-sm text-end"))" aria-label="Precio unitario"
                                           onkeydown="@ValidacionEnVivo.SoloPositivos" @bind="l.PrecioUnitario" @bind:event="oninput" @bind:after="@(() => v.Tocado(n + "precio"))" />
                                    <ErrorCampo Mensaje="@(v.Error(n + "precio", Errores()))" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" class="@(v.Clase(n + "descuento", Errores(), "form-control form-control-sm text-end", n + "cantidad", n + "precio"))" aria-label="Descuento"
                                           onkeydown="@ValidacionEnVivo.SoloPositivos" @bind="l.Descuento" @bind:event="oninput" @bind:after="@(() => v.Tocado(n + "descuento"))" />
                                    <ErrorCampo Mensaje="@(v.Error(n + "descuento", Errores(), n + "cantidad", n + "precio"))" />
                                </td>
                                <td class="text-end fw-semibold">@l.ImporteCalculado.ToString("N2")</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => Quitar(l)">Quitar</button></td>
                            }
                            else
                            {
                                <td class="text-end">@l.Cantidad.ToString("0.###")</td>
                                <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end">@l.Descuento.ToString("N2")</td>
                                <td class="text-end fw-semibold">@l.Importe.ToString("N2")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body">
            @if (v.Error("lineas", Errores()) is { } errorLineas)
            {
                <div class="small text-danger mb-2">@errorLineas</div>
            }
            <div class="row justify-content-end">
                <div class="col-sm-6 col-md-4">
                    <div class="d-flex justify-content-between"><span class="text-muted">Subtotal</span><span>S/ @SubTotal.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">IGV (18%)</span><span>S/ @Igv.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between border-top mt-2 pt-2 fw-semibold"><span>Total</span><span>S/ @Total.ToString("N2")</span></div>
                    @if (Editable)
                    {
                        <div class="form-text text-end">Referencial: el sistema calcula los importes al guardar.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Enviar, Aceptar, Rechazar y Anular están en la lista. *@
    <div class="card card-body mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="/cotizaciones">Cancelar</a>
                @if (Editable)
                {
                    <button class="btn btn-primary" disabled="@guardando" @onclick="Guardar">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private CotizacionDatos? cotizacion;
    private List<Cliente> clientes = new();
    private string? error;
    private bool guardando;

    private bool EsNuevo => Id is null;
    private string Titulo => EsNuevo ? "Nueva cotización" : "Editar cotización";
    private bool Editable => EsNuevo || cotizacion?.Estado == "REGISTRADA";

    // Mientras se edita se muestran los importes de referencia; una cotización ya cerrada muestra los del BO.
    private decimal SubTotal => Editable ? TextosVentas.SubTotal(cotizacion!.Lineas) : cotizacion!.SubTotal;
    private decimal Igv => Editable ? TextosVentas.Igv(cotizacion!.Lineas) : cotizacion!.Igv;
    private decimal Total => Editable ? TextosVentas.Total(cotizacion!.Lineas) : cotizacion!.Total;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await Api.Get<List<Cliente>>("clientes?estado=true") ?? new();   // solo clientes activos
            if (EsNuevo)
            {
                var hoy = DateOnly.FromDateTime(DateTime.Today);
                cotizacion = new CotizacionDatos { FechaEmision = hoy, FechaVigencia = hoy.AddDays(15), Estado = "REGISTRADA" };
            }
            else
            {
                cotizacion = await Api.Get<CotizacionDatos>($"cotizaciones/{Id}");   // GET /api/cotizaciones/{Id}
                emisionOriginal = cotizacion?.FechaEmision;
                // si el cliente de la cotización ya no está activo, igual se muestra en la lista
                if (cotizacion is not null && clientes.All(c => c.Id != cotizacion.IdCliente))
                {
                    clientes.Add(new Cliente { Id = cotizacion.IdCliente, TipoPersona = "JURIDICA", RazonSocial = cotizacion.Cliente, NumeroDocumento = cotizacion.DocumentoCliente ?? "" });
                }
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    // Lo llama el BuscadorProducto con el producto elegido: nueva línea con su precio de venta
    private void AgregarProducto(Producto p)
    {
        cotizacion!.Lineas.Add(new LineaDatos
        {
            IdProducto = p.Id,
            Producto = p.Nombre,
            CodigoProducto = p.CodigoInterno,
            Cantidad = 1,
            PrecioUnitario = p.PrecioVenta,
            Descuento = 0
        });
    }

    private void Quitar(LineaDatos l) => cotizacion!.Lineas.Remove(l);

    // ---------------- Validación en pantalla (RNF004) ----------------
    // Mismas reglas que CotizacionBOImpl. Cada error sale debajo de su cuadro; el BO vuelve a validar todo.
    private readonly ValidacionEnVivo v = new();
    private DateOnly? emisionOriginal;   // al editar: la fecha ya registrada se puede conservar aunque sea pasada

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (cotizacion is null || !Editable)
        {
            return e;
        }
        if (string.IsNullOrWhiteSpace(cotizacion.Numero))
        {
            e["numero"] = "El número es obligatorio.";
        }
        if (cotizacion.IdCliente <= 0)
        {
            e["cliente"] = "Seleccione el cliente.";
        }
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        if (cotizacion.FechaEmision is null)
        {
            e["fechaEmision"] = "La fecha de emisión es obligatoria.";
        }
        else if (cotizacion.FechaEmision < hoy && (EsNuevo || cotizacion.FechaEmision != emisionOriginal))
        {
            // igual que el BO: no se emite con fecha pasada (al editar se puede conservar la ya registrada)
            e["fechaEmision"] = "La fecha de emisión no puede ser anterior a hoy.";
        }
        if (cotizacion.FechaVigencia is null)
        {
            e["fechaVigencia"] = "La fecha de vigencia es obligatoria.";
        }
        else if (cotizacion.FechaEmision is not null && cotizacion.FechaVigencia < cotizacion.FechaEmision)
        {
            e["fechaVigencia"] = "La vigencia no puede ser anterior a la emisión.";
        }
        else if (cotizacion.FechaVigencia < hoy)
        {
            e["fechaVigencia"] = "La vigencia no puede ser anterior a hoy.";
        }
        if (cotizacion.Lineas.Count == 0)
        {
            e["lineas"] = "Agregue al menos un producto con el buscador.";
        }
        foreach (var l in cotizacion.Lineas)
        {
            ValidacionEnVivo.ErroresLinea(e, v.Clave(l), l.Cantidad, l.PrecioUnitario, l.Descuento);
        }
        return e;
    }

    private async Task Guardar()
    {
        error = null;
        if (!v.Intentar(Errores()))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        guardando = true;
        try
        {
            // las líneas se numeran en el orden de la pantalla
            for (var i = 0; i < cotizacion!.Lineas.Count; i++)
            {
                cotizacion.Lineas[i].NumeroLinea = i + 1;
            }

            if (EsNuevo)
            {
                await Api.Post<CotizacionDatos>("cotizaciones", cotizacion);          // POST /api/cotizaciones
            }
            else
            {
                await Api.Put<CotizacionDatos>($"cotizaciones/{Id}", cotizacion);    // PUT /api/cotizaciones/{Id}
            }
            Nav.NavigateTo("/cotizaciones");
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // mensaje del BO, por ejemplo "La fecha de vigencia no puede ser anterior a la fecha de emision"
        }
        finally
        {
            guardando = false;
        }
    }
}

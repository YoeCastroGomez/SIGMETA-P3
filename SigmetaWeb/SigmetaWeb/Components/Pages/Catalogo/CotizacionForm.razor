@page "/cotizaciones/nueva"
@page "/cotizaciones/editar/{Id:int}"
@inject NavigationManager Nav

<PageTitle>@Titulo · SIGMETA</PageTitle>

@* RF007 · Formulario de cotización: cabecera y líneas. Solo visual (Lab 9): ningún botón registra ni calcula,
   todos vuelven a la lista. Importes solo en soles. *@
<Encabezado Rf="RF007" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/cotizaciones">Volver a la lista</a>
</Encabezado>

<div class="card card-body mb-3">
    <h2 class="h6 fw-semibold mb-3">Cabecera</h2>
    <div class="row">
        @* RF007: el número lo ingresa el usuario (CotizacionBOImpl lo exige, máx. 20). *@
        <div class="col-md-4">
            <Campo Etiqueta="Número" Id="numero" Obligatorio="true">
                <input id="numero" class="form-control" maxlength="20" value="@ejemplo?.Numero" placeholder="COT-2026-0001" />
            </Campo>
        </div>
        <div class="col-md-4 mb-3">
            @* Solo lectura: toda cotización nueva empieza REGISTRADA y solo cambia con los botones de la lista. *@
            <div class="small text-muted text-uppercase">Estado</div>
            <div class="fw-semibold mt-1"><Estado Texto="@MuestrasCatalogo.Texto(ejemplo?.Estado ?? "REGISTRADA")" /></div>
        </div>
        <div class="col-12"></div>
        <div class="col-md-6">
            <Campo Etiqueta="Cliente" Id="cliente" Obligatorio="true" Ayuda="Solo clientes activos.">
                <select id="cliente" class="form-select">
                    <option value="">Seleccione…</option>
                    @foreach (var c in MuestrasCatalogo.Clientes)
                    {
                        <option selected="@(ejemplo?.Cliente == c)">@c</option>
                    }
                </select>
            </Campo>
        </div>
        <div class="col-md-3">
            <Campo Etiqueta="Fecha de emisión" Id="fechaEmision" Obligatorio="true">
                <input id="fechaEmision" type="date" class="form-control" value="@(EsNuevo ? null : "2026-09-14")" />
            </Campo>
        </div>
        <div class="col-md-3">
            <Campo Etiqueta="Vigencia hasta" Id="fechaVigencia" Obligatorio="true" Ayuda="No antes de la emisión.">
                <input id="fechaVigencia" type="date" class="form-control" value="@(EsNuevo ? null : "2026-09-28")" />
            </Campo>
        </div>
        <div class="col-12">
            <Campo Etiqueta="Observaciones" Id="observaciones">
                <input id="observaciones" class="form-control" maxlength="255" value="@ejemplo?.Observaciones" />
            </Campo>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body pb-0">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h6 fw-semibold mb-0">Líneas</h2>
            <button class="btn btn-sm btn-outline-secondary">Agregar línea</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th class="w-25">Producto</th>
                    <th>Cantidad</th>
                    <th>Precio unitario (S/)</th>
                    <th>Descuento (S/)</th>
                    <th class="text-end">Importe (S/)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (EsNuevo)
                {
                    @* Cotización nueva: una línea vacía para mostrar cómo se llena. *@
                    <tr>
                        <td>1</td>
                        <td>
                            <select class="form-select" aria-label="Producto">
                                <option value="">Seleccione…</option>
                                @foreach (var p in MuestrasCatalogo.Productos.Where(p => p.Activo))
                                {
                                    <option>@p.CodigoInterno · @p.Nombre</option>
                                }
                            </select>
                        </td>
                        <td><input type="number" min="0" step="0.001" class="form-control" aria-label="Cantidad" /></td>
                        <td><input type="number" min="0" step="0.01" class="form-control" aria-label="Precio unitario" /></td>
                        <td><input type="number" min="0" step="0.01" class="form-control" aria-label="Descuento" /></td>
                        <td class="text-end">0.00</td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-danger">Quitar</button></td>
                    </tr>
                }
                else
                {
                    @foreach (var l in ejemplo!.Lineas)
                    {
                        <tr>
                            <td>@l.NumeroLinea</td>
                            <td>
                                <select class="form-select" aria-label="Producto">
                                    @foreach (var p in MuestrasCatalogo.Productos)
                                    {
                                        var texto = $"{p.CodigoInterno} · {p.Nombre}";
                                        <option selected="@(texto == l.Producto)">@texto</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" min="0" step="0.001" class="form-control" aria-label="Cantidad" value="@l.Cantidad" /></td>
                            <td><input type="number" min="0" step="0.01" class="form-control" aria-label="Precio unitario" value="@l.PrecioUnitario" /></td>
                            <td><input type="number" min="0" step="0.01" class="form-control" aria-label="Descuento" value="@l.Descuento" /></td>
                            <td class="text-end">@l.Importe.ToString("N2")</td>
                            <td class="text-end"><button class="btn btn-sm btn-outline-danger">Quitar</button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-body">
        <div class="row justify-content-end">
            <div class="col-sm-6 col-md-4">
                <div class="d-flex justify-content-between"><span class="text-muted">Subtotal</span><span>S/ @(EsNuevo ? "0.00" : ejemplo!.SubTotal.ToString("N2"))</span></div>
                <div class="d-flex justify-content-between"><span class="text-muted">IGV (18%)</span><span>S/ @(EsNuevo ? "0.00" : ejemplo!.Igv.ToString("N2"))</span></div>
                <div class="d-flex justify-content-between border-top mt-2 pt-2 fw-semibold"><span>Total</span><span>S/ @(EsNuevo ? "0.00" : ejemplo!.Total.ToString("N2"))</span></div>
            </div>
        </div>
    </div>
</div>

@* Solo se edita una cotización REGISTRADA. Enviar, Aceptar, Rechazar y Anular están en la lista. *@
<div class="card card-body mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/cotizaciones">Cancelar</a>
            <button class="btn btn-primary" @onclick="Volver">Guardar</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private bool EsNuevo => Id is null;
    private string Titulo => EsNuevo ? "Nueva cotización" : "Editar cotización";

    // Al editar se muestra una cotización de ejemplo fija (Lab 9: sin consultas).
    private CotizacionFila? ejemplo => EsNuevo ? null : MuestrasCatalogo.Cotizaciones[2];

    // Lab 9: no se registra ni se cambia ningún estado, solo se navega.
    private void Volver() => Nav.NavigateTo("/cotizaciones");
}

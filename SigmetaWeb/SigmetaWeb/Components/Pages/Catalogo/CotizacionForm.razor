@page "/cotizaciones/nueva"
@page "/cotizaciones/editar/{Id:int}"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Administrador")]
@using SigmetaWeb.Components.Pages.Ventas
@using SigmetaWeb.Components.Pages.Clientes
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>@Titulo · SIGMETA</PageTitle>

@* RF007 · Formulario de cotización (Vendedor) y su consulta (Administrador y cotizaciones cerradas).
   PATRÓN UX de formularios (ver Shared/ComponentesFlujo.cs): recorrido del documento arriba, secciones numeradas,
   resumen fijo con totales + lista de lo que falta + Guardar bloqueado hasta completar, y el siguiente paso.
   Nueva: POST /api/cotizaciones. Editar: GET /api/cotizaciones/{Id} y PUT /api/cotizaciones/{Id} (solo REGISTRADA).
   El cliente se elige con BuscadorCliente (cualquier dato) y los productos con SelectorProducto (categoría y texto;
   un código exacto o el lector lo agrega solo). El precio es el de lista, con IGV incluido: no se edita y el BO lo
   vuelve a poner. El total es la suma de los importes; el IGV solo se desglosa. Cantidades enteras salvo en
   kilogramo, metro y litro.
   El total, el valor de venta y el IGV los calcula el BO al guardar; aquí se muestran como referencia mientras se edita.
   Los mensajes del BO (cliente desactivado, precio bajo el costo, cotización sin líneas...) salen en el aviso rojo. *@
<Encabezado Rf="RF007" Titulo="@Titulo" Subtitulo="@Subtitulo">
    @if (cotizacion is not null && !Editable)
    {
    <a class="btn btn-outline-secondary" href="@VolverA">Volver a cotizaciones</a>
    }
</Encabezado>

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />

@if (cotizacion is null)
{
    <p class="text-muted">Cargando cotización...</p>
}
else
{
    @if (!EsNuevo)
    {
        <PasosDocumento Pasos="@FlujoVentas.PasosCotizacion(cotizacion, ordenGenerada)" Titulo="Recorrido de la cotización" />
    }
    @if (cotizacion.Anulado)
    {
        @* RF007: la anulación es lógica; se muestra cuándo y por qué ya no vale *@
        @* se deja: la fecha y el motivo de la anulación no salen en otro lugar *@
        <div class="alert alert-secondary">
            Anulada el @TextosVentas.FechaHora(cotizacion.FechaAnulacion) · <strong>Motivo:</strong> @cotizacion.MotivoAnulacion
        </div>
    }
    @* sin "Solo consulta": el estado ya se ve en el recorrido y en el total, y el título no dice "Editar" *@

    <div class="row g-3">
        <div class="col-lg-8">
            @* -------- 1. Cliente y vigencia -------- *@
            <div class="card card-body mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
                    <h2 class="h6 fw-semibold mb-0"><span class="seccion">1</span> Cliente y vigencia</h2>
                    <span class="small text-muted">
                        N.º <strong class="text-body">@(string.IsNullOrEmpty(cotizacion.Numero) ? "…" : cotizacion.Numero)</strong>
                    </span>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <Campo Etiqueta="Cliente" Id="cliente" Obligatorio="@Editable" Error="@(v.Error("cliente", Errores()))">
                            <BuscadorCliente Id="cliente" Clientes="clientes" IdCliente="cotizacion.IdCliente" IdClienteChanged="ElegirCliente"
                                             ClaseCaja="@(v.Clase("cliente", Errores(), "form-control"))" Deshabilitado="@(!Editable)" />
                        </Campo>
                    </div>
                    <div class="col-md-5">
                        <Campo Etiqueta="Fecha de emisión" Id="fechaEmision" Obligatorio="@Editable" Error="@(v.Error("fechaEmision", Errores()))">
                            <input id="fechaEmision" type="date" class="@(v.Clase("fechaEmision", Errores()))"
                                   min="@(EsNuevo ? Hoy.ToString("yyyy-MM-dd") : null)"
                                   @bind="cotizacion.FechaEmision" @bind:format="yyyy-MM-dd" @bind:after="AlCambiarFecha" disabled="@(!Editable)" />
                        </Campo>
                    </div>
                    <div class="col-md-7">
                        <Campo Etiqueta="Vigente hasta" Id="fechaVigencia" Obligatorio="@Editable"
                               Error="@(v.Error("fechaVigencia", Errores(), "fechaEmision"))">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <input id="fechaVigencia" type="date" class="@(v.Clase("fechaVigencia", Errores(), "form-control", "fechaEmision"))" style="max-width: 11rem;"
                                       min="@(cotizacion.FechaEmision?.ToString("yyyy-MM-dd"))"
                                       @bind="cotizacion.FechaVigencia" @bind:format="yyyy-MM-dd" @bind:after="@(() => v.Tocado("fechaVigencia"))" disabled="@(!Editable)" />
                                @if (Editable)
                                {
                                    @foreach (var d in new[] { 7, 15, 30 })
                                    {
                                        <button type="button" class="btn btn-sm @(DiasDeVigencia == d ? "btn-dark" : "btn-outline-secondary")"
                                                @onclick="() => FijarVigencia(d)">@d días</button>
                                    }
                                }
                            </div>
                        </Campo>
                    </div>
                    <div class="col-12">
                        <Campo Etiqueta="Observaciones" Id="observaciones" Clase="mb-0">
                            <textarea id="observaciones" class="form-control observaciones" rows="2" maxlength="255"
                                      placeholder="@(Editable ? "Opcional: condiciones de entrega, forma de pago u otra indicación para el cliente" : "—")"
                                      @bind="cotizacion.Observaciones" @bind:event="oninput" disabled="@(!Editable)"></textarea>
                            @if (Editable)
                            {
                                <div class="form-text text-end">@(cotizacion.Observaciones?.Length ?? 0)/255</div>
                            }
                        </Campo>
                    </div>
                </div>
            </div>

            @* -------- 2. Productos -------- *@
            <div class="card mb-3">
                <div class="card-body pb-0">
                    <h2 class="h6 fw-semibold mb-1"><span class="seccion">2</span> Productos</h2>
                    @if (Editable)
                    {
                        @* Catálogo completo con filtro por categoría y texto; si el producto ya está, se suma 1 a su cantidad *@
                        <SelectorProducto Id="buscadorCotizacion" AlElegir="AgregarProducto" />
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 tabla-lineas">
                        <thead class="table-light">
                            <tr>
                                <th class="text-muted" style="width: 2.5rem;">#</th>
                                <th>Producto</th>
                                <th style="width: 9.5rem;">Cantidad</th>
                                <th class="text-end" style="width: 7rem;">Precio unit.</th>
                                <th style="width: 8rem;">Descuento</th>
                                <th class="text-end">Importe</th>
                                @if (Editable) { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @if (cotizacion.Lineas.Count == 0)
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">Aún no hay productos: búsquelos arriba por nombre, código o categoría.</td></tr>
                            }
                            @for (var i = 0; i < cotizacion.Lineas.Count; i++)
                            {
                                var l = cotizacion.Lineas[i];
                                var n = v.Clave(l);
                                var hayStock = stock.TryGetValue(l.IdProducto, out var enAlmacen);
                                <tr @key="l" class="@(Editable && AvisoLinea(l) is not null ? "con-aviso" : null)">
                                    <td class="text-muted small">@(i + 1)</td>
                                    <td>
                                        <div class="producto-nombre">@l.Producto</div>
                                        @if (hayStock && Editable)
                                        {
                                            <div class="small @(l.Cantidad > enAlmacen ? "text-warning-emphasis fw-semibold" : "text-muted")">
                                                Stock: @enAlmacen.ToString("0.###") @l.UnidadCorta
                                            </div>
                                        }
                                    </td>
                                    @if (Editable)
                                    {
                                        <td>
                                            @* las flechas suben y bajan de 1 en 1; kg, m y L aceptan decimales escritos *@
                                            <div class="input-group input-group-sm cantidad">
                                                @* el valor no válido (0, negativo, más de 3 decimales) no se deja escribir: LineaDatos.Validar *@
                                                <input type="number" step="1" min="@l.MinimoCantidad" data-positivo="1"
                                                       class="@(v.Clase(n + "cantidad", Errores(), "form-control text-end"))" aria-label="Cantidad"
                                                       onkeydown="@l.TeclasCantidad" oninput="@LineaDatos.Validar" onfocusout="@LineaDatos.Restaurar"
                                                       @bind="l.Cantidad" @bind:after="@(() => v.Tocado(n + "cantidad"))" @onblur="l.Ajustar" />
                                                <span class="input-group-text">@l.UnidadCorta</span>
                                            </div>
                                        </td>
                                        @* RF005: el precio de lista lo fija el Administrador; el Vendedor solo da descuento *@
                                        <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                        <td>
                                            <div class="input-group input-group-sm descuento">
                                                <span class="input-group-text">S/</span>
                                                @* no se deja escribir un descuento mayor que el importe de la línea ni con más de 2 decimales *@
                                                <input type="number" step="1" min="0" max="@l.DescuentoMaximo" data-decimales="2"
                                                       class="@(v.Clase(n + "descuento", Errores(), "form-control text-end", n + "cantidad", n + "precio"))" aria-label="Descuento en soles"
                                                       onkeydown="@l.TeclasDescuento" oninput="@LineaDatos.Validar" onfocusout="@LineaDatos.Restaurar"
                                                       @bind="l.Descuento" @bind:after="@(() => v.Tocado(n + "descuento"))" @onblur="l.Ajustar" />
                                            </div>
                                        </td>
                                        <td class="text-end fw-semibold">@l.ImporteCalculado.ToString("N2")</td>
                                        <td class="text-end"><button type="button" class="btn btn-sm btn-quitar" title="Quitar" aria-label="@($"Quitar {l.Producto}")" @onclick="() => Quitar(l)"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M6.5 1h3a1 1 0 0 1 1 1v1H13a.5.5 0 0 1 0 1h-.6l-.7 9.1A1.5 1.5 0 0 1 10.2 14.5H5.8a1.5 1.5 0 0 1-1.5-1.4L3.6 4H3a.5.5 0 0 1 0-1h2.5V2a1 1 0 0 1 1-1Zm0 2h3V2h-3v1ZM4.6 4l.7 9a.5.5 0 0 0 .5.5h4.4a.5.5 0 0 0 .5-.5l.7-9H4.6Zm2 1.5a.5.5 0 0 1 .5.5v5.5a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.8 0a.5.5 0 0 1 .5.5v5.5a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Z"/></svg></button></td>
                                    }
                                    else
                                    {
                                        <td class="text-end">@l.Cantidad.ToString("0.###") <span class="text-muted small">@l.UnidadCorta</span></td>
                                        <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">@l.Descuento.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@l.Importe.ToString("N2")</td>
                                    }
                                </tr>
                                @* los avisos de la línea van en una fila aparte, a todo lo ancho: no deforman las columnas *@
                                @if (Editable && AvisoLinea(l) is { } aviso)
                                {
                                    <tr @key="(l, 1)" class="fila-aviso">
                                        <td></td>
                                        <td colspan="6"><span class="aviso"><svg class="icono-aviso" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg> @aviso</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (v.Error("lineas", Errores()) is { } errorLineas)
                {
                    <div class="card-body pt-2"><div class="small text-danger">@errorLineas</div></div>
                }
            </div>
        </div>

        @* -------- Resumen fijo: total, desglose y acciones (ResumenTotal) -------- *@
        <div class="col-lg-4">
            <ResumenTotal Total="@Total" SubTotal="@SubTotal" Igv="@Igv"
                          EstadoTexto="@(EsNuevo ? null : TextosVentas.Texto(cotizacion.Anulado ? "ANULADA" : cotizacion.Estado))"
                          Registro="@(EsNuevo ? null : $"Registrada por {cotizacion.UsuarioRegistro} · {TextosVentas.FechaHora(cotizacion.FechaRegistro)}")">
                @if (Editable)
                {
                    @if (Pendientes.Any(p => !p.Listo))
                    {
                        <ul class="lista-pendientes list-unstyled small mb-0" aria-label="Lo que falta para guardar">
                            @foreach (var item in Pendientes.Where(p => !p.Listo))
                            {
                                <li class="falta"><span class="marca" aria-hidden="true">•</span><span>@item.Texto</span></li>
                            }
                        </ul>
                    }
                    <BotonCondicionado Texto="@(EsNuevo ? "Registrar cotización" : "Guardar cambios")" TextoOcupado="Guardando..." Bloque="true"
                                       Clase="btn-primary w-100" Ocupado="@guardando" AlHacerClic="Guardar"
                                       Motivo="@(Pendientes.All(p => p.Listo) ? null : "Falta completar lo indicado.")" MostrarMotivo="false" />
                    <a class="btn btn-outline-secondary w-100" href="@VolverA">Cancelar</a>
                }
                else
                {
                    @if (EsVendedor && cotizacion.Estado == "ACEPTADA" && !cotizacion.Anulado)
                    {
                        @if (ordenGenerada is not null)
                        {
                            <a class="btn btn-outline-secondary w-100" href="@($"/ordenes/editar/{ordenGenerada.Id}")">Ver orden @ordenGenerada.Numero</a>
                        }
                        else
                        {
                            <a class="btn btn-primary w-100" href="@($"/ordenes/nueva?cotizacion={cotizacion.Id}")">Generar orden</a>
                        }
                    }
                    @if (!cotizacion.Anulado)
                    {
                        @* RF007: volver a imprimirla o guardarla en PDF (CotizacionEnviar) *@
                        <a class="btn btn-outline-secondary w-100"
                           href="@($"/cotizaciones/{cotizacion.Id}/enviar?volver={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}")">Imprimir o PDF</a>
                    }
                }
            </ResumenTotal>
        </div>
    </div>
}


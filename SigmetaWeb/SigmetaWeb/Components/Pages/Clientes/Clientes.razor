@page "/clientes"
@inject ApiJava Api

<PageTitle>Clientes · SIGMETA</PageTitle>

@* RF003 · Lista de clientes. Datos reales del Java: GET /api/clientes (con filtros por documento,
   razón social o estado) y DELETE /api/clientes/{id} para desactivar. *@
<Encabezado Rf="RF003" Titulo="Clientes"
            Subtitulo="Un cliente desactivado conserva su historial, pero no puede elegirse en documentos nuevos.">
    <a class="btn btn-primary" href="/clientes/nuevo">Nuevo cliente</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault>
        <Campo Etiqueta="Número de documento" Id="fDoc" Clase="col-sm-6 col-md-3">
            <input id="fDoc" class="form-control" maxlength="20" @bind="filtroDocumento" />
        </Campo>
        <Campo Etiqueta="Razón social" Id="fNombre" Clase="col-sm-6 col-md">
            <input id="fNombre" class="form-control" maxlength="150" @bind="filtroRazonSocial" />
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-3">
            <select id="fEstado" class="form-select" @bind="filtroEstado">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
            </select>
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </form>
    <div class="form-text">Se busca por documento; si está vacío, por razón social; si también está vacía, por estado.</div>
</div>

@if (clientes is null)
{
    <p class="text-muted">Cargando clientes...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Documento</th>
                        <th>Razón social o nombre</th>
                        <th>Tipo</th>
                        <th>Condición de pago</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (clientes.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron clientes.</td></tr>
                    }
                    @foreach (var c in Paginar(clientes, paginaActual, tamanoPagina))
                    {
                        <tr>
                            <td><span class="small text-muted">@Cliente.Texto(c.TipoDocumento)</span><br />@c.NumeroDocumento</td>
                            <td><strong>@c.NombreMostrado</strong></td>
                            <td>@Cliente.Texto(c.TipoPersona)</td>
                            <td>
                                @Cliente.Texto(c.CondicionPago)
                                @if (c.CondicionPago == "CREDITO")
                                {
                                    <div class="small text-muted">Límite S/ @c.LimiteCredito.ToString("N2") · @c.PlazoCreditoDias días</div>
                                }
                            </td>
                            <td><Estado Texto="@(c.Activo ? "Activo" : "Inactivo")" /></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/clientes/editar/{c.Id}")">Editar</a>
                                    @* RF003: la línea de crédito solo la maneja el Administrador *@
                                    <AuthorizeView Roles="Administrador">
                                        <Authorized>
                                            <a class="btn btn-sm btn-outline-secondary" href="@($"/clientes/credito/{c.Id}")">Crédito</a>
                                        </Authorized>
                                    </AuthorizeView>
                                    @if (c.Activo)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Desactivar(c)">Desactivar</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@((clientes)?.Count ?? 0)" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T>? registros, int pagina, int tamano)
    {
        if (registros is null) return Enumerable.Empty<T>();
        if (tamano == 0) return registros;
        int total = registros.Count();
        int paginaSegura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((paginaSegura - 1) * tamano).Take(tamano);
    }

    private List<Cliente>? clientes;
    private string filtroDocumento = "";
    private string filtroRazonSocial = "";
    private string filtroEstado = "";
    private string? error;
    private string? exito;

    // al abrir la pantalla se piden los clientes al Java
    protected override async Task OnInitializedAsync()
    {
        await Cargar("clientes");
    }

    private async Task Buscar()
    {
        exito = null;
        if (!string.IsNullOrWhiteSpace(filtroDocumento))
        {
            await Cargar($"clientes?documento={Uri.EscapeDataString(filtroDocumento.Trim())}");      // buscarPorDocumento
        }
        else if (!string.IsNullOrWhiteSpace(filtroRazonSocial))
        {
            await Cargar($"clientes?razonSocial={Uri.EscapeDataString(filtroRazonSocial.Trim())}");  // buscarPorRazonSocial
        }
        else if (filtroEstado != "")
        {
            await Cargar($"clientes?estado={filtroEstado}");                                         // listarPorEstado
        }
        else
        {
            await Cargar("clientes");                                                                // listarTodos
        }
    }

    private async Task Limpiar()
    {
        filtroDocumento = filtroRazonSocial = filtroEstado = "";
        exito = null;
        await Cargar("clientes");
    }

    private async Task Cargar(string ruta)
    {
        error = null;
        try
        {
            clientes = await Api.Get<List<Cliente>>(ruta) ?? new List<Cliente>();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            clientes ??= new List<Cliente>();
        }
    }

    // DELETE /api/clientes/{id}: baja lógica, el cliente queda inactivo
    private async Task Desactivar(Cliente c)
    {
        error = null;
        exito = null;
        try
        {
            await Api.Delete($"clientes/{c.Id}");
            await Buscar();
            exito = $"Se desactivó el cliente {c.NombreMostrado}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

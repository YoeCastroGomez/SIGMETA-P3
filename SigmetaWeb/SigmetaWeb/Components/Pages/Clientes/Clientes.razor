@page "/clientes"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Administrador")]
@inject ApiJava Api

<PageTitle>Clientes · SIGMETA</PageTitle>

@* RF003 · Lista de clientes. Datos reales del Java: GET /api/clientes (con filtros por documento,
   razón social o estado) y DELETE /api/clientes/{id} para desactivar. *@
<Encabezado Rf="RF003" Titulo="Clientes"
            Subtitulo="Un cliente desactivado conserva su historial, pero no puede elegirse en documentos nuevos.">
    <a class="btn btn-primary" href="/clientes/nuevo">Nuevo cliente</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@* Mismo aviso que Categorías y Productos antes de una baja lógica *@
<Confirmacion Visible="@(porDesactivar is not null)"
              Titulo="Desactivar cliente"
              TextoConfirmar="Desactivar"
              AlConfirmar="ConfirmarDesactivar"
              AlCancelar="() => porDesactivar = null">
    ¿Seguro que desea desactivar a <strong>@porDesactivar?.NombreMostrado</strong>?
    <div class="small text-muted mt-2">Conserva su historial, pero ya no podrá elegirse en cotizaciones ni ventas.</div>
</Confirmacion>
<AvisoExito Mensaje="@exito" AlCerrar="() => exito = null" />

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Número de documento" Id="fDoc" Clase="col-sm-6 col-md-3">
            <input id="fDoc" class="form-control" maxlength="20" @bind="filtroDocumento" />
        </Campo>
        <Campo Etiqueta="Razón social" Id="fNombre" Clase="col-sm-6 col-md">
            <input id="fNombre" class="form-control" maxlength="150" @bind="filtroRazonSocial" />
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-3">
            <select id="fEstado" class="form-select" @bind="filtroEstado">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
            </select>
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </form>
    <div class="form-text">Usa uno o varios filtros: si llenas varios, se muestran los clientes que cumplen todos.</div>
</div>

@if (clientes is null)
{
    <p class="text-muted">Cargando clientes...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Documento</th>
                        <th>Razón social o nombre</th>
                        <th>Tipo</th>
                        <th>Condición de pago</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (clientes.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron clientes.</td></tr>
                    }
                    @foreach (var c in Paginar(clientes, paginaActual, tamanoPagina))
                    {
                        <tr>
                            <td><span class="small text-muted">@Cliente.Texto(c.TipoDocumento)</span><br />@c.NumeroDocumento</td>
                            <td><strong>@c.NombreMostrado</strong></td>
                            <td>@Cliente.Texto(c.TipoPersona)</td>
                            <td>
                                @Cliente.Texto(c.CondicionPago)
                                @if (c.CondicionPago == "CREDITO")
                                {
                                    <div class="small text-muted">Límite S/ @c.LimiteCredito.ToString("N2") · @c.PlazoCreditoDias días</div>
                                }
                            </td>
                            <td><Estado Texto="@(c.Activo ? "Activo" : "Inactivo")" /></td>
                            @* UI/UX: una acción visible por fila y el resto en «⋯» (menos ruido en tablas densas, igual que Ventas) *@
                            <td class="text-end acciones">
                                <AccionesFila Principal="@(new AccionFila("Editar", Ruta: $"/clientes/editar/{c.Id}", Destacada: false))"
                                              Otras="@OtrasAcciones(c)" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@((clientes)?.Count ?? 0)" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    // Menú «⋯»: crédito (solo Administrador y clientes activos, RF003), desactivar o activar
    private List<AccionFila> OtrasAcciones(Cliente c)
    {
        var lista = new List<AccionFila>();
        if (c.Activo && Rol == "Administrador")
            lista.Add(new("Línea de crédito", Ruta: $"/clientes/credito/{c.Id}"));
        if (c.Activo)
            lista.Add(new("Desactivar", Hacer: () => { porDesactivar = c; return Task.CompletedTask; }, Peligro: true));
        else
            lista.Add(new("Activar", Hacer: () => Activar(c)));
        return lista;
    }

    private Task Ejecutar(AccionFila a) => a.Hacer?.Invoke() ?? Task.CompletedTask;

    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T>? registros, int pagina, int tamano)
    {
        if (registros is null) return Enumerable.Empty<T>();
        if (tamano == 0) return registros;
        int total = registros.Count();
        int paginaSegura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((paginaSegura - 1) * tamano).Take(tamano);
    }

    private List<Cliente>? clientes;
    private string filtroDocumento = "";
    private string filtroRazonSocial = "";
    private string filtroEstado = "";
    private string? error;
    private string? exito;

    // Aviso de éxito con el patrón único (AvisoGuardado): el formulario vuelve aquí con ?guardado=…&ref=…
    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }
    private bool avisoLeido;

    protected override void OnParametersSet()
    {
        if (avisoLeido) return;   // solo al llegar: después manda lo que haga el usuario en la lista
        avisoLeido = true;
        var nombre = string.IsNullOrWhiteSpace(Referencia) ? "" : " " + Referencia.Trim().TrimEnd('.');
        exito = Guardado switch
        {
            "linea" => $"Se asignó la línea de crédito del cliente{nombre}.",       // vuelve de LineaCredito
            "sinlinea" => $"Se retiró la línea de crédito del cliente{nombre}.",
            _ => AvisoGuardado.Texto(Guardado, "el cliente", Referencia) ?? exito
        };
    }
    // al abrir la pantalla se piden los clientes al Java
    protected override async Task OnInitializedAsync()
    {
        await Cargar("clientes");
    }

    private async Task Buscar()
    {
        exito = null;
        // documento, razón social y estado: por separado o juntos; los combina el BO (ClienteBO.buscar)
        var parametros = new List<string>();
        if (!string.IsNullOrWhiteSpace(filtroDocumento))
        {
            parametros.Add($"documento={Uri.EscapeDataString(filtroDocumento.Trim())}");
        }
        if (!string.IsNullOrWhiteSpace(filtroRazonSocial))
        {
            parametros.Add($"razonSocial={Uri.EscapeDataString(filtroRazonSocial.Trim())}");
        }
        if (filtroEstado != "")
        {
            parametros.Add($"estado={filtroEstado}");
        }
        await Cargar(parametros.Count == 0 ? "clientes" : "clientes?" + string.Join("&", parametros));
    }

    private async Task Limpiar()
    {
        filtroDocumento = filtroRazonSocial = filtroEstado = "";
        exito = null;
        await Cargar("clientes");
    }

    private async Task Cargar(string ruta)
    {
        error = null;
        try
        {
            clientes = await Api.Get<List<Cliente>>(ruta) ?? new List<Cliente>();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            clientes ??= new List<Cliente>();
        }
    }

    private Cliente? porDesactivar;   // cliente esperando la confirmación

    // DELETE /api/clientes/{id}: baja lógica, el cliente queda inactivo
    private async Task ConfirmarDesactivar()
    {
        var c = porDesactivar!;
        porDesactivar = null;
        error = null;
        exito = null;
        try
        {
            await Api.Delete($"clientes/{c.Id}");
            await Buscar();
            exito = $"Se desactivó el cliente {c.NombreMostrado.TrimEnd('.')}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    // POST /api/clientes/{id}/activar: vuelve a activar un cliente desactivado.
    // El BO lo rechaza si su documento o su razón social ya los usa otro cliente.
    private async Task Activar(Cliente c)
    {
        error = null;
        exito = null;
        try
        {
            await Api.Post<Cliente>($"clientes/{c.Id}/activar", null);
            await Buscar();
            exito = $"Se activó el cliente {c.NombreMostrado.TrimEnd('.')}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        catch (Exception)
        {
            error = "No se pudo completar la operación. Inténtalo otra vez; si el problema continúa, avisa al Administrador.";
        }
    }
}

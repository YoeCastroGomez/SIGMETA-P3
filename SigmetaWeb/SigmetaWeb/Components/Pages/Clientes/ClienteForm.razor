@page "/clientes/nuevo"
@page "/clientes/editar/{Id:int}"
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>@Titulo · SIGMETA</PageTitle>

@* RF003 · Formulario de cliente.
   Nuevo: POST /api/clientes. Editar: GET /api/clientes/{Id} para cargarlo y PUT /api/clientes/{Id} para guardar.
   Los mensajes del BO (documento repetido, RUC inválido, correo inválido...) salen en el aviso rojo. *@
<Encabezado Rf="RF003" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/clientes">Volver a la lista</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (cliente is null)
{
    <p class="text-muted">Cargando cliente...</p>
}
else
{
    @* novalidate: sin globos del navegador. Cada error sale en rojo debajo de su campo mientras se escribe
       (estándar RNF004, ValidacionEnVivo); los del BO (documento repetido...) en el aviso rojo de arriba. *@
    <EditForm Model="@cliente" OnSubmit="Guardar" novalidate>
        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">Identificación</h2>

            @* JURIDICA = razón social, NATURAL = nombres y apellidos *@
            <Campo Etiqueta="Tipo de persona" Obligatorio="true">
                <InputRadioGroup @bind-Value="cliente.TipoPersona">
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="tpJuridica" Value="@("JURIDICA")" />
                            <label class="form-check-label" for="tpJuridica">Empresa (jurídica)</label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="tpNatural" Value="@("NATURAL")" />
                            <label class="form-check-label" for="tpNatural">Persona natural</label>
                        </div>
                    </div>
                </InputRadioGroup>
            </Campo>

            <div class="row">
                <div class="col-md-4">
                    <Campo Etiqueta="Tipo de documento" Id="tipoDoc" Obligatorio="true">
                        <InputSelect id="tipoDoc" class="form-select" @bind-Value="cliente.TipoDocumento" @bind-Value:after="@(() => v.Tocado("tipoDoc"))">
                            <option value="RUC">RUC</option>
                            <option value="DNI">DNI</option>
                            <option value="CARNET_EXTRANJERIA">Carné de extranjería</option>
                            <option value="PASAPORTE">Pasaporte</option>
                        </InputSelect>
                    </Campo>
                </div>
                <div class="col-md-8">
                    <Campo Etiqueta="Número de documento" Id="numDoc" Obligatorio="true" Error="@(v.Error("numDoc", Errores(), "tipoDoc"))"
                           Ayuda="Único. RUC: 11 dígitos (empieza en 10, 15, 16, 17 o 20) · DNI: 8 dígitos · Carné: 9 a 12 · Pasaporte: 6 a 12.">
                        <InputText id="numDoc" class="@(v.Clase("numDoc", Errores(), "form-control", "tipoDoc"))" maxlength="20"
                                   @bind-Value="cliente.NumeroDocumento" @oninput="@(e => v.Escribiendo("numDoc", e))" />
                    </Campo>
                </div>

                @if (cliente.TipoPersona == "JURIDICA")
                {
                    <div class="col-12">
                        <Campo Etiqueta="Razón social" Id="razonSocial" Obligatorio="true" Ayuda="Debe ser única: no puede haber dos clientes con la misma razón social." Error="@(v.Error("razonSocial", Errores()))">
                            <InputText id="razonSocial" class="@(v.Clase("razonSocial", Errores()))" maxlength="150"
                                       @bind-Value="cliente.RazonSocial" @oninput="@(e => v.Escribiendo("razonSocial", e))" />
                        </Campo>
                    </div>
                }
                else
                {
                    <div class="col-md-6">
                        <Campo Etiqueta="Nombres" Id="nombres" Obligatorio="true" Error="@(v.Error("nombres", Errores()))">
                            <InputText id="nombres" class="@(v.Clase("nombres", Errores()))" maxlength="100"
                                       @bind-Value="cliente.Nombres" @oninput="@(e => v.Escribiendo("nombres", e))" />
                        </Campo>
                    </div>
                    <div class="col-md-6">
                        <Campo Etiqueta="Apellidos" Id="apellidos" Obligatorio="true" Error="@(v.Error("apellidos", Errores()))">
                            <InputText id="apellidos" class="@(v.Clase("apellidos", Errores()))" maxlength="100"
                                       @bind-Value="cliente.Apellidos" @oninput="@(e => v.Escribiendo("apellidos", e))" />
                        </Campo>
                    </div>
                }
            </div>
        </div>

        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">Datos de contacto</h2>
            <div class="row">
                <div class="col-12">
                    <Campo Etiqueta="Dirección" Id="direccion">
                        <InputText id="direccion" class="form-control" maxlength="200" @bind-Value="cliente.Contacto.Direccion" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Teléfono" Id="telefono" Ayuda="Dígitos, espacios, + y -." Error="@(v.Error("telefono", Errores()))">
                        <InputText id="telefono" type="tel" class="@(v.Clase("telefono", Errores()))" maxlength="20"
                                   @bind-Value="cliente.Contacto.Telefono" @oninput="@(e => v.Escribiendo("telefono", e))" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Correo" Id="correo" Error="@(v.Error("correo", Errores()))">
                        <InputText id="correo" type="email" class="@(v.Clase("correo", Errores()))" maxlength="120"
                                   @bind-Value="cliente.Contacto.Correo" @oninput="@(e => v.Escribiendo("correo", e))" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Persona de contacto" Id="contacto">
                        <InputText id="contacto" class="form-control" maxlength="100" @bind-Value="cliente.Contacto.NombreContacto" />
                    </Campo>
                </div>
            </div>
        </div>

        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">Condición comercial</h2>
            @if (EsNuevo)
            {
                <div class="alert alert-secondary">
                    Todo cliente nuevo empieza al <strong>contado</strong>. La línea de crédito, el plazo y la calificación
                    los asigna el Administrador desde la opción Crédito de la lista.
                </div>
            }
            else
            {
                @* Solo lectura: el crédito se cambia en la pantalla Línea de crédito. *@
                <div class="row">
                    <div class="col-sm-3 mb-3">
                        <div class="small text-muted text-uppercase">Condición de pago</div>
                        <div class="fw-semibold">@Cliente.Texto(cliente.CondicionPago)</div>
                    </div>
                    <div class="col-sm-3 mb-3">
                        <div class="small text-muted text-uppercase">Límite de crédito</div>
                        <div class="fw-semibold">S/ @cliente.LimiteCredito.ToString("N2")</div>
                    </div>
                    <div class="col-sm-3 mb-3">
                        <div class="small text-muted text-uppercase">Plazo</div>
                        <div class="fw-semibold">@cliente.PlazoCreditoDias días</div>
                    </div>
                    <div class="col-sm-3 mb-3">
                        <div class="small text-muted text-uppercase">Calificación</div>
                        <div class="fw-semibold">@Cliente.Texto(cliente.CalificacionCrediticia)</div>
                    </div>
                    <div class="col-sm-3">
                        <Campo Etiqueta="Estado" Id="estado">
                            <div class="form-check form-switch mt-1">
                                <InputCheckbox id="estado" class="form-check-input" @bind-Value="cliente.Activo" />
                                <label class="form-check-label" for="estado">Activo</label>
                            </div>
                        </Campo>
                    </div>
                </div>
            }

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
                <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="/clientes">Cancelar</a>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Cliente? cliente;
    private string? error;
    private bool guardando;

    private bool EsNuevo => Id is null;
    private string Titulo => EsNuevo ? "Nuevo cliente" : "Editar cliente";

    protected override async Task OnInitializedAsync()
    {
        if (EsNuevo)
        {
            cliente = new Cliente();
            return;
        }
        try
        {
            cliente = await Api.Get<Cliente>($"clientes/{Id}");   // GET /api/clientes/{Id}
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "No existe el cliente con id 99"
        }
    }

    // ---------------- Validación en pantalla (RNF004) ----------------
    // Mismas reglas que ClienteBOImpl.validarDatos y Validador. El BO vuelve a validar todo, y lo que solo él
    // sabe (documento o razón social repetidos) sale en el aviso rojo de arriba.
    private readonly ValidacionEnVivo v = new();

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (cliente is null)
        {
            return e;
        }
        var documento = ValidacionEnVivo.ErrorDocumento(cliente.TipoDocumento, v.Texto("numDoc", cliente.NumeroDocumento).Trim());
        if (documento is not null)
        {
            e["numDoc"] = documento;
        }
        if (cliente.TipoPersona == "JURIDICA")
        {
            if (string.IsNullOrWhiteSpace(v.Texto("razonSocial", cliente.RazonSocial)))
            {
                e["razonSocial"] = "La razón social es obligatoria para una empresa.";
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(v.Texto("nombres", cliente.Nombres)))
            {
                e["nombres"] = "Los nombres son obligatorios para una persona natural.";
            }
            if (string.IsNullOrWhiteSpace(v.Texto("apellidos", cliente.Apellidos)))
            {
                e["apellidos"] = "Los apellidos son obligatorios para una persona natural.";
            }
        }
        if (ValidacionEnVivo.ErrorTelefono(v.Texto("telefono", cliente.Contacto.Telefono)) is { } telefono)
        {
            e["telefono"] = telefono;
        }
        if (ValidacionEnVivo.ErrorCorreo(v.Texto("correo", cliente.Contacto.Correo)) is { } correo)
        {
            e["correo"] = correo;
        }
        return e;
    }

    private async Task Guardar()
    {
        error = null;
        if (!v.Intentar(Errores()))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        guardando = true;
        try
        {
            // se manda solo lo que corresponde al tipo de persona
            if (cliente!.TipoPersona == "JURIDICA")
            {
                cliente.Nombres = null;
                cliente.Apellidos = null;
            }
            else
            {
                cliente.RazonSocial = null;
            }

            if (EsNuevo)
            {
                await Api.Post<Cliente>("clientes", cliente);         // POST /api/clientes
            }
            else
            {
                await Api.Put<Cliente>($"clientes/{Id}", cliente);    // PUT /api/clientes/{Id}
            }
            Nav.NavigateTo("/clientes");
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // mensaje del BO, por ejemplo "Ya existe un cliente con el documento ..."
        }
        finally
        {
            guardando = false;
        }
    }
}

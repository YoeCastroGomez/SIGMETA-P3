@page "/clientes/credito/{Id:int}"
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Línea de crédito · SIGMETA</PageTitle>

@* RF003 · Línea de crédito (solo Administrador).
   Asignar: PUT /api/clientes/{Id}/linea-credito. Retirar: DELETE /api/clientes/{Id}/linea-credito.
   Si otro rol llega aquí escribiendo la dirección, el BO lo rechaza con "El rol X no tiene permiso...". *@
<Encabezado Rf="RF003" Titulo="Línea de crédito" Subtitulo="Solo el Administrador asigna o retira crédito.">
    <a class="btn btn-outline-secondary" href="/clientes">Volver a la lista</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (cliente is null)
{
    <p class="text-muted">Cargando cliente...</p>
}
else
{
    <div class="card card-body mb-3" style="max-width: 760px;">
        <div class="row">
            <div class="col-sm-7 mb-3">
                <div class="small text-muted text-uppercase">Cliente</div>
                <div class="fw-semibold">@cliente.NombreMostrado</div>
            </div>
            <div class="col-sm-5 mb-3">
                <div class="small text-muted text-uppercase">@Cliente.Texto(cliente.TipoDocumento)</div>
                <div class="fw-semibold">@cliente.NumeroDocumento</div>
            </div>
            <div class="col-sm-7 mb-3">
                <div class="small text-muted text-uppercase">Condición actual</div>
                <div class="fw-semibold">@Cliente.Texto(cliente.CondicionPago)</div>
            </div>
        </div>

        <hr />

        @* novalidate: sin globos del navegador; cada error sale debajo de su campo (estándar RNF004) *@
        <EditForm Model="@linea" OnSubmit="Guardar" novalidate>
            <div class="row">
                <div class="col-md-4">
                    <Campo Etiqueta="Límite de crédito (S/)" Id="limite" Obligatorio="true" Ayuda="Mayor a 0." Error="@(v.Error("limite", Errores()))">
                        <InputNumber id="limite" class="@(v.Clase("limite", Errores()))" step="0.01" onkeydown="@ValidacionEnVivo.SoloPositivos"
                                     @bind-Value="linea.LimiteCredito" @oninput="@(e => v.Escribiendo("limite", e))" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Plazo (días)" Id="plazo" Obligatorio="true" Ayuda="Mayor a 0. Máximo por venta." Error="@(v.Error("plazo", Errores()))">
                        <InputNumber id="plazo" class="@(v.Clase("plazo", Errores()))" onkeydown="@ValidacionEnVivo.SoloPositivos"
                                     @bind-Value="linea.PlazoCreditoDias" @oninput="@(e => v.Escribiendo("plazo", e))" />
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Calificación crediticia" Id="calif" Ayuda="Escala interna del Administrador.">
                        <InputSelect id="calif" class="form-select" @bind-Value="linea.CalificacionCrediticia">
                            @foreach (var c in new[] { "A", "B", "C", "SIN_EVALUAR" })
                            {
                                <option value="@c">@Cliente.Texto(c)</option>
                            }
                        </InputSelect>
                    </Campo>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
                <div>
                    @if (cliente.CondicionPago == "CREDITO")
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="Retirar">Retirar línea</button>
                        <div class="form-text">El cliente pasa a contado. Se conserva su calificación.</div>
                    }
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="/clientes">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Cliente? cliente;
    private LineaCreditoDatos linea = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cliente = await Api.Get<Cliente>($"clientes/{Id}");   // GET /api/clientes/{Id}
            linea = new LineaCreditoDatos
            {
                LimiteCredito = cliente!.LimiteCredito,
                PlazoCreditoDias = cliente.PlazoCreditoDias,
                CalificacionCrediticia = cliente.CalificacionCrediticia,
            };
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    // ---------------- Validación en pantalla (RNF004) ----------------
    // Mismas reglas que ClienteBOImpl.asignarLineaCredito: límite y plazo mayores a 0.
    private readonly ValidacionEnVivo v = new();

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        var limite = v.Numero("limite", linea.LimiteCredito);
        if (limite is null or <= 0)
        {
            e["limite"] = "El límite de crédito es obligatorio y debe ser mayor a 0.";
        }
        else if (ValidacionEnVivo.MasDecimales(limite.Value, 2))
        {
            e["limite"] = "El límite de crédito admite como máximo 2 decimales.";
        }
        var plazo = v.Numero("plazo", linea.PlazoCreditoDias);
        if (plazo is null or <= 0)
        {
            e["plazo"] = "El plazo es obligatorio y debe ser mayor a 0 días.";
        }
        else if (ValidacionEnVivo.MasDecimales(plazo.Value, 0))
        {
            e["plazo"] = "El plazo debe ser un número entero de días.";
        }
        else if (plazo > 3650)
        {
            e["plazo"] = "El plazo no puede pasar de 3650 días.";
        }
        return e;
    }

    // PUT /api/clientes/{Id}/linea-credito -> asignarLineaCredito del BO
    private async Task Guardar()
    {
        error = null;
        if (!v.Intentar(Errores()))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        try
        {
            await Api.Put<Cliente>($"clientes/{Id}/linea-credito", linea);
            Nav.NavigateTo("/clientes");
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "No se puede asignar credito a un cliente desactivado"
        }
    }

    // DELETE /api/clientes/{Id}/linea-credito -> retirarLineaCredito del BO
    private async Task Retirar()
    {
        error = null;
        try
        {
            await Api.Delete<Cliente>($"clientes/{Id}/linea-credito");
            Nav.NavigateTo("/clientes");
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

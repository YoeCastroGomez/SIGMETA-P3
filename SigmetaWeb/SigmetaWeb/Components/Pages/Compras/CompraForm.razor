@using SigmetaWeb.Components.Pages.Catalogo
@page "/compras/nueva"
@page "/compras/editar/{Id:int}"
@inject NavigationManager Nav

@* RF011 - Registro y edición de compras.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>@Titulo · SIGMETA</PageTitle>

<Encabezado Rf="RF011" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/compras">
        Volver a la lista
    </a>
</Encabezado>

@* Cabecera de la compra *@
<div class="card card-body mb-3">
    <h2 class="h6 fw-semibold mb-3">Datos de la compra</h2>
    @if (!EsNuevo)
    {
        <div class="d-flex flex-wrap gap-3 mb-3">
            <span><strong>Número:</strong> @NumeroCompra</span>
            <span><strong>Estado:</strong> <Estado Texto="@EstadoCompra" /></span>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <Campo Etiqueta="Proveedor" Id="proveedor"
                   Obligatorio="true">
                <select id="proveedor" class="form-select">
                    <option value="">Seleccione un proveedor</option>
                    @foreach (var proveedor in MuestrasCatalogo.Proveedores.Where(p => p.Activo))
                    {
                        <option value="@proveedor.Id" selected="@(Id.HasValue && proveedor.Id == Id.Value)">@proveedor.RazonSocial</option>
                    }
                </select>
            </Campo>
        </div>

        <div class="col-md-3">
            <Campo Etiqueta="Fecha" Id="fecha"
                   Obligatorio="true">
                <input id="fecha" type="date"
                       class="form-control"
                       value="@FechaCompra" />
            </Campo>
        </div>

        <div class="col-md-3">
            <Campo Etiqueta="Fecha estimada de recepción"
                   Id="fechaEstimada">
                <input id="fechaEstimada" type="date"
                       class="form-control"
                       value="@FechaEstimada" />
            </Campo>
        </div>
    </div>
</div>

@* Detalle de productos *@
<div class="card card-body mb-3">
    <h2 class="h6 fw-semibold mb-3">Detalle de compra</h2>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Producto</th>
                    <th>Unidad de compra</th>
                    <th>Cantidad</th>
                    <th>Costo unitario (S/)</th>
                    <th class="text-end">Importe (S/)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var linea in Lineas)
                {
                    <tr @key="linea">
                        <td>
                            <select class="form-select" @bind="linea.ProductoId">
                                <option value="0">Seleccione un producto</option>
                                @foreach (var producto in MuestrasCatalogo.Productos.Where(p => p.Activo))
                                {
                                    <option value="@producto.Id">@producto.CodigoInterno · @producto.Nombre</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="form-select" @bind="linea.UnidadCompra">
                                <option value="UNIDAD">Unidad</option>
                                <option value="CAJA">Caja</option>
                            </select>
                        </td>
                        <td>
                            <input type="number" class="form-control" min="0.001" step="0.001"
                                   @bind="linea.Cantidad" @bind:event="oninput" />
                        </td>
                        <td>
                            <input type="number" class="form-control" min="0" step="0.01"
                                   @bind="linea.CostoUnitario" @bind:event="oninput" />
                        </td>
                        <td class="text-end text-nowrap">S/ @linea.Importe.ToString("N2")</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="() => QuitarLinea(linea)">Quitar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div>
        <button type="button" class="btn btn-outline-secondary" @onclick="AgregarLinea">
            Agregar producto
        </button>
    </div>
</div>

@* Totales de ejemplo *@
<div class="card card-body mb-3">
    <h2 class="h6 fw-semibold mb-3">Resumen de compra</h2>

    <div class="row justify-content-end">
        <div class="col-md-4">
            <div class="d-flex justify-content-between mb-2">
                <span>Subtotal:</span>
                <strong>S/ @Subtotal.ToString("N2")</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>IGV (18 %):</span>
                <strong>S/ @Igv.ToString("N2")</strong>
            </div>
            <hr />
            <div class="d-flex justify-content-between">
                <strong>Total:</strong>
                <strong>S/ @Total.ToString("N2")</strong>
            </div>
        </div>
    </div>
</div>

@* Acciones: solo navegación, sin registrar datos *@
<div class="d-flex justify-content-end gap-2">
    <a class="btn btn-outline-secondary" href="/compras">
        Cancelar
    </a>

    <button class="btn btn-primary" @onclick="Volver">
        Guardar
    </button>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool EsNuevo => Id is null;

    private string Titulo =>
        EsNuevo ? "Nueva compra" : "Editar compra";

    // Los datos de COMP-001 y COMP-002 coinciden con el listado y la recepción.
    private string NumeroCompra => $"COMP-{Id:000}";
    private string EstadoCompra => Id == 2 ? "RECIBIDA_PARCIAL" : "REGISTRADA";

    // Muestras coherentes con Compras y Recepciones, sin acceso a la BD.
    private string FechaCompra => Id == 2 ? "2026-10-22" : "2026-10-20";
    private string FechaEstimada => Id == 2 ? "2026-10-29" : "2026-10-27";
    private sealed class LineaCompra
    {
        public int ProductoId { get; set; }
        public string UnidadCompra { get; set; } = "UNIDAD";
        public decimal Cantidad { get; set; } = 1m;
        public decimal CostoUnitario { get; set; }
        public decimal Importe => Math.Max(0m, Cantidad) * Math.Max(0m, CostoUnitario);
    }

    private List<LineaCompra> Lineas { get; set; } = new();

    protected override void OnParametersSet()
    {
        // Se recargan datos de muestra solo cuando se navega a una compra diferente.
        if (idCargado == Id && Lineas.Count > 0) return;
        idCargado = Id;
        Lineas = Id switch
        {
            1 => new() { new() { ProductoId = 1, Cantidad = 2m, CostoUnitario = 250m } },
            2 => new() { new() { ProductoId = 2, Cantidad = 4m, CostoUnitario = 250m } },
            _ => new() { new() { ProductoId = 0, Cantidad = 1m, CostoUnitario = 0m } }
        };
    }

    private int? idCargado;
    private void AgregarLinea() => Lineas.Add(new LineaCompra { ProductoId = 0 });
    private void QuitarLinea(LineaCompra linea)
    {
        Lineas.Remove(linea);
        if (Lineas.Count == 0) Lineas.Add(new LineaCompra { ProductoId = 0 });
    }

    private decimal Subtotal => Lineas.Sum(l => l.Importe);
    private decimal Igv => Math.Round(Subtotal * 0.18m, 2);
    private decimal Total => Subtotal + Igv;

    // Lab 9: Guardar no registra información.
    private void Volver()
    {
        Nav.NavigateTo("/compras");
    }
}

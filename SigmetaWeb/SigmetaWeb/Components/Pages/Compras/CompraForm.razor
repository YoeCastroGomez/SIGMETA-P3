@page "/compras/nueva"
@page "/compras/editar/{Id:int}"
@using SigmetaWeb.Components.Pages.Catalogo
@using SigmetaWeb.Components.Pages.Compras
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>@Titulo · SIGMETA</PageTitle>
<Encabezado Rf="RF011" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/compras">Volver a la lista</a>
</Encabezado>
<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (cargando)
{
    <p class="text-muted">Cargando información de compra...</p>
}
else
{
    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Datos de la compra</h2>
        <div class="row g-3">
            @* Estándar RNF004: cada error sale en rojo debajo de su cuadro mientras se escribe (ValidacionEnVivo);
               los del BO (proveedor desactivado...) en el aviso rojo de arriba. *@
            <Campo Etiqueta="Número de orden" Id="numeroCompra" Clase="col-md-4" Obligatorio="true" Error="@(v.Error("numero", Errores()))">
                <input id="numeroCompra" class="@(v.Clase("numero", Errores()))" maxlength="50"
                       @bind="numero" @bind:event="oninput" @bind:after="@(() => v.Tocado("numero"))" />
            </Campo>
            <Campo Etiqueta="Proveedor" Id="proveedorCompra" Clase="col-md-8" Obligatorio="true" Error="@(v.Error("proveedor", Errores()))">
                <select id="proveedorCompra" class="@(v.Clase("proveedor", Errores(), "form-select"))"
                        @bind="proveedorId" @bind:after="@(() => v.Tocado("proveedor"))">
                    <option value="0">Seleccione un proveedor</option>
                    @foreach (var p in proveedores.Where(p => p.Estado || p.Id == proveedorId))
                    {
                        <option value="@p.Id">@p.RazonSocial @(p.Estado ? "" : "(Inactivo)")</option>
                    }
                </select>
            </Campo>
            <Campo Etiqueta="Fecha de emisión" Id="fechaCompra" Clase="col-md-6" Obligatorio="true">
                <input id="fechaCompra" type="date" class="form-control" @bind="fecha" @bind:after="@(() => v.Tocado("fecha"))" />
            </Campo>
            <Campo Etiqueta="Fecha estimada de recepción" Id="fechaEstimadaCompra" Clase="col-md-6" Error="@(v.Error("fechaEstimada", Errores(), "fecha"))">
                <input id="fechaEstimadaCompra" type="date" class="@(v.Clase("fechaEstimada", Errores(), "form-control", "fecha"))"
                       @bind="fechaEstimada" @bind:after="@(() => v.Tocado("fechaEstimada"))" />
            </Campo>
            <Campo Etiqueta="Observaciones" Id="observacionesCompra" Clase="col-12">
                <textarea id="observacionesCompra" class="form-control" maxlength="255" rows="2" @bind="observaciones"></textarea>
            </Campo>
        </div>
    </div>

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Detalle de compra</h2>
        <p class="small text-muted">
            Los productos se eligen del catálogo disponible. Los importes definitivos los calcula Java.
        </p>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th><th>Unidad</th><th>Cantidad</th><th>Precio unitario (S/)</th>
                        <th>Descuento (S/)</th><th>Importe (S/)</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in lineas)
                    {
                        var n = Clave(linea);
                        <tr @key="linea">
                            <td>
                                <input type="text" class="@(v.Clase(n + "producto", Errores()))" list="productosCompraDisponibles"
                                       autocomplete="off" placeholder="Código o nombre del producto"
                                       value="@TextoProducto(linea)"
                                       @oninput="@(e => EscribiendoProducto(linea, e))" />
                                <ErrorCampo Mensaje="@(v.Error(n + "producto", Errores()))" />
                            </td>
                            <td>
                                <select class="form-select" @bind="linea.UnidadCompra">
                                    @foreach (var unidad in MuestrasCatalogo.Unidades)
                                    {
                                        <option value="@unidad">@MuestrasCatalogo.Texto(unidad)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" step="0.001" class="@(v.Clase(n + "cantidad", Errores(), "form-control sin-flechas"))"
                                       onkeydown="@ValidacionEnVivo.SoloPositivos"
                                       @bind="linea.Cantidad" @bind:event="oninput" @bind:after="@(() => v.Tocado(n + "cantidad"))" />
                                <ErrorCampo Mensaje="@(v.Error(n + "cantidad", Errores()))" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="@(v.Clase(n + "precio", Errores(), "form-control sin-flechas"))"
                                       onkeydown="@ValidacionEnVivo.SoloPositivos"
                                       @bind="linea.PrecioUnitario" @bind:event="oninput" @bind:after="@(() => v.Tocado(n + "precio"))" />
                                <ErrorCampo Mensaje="@(v.Error(n + "precio", Errores()))" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="@(v.Clase(n + "descuento", Errores(), "form-control sin-flechas", n + "cantidad", n + "precio"))"
                                       onkeydown="@ValidacionEnVivo.SoloPositivos"
                                       @bind="linea.Descuento" @bind:event="oninput" @bind:after="@(() => v.Tocado(n + "descuento"))" />
                                <ErrorCampo Mensaje="@(v.Error(n + "descuento", Errores(), n + "cantidad", n + "precio"))" />
                            </td>
                            <td>S/ @Importe(linea).ToString("N2")</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        disabled="@(lineas.Count <= 1)" @onclick="() => Quitar(linea)">Quitar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <datalist id="productosCompraDisponibles">
            @foreach (var p in productos.Where(p => p.Estado))
            {
                <option value="@EtiquetaProducto(p)"></option>
            }
        </datalist>
        <button type="button" class="btn btn-outline-secondary align-self-start" @onclick="Agregar">Agregar producto</button>
    </div>

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Resumen de compra</h2>
        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="d-flex justify-content-between mb-2"><span>Subtotal</span><strong>S/ @SubTotal.ToString("N2")</strong></div>
                <div class="d-flex justify-content-between mb-2"><span>IGV (18 %)</span><strong>S/ @Igv.ToString("N2")</strong></div>
                <hr />
                <div class="d-flex justify-content-between"><strong>Total</strong><strong>S/ @Total.ToString("N2")</strong></div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" href="/compras">Cancelar</a>
        <button type="button" class="btn btn-primary" disabled="@guardando" @onclick="Guardar">
            @(guardando ? "Guardando..." : "Guardar compra")
        </button>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool EsNuevo => Id is null;
    private string Titulo => EsNuevo ? "Nueva compra" : "Editar compra";
    private List<Proveedor> proveedores = new();
    private List<ProductoCompraRest> productos = new();
    private List<SolicitudDetalleCompraRest> lineas = new();
    private readonly Dictionary<SolicitudDetalleCompraRest, string> textosProductos = new();
    private string numero = "";
    private int proveedorId;
    private DateTime fecha = DateTime.Today;
    private DateTime? fechaEstimada;
    private string? observaciones;
    private bool cargando;
    private bool guardando;
    private string? error;

    private decimal Importe(SolicitudDetalleCompraRest l) =>
        Math.Round(l.Cantidad * l.PrecioUnitario - l.Descuento, 2);
    private decimal SubTotal => lineas.Sum(Importe);
    private decimal Igv => Math.Round(SubTotal * 0.18m, 2, MidpointRounding.AwayFromZero);
    private decimal Total => SubTotal + Igv;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        error = null;
        try
        {
            proveedores = await Api.Get<List<Proveedor>>("proveedores") ?? new();
            productos = await Api.Get<List<ProductoCompraRest>>("productos") ?? new();
            if (EsNuevo)
            {
                numero = "";
                proveedorId = 0;
                fecha = DateTime.Today;
                fechaEstimada = null;
                observaciones = null;
                textosProductos.Clear();
                lineas = new() { NuevaLinea() };
            }
            else
            {
                CompraRest? compra = await Api.Get<CompraRest>($"compras/{Id}");
                if (compra is null)
                {
                    error = "No se encontró la compra solicitada.";
                    return;
                }
                if (compra.Estado != "REGISTRADA" || compra.Anulado)
                {
                    error = "Solo se pueden modificar compras registradas y no anuladas.";
                    return;
                }
                numero = compra.Numero;
                proveedorId = compra.IdProveedor;
                fecha = DateTime.TryParse(compra.FechaEmision, out var f) ? f : DateTime.Today;
                fechaEstimada = DateTime.TryParse(compra.FechaRecepcionEstimada, out var fe) ? fe : null;
                observaciones = compra.Observaciones;
                textosProductos.Clear();
                lineas = compra.Detalles.Select(d => new SolicitudDetalleCompraRest
                {
                    NumeroLinea = d.NumeroLinea,
                    IdProducto = d.IdProducto,
                    Cantidad = d.Cantidad,
                    PrecioUnitario = d.PrecioUnitario,
                    Descuento = d.Descuento,
                    UnidadCompra = d.UnidadCompra,
                    FactorConversion = d.FactorConversion
                }).ToList();
                foreach (var linea in lineas)
                {
                    textosProductos[linea] = productos.FirstOrDefault(p => p.Id == linea.IdProducto) is { } p
                        ? EtiquetaProducto(p)
                        : "";
                }
            }
        }
        catch (ErrorApi e) { error = e.Message; }
        finally { cargando = false; }
    }

    private static string EtiquetaProducto(ProductoCompraRest p) =>
        $"{p.CodigoInterno} · {p.Nombre}";

    private string TextoProducto(SolicitudDetalleCompraRest linea) =>
        textosProductos.TryGetValue(linea, out var texto) ? texto : "";

    private void CambiarProducto(SolicitudDetalleCompraRest linea, string? texto)
    {
        texto = texto?.Trim() ?? "";
        textosProductos[linea] = texto;
        // No enviamos el texto al Java: solo el ID de un producto elegido de la lista.
        var producto = productos.FirstOrDefault(p => (p.Estado || p.Id == linea.IdProducto)
            && string.Equals(EtiquetaProducto(p), texto, StringComparison.OrdinalIgnoreCase));
        if (producto is null)
        {
            linea.IdProducto = 0;
            return;
        }
        if (linea.IdProducto != producto.Id)
        {
            linea.IdProducto = producto.Id;
            linea.UnidadCompra = producto.UnidadCompra;
            linea.FactorConversion = producto.FactorConversion;
            linea.PrecioUnitario = producto.CostoUnitario;
        }
    }

    private void EscribiendoProducto(SolicitudDetalleCompraRest linea, ChangeEventArgs e)
    {
        v.Tocado(Clave(linea) + "producto");
        CambiarProducto(linea, e.Value?.ToString());
    }

    private SolicitudDetalleCompraRest NuevaLinea()
    {
        var linea = new SolicitudDetalleCompraRest { Cantidad = 1, IdProducto = 0 };
        textosProductos[linea] = "";
        return linea;
    }
    private void Agregar() => lineas.Add(NuevaLinea());
    private void Quitar(SolicitudDetalleCompraRest linea)
    {
        if (lineas.Count > 1)
        {
            lineas.Remove(linea);
            textosProductos.Remove(linea);
        }
    }

    // ---------------- Validación en pantalla (RNF004) ----------------
    // Mismas reglas que CompraBOImpl. Cada error sale debajo de su cuadro; el BO vuelve a validar todo.
    private readonly ValidacionEnVivo v = new();

    // Clave de una línea para sus errores (las líneas se agregan y se quitan, por eso no se usa la posición)
    private readonly Dictionary<SolicitudDetalleCompraRest, int> claves = new();
    private int ultimaClave;
    private string Clave(SolicitudDetalleCompraRest l)
    {
        if (!claves.TryGetValue(l, out var c))
        {
            c = claves[l] = ++ultimaClave;
        }
        return $"l{c}.";
    }

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (string.IsNullOrWhiteSpace(numero))
        {
            e["numero"] = "El número de orden es obligatorio.";
        }
        if (proveedorId <= 0)
        {
            e["proveedor"] = "Seleccione el proveedor.";
        }
        else if (EsNuevo && !proveedores.Any(p => p.Id == proveedorId && p.Estado))
        {
            e["proveedor"] = "El proveedor está desactivado: elija uno activo.";
        }
        if (fechaEstimada.HasValue && fechaEstimada.Value.Date < fecha.Date)
        {
            e["fechaEstimada"] = "La recepción estimada no puede ser anterior a la emisión.";
        }
        foreach (var l in lineas)
        {
            var n = Clave(l);
            var elegido = l.IdProducto > 0 && productos.Any(p => p.Id == l.IdProducto &&
                string.Equals(EtiquetaProducto(p), TextoProducto(l), StringComparison.OrdinalIgnoreCase));
            if (!elegido)
            {
                e[n + "producto"] = string.IsNullOrWhiteSpace(TextoProducto(l))
                    ? "Elija el producto."
                    : "Elija un producto de la lista.";
            }
            if (l.Cantidad <= 0)
            {
                e[n + "cantidad"] = "La cantidad debe ser mayor a 0.";
            }
            else if (ValidacionEnVivo.MasDecimales(l.Cantidad, 3))
            {
                e[n + "cantidad"] = "Máximo 3 decimales.";
            }
            if (l.PrecioUnitario < 0)
            {
                e[n + "precio"] = "El precio no puede ser negativo.";
            }
            else if (ValidacionEnVivo.MasDecimales(l.PrecioUnitario, 2))
            {
                e[n + "precio"] = "Máximo 2 decimales.";
            }
            if (l.Descuento < 0)
            {
                e[n + "descuento"] = "El descuento no puede ser negativo.";
            }
            else if (l.Descuento > l.Cantidad * l.PrecioUnitario)
            {
                e[n + "descuento"] = "El descuento no puede ser mayor que cantidad × precio.";
            }
        }
        return e;
    }

    private async Task Guardar()
    {
        error = null;
        if (!v.Intentar(Errores()))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        guardando = true;
        try
        {
            var pedido = new SolicitudCompraRest
            {
                Numero = numero.Trim(),
                IdProveedor = proveedorId,
                FechaEmision = fecha.ToString("yyyy-MM-dd"),
                FechaRecepcionEstimada = fechaEstimada?.ToString("yyyy-MM-dd"),
                Observaciones = observaciones,
                Detalles = lineas.Select((l, i) => new SolicitudDetalleCompraRest
                {
                    NumeroLinea = i + 1,
                    IdProducto = l.IdProducto,
                    Cantidad = l.Cantidad,
                    PrecioUnitario = l.PrecioUnitario,
                    Descuento = l.Descuento,
                    UnidadCompra = l.UnidadCompra,
                    FactorConversion = l.FactorConversion
                }).ToList()
            };
            if (EsNuevo)
                await Api.Post<CompraRest>("compras", pedido);
            else
                await Api.Put<CompraRest>($"compras/{Id}", pedido);
            Nav.NavigateTo("/compras");
        }
        catch (ErrorApi e) { error = e.Message; }
        finally { guardando = false; }
    }
}

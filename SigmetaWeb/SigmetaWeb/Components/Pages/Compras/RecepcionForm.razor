@page "/compras/{Id:int}/recepcion"
@inject NavigationManager Nav

@* RF012 - Recepción de compra.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Recepción de compra · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Recepción de mercadería"
            Subtitulo="Registrar visualmente una recepción total o parcial.">
    <a class="btn btn-outline-secondary" href="/recepciones">
        Volver a compras por recibir
    </a>
</Encabezado>

<div class="card card-body mb-3">
    <h2 class="h6 fw-semibold mb-3">Datos de la compra</h2>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="small text-muted text-uppercase">
                Número de compra
            </div>
            <div class="fw-semibold">
                @NumeroCompra
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="small text-muted text-uppercase">
                Proveedor
            </div>
            <div class="fw-semibold">
                @Proveedor
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="small text-muted text-uppercase">
                Estado
            </div>
            <Estado Texto="@EstadoCompra" />
        </div>
    </div>
</div>

<div class="card card-body mb-3">
    <h2 class="h6 fw-semibold mb-3">
        Datos de la recepción
    </h2>

    <div class="row">
        <div class="col-md-4">
            <Campo Etiqueta="Fecha de recepción"
                   Id="fechaRecepcion"
                   Obligatorio="true">
                <input id="fechaRecepcion"
                       type="date"
                       class="form-control"
                       value="2026-10-26" />
            </Campo>
        </div>

        <div class="col-md-8">
            <Campo Etiqueta="Observaciones"
                   Id="observaciones">
                <textarea id="observaciones"
                          class="form-control"
                          rows="2"
                          maxlength="250"
                          placeholder="Observaciones de la recepción"></textarea>
            </Campo>
        </div>
    </div>
</div>

<div class="card card-body mb-3">
    <h2 class="h6 fw-semibold mb-3">
        Productos de la compra
    </h2>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Producto</th>
                    <th>Pedido</th>
                    <th>Ya recibido</th>
                    <th>Pendiente</th>
                    <th>Recibir ahora *</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Lineas)
                {
                    <tr>
                        <td>@MuestrasCompras.NombreProducto(l.Linea.CodigoInterno)</td>
                        <td>@l.Linea.Cantidad.ToString("0.###")</td>
                        <td>@l.Linea.Recibido.ToString("0.###")</td>
                        <td>@l.Linea.Pendiente.ToString("0.###")</td>
                        <td>
                            <input type="number"
                                   class="form-control"
                                   min="0"
                                   max="@l.Linea.Pendiente"
                                   step="1"
                                   @bind="l.Ahora" @bind:event="oninput" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
    <span class="small text-muted">
        <span class="text-danger">*</span> Campo obligatorio
    </span>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary"
           href="/recepciones">
            Cancelar
        </a>

        <button class="btn btn-primary"
                @onclick="Volver">
            Registrar recepción
        </button>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private class LineaRecepcion
    {
        public LineaCompraFila Linea { get; init; } = default!;
        public decimal Ahora { get; set; }
    }

    // Datos de demostración (los mismos de Compras). No se consulta la BD.
    private CompraFila? Compra => MuestrasCompras.Compras.FirstOrDefault(c => c.Id == Id);

    private string NumeroCompra => Compra?.Numero ?? $"COMP-{Id:000}";

    private string Proveedor => Compra?.Proveedor ?? "—";

    private string EstadoCompra => Compra?.Estado ?? "REGISTRADA";

    private List<LineaRecepcion> Lineas = new();

    // Por defecto se propone recibir todo lo pendiente.
    protected override void OnParametersSet()
    {
        Lineas = (Compra?.Lineas ?? Array.Empty<LineaCompraFila>())
            .Select(l => new LineaRecepcion { Linea = l, Ahora = l.Pendiente })
            .ToList();
    }

    // Lab 9: no se registra ninguna recepción.
    private void Volver()
    {
        Nav.NavigateTo("/recepciones");
    }
}

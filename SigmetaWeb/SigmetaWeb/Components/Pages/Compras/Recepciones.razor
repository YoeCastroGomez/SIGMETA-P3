@page "/recepciones"

@* RF012 - Compras pendientes de recepción.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Compras por recibir · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Compras por recibir"
            Subtitulo="Compras con mercadería pendiente de recepción." />

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in MuestrasCompras.Compras.Where(c => c.Estado is "REGISTRADA" or "RECIBIDA_PARCIAL"))
                {
                    <tr>
                        <td>@c.Numero</td>
                        <td>@c.Proveedor</td>
                        <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><Estado Texto="@c.Estado" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary"
                               href="/compras/@c.Id/recepcion">
                                Recibir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

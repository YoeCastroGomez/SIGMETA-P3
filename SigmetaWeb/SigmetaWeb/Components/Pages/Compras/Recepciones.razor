@using SigmetaWeb.Components.Pages.Catalogo
﻿@page "/recepciones"

@* RF012 - Compras pendientes de recepción.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Compras por recibir · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Compras por recibir"
            Subtitulo="Compras con mercadería pendiente de recepción." />

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>COMP-001</td>
                    <td>@MuestrasCatalogo.Proveedores[0].RazonSocial</td>
                    <td>20/10/2026</td>
                    <td><Estado Texto="REGISTRADA" /></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary"
                           href="/compras/1/recepcion">
                            Recibir
                        </a>
                    </td>
                </tr>

                <tr>
                    <td>COMP-002</td>
                    <td>@MuestrasCatalogo.Proveedores[1].RazonSocial</td>
                    <td>22/10/2026</td>
                    <td><Estado Texto="RECIBIDA_PARCIAL" /></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary"
                           href="/compras/2/recepcion">
                            Recibir
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

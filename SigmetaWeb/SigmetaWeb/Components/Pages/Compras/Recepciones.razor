@page "/recepciones"

@* RF012 - Compras pendientes de recepción.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Compras por recibir · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Compras por recibir"
            Subtitulo="Compras con mercadería pendiente de recepción." />

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in Paginar(MuestrasCompras.Compras.Where(c => c.Estado is "REGISTRADA" or "RECIBIDA_PARCIAL"), paginaActual, tamanoPagina))
                {
                    <tr>
                        <td>@c.Numero</td>
                        <td>@c.Proveedor</td>
                        <td>@c.Fecha.ToString("yyyy-MM-dd")</td>
                        <td><Estado Texto="@c.Estado" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary"
                               href="/compras/@c.Id/recepcion">
                                Recibir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
        <Paginacion TotalRegistros="@(MuestrasCompras.Compras.Where(c => c.Estado is "REGISTRADA" or "RECIBIDA_PARCIAL").Count())" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
</div>

@code {
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T> registros, int pagina, int tamano)
    {
        if (tamano == 0) return registros;
        int total = registros.Count();
        int segura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((segura - 1) * tamano).Take(tamano);
    }
}

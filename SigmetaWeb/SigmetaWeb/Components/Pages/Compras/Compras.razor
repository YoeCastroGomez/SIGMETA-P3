@using SigmetaWeb.Components.Pages.Catalogo
@page "/compras"

@* RF011 - Listado de compras a proveedores.
   Solo interfaz visual para el Laboratorio 9. *@

<PageTitle>Compras · SIGMETA</PageTitle>

<Encabezado Rf="RF011" Titulo="Compras a proveedores">
    <a class="btn btn-primary" href="/compras/nueva">
        Nueva compra
    </a>
</Encabezado>

@* Filtros de búsqueda *@
<div class="card card-body mb-3">
    <div class="row g-3 align-items-end">

        <Campo Etiqueta="Proveedor" Id="proveedor"
               Clase="col-sm-6 col-md-4">
            <input id="proveedor" class="form-control"
                   placeholder="Buscar proveedor" @bind="proveedorFiltro" />
        </Campo>

        <Campo Etiqueta="Desde" Id="fechaDesde"
               Clase="col-sm-6 col-md-3">
            <input id="fechaDesde" type="date"
                   class="form-control" @bind="desdeFiltro" />
        </Campo>

        <Campo Etiqueta="Hasta" Id="fechaHasta"
               Clase="col-sm-6 col-md-3">
            <input id="fechaHasta" type="date"
                   class="form-control" @bind="hastaFiltro" />
        </Campo>

        <div class="col-auto">
            <button class="btn btn-dark" @onclick="Buscar">Buscar</button>
            <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>

    </div>
</div>

@* Listado de ejemplo *@
<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var compra in ComprasFiltradas)
                {
                    <tr>
                        <td>@compra.Numero</td>
                        <td>@compra.Proveedor</td>
                        <td>@compra.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>S/ @compra.Total.ToString("N2")</td>
                        <td><Estado Texto="@compra.Estado" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/compras/editar/{compra.Id}")">Editar</a>
                        </td>
                    </tr>
                }
                @if (ComprasFiltradas.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron compras con estos filtros.</td></tr>
                }
            </tbody>

        </table>
    </div>
</div>

@code {
    // Datos de demostración (Lab 9). El filtro no consulta la base de datos.
    private sealed record CompraFila(int Id, string Numero, string Proveedor, DateTime Fecha, decimal Total, string Estado);
    private IEnumerable<CompraFila> ComprasEjemplo => new[]
    {
        new CompraFila(1, "COMP-001", MuestrasCatalogo.Proveedores[0].RazonSocial, new DateTime(2026, 10, 20), 590m, "REGISTRADA"),
        new CompraFila(2, "COMP-002", MuestrasCatalogo.Proveedores[1].RazonSocial, new DateTime(2026, 10, 22), 1180m, "RECIBIDA_PARCIAL")
    };

    private string proveedorFiltro = "";
    private DateTime? desdeFiltro;
    private DateTime? hastaFiltro;
    private string proveedorAplicado = "";
    private DateTime? desdeAplicado;
    private DateTime? hastaAplicado;

    private List<CompraFila> ComprasFiltradas => ComprasEjemplo
        .Where(c => string.IsNullOrWhiteSpace(proveedorAplicado)
            || c.Proveedor.Contains(proveedorAplicado.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(c => !desdeAplicado.HasValue || c.Fecha.Date >= desdeAplicado.Value.Date)
        .Where(c => !hastaAplicado.HasValue || c.Fecha.Date <= hastaAplicado.Value.Date)
        .ToList();

    private void Buscar()
    {
        proveedorAplicado = proveedorFiltro;
        desdeAplicado = desdeFiltro;
        hastaAplicado = hastaFiltro;
    }

    private void Limpiar()
    {
        proveedorFiltro = proveedorAplicado = "";
        desdeFiltro = hastaFiltro = desdeAplicado = hastaAplicado = null;
    }
}

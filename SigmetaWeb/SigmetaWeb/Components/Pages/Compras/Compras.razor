@page "/compras"
@inject ApiJava Api
@using SigmetaWeb.Components.Pages.Compras
@using SigmetaWeb.Components.Pages.Catalogo
@using SigmetaWeb.Components.Shared

<PageTitle>Compras · SIGMETA</PageTitle>

<Encabezado Rf="RF011" Titulo="Compras a proveedores"
            Subtitulo="Órdenes reales de compra, con historial de anulaciones.">
    <a class="btn btn-primary" href="/compras/nueva">Nueva compra</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Número de compra" Id="numeroCompraFiltro" Clase="col-sm-6 col-md-3">
            <input id="numeroCompraFiltro" type="text" class="form-control"
                   placeholder="Ej. OC-LAB11" @bind="filtroNumero" />
        </Campo>
        <Campo Etiqueta="Proveedor" Id="proveedorCompra" Clase="col-sm-6 col-md-3">
            <input id="proveedorCompra" type="text" class="form-control"
                   list="sugerenciasProveedoresCompras" autocomplete="off"
                   placeholder="Escribe o selecciona" @bind="filtroProveedorTexto" />
            <datalist id="sugerenciasProveedoresCompras">
                @foreach (var p in proveedores.OrderBy(p => p.RazonSocial))
                {
                    <option value="@p.RazonSocial"></option>
                }
            </datalist>
        </Campo>
        <Campo Etiqueta="Desde" Id="fechaDesdeCompra" Clase="col-sm-6 col-md-2">
            <input id="fechaDesdeCompra" type="date" class="form-control" @bind="filtroDesde" />
        </Campo>
        <Campo Etiqueta="Hasta" Id="fechaHastaCompra" Error="@(ValidacionEnVivo.ErrorRango(filtroDesde, filtroHasta))" Clase="col-sm-6 col-md-2">
            <input id="fechaHastaCompra" type="date" class="@(ValidacionEnVivo.ClaseRango(filtroDesde, filtroHasta))" @bind="filtroHasta" />
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark" disabled="@cargando">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar" disabled="@cargando">Limpiar</button>
        </div>
    </form>
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Número</th><th>Proveedor</th><th>Fecha</th><th>Total</th><th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in ComprasPagina)
                {
                    <tr>
                        <td>@c.Numero</td>
                        <td>@NombreProveedor(c.IdProveedor)</td>
                        <td>@c.FechaEmision</td>
                        <td>S/ @c.Total.ToString("N2")</td>
                        <td><Estado Texto="@c.Estado" /></td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="@($"/compras/detalle/{c.Id}")">Ver detalle</a>
                                @if (c.Estado == "REGISTRADA" && !c.Anulado)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/compras/editar/{c.Id}")">Editar</a>
                                    @if (confirmarId == c.Id)
                                    {
                                        <button type="button" class="btn btn-sm btn-danger" disabled="@cargando" @onclick="() => Anular(c)">Confirmar anulación</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmarId = null">Cancelar</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmarId = c.Id">Anular</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!cargando && error is null && resultado.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay compras que coincidan con la búsqueda.</td></tr>
                }
                @if (cargando && cargaInicial)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2" role="status"></span>Consultando compras y proveedores...</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (!cargando && error is null)
    {
        <Paginacion TotalRegistros="@resultado.Count"
                    @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    }
</div>

@code {
    private List<CompraRest> compras = new();
    private List<CompraRest> resultado = new();
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<CompraRest> ComprasPagina => tamanoPagina == 0
        ? resultado
        : resultado.Skip((Math.Clamp(paginaActual, 1, TotalPaginas) - 1) * tamanoPagina).Take(tamanoPagina);
    private int TotalPaginas => tamanoPagina == 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)resultado.Count / tamanoPagina));
    private void AjustarPagina() => paginaActual = Math.Clamp(paginaActual, 1, TotalPaginas);
    private List<Proveedor> proveedores = new();
    private string filtroProveedorTexto = "";
    private string filtroNumero = "";
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private string? error;
    private string? exito;
    private int? confirmarId;
    private bool cargando;
    private bool cargaInicial = true;
    private Dictionary<int, string> nombresProveedores = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            // Ambas peticiones son independientes y pueden ejecutarse a la vez.
            var tareaProveedores = Api.Get<List<Proveedor>>("proveedores");
            var tareaCompras = Api.Get<List<CompraRest>>("compras");
            await Task.WhenAll(tareaProveedores, tareaCompras);
            proveedores = await tareaProveedores ?? new();
            nombresProveedores = proveedores.ToDictionary(p => p.Id, p => p.RazonSocial);
            compras = await tareaCompras ?? new();
            AplicarFiltros();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        catch (Exception)
        {
            error = "No se pudo cargar la lista. Comprueba la conexión e inténtalo de nuevo.";
        }
        finally
        {
            cargando = false;
            cargaInicial = false;
        }
    }

    private string NombreProveedor(int id) =>
        nombresProveedores.TryGetValue(id, out var nombre) ? nombre : $"Proveedor #{id}";

    // RF011: el historial por proveedor y fechas lo filtra el BO (CompraBO.listarPorProveedorYFechas) con
    // GET /api/compras?idProveedor=&fechaInicio=&fechaFin=. Sin esos filtros: GET /api/compras (todas).
    private string rutaConsulta = "compras";

    private async Task Cargar()
    {
        cargando = true;
        error = null;
        try
        {
            compras = await Api.Get<List<CompraRest>>(rutaConsulta) ?? new();
            AplicarFiltros();
        }
        catch (ErrorApi e) { error = e.Message; }   // por ejemplo "La fecha de inicio no puede ser posterior a la fecha de fin"
        catch (Exception) { error = "Ocurrió un problema al consultar las compras. Inténtalo otra vez."; }
        finally { cargando = false; }
    }

    // Solo el número de compra se filtra aquí (el BO no tiene esa búsqueda); proveedor y fechas los filtra el BO
    private void AplicarFiltros()
    {
        resultado = compras
            .Where(c => string.IsNullOrWhiteSpace(filtroNumero) ||
                c.Numero.Contains(filtroNumero.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.Id)
            .ToList();
        AjustarPagina();
    }

    private async Task Buscar()
    {
        error = null;
        exito = null;
        paginaActual = 1;
        confirmarId = null;

        if (filtroDesde.HasValue && filtroHasta.HasValue && filtroDesde.Value.Date > filtroHasta.Value.Date)
        {
            error = "La fecha de inicio no puede ser posterior a la fecha de fin.";
            return;
        }

        var parametros = new List<string>();
        if (!string.IsNullOrWhiteSpace(filtroProveedorTexto))
        {
            var proveedor = proveedores.FirstOrDefault(p =>
                string.Equals(p.RazonSocial, filtroProveedorTexto.Trim(), StringComparison.OrdinalIgnoreCase));
            if (proveedor is null)
            {
                error = "Selecciona un proveedor de la lista.";
                return;
            }
            parametros.Add($"idProveedor={proveedor.Id}");
        }
        var cultura = System.Globalization.CultureInfo.InvariantCulture;
        if (filtroDesde.HasValue)
            parametros.Add($"fechaInicio={filtroDesde.Value.ToString("yyyy-MM-dd", cultura)}");
        if (filtroHasta.HasValue)
            parametros.Add($"fechaFin={filtroHasta.Value.ToString("yyyy-MM-dd", cultura)}");
        rutaConsulta = parametros.Count == 0 ? "compras" : $"compras?{string.Join("&", parametros)}";
        await Cargar();
    }

    private async Task Limpiar()
    {
        filtroProveedorTexto = "";
        filtroNumero = "";
        filtroDesde = filtroHasta = null;
        exito = null;
        error = null;
        confirmarId = null;
        paginaActual = 1;
        rutaConsulta = "compras";
        await Cargar();
    }

    private async Task Anular(CompraRest compra)
    {
        cargando = true;
        error = exito = null;
        try
        {
            await Api.Delete($"compras/{compra.Id}");
            confirmarId = null;
        }
        catch (ErrorApi e) { error = e.Message; }
        finally { cargando = false; }

        if (error is null)
        {
            await Cargar();   // respeta el filtro vigente (rutaConsulta)
            if (error is null)
            {
                exito = $"Se anuló la compra {compra.Numero}.";
            }
        }
    }
}

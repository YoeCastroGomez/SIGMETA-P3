@using SigmetaWeb.Components.Pages.Catalogo
﻿@page "/compras"

@* RF011 - Listado de compras a proveedores.
   Solo interfaz visual para el Laboratorio 9. *@

<PageTitle>Compras · SIGMETA</PageTitle>

<Encabezado Rf="RF011" Titulo="Compras a proveedores">
    <a class="btn btn-primary" href="/compras/nueva">
        Nueva compra
    </a>
</Encabezado>

@* Filtros de búsqueda *@
<div class="card card-body mb-3">
    <div class="row g-3 align-items-end">

        <Campo Etiqueta="Proveedor" Id="proveedor"
               Clase="col-sm-6 col-md-4">
            <input id="proveedor" class="form-control"
                   placeholder="Buscar proveedor" />
        </Campo>

        <Campo Etiqueta="Desde" Id="fechaDesde"
               Clase="col-sm-6 col-md-3">
            <input id="fechaDesde" type="date"
                   class="form-control" />
        </Campo>

        <Campo Etiqueta="Hasta" Id="fechaHasta"
               Clase="col-sm-6 col-md-3">
            <input id="fechaHasta" type="date"
                   class="form-control" />
        </Campo>

        <div class="col-auto">
            <button class="btn btn-dark">Buscar</button>
        </div>

    </div>
</div>

@* Listado de ejemplo *@
<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>COMP-001</td>
                    <td>@MuestrasCatalogo.Proveedores[0].RazonSocial</td>
                    <td>20/10/2026</td>
                    <td>S/ 590.00</td>
                    <td><Estado Texto="REGISTRADA" /></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary"
                           href="/compras/editar/1">
                            Editar
                        </a>
                    </td>
                </tr>

                <tr>
                    <td>COMP-002</td>
                    <td>@MuestrasCatalogo.Proveedores[1].RazonSocial</td>
                    <td>22/10/2026</td>
                    <td>S/ 1,180.00</td>
                    <td><Estado Texto="RECIBIDA_PARCIAL" /></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary"
                           href="/compras/editar/2">
                            Editar
                        </a>
                    </td>
                </tr>
            </tbody>

        </table>
    </div>
</div>

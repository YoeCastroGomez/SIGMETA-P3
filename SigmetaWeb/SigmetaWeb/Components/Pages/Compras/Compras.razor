@page "/compras"

@* RF011 - Listado de compras a proveedores.
   Solo interfaz visual para el Laboratorio 9. *@

<PageTitle>Compras · SIGMETA</PageTitle>

<Encabezado Rf="RF011" Titulo="Compras a proveedores">
    <a class="btn btn-primary" href="/compras/nueva">
        Nueva compra
    </a>
</Encabezado>

@* Filtros de búsqueda *@
<div class="card card-body mb-3">
    <div class="row g-3 align-items-end">

        <Campo Etiqueta="Proveedor" Id="proveedor"
               Clase="col-sm-6 col-md-4">
            <input id="proveedor" class="form-control"
                   placeholder="Buscar proveedor"
                   @bind="filtroProveedor" @bind:event="oninput" />
        </Campo>

        <Campo Etiqueta="Desde" Id="fechaDesde"
               Clase="col-sm-6 col-md-3">
            <input id="fechaDesde" type="date"
                   class="form-control" @bind="filtroDesde" />
        </Campo>

        <Campo Etiqueta="Hasta" Id="fechaHasta"
               Clase="col-sm-6 col-md-3">
            <input id="fechaHasta" type="date"
                   class="form-control" @bind="filtroHasta" />
        </Campo>

        <div class="col-auto">
            <button class="btn btn-dark" @onclick="Buscar">Buscar</button>
        </div>

    </div>
</div>

@* Listado de ejemplo (mismos datos que Recepciones y Kardex) *@
<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in resultado)
                {
                    <tr>
                        <td>@c.Numero</td>
                        <td>@c.Proveedor</td>
                        <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>S/ @c.Total.ToString("N2")</td>
                        <td><Estado Texto="@c.Estado" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/compras/editar/@c.Id">
                                Editar
                            </a>
                        </td>
                    </tr>
                }
                @if (resultado.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No hay compras que coincidan con la búsqueda.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

@code {
    private string filtroProveedor = "";
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private List<CompraFila> resultado = MuestrasCompras.Compras.ToList();

    private void Buscar()
    {
        resultado = MuestrasCompras.Compras
            .Where(c => string.IsNullOrWhiteSpace(filtroProveedor)
                        || c.Proveedor.Contains(filtroProveedor.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(c => filtroDesde is null || c.Fecha >= DateOnly.FromDateTime(filtroDesde.Value))
            .Where(c => filtroHasta is null || c.Fecha <= DateOnly.FromDateTime(filtroHasta.Value))
            .ToList();
    }
}

@page "/almacen/ajuste"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Almacenero")]
@inject ApiJava Api
@inject NavigationManager Nav
@using SigmetaWeb.Components.Pages.Seguridad

<PageTitle>@Titulo · SIGMETA</PageTitle>

@* RF012 y RF014 · Ajuste de inventario por conteo físico (Almacenero con autorización del Administrador).
     1 Preparar: producto (se busca por código, nombre o categoría), cantidad contada y motivo.
     2 Autorización: POST /api/almacen/ajustes/solicitar con ESTE ajuste, más datosOperacion (la pantalla en JSON)
       para retomarlo con /almacen/ajuste?solicitud=ID. El ajuste queda en Movimientos como «por registrar».
     3 Registrar: con la autorización aprobada, POST /api/almacen/ajustes (el BO la consume: queda USADA).
   GET /api/almacen/existencias · GET /api/solicitudes/en-curso?operacion=AJUSTE_INVENTARIO *@
<Encabezado Rf="RF012" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/almacen/movimientos">Volver</a>
</Encabezado>

<Notificacion Mensaje="@error" Error="true" Segundos="8" AlCerrar="() => error = null" />

@if (!cargado)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <PasosDocumento Pasos="@Pasos" Titulo="Pasos del ajuste" />

    <div class="row g-3">
        <div class="col-lg-8">
            @* -------- 1. Producto contado -------- *@
            <div class="card card-body mb-3">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <h2 class="h6 fw-semibold mb-0"><span class="numero-paso">1</span> Producto contado</h2>
                    @if (Producto is not null && !Bloqueado && retomada is null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CambiarProducto">Cambiar</button>
                    }
                </div>

                @if (Producto is null)
                {
                    <Campo Etiqueta="Buscar el producto" Id="buscarProducto" Error="@E("producto")" Clase="mb-2">
                        <input id="buscarProducto" type="search" class="form-control @Invalido("producto")" maxlength="60" autocomplete="off"
                               placeholder="Código, nombre o categoría"
                               @bind="buscar" @bind:event="oninput" @onkeydown="AlTeclear" />
                    </Campo>
                    <div class="d-flex flex-wrap gap-2 mb-2" role="group" aria-label="Filtrar productos">
                        @foreach (var (valor, texto) in Filtros)
                        {
                            <button type="button" class="btn btn-sm @(filtro == valor ? "btn-dark" : "btn-outline-secondary")"
                                    aria-pressed="@(filtro == valor ? "true" : "false")" @onclick="() => filtro = valor">
                                @texto <span class="opacity-75">@Cuantos(valor)</span>
                            </button>
                        }
                    </div>

                    var encontrados = Encontrados;
                    if (existencias.Count == 0)
                    {
                        <p class="small text-muted mb-0">No hay productos activos.</p>
                    }
                    else if (encontrados.Count == 0)
                    {
                        <p class="small text-muted mb-0">@SinResultados</p>
                    }
                    else
                    {
                        <div class="lista-productos" role="listbox" aria-label="Productos">
                            @foreach (var p in encontrados.Take(MaximoVisibles))
                            {
                                <button type="button" class="opcion-producto" role="option" @key="p.Id" @onclick="() => Elegir(p.Id)">
                                    <span class="col-codigo">
                                        <span class="numero">@p.CodigoInterno</span>
                                        <span class="sub">@(p.Categoria ?? "Sin categoría")</span>
                                    </span>
                                    <span class="col-nombre fw-semibold">@p.Nombre</span>
                                    <span class="col-stock">
                                        <span class="cifra">@Formato.Cantidad(p.StockActual) <span class="sub d-inline">@TextosAlmacen.Unidad(p.UnidadVenta)</span></span>
                                        <span class="sub">Mín. @Formato.Cantidad(p.StockMinimo)</span>
                                    </span>
                                    <span class="col-estado">
                                        @if (EnCursoDe(p.Id) is { } tramite)
                                        {
                                            <Estado Texto="@EstadoAjuste(tramite)" />
                                        }
                                        else if (p.Situacion != "Normal")
                                        {
                                            <Estado Texto="@p.Situacion" />
                                        }
                                    </span>
                                </button>
                            }
                        </div>
                        @if (encontrados.Count > MaximoVisibles)
                        {
                            <div class="small text-muted mt-2">@MaximoVisibles de @encontrados.Count</div>
                        }
                    }
                }
                else
                {
                    <div class="producto-elegido">
                        <div>
                            <div class="small text-muted">Código</div>
                            <div class="numero fs-5">@Producto.CodigoInterno</div>
                            <div class="small text-muted">@(Producto.Categoria ?? "Sin categoría")</div>
                        </div>
                        <div class="nombre">
                            <div class="small text-muted">Producto</div>
                            <div class="fw-semibold">@Producto.Nombre</div>
                            @if (Producto.Situacion != "Normal")
                            {
                                <Estado Texto="@Producto.Situacion" />
                            }
                        </div>
                        <div class="text-end">
                            <div class="small text-muted">Costo unitario</div>
                            <div class="fw-semibold">@Formato.Soles(Producto.CostoUnitario)</div>
                        </div>
                    </div>
                    @if (retomada is null && EnCursoDe(Producto.Id) is { } otro)
                    {
                        <div class="alert alert-warning small mt-3 mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>Este producto ya tiene un ajuste <strong>@EstadoAjuste(otro).ToLowerInvariant()</strong>
                                (contado: @Formato.Cantidad(LeerDatos(otro)?.CantidadContada)).</span>
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/almacen/ajuste?solicitud={otro.Id}")">Continuar ese ajuste</a>
                        </div>
                    }
                }
            </div>

            @* -------- 2. Cantidad contada -------- *@
            <div class="card card-body mb-3">
                <h2 class="h6 fw-semibold mb-2"><span class="numero-paso">2</span> Cantidad contada</h2>
                <div class="row g-3 align-items-stretch">
                    <Campo Etiqueta="Contado" Id="contado" Obligatorio="true" Error="@E("contado")" Clase="col-sm-4">
                        <div class="input-group">
                            <input id="contado" type="number" min="0" step="any" class="form-control @Invalido("contado")"
                                   @bind="contado" @bind:event="oninput" disabled="@(Bloqueado || Producto is null)" />
                            @if (Producto is not null)
                            {
                                <span class="input-group-text">@TextosAlmacen.Unidad(Producto.UnidadVenta)</span>
                            }
                        </div>
                    </Campo>
                    <div class="col-sm-4">
                        <div class="cuadro">
                            <div class="small text-muted">Stock en el sistema</div>
                            <div class="h4 fw-bold mb-0">@(Producto is null ? "—" : Formato.Cantidad(Producto.StockActual))</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="cuadro">
                            <div class="small text-muted">Diferencia</div>
                            @if (Diferencia is null)
                            {
                                <div class="h4 fw-bold mb-0">—</div>
                            }
                            else if (!HayDiferencia)
                            {
                                <div class="h4 fw-bold mb-0">0</div>
                                <div class="small text-muted">Coincide: no hay ajuste</div>
                            }
                            else
                            {
                                <div class="h4 fw-bold mb-0 @(Diferencia > 0 ? "text-success-emphasis" : "text-danger-emphasis")">
                                    @(Diferencia > 0 ? "+" : "−")@Formato.Cantidad(Math.Abs(Diferencia.Value))
                                </div>
                                <div class="small text-muted">@(Diferencia > 0 ? "Sobrante: ingresa al stock" : "Faltante: sale del stock")</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* -------- 3. Motivo -------- *@
            <div class="card card-body mb-3">
                <h2 class="h6 fw-semibold mb-2"><span class="numero-paso">3</span> Motivo de la diferencia</h2>
                <Campo Etiqueta="Motivo" Id="motivo" Obligatorio="true" Error="@E("motivo")">
                    <input id="motivo" class="form-control @Invalido("motivo")" maxlength="@LargoMotivo"
                           @bind="motivo" @bind:event="oninput" disabled="@Bloqueado" />
                </Campo>
                @if (!Bloqueado)
                {
                    <div class="d-flex flex-wrap gap-2" aria-label="Motivos frecuentes">
                        @foreach (var m in Motivos)
                        {
                            <button type="button" class="btn btn-sm @(EsMotivo(m) ? "btn-dark" : "btn-outline-secondary")" @onclick="() => ElegirMotivo(m)">@m</button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <ResumenTotal Etiqueta="Valor del ajuste al costo" Total="@((decimal)Valor)" Numero="@Producto?.CodigoInterno"
                          EstadoTexto="@EstadoTexto" Detalle="@TextoDiferencia">
                @if (Faltan.Count > 0 && !Bloqueado)
                {
                    <ul class="lista-pendientes list-unstyled small mb-0" aria-label="Lo que falta">
                        @foreach (var f in Faltan)
                        {
                            <li class="falta"><span class="marca" aria-hidden="true">•</span><span>@f</span></li>
                        }
                    </ul>
                }

                <PedirAutorizacion Listo="@(Errores().Count == 0)" Solicitar="Solicitar" Retomar="@retomada" Volver="/almacen/movimientos"
                                   EstadoChanged="AlCambiarAutorizacion" AlError="m => error = m">
                    <BotonCondicionado Texto="Registrar ajuste" TextoOcupado="Registrando..." Bloque="true" Clase="btn-primary w-100"
                                       Ocupado="@guardando" AlHacerClic="Guardar" />
                </PedirAutorizacion>
                @if (estadoAutorizacion is null)
                {
                    <a class="btn btn-outline-secondary w-100" href="/almacen/movimientos">Cancelar</a>
                }
            </ResumenTotal>
        </div>
    </div>
}

@code {
    private const int MaximoVisibles = 8;
    private const int LargoMotivo = 200;   // mismo límite que MovimientoInventarioBOImpl.solicitarAjuste
    private static readonly System.Text.Json.JsonSerializerOptions Json = new(System.Text.Json.JsonSerializerDefaults.Web);

    // motivos que más se repiten en un conteo; se pueden completar después de elegirlos
    private static readonly string[] MotivosFaltante =
        { "Merma", "Rotura o daño", "Pérdida o robo", "Producto vencido o inservible", "Error en el conteo anterior" };
    private static readonly string[] MotivosSobrante =
        { "Mercadería recibida sin registrar", "Devolución no registrada", "Despacho registrado de más", "Error en el conteo anterior" };
    private static readonly string[] MotivosGenerales =
        { "Error en el conteo anterior", "Merma", "Rotura o daño", "Mercadería recibida sin registrar" };

    private static readonly (string Valor, string Texto)[] Filtros =
        { ("", "Todos"), ("BAJO", "Bajo el mínimo"), ("SIN", "Sin stock"), ("TRAMITE", "En trámite") };

    private List<ExistenciaFila> existencias = new();
    private List<SolicitudDatos> enCurso = new();        // otros ajustes en trámite del Almacenero
    private string? estadoAutorizacion;     // RF014: null, PENDIENTE, APROBADA, RECHAZADA, VENCIDA o USADA
    // RF014: retoma el ajuste con la autorización ya pedida: /almacen/ajuste?solicitud=ID
    [SupplyParameterFromQuery(Name = "solicitud")] public int? IdSolicitud { get; set; }
    private int? solicitudCargada;
    private SolicitudDatos? retomada;
    private int idProducto;
    private double? contado;
    private string motivo = "";
    private string buscar = "";
    private string filtro = "";
    private bool cargado;
    private bool intento;
    private bool guardando;
    private string? error;

    private string Titulo => retomada is null ? "Ajuste por conteo físico" : "Ajuste en trámite";
    // mientras espera o ya está autorizado, el ajuste no se cambia (se autorizó lo que se mandó)
    private bool Bloqueado => estadoAutorizacion is "PENDIENTE" or "APROBADA";
    private bool Autorizada => estadoAutorizacion == "APROBADA";
    private ExistenciaFila? Producto => existencias.FirstOrDefault(p => p.Id == idProducto);
    private double? Diferencia => Producto is null || contado is null ? null : contado - Producto.StockActual;
    private bool HayDiferencia => Diferencia is double d && Math.Abs(d) >= 0.0005;
    private double Valor => HayDiferencia ? Math.Abs(Diferencia!.Value) * Producto!.CostoUnitario : 0;
    private string[] Motivos => !HayDiferencia ? MotivosGenerales : Diferencia > 0 ? MotivosSobrante : MotivosFaltante;

    private string? TextoDiferencia => !HayDiferencia ? Producto?.Nombre
        : $"{(Diferencia > 0 ? "Sobrante" : "Faltante")} de {Formato.Cantidad(Math.Abs(Diferencia!.Value))} {TextosAlmacen.Unidad(Producto!.UnidadVenta)} · {Producto.Nombre}";

    // estado del ajuste mientras no existe (lo que sigue a la solicitud)
    private string? EstadoTexto => estadoAutorizacion switch
    {
        "PENDIENTE" => "Solicitado",
        "APROBADA" => "Autorizado",
        "RECHAZADA" => "Rechazado",
        "VENCIDA" => "Vencido",
        _ => null
    };

    internal static string EstadoAjuste(SolicitudDatos s) => s.Cancelada ? "Cancelado" : s.Estado switch
    {
        "PENDIENTE" => "Solicitado",
        "APROBADA" => "Autorizado",
        "RECHAZADA" => "Rechazado",
        "VENCIDA" => "Vencido",
        _ => TextosSeguridad.Texto(s.Estado)
    };

    private List<PasoDocumento> Pasos => new()
    {
        new("Preparar el ajuste", Errores().Count == 0 || Bloqueado ? EstadoPaso.Hecho : EstadoPaso.Actual, Producto?.CodigoInterno),
        new("Autorización", Autorizada ? EstadoPaso.Hecho : Errores().Count == 0 || estadoAutorizacion is not null ? EstadoPaso.Actual : EstadoPaso.Pendiente,
            estadoAutorizacion switch { "PENDIENTE" => "Solicitada", "RECHAZADA" => "Rechazada", "VENCIDA" => "Vencida", _ => null },
            estadoAutorizacion == "PENDIENTE" ? "Administrador" : null),
        new("Registrar", Autorizada ? EstadoPaso.Actual : EstadoPaso.Pendiente, null, Autorizada ? "Almacenero" : null)
    };

    // ---------------- búsqueda del producto ----------------

    // cada palabra tiene que aparecer en el código, el nombre o la categoría ("cable 14" encuentra CABLE THW 14 AWG)
    private List<ExistenciaFila> Encontrados
    {
        get
        {
            var palabras = buscar.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return existencias
                .Where(p => PasaFiltro(p, filtro))
                .Where(p => palabras.All(w => Busqueda.Coincide(w, p.CodigoInterno, p.Nombre, p.Categoria)))
                .OrderBy(p => p.Nombre)
                .ToList();
        }
    }

    private bool PasaFiltro(ExistenciaFila p, string valor) => valor switch
    {
        "BAJO" => p.BajoMinimo,
        "SIN" => p.SinStock,
        "TRAMITE" => EnCursoDe(p.Id) is not null,
        _ => true
    };

    private int Cuantos(string valor) => existencias.Count(p => PasaFiltro(p, valor));

    private string SinResultados => string.IsNullOrWhiteSpace(buscar)
        ? "Ningún producto está en este filtro." : $"Ningún producto coincide con «{buscar.Trim()}».";

    // Enter con un solo resultado lo elige
    private void AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && Encontrados is { Count: 1 } unico)
        {
            Elegir(unico[0].Id);
        }
    }

    private void Elegir(int id)
    {
        idProducto = id;
        contado = null;
    }

    private void CambiarProducto()
    {
        idProducto = 0;
        contado = null;
        intento = false;
    }

    // ---------------- motivo ----------------

    private bool EsMotivo(string m) => motivo.Trim().StartsWith(m, StringComparison.OrdinalIgnoreCase);

    // si ya se escribió un detalle después del motivo elegido, se conserva ("Rotura o daño: 2 al apilar")
    private void ElegirMotivo(string m)
    {
        var actual = motivo.Trim();
        var anterior = MotivosFaltante.Concat(MotivosSobrante).FirstOrDefault(x => actual.StartsWith(x, StringComparison.OrdinalIgnoreCase));
        var detalle = anterior is null ? "" : actual[anterior.Length..].TrimStart(':', ' ');
        if (anterior is null && actual.Length > 0) detalle = actual;
        var nuevo = detalle.Length == 0 ? m : $"{m}: {detalle}";
        motivo = nuevo.Length > LargoMotivo ? nuevo[..LargoMotivo] : nuevo;
    }

    // ---------------- validación (mismas reglas que MovimientoInventarioBOImpl.registrarAjuste) ----------------

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (Producto is null) e["producto"] = "Elige el producto contado";
        if (contado is null) e["contado"] = "Escribe la cantidad contada";
        else if (contado < 0) e["contado"] = "La cantidad contada no puede ser negativa";
        else if (Diferencia is not null && !HayDiferencia) e["contado"] = "Coincide con el stock: no hay nada que ajustar";
        if (string.IsNullOrWhiteSpace(motivo)) e["motivo"] = "Escribe o elige el motivo";
        return e;
    }

    private List<string> Faltan => Errores().Values.ToList();
    private string? E(string campo) => intento && Errores().TryGetValue(campo, out var m) ? m : null;
    private string Invalido(string campo) => E(campo) is null ? "" : "is-invalid";

    // ---------------- carga y retoma ----------------

    protected override async Task OnParametersSetAsync()
    {
        // la misma página se reutiliza al ir de un ajuste a otro: se carga cada vez que cambia la solicitud
        if (cargado && solicitudCargada == IdSolicitud) return;
        cargado = false;
        solicitudCargada = IdSolicitud;
        retomada = null;
        estadoAutorizacion = null;
        idProducto = 0;
        contado = null;
        motivo = "";
        intento = false;
        try
        {
            existencias = await Api.Get<List<ExistenciaFila>>("almacen/existencias") ?? new();
            enCurso = await Api.Get<List<SolicitudDatos>>($"solicitudes/en-curso?operacion={TextosSeguridad.OperacionAjuste}") ?? new();
            if (IdSolicitud is int id)
            {
                await Retomar(id);
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        cargado = true;
    }

    // RF014: vuelve a armar el ajuste tal como se pidió y sigue su autorización (no se pide otra vez)
    private async Task Retomar(int idSolicitud)
    {
        var s = await Api.Get<SolicitudDatos>($"solicitudes/{idSolicitud}");
        var datos = s is null ? null : LeerDatos(s);
        if (s is null || datos is null || s.Operacion != TextosSeguridad.OperacionAjuste)
        {
            error = "No se encontraron los datos de esa solicitud. Prepare el ajuste otra vez.";
            return;
        }
        if (s.Estado == "USADA")
        {
            error = "Esa autorización ya se usó: el ajuste ya está registrado.";
            return;
        }
        if (existencias.All(p => p.Id != datos.IdProducto))
        {
            error = "El producto de esa solicitud ya no está activo.";
            return;
        }
        idProducto = datos.IdProducto;
        contado = datos.CantidadContada;
        motivo = datos.Motivo ?? s.Motivo ?? "";
        retomada = s;
        estadoAutorizacion = s.Estado;
    }

    // lo que se guardó al pedir la autorización (los datos del producto son solo para mostrarlo en las listas)
    private sealed class DatosAjusteGuardado
    {
        public int IdProducto { get; set; }
        public double CantidadContada { get; set; }
        public string? Motivo { get; set; }
        public string? Codigo { get; set; }
        public string? Producto { get; set; }
        public string? Unidad { get; set; }
        public double StockSistema { get; set; }
    }

    private static DatosAjusteGuardado? LeerDatos(SolicitudDatos s)
    {
        if (string.IsNullOrEmpty(s.DatosOperacion)) return null;
        try
        {
            var d = System.Text.Json.JsonSerializer.Deserialize<DatosAjusteGuardado>(s.DatosOperacion, Json);
            return d is { IdProducto: > 0 } ? d : null;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private SolicitudDatos? EnCursoDe(int id) => enCurso
        .Where(s => s.Id != retomada?.Id && s.Estado is "PENDIENTE" or "APROBADA")
        .FirstOrDefault(s => LeerDatos(s)?.IdProducto == id);

    private void AlCambiarAutorizacion(string? estado)
    {
        estadoAutorizacion = estado;
        if (estado is null)
        {
            retomada = null;   // se descartó la solicitud: el ajuste se vuelve a preparar
        }
    }

    // ---------------- autorización y registro ----------------

    // RF014: pide la autorización de ESTE ajuste (mismo cuerpo que registrarlo) y guarda la pantalla para retomarla
    private Task<SolicitudDatos?> Solicitar()
    {
        intento = true;
        error = null;
        var p = Producto!;
        var datos = new DatosAjusteGuardado
        {
            IdProducto = idProducto, CantidadContada = contado ?? 0, Motivo = motivo.Trim(),
            Codigo = p.CodigoInterno, Producto = p.Nombre, Unidad = TextosAlmacen.Unidad(p.UnidadVenta), StockSistema = p.StockActual
        };
        return Api.Post<SolicitudDatos>("almacen/ajustes/solicitar", new
        {
            idProducto, cantidadContada = contado, motivo = motivo.Trim(),
            datosOperacion = System.Text.Json.JsonSerializer.Serialize(datos, Json)
        });
    }

    private async Task Guardar()
    {
        intento = true;
        error = null;
        if (Errores().Count > 0) return;
        guardando = true;
        try
        {
            await Api.Post<object>("almacen/ajustes", new { idProducto, cantidadContada = contado, motivo = motivo.Trim() });
            Nav.NavigateTo(AvisoGuardado.Ruta("/almacen/movimientos", "ajuste", $"{Producto!.CodigoInterno} · {Producto.Nombre}"));
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}

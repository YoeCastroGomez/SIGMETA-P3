@page "/almacen/movimientos"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Almacenero,Administrador")]
@inject ApiJava Api
@using SigmetaWeb.Components.Pages.Seguridad

<PageTitle>Movimientos de almacén · SIGMETA</PageTitle>

@* RF012 · Movimientos de inventario de todos los productos, con filtros.
   GET /api/almacen/kardex?desde=&hasta=&tipo= · POST /api/almacen/ajustes/{id}/revertir (Almacenero con autorización)
   · PUT /api/almacen/movimientos/{id}/motivo (Administrador). *@
<Encabezado Rf="RF012" Titulo="Movimientos de almacén"
            Subtitulo="Los movimientos no se borran: lo que deja de valer se revierte con el movimiento contrario.">
    @if (EsAlmacenero)
    {
        <a class="btn btn-primary" href="/almacen/ajuste">Ajuste por conteo físico</a>
    }
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<AvisoExito Mensaje="@exito" AlCerrar="() => exito = null" />

<Confirmacion Visible="@(enAccion is not null)" Titulo="@(accion == "revertir" ? "Revertir ajuste" : "Corregir motivo")"
              TextoConfirmar="@(accion == "revertir" ? "Revertir" : "Guardar")"
              ClaseConfirmar="@(accion == "revertir" ? "btn-danger" : "btn-primary")"
              AlConfirmar="Confirmar" AlCancelar="() => enAccion = null">
    @if (accion == "revertir")
    {
        <p class="mb-2">Se registrará el movimiento contrario al ajuste de <strong>@Formato.Cantidad(enAccion?.Cantidad)</strong>
            en <strong>@enAccion?.Producto</strong>. Necesita la autorización del Administrador para este ajuste: si aún no la tienes, se le pide con estos datos.</p>
    }
    else
    {
        <p class="mb-2">Solo se corrige el texto del motivo. Las cantidades de un movimiento no se editan.</p>
    }
    <Campo Etiqueta="Motivo" Id="motivoMov" Obligatorio="true" Error="@errorMotivo">
        <textarea id="motivoMov" class="form-control" rows="2" maxlength="255" @bind="motivo" @bind:event="oninput"></textarea>
    </Campo>
</Confirmacion>

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Tipo de movimiento" Id="fTipo" Clase="col-md-4">
            <select id="fTipo" class="form-select" @bind="tipo">
                <option value="">Todos</option>
                @foreach (var t in TextosAlmacen.TiposMovimiento)
                {
                    <option value="@t">@TextosAlmacen.Movimiento(t)</option>
                }
            </select>
        </Campo>
        <Campo Etiqueta="Desde" Id="fDesde" Clase="col-sm-6 col-md-2">
            <input id="fDesde" type="date" class="form-control" @bind="desde" />
        </Campo>
        <Campo Etiqueta="Hasta" Id="fHasta" Clase="col-sm-6 col-md-2">
            <input id="fHasta" type="date" class="form-control" @bind="hasta" />
        </Campo>
        <Campo Etiqueta="Producto" Id="fTexto" Clase="col-md">
            <input id="fTexto" class="form-control" maxlength="100" placeholder="Código o nombre" @bind="texto" @bind:event="oninput" @bind:after="() => paginaActual = 1" />
        </Campo>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark" disabled="@cargando">Buscar</button>
        </div>
    </form>
</div>

@* RF014: ajustes por conteo que esperan (o ya tienen) la autorización del Administrador. Todavía no son
   movimientos: se registran desde aquí con la misma autorización. GET /api/solicitudes/en-curso *@
@if (porRegistrar.Count > 0)
{
    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-0">Ajustes por registrar</h2>
        </div>
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table align-middle mb-0 tabla-lista">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Contado</th>
                        <th>Diferencia</th>
                        <th>Motivo</th>
                        <th>Autorización</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in porRegistrar)
                    {
                        <tr @key="s.Id">
                            <td>
                                <span class="fw-semibold">@s.Referencia</span>
                                <div class="sub">Pedido @TextosSeguridad.Hace(s.FechaSolicitud)</div>
                            </td>
                            <td class="text-end text-nowrap">@Contado(s)</td>
                            <td class="text-nowrap">@Diferencia(s)</td>
                            <td class="small" style="max-width: 240px;">@s.Motivo</td>
                            <td>
                                <Estado Texto="@Ajuste.EstadoAjuste(s)" />
                                @if (s.Vigente)
                                {
                                    <div class="sub">Hasta @Formato.FechaHora(s.FechaVencimiento)</div>
                                }
                            </td>
                            <td class="acciones">
                                <AccionesFila Principal="@PrincipalPorRegistrar(s)" Otras="@SecundariasPorRegistrar(s)"
                                              Ocupado="@trabajando" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (movimientos is null)
{
    <p class="text-muted">Cargando movimientos...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Producto</th>
                        <th>Movimiento</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Saldo</th>
                        <th>Detalle</th>
                        <th>Usuario</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtrados.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay movimientos con ese filtro.</td></tr>
                    }
                    @foreach (var m in Pagina)
                    {
                        <tr>
                            <td class="text-nowrap">@Formato.FechaHora(m.FechaMovimiento)</td>
                            <td><a href="@($"/almacen/kardex/{m.IdProducto}")" class="text-decoration-none"><strong>@m.CodigoInterno</strong></a>
                                <div class="small text-muted">@m.Producto</div></td>
                            <td>@TextosAlmacen.Movimiento(m.Tipo)
                                @if (m.Revertido == 1)
                                {
                                    <div><Estado Texto="Revertido" /></div>
                                }
                            </td>
                            <td class="text-end text-nowrap @(m.EsEntrada ? "text-success-emphasis" : "text-danger-emphasis")">
                                @(m.EsEntrada ? "+" : "−")@Formato.Cantidad(m.Cantidad) @TextosAlmacen.Unidad(m.UnidadVenta)
                            </td>
                            <td class="text-end">@Formato.Cantidad(m.StockResultante)</td>
                            <td class="small" style="max-width: 260px;">@m.Motivo</td>
                            <td>@m.Usuario</td>
                            <td class="text-end">
                                @if (AccionesMovimiento(m) is { Count: > 0 } acciones)
                                {
                                    <AccionesFila Otras="@acciones" AlElegir="Ejecutar" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@Filtrados.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
    @if (movimientos.Count >= 500)
    {
        <p class="small text-muted">Se muestran los 500 movimientos más recientes. Usa las fechas para ver los anteriores.</p>
    }
}


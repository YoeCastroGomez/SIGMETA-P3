@page "/almacen/movimientos"
@using SigmetaWeb.Components.Pages.Compras

@* RF012 - Movimientos de inventario.
   Solo presentación visual para el Laboratorio 9. Son los mismos movimientos del Kardex;
   Revertir agrega un movimiento compensatorio solo en esta pantalla (no modifica el inventario). *@

<PageTitle>Movimientos de almacén · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Movimientos de almacén"
            Subtitulo="Historial de entradas, salidas y reversiones de inventario." />

<div class="alert alert-secondary">
    Los movimientos de inventario se conservan en el historial.
    Una operación incorrecta se corrige mediante un movimiento
    de reversión, sin eliminar el movimiento original.
    En esta demostración la reversión no se guarda: al recargar la página vuelve a mostrarse el historial original.
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Stock resultante</th>
                    <th>Referencia</th>
                    <th>Usuario</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var m in historial)
                {
                    <tr>
                        <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@MuestrasCompras.NombreProducto(m.CodigoInterno)</td>
                        <td><Estado Texto="@m.Tipo" /></td>
                        <td>@m.Cantidad.ToString("0.###")</td>
                        <td>@m.StockResultante.ToString("0.###")</td>
                        <td>@m.Referencia</td>
                        <td>@m.Usuario</td>
                        <td class="text-end">
                            @if (m.Tipo == "REVERSION")
                            {
                                <span class="text-muted small">Movimiento compensatorio</span>
                            }
                            else if (revertidos.Contains(m.Id))
                            {
                                <Estado Texto="Revertido" />
                            }
                            else if (m.Referencia == "Saldo inicial")
                            {
                                <span class="text-muted small">No reversible</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => Revertir(m)">
                                    Revertir
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private readonly HashSet<int> revertidos = new();

    // Más reciente primero. Las reversiones agregadas en pantalla quedan arriba.
    private List<MovimientoFila> historial =
        MuestrasCompras.Movimientos.OrderByDescending(m => m.Fecha).ThenByDescending(m => m.Id).ToList();

    private void Revertir(MovimientoFila original)
    {
        // El stock resultante parte del último movimiento del producto en la lista.
        var stockActual = historial.First(m => m.CodigoInterno == original.CodigoInterno).StockResultante;
        var stock = original.Tipo == "ENTRADA" ? stockActual - original.Cantidad : stockActual + original.Cantidad;

        revertidos.Add(original.Id);
        historial.Insert(0, new MovimientoFila(
            historial.Max(m => m.Id) + 1, new DateOnly(2026, 10, 27), original.CodigoInterno,
            "REVERSION", original.Cantidad, stock, $"Reversión de {original.Referencia}", "admin"));
    }
}

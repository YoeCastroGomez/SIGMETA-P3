@using SigmetaWeb.Components.Pages.Catalogo
﻿@page "/almacen/movimientos"

@* RF012 - Movimientos de inventario.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Movimientos de almacén · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Movimientos de almacén"
            Subtitulo="Historial de entradas, salidas y reversiones de inventario." />

<div class="alert alert-secondary">
    Los movimientos de inventario se conservan en el historial.
    Una operación incorrecta se corrige mediante un movimiento
    de reversión, sin eliminar el movimiento original.
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Stock resultante</th>
                    <th>Referencia</th>
                    <th>Usuario</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @* Datos de muestra coherentes con el catálogo y las recepciones:
                   COMP-001 aún no recibida: no genera entrada.
                   COMP-002: 4 alicates solicitados, 1 recibido y 3 pendientes.
                   El inventario inicial explica las existencias anteriores a estas compras. *@
                <tr>
                    <td>26/10/2026</td>
                    <td>@MuestrasCatalogo.Productos[1].Nombre</td>
                    <td><Estado Texto="ENTRADA" /></td>
                    <td>1</td>
                    <td>50</td>
                    <td><a href="/compras/editar/2" title="Consultar compra COMP-002">REC-COMP-002</a></td>
                    <td>lpaucar</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-danger">Revertir</button></td>
                </tr>
                <tr>
                    <td>21/10/2026</td>
                    <td>@MuestrasCatalogo.Productos[1].Nombre</td>
                    <td><Estado Texto="ENTRADA" /></td>
                    <td>49</td>
                    <td>49</td>
                    <td>INV-INICIAL-INT-002</td>
                    <td>lpaucar</td>
                    <td class="text-end">—</td>
                </tr>
                <tr>
                    <td>19/10/2026</td>
                    <td>@MuestrasCatalogo.Productos[0].Nombre</td>
                    <td><Estado Texto="ENTRADA" /></td>
                    <td>100</td>
                    <td>100</td>
                    <td>INV-INICIAL-INT-001</td>
                    <td>lpaucar</td>
                    <td class="text-end">—</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@using SigmetaWeb.Components.Pages.Catalogo
﻿@page "/almacen/stock-minimo"

@* RF012 - Consulta de productos con stock mínimo.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Stock mínimo · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Productos con stock mínimo"
            Subtitulo="Productos cuyo stock actual es menor o igual al mínimo establecido." />

<div class="alert alert-secondary">
    Se muestran únicamente los productos cuyo stock alcanzó el mínimo o está por debajo.
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Stock actual</th>
                    <th>Stock mínimo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var producto in MuestrasCatalogo.Productos.Where(p => p.Activo && p.StockActual <= p.StockMinimo))
                {
                    <tr>
                        <td>@producto.CodigoInterno</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.StockActual</td>
                        <td>@producto.StockMinimo</td>
                        <td><span class="badge bg-danger">Bajo el mínimo</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="@($"/almacen/kardex/{producto.Id}")">Ver Kardex</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="alert alert-secondary">
    Los datos mostrados son de demostración.
    La consulta real del inventario se integrará posteriormente
    con los servicios Java.
</div>

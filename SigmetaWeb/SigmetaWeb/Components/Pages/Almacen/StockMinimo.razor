@page "/almacen/stock-minimo"
@using SigmetaWeb.Components.Pages.Catalogo

@* RF012 - Consulta de productos con stock mínimo.
   Solo presentación visual para el Laboratorio 9. Las existencias y mínimos vienen del Catálogo. *@

<PageTitle>Stock mínimo · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Productos con stock mínimo"
            Subtitulo="Productos cuyo stock actual es menor o igual al mínimo establecido." />

<div class="alert alert-secondary">
    Los productos mostrados requieren atención porque su
    stock actual alcanzó o está por debajo del mínimo.
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Stock actual</th>
                    <th>Stock mínimo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Paginar(MuestrasCatalogo.Productos.Where(p => p.Activo && p.StockActual <= p.StockMinimo), paginaActual, tamanoPagina))
                {
                    <tr>
                        <td>@p.CodigoInterno</td>
                        <td>@p.Nombre</td>
                        <td>@p.StockActual.ToString("0.###")</td>
                        <td>@p.StockMinimo.ToString("0.###")</td>
                        <td>
                            @if (p.StockActual < p.StockMinimo)
                            {
                                <Estado Texto="Bajo el mínimo" />
                            }
                            else
                            {
                                <Estado Texto="En el mínimo" />
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/almacen/kardex/@p.Id">
                                Ver Kardex
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
        <Paginacion TotalRegistros="@(MuestrasCatalogo.Productos.Where(p => p.Activo && p.StockActual <= p.StockMinimo).Count())" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
</div>

<div class="alert alert-secondary">
    Los datos mostrados son de demostración.
    La consulta real del inventario se integrará posteriormente
    con los servicios Java.
</div>

@code {
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T> registros, int pagina, int tamano)
    {
        if (tamano == 0) return registros;
        int total = registros.Count();
        int segura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((segura - 1) * tamano).Take(tamano);
    }
}

@page "/almacen/kardex"
@page "/almacen/kardex/{Id:int}"
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Kardex · SIGMETA</PageTitle>

@* RF012 · Kardex de un producto: cada entrada y salida con el saldo que dejó. Consulta de los cuatro roles.
   GET /api/almacen/existencias · GET /api/almacen/kardex?producto=&desde=&hasta= *@
<Encabezado Rf="RF012" Titulo="Kardex"
            Subtitulo="Historial de entradas y salidas de un producto. El stock solo cambia con estos movimientos." />

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Producto" Id="fProducto" Clase="col-md-6">
            <select id="fProducto" class="form-select" @bind="idProducto" @bind:after="AlElegir">
                <option value="0">Elige un producto</option>
                @foreach (var p in existencias)
                {
                    <option value="@p.Id">@p.CodigoInterno · @p.Nombre</option>
                }
            </select>
        </Campo>
        <Campo Etiqueta="Desde" Id="fDesde" Clase="col-sm-6 col-md-2">
            <input id="fDesde" type="date" class="form-control" @bind="desde" />
        </Campo>
        <Campo Etiqueta="Hasta" Id="fHasta" Clase="col-sm-6 col-md-2">
            <input id="fHasta" type="date" class="form-control" @bind="hasta" />
        </Campo>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark" disabled="@(cargando || idProducto == 0)">Buscar</button>
        </div>
    </form>
</div>

@if (Producto is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">En almacén</div>
                <div class="h4 fw-bold mb-0">@Formato.Cantidad(Producto.StockActual) <span class="small text-muted fw-normal">@TextosAlmacen.Unidad(Producto.UnidadVenta)</span></div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Comprometido</div>
                <div class="h4 fw-bold mb-0">@Formato.Cantidad(Producto.Comprometido)</div>
                <div class="small text-muted">vendido sin despachar</div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Disponible para vender</div>
                <div class="h4 fw-bold mb-0 @(Producto.Disponible <= 0 ? "text-danger" : "")">@Formato.Cantidad(Producto.Disponible)</div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Stock mínimo</div>
                <div class="h4 fw-bold mb-0">@Formato.Cantidad(Producto.StockMinimo)</div>
                <div><Estado Texto="@Producto.Situacion" /></div>
            </div>
        </div>
        <div class="col-12 col-lg">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Costo promedio</div>
                <div class="h4 fw-bold mb-0">@Formato.Soles(Producto.CostoUnitario)</div>
                <div class="small text-muted">valor en almacén @Formato.Soles(Producto.StockActual * Producto.CostoUnitario)</div>
            </div>
        </div>
    </div>
}

@if (idProducto == 0)
{
    <div class="card card-body text-center text-muted py-5">Elige un producto para ver su kardex.</div>
}
else if (movimientos is null)
{
    <p class="text-muted">Cargando movimientos...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Movimiento</th>
                        <th>Detalle</th>
                        <th class="text-end">Entrada</th>
                        <th class="text-end">Salida</th>
                        <th class="text-end">Saldo</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (movimientos.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">El producto no tiene movimientos en ese periodo.</td></tr>
                    }
                    @foreach (var m in Pagina)
                    {
                        <tr>
                            <td class="text-nowrap">@Formato.FechaHora(m.FechaMovimiento)</td>
                            <td><Estado Texto="@(m.EsEntrada ? "Entrada" : "Salida")" /> <span class="ms-1">@TextosAlmacen.Movimiento(m.Tipo)</span></td>
                            <td class="small" style="max-width: 300px;">@m.Motivo</td>
                            <td class="text-end">@(m.EsEntrada ? Formato.Cantidad(m.Cantidad) : "")</td>
                            <td class="text-end">@(m.EsEntrada ? "" : Formato.Cantidad(m.Cantidad))</td>
                            <td class="text-end fw-semibold">@Formato.Cantidad(m.StockResultante)</td>
                            <td>@m.Usuario</td>
                        </tr>
                    }
                </tbody>
                @if (movimientos.Count > 0)
                {
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Totales del periodo</th>
                            <th class="text-end">@Formato.Cantidad(movimientos.Where(m => m.EsEntrada).Sum(m => m.Cantidad))</th>
                            <th class="text-end">@Formato.Cantidad(movimientos.Where(m => !m.EsEntrada).Sum(m => m.Cantidad))</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
        <Paginacion TotalRegistros="@movimientos.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
    @if (movimientos.Count >= 500)
    {
        <p class="small text-muted">Se muestran los 500 movimientos más recientes. Acorta el periodo para ver los anteriores.</p>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private List<ExistenciaFila> existencias = new();
    private List<MovimientoFila>? movimientos;
    private int idProducto;
    private DateTime? desde;
    private DateTime? hasta;
    private bool cargando;
    private string? error;
    private int paginaActual = 1;
    private int tamanoPagina = 25;

    private ExistenciaFila? Producto => existencias.FirstOrDefault(p => p.Id == idProducto);
    private IEnumerable<MovimientoFila> Pagina => tamanoPagina == 0 ? movimientos!
        : movimientos!.Skip((Math.Max(paginaActual, 1) - 1) * tamanoPagina).Take(tamanoPagina);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (existencias.Count == 0)
            {
                existencias = await Api.Get<List<ExistenciaFila>>("almacen/existencias") ?? new();
            }
            idProducto = Id ?? 0;
            movimientos = null;
            if (idProducto != 0)
            {
                await Buscar();
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    // al elegir otro producto cambia la dirección: así el kardex de un producto se puede enlazar
    private void AlElegir() => Nav.NavigateTo(idProducto == 0 ? "/almacen/kardex" : $"/almacen/kardex/{idProducto}");

    private async Task Buscar()
    {
        if (idProducto == 0) return;
        error = null;
        if (desde is not null && hasta is not null && desde > hasta)
        {
            error = "La fecha de inicio no puede ser posterior a la fecha de fin.";
            return;
        }
        cargando = true;
        try
        {
            movimientos = await Api.Get<List<MovimientoFila>>(
                $"almacen/kardex?producto={idProducto}&desde={Formato.Iso(desde)}&hasta={Formato.Iso(hasta)}") ?? new();
            paginaActual = 1;
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            movimientos ??= new();
        }
        finally
        {
            cargando = false;
        }
    }
}

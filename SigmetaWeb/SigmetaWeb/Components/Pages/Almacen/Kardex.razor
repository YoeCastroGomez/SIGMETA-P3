@page "/almacen/kardex"
@page "/almacen/kardex/{Id:int}"

@* RF012 - Kardex de inventario.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Kardex · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Kardex de inventario"
            Subtitulo="Consulta de movimientos y stock por producto." />

@if (Id is null)
{
    @* Primera vista: seleccionar producto *@

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">
            Buscar producto
        </h2>

        <div class="row g-3 align-items-end">
            <Campo Etiqueta="Código o nombre"
                   Id="buscarProducto"
                   Clase="col-sm-6 col-md-6">
                <input id="buscarProducto"
                       class="form-control"
                       placeholder="Buscar producto" />
            </Campo>

            <div class="col-auto">
                <button class="btn btn-dark">
                    Buscar
                </button>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Stock actual</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>PROD-001</td>
                        <td>Taladro industrial</td>
                        <td>30</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/almacen/kardex/1">
                                Ver Kardex
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>PROD-002</td>
                        <td>Martillo de acero</td>
                        <td>15</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/almacen/kardex/2">
                                Ver Kardex
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    @* Segunda vista: historial del producto *@

    <div class="card card-body mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="small text-muted text-uppercase">
                    Producto seleccionado
                </div>

                <div class="fw-semibold">
                    @NombreProducto
                </div>
            </div>

            <a class="btn btn-outline-secondary"
               href="/almacen/kardex">
                Cambiar producto
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th>Stock resultante</th>
                        <th>Referencia</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>20/10/2026</td>
                        <td><Estado Texto="ENTRADA" /></td>
                        <td>20</td>
                        <td>—</td>
                        <td>20</td>
                        <td>COMP-001</td>
                    </tr>

                    <tr>
                        <td>23/10/2026</td>
                        <td><Estado Texto="SALIDA" /></td>
                        <td>—</td>
                        <td>5</td>
                        <td>15</td>
                        <td>VENT-001</td>
                    </tr>

                    <tr>
                        <td>26/10/2026</td>
                        <td><Estado Texto="ENTRADA" /></td>
                        <td>10</td>
                        <td>—</td>
                        <td>25</td>
                        <td>REC-002</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert alert-secondary">
        Los movimientos se muestran en orden cronológico.
        Cada operación conserva su registro histórico.
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    // Datos ficticios para la demostración del Lab 9.
    private string NombreProducto =>
        Id == 2 ? "Martillo de acero" : "Taladro industrial";
}

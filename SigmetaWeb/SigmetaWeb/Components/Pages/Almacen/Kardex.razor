@page "/almacen/kardex"
@page "/almacen/kardex/{Id:int}"
@using SigmetaWeb.Components.Pages.Catalogo
@using SigmetaWeb.Components.Pages.Compras

@* RF012 - Kardex de inventario.
   Solo presentación visual para el Laboratorio 9. Usa los productos del Catálogo
   (mismos códigos y existencias) y los movimientos de MuestrasCompras. *@

<PageTitle>Kardex · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Kardex de inventario"
            Subtitulo="Consulta de movimientos y stock por producto." />

@if (Id is null)
{
    @* Primera vista: seleccionar producto *@

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">
            Buscar producto
        </h2>

        <div class="row g-3 align-items-end">
            <Campo Etiqueta="Código o nombre"
                   Id="buscarProducto"
                   Clase="col-sm-6 col-md-6">
                <input id="buscarProducto"
                       class="form-control"
                       placeholder="Buscar producto"
                       @bind="filtro" @bind:event="oninput" />
            </Campo>

            <div class="col-auto">
                <button class="btn btn-dark" @onclick="Buscar">
                    Buscar
                </button>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Stock actual</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in resultado)
                    {
                        <tr>
                            <td>@p.CodigoInterno</td>
                            <td>@p.Nombre</td>
                            <td>@p.StockActual.ToString("0.###")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="/almacen/kardex/@p.Id">
                                    Ver Kardex
                                </a>
                            </td>
                        </tr>
                    }
                    @if (resultado.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No hay productos que coincidan con la búsqueda.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    @* Segunda vista: historial del producto *@

    <div class="card card-body mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="small text-muted text-uppercase">
                    Producto seleccionado
                </div>

                <div class="fw-semibold">
                    @producto?.CodigoInterno · @producto?.Nombre
                </div>
                <div class="small text-muted">
                    Stock actual: @producto?.StockActual.ToString("0.###")
                </div>
            </div>

            <a class="btn btn-outline-secondary"
               href="/almacen/kardex">
                Cambiar producto
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th>Stock resultante</th>
                        <th>Referencia</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var m in movimientos)
                    {
                        <tr>
                            <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                            <td><Estado Texto="@m.Tipo" /></td>
                            <td>@(m.Tipo == "ENTRADA" ? m.Cantidad.ToString("0.###") : "—")</td>
                            <td>@(m.Tipo == "SALIDA" ? m.Cantidad.ToString("0.###") : "—")</td>
                            <td>@m.StockResultante.ToString("0.###")</td>
                            <td>@m.Referencia</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert alert-secondary">
        Los movimientos se muestran en orden cronológico.
        Cada operación conserva su registro histórico.
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private string filtro = "";
    private List<ProductoFila> resultado = MuestrasCatalogo.Productos.ToList();
    private ProductoFila? producto;
    private List<MovimientoFila> movimientos = new();

    protected override void OnParametersSet()
    {
        producto = MuestrasCatalogo.Productos.FirstOrDefault(p => p.Id == Id);
        movimientos = producto is null
            ? new()
            : MuestrasCompras.MovimientosDe(producto.CodigoInterno).ToList();
    }

    private void Buscar()
    {
        var texto = filtro.Trim();
        resultado = MuestrasCatalogo.Productos
            .Where(p => texto.Length == 0
                        || p.CodigoInterno.Contains(texto, StringComparison.OrdinalIgnoreCase)
                        || p.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}

@using SigmetaWeb.Components.Pages.Catalogo
@page "/almacen/kardex"
@page "/almacen/kardex/{Id:int}"

@* RF012 - Kardex de inventario.
   Solo presentación visual para el Laboratorio 9. *@

<PageTitle>Kardex · SIGMETA</PageTitle>

<Encabezado Rf="RF012"
            Titulo="Kardex de inventario"
            Subtitulo="Consulta de movimientos y stock por producto." />

@if (Id is null)
{
    @* Primera vista: seleccionar producto *@

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">
            Buscar producto
        </h2>

        <div class="row g-3 align-items-end">
            <Campo Etiqueta="Código o nombre"
                   Id="buscarProducto"
                   Clase="col-sm-6 col-md-6">
                <input id="buscarProducto"
                       class="form-control"
                       placeholder="Buscar producto" @bind="busquedaTexto" />
            </Campo>

            <div class="col-auto">
                <button class="btn btn-dark" @onclick="Buscar">
                    Buscar
                </button>
                <button class="btn btn-outline-secondary ms-2" @onclick="Limpiar">Limpiar</button>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Stock actual</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var producto in ProductosFiltrados)
                    {
                        <tr>
                            <td>@producto.CodigoInterno</td>
                            <td>@producto.Nombre</td>
                            <td>@producto.StockActual</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="@($"/almacen/kardex/{producto.Id}")">Ver Kardex</a></td>
                        </tr>
                    }
                    @if (ProductosFiltrados.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No se encontraron productos.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    @* Segunda vista: historial del producto *@

    <div class="card card-body mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="small text-muted text-uppercase">
                    Producto seleccionado
                </div>

                <div class="fw-semibold">
                    @NombreProducto
                </div>
            </div>

            <a class="btn btn-outline-secondary"
               href="/almacen/kardex">
                Cambiar producto
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th>Stock resultante</th>
                        <th>Referencia</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Id == 1)
                    {
                        <tr><td>19/10/2026</td><td><Estado Texto="ENTRADA" /></td><td>100</td><td>—</td><td>100</td><td>INV-INICIAL-INT-001</td></tr>
                    }
                    else if (Id == 2)
                    {
                        <tr><td>21/10/2026</td><td><Estado Texto="ENTRADA" /></td><td>49</td><td>—</td><td>49</td><td>INV-INICIAL-INT-002</td></tr>
                        <tr><td>26/10/2026</td><td><Estado Texto="ENTRADA" /></td><td>1</td><td>—</td><td>50</td><td><a href="/compras/editar/2" title="Consultar compra COMP-002">REC-COMP-002</a></td></tr>
                    }
                    else if (Id == 3 || Id == 4 || Id == 5)
                    {
                        <tr><td>19/10/2026</td><td><Estado Texto="ENTRADA" /></td><td>@ProductoSeleccionado?.StockActual</td><td>—</td><td>@ProductoSeleccionado?.StockActual</td><td>INV-INICIAL-@ProductoSeleccionado?.CodigoInterno</td></tr>
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Producto no encontrado.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert alert-secondary">
        Los movimientos se muestran en orden cronológico.
        Cada operación conserva su registro histórico.
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    // Filtro local para la demostración del Lab 9.
    private string busquedaTexto = "";
    private string busquedaAplicada = "";
    private List<ProductoFila> ProductosFiltrados => MuestrasCatalogo.Productos
        .Where(p => p.Activo && (string.IsNullOrWhiteSpace(busquedaAplicada)
            || p.Nombre.Contains(busquedaAplicada.Trim(), StringComparison.OrdinalIgnoreCase)
            || p.CodigoInterno.Contains(busquedaAplicada.Trim(), StringComparison.OrdinalIgnoreCase)))
        .ToList();
    private void Buscar() => busquedaAplicada = busquedaTexto;
    private void Limpiar() => busquedaTexto = busquedaAplicada = "";

    // Datos ficticios para la demostración del Lab 9.
    private ProductoFila? ProductoSeleccionado =>
        MuestrasCatalogo.Productos.FirstOrDefault(p => p.Id == Id);

    private string NombreProducto => ProductoSeleccionado?.Nombre ?? "Producto no encontrado";
}

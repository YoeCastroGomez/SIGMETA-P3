@* RF015 · Reporte de abastecimiento: compras, rotación y valor del inventario. Parte de la página Reportes (/reportes): solo muestra los datos que recibe. *@
@using SigmetaWeb.Components.Pages.Almacen
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted">Comprado en el periodo</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(Datos.Compras.Sum(c => c.Total))</div>
                <div class="small text-muted">@Datos.Compras.Sum(c => c.Compras).ToString("N0") compras</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted">Compras por recibir</div>
                <div class="h5 fw-bold mb-0">@Datos.Compras.Sum(c => c.PorRecibir).ToString("N0")</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted">Inventario al costo promedio</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(Datos.Inventario.Sum(i => i.ValorCosto))</div>
                <div class="small text-muted">a precio de venta @Formato.Soles(Datos.Inventario.Sum(i => i.ValorVenta))</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted">Productos en su mínimo</div>
                <div class="h5 fw-bold mb-0">@Datos.Inventario.Sum(i => i.EnMinimo).ToString("N0")</div>
                <div class="small"><a href="/almacen/stock-minimo">Ver cuáles</a></div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Compras a proveedores</h2></div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Proveedor</th><th>RUC</th><th class="text-end">Compras</th><th class="text-end">Por recibir</th><th class="text-end">Total</th><th style="width: 25%;">% del total comprado</th></tr></thead>
                <tbody>
                    @if (Datos.Compras.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">No hubo compras en el periodo.</td></tr>
                    }
                    @foreach (var c in Datos.Compras)
                    {
                        <tr><td>@c.Proveedor</td><td>@c.Ruc</td><td class="text-end">@c.Compras.ToString("N0")</td><td class="text-end">@c.PorRecibir.ToString("N0")</td><td class="text-end">@c.Total.ToString("N2")</td><td><BarraParticipacion Valor="c.Total" Total="Datos.Compras.Sum(x => x.Total)" /></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body pb-0">
                    <h2 class="h6 fw-semibold mb-1">Productos de mayor movimiento (10 primeros)</h2>
                    <p class="small text-muted mb-3">Unidades despachadas, menos lo devuelto.</p>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Producto</th><th class="text-end">Salieron</th><th class="text-end">En almacén</th><th style="width: 30%;">% de las unidades del top 10</th></tr></thead>
                        <tbody>
                            @if (Datos.MayorMovimiento.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No hubo despachos en el periodo.</td></tr>
                            }
                            @foreach (var p in Datos.MayorMovimiento)
                            {
                                <tr>
                                    <td><strong>@p.CodigoInterno</strong> <div class="small text-muted">@p.Producto</div></td>
                                    <td class="text-end">@Formato.Cantidad(p.Unidades) @TextosAlmacen.Unidad(p.UnidadVenta)</td>
                                    <td class="text-end">@Formato.Cantidad(p.StockActual)</td>
                                    <td><BarraParticipacion Valor="p.Unidades" Total="Datos.MayorMovimiento.Sum(x => x.Unidades)" Color="bg-info" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body pb-0">
                    <h2 class="h6 fw-semibold mb-1">Productos sin movimiento</h2>
                    <p class="small text-muted mb-3">Con existencias y sin ninguna salida en el periodo: capital inmovilizado.</p>
                </div>
                <div class="table-responsive" style="max-height: 420px;">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Producto</th><th class="text-end">En almacén</th><th class="text-end">Valor al costo</th><th>Última salida</th></tr></thead>
                        <tbody>
                            @if (Datos.SinMovimiento.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Todos los productos con stock tuvieron salidas.</td></tr>
                            }
                            @foreach (var p in Datos.SinMovimiento)
                            {
                                <tr>
                                    <td><strong>@p.CodigoInterno</strong> <div class="small text-muted">@p.Producto</div></td>
                                    <td class="text-end">@Formato.Cantidad(p.StockActual)</td>
                                    <td class="text-end">@p.ValorInmovilizado.ToString("N2")</td>
                                    <td class="text-nowrap">@(p.UltimaSalida is null ? "Nunca" : Formato.Fecha(p.UltimaSalida))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-1">Inventario valorizado por categoría</h2>
            <p class="small text-muted mb-3">Existencias de hoy al costo promedio ponderado.</p>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Categoría</th><th class="text-end">Productos</th><th class="text-end">En su mínimo</th><th class="text-end">Valor al costo</th><th class="text-end">Valor a precio de venta</th><th style="width: 22%;">% del valor al costo</th></tr></thead>
                <tbody>
                    @foreach (var i in Datos.Inventario)
                    {
                        <tr><td>@i.Categoria</td><td class="text-end">@i.Productos.ToString("N0")</td><td class="text-end">@i.EnMinimo.ToString("N0")</td><td class="text-end">@i.ValorCosto.ToString("N2")</td><td class="text-end">@i.ValorVenta.ToString("N2")</td><td><BarraParticipacion Valor="i.ValorCosto" Total="Datos.Inventario.Sum(x => x.ValorCosto)" Color="bg-success" /></td></tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th>Total</th>
                        <th class="text-end">@Datos.Inventario.Sum(i => i.Productos).ToString("N0")</th>
                        <th class="text-end">@Datos.Inventario.Sum(i => i.EnMinimo).ToString("N0")</th>
                        <th class="text-end">@Datos.Inventario.Sum(i => i.ValorCosto).ToString("N2")</th>
                        <th class="text-end">@Datos.Inventario.Sum(i => i.ValorVenta).ToString("N2")</th>
                        <th>100 %</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    @Barra("Reporte de abastecimiento e inventario", "Compras y rotación de productos")

@code {
    [Parameter, EditorRequired] public ReporteAbastecimiento Datos { get; set; } = default!;
    // barra con el título y los botones de descarga (PDF, Excel y XML) que arma la página
    [Parameter, EditorRequired] public Func<string, string, RenderFragment> Barra { get; set; } = default!;
}

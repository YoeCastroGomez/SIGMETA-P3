@page "/reportes"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Administrador")]
@inject ApiJava Api
@inject IJSRuntime JS
@using SigmetaWeb.Components.Pages.Almacen

<PageTitle>Reportes · SIGMETA</PageTitle>

@* RF015 · Reportes del Administrador sobre un periodo: comercial (ventas y crédito), abastecimiento e inventario, y caja.
   GET /api/reportes/comercial|abastecimiento|caja?desde=&hasta=. Las sumas vienen hechas de la base (RNF003).
   Descargar PDF: GET /api/reportes/{tipo}/pdf?desde=&hasta=. El PDF lo genera el Java con JasperReports
   (plantillas .jrxml en sigmeta-services/src/main/resources/reports) y aquí solo se descarga. *@

<Encabezado Rf="RF015" Titulo="Reportes" Subtitulo="Reportes comercial, de abastecimiento e inventario y de caja. Importes en soles (S/).">
    @if (HayReporte)
    {
        <button type="button" class="btn btn-primary" disabled="@(cargando || descargando)" @onclick="DescargarPdf">
            @(descargando ? "Generando PDF..." : "Descargar PDF")
        </button>
        <a class="btn btn-outline-secondary" download="@nombreCsv" href="@("data:text/csv;charset=utf-8,%EF%BB%BF" + Uri.EscapeDataString(csv!))">Exportar a CSV</a>
    }
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Consultar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Desde" Id="fDesde" Obligatorio="true" Clase="col-sm-6 col-md-2">
            <input id="fDesde" type="date" class="form-control" @bind="desde" />
        </Campo>
        <Campo Etiqueta="Hasta" Id="fHasta" Obligatorio="true" Clase="col-sm-6 col-md-2">
            <input id="fHasta" type="date" class="form-control" @bind="hasta" />
        </Campo>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark" disabled="@cargando">Consultar</button>
        </div>
        <div class="col d-flex flex-wrap gap-1 justify-content-md-end">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("hoy"))">Hoy</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("mes"))">Este mes</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("anterior"))">Mes anterior</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("90"))">Últimos 90 días</button>
        </div>
    </form>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(reporte == "comercial" ? "active" : "")" @onclick="@(() => Cambiar("comercial"))">Comercial</button></li>
    <li class="nav-item"><button class="nav-link @(reporte == "abastecimiento" ? "active" : "")" @onclick="@(() => Cambiar("abastecimiento"))">Abastecimiento e inventario</button></li>
    <li class="nav-item"><button class="nav-link @(reporte == "caja" ? "active" : "")" @onclick="@(() => Cambiar("caja"))">Caja</button></li>
</ul>

@if (cargando)
{
    <p class="text-muted">Calculando el reporte...</p>
}
else if (reporte == "comercial" && comercial is not null)
{
    var t = comercial.Totales;
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Ventas al contado</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(t.MontoContado)</div>
                <div class="small text-muted">@t.VentasContado.ToString("N0") ventas</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Ventas al crédito</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(t.MontoCredito)</div>
                <div class="small text-muted">@t.VentasCredito.ToString("N0") ventas</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Venta neta del periodo</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(t.VentaNeta)</div>
                <div class="small text-muted">menos @Formato.Soles(t.MontoNotasCredito) en @t.NotasCredito.ToString("N0") notas de crédito</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Por cobrar a la fecha</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(t.SaldoPorCobrar)</div>
                <div class="small @(t.SaldoVencido > 0 ? "text-danger" : "text-muted")">@Formato.Soles(t.SaldoVencido) vencido</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Ventas por día</h2></div>
        @if (comercial.PorDia.Count == 0)
        {
            <div class="card-body pt-0 text-muted">No hubo ventas en el periodo.</div>
        }
        else
        {
            var maximo = comercial.PorDia.Max(d => d.Total);
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Fecha</th><th class="text-end">Ventas</th><th class="text-end">Subtotal</th><th class="text-end">IGV</th><th class="text-end">Total</th><th style="width: 35%;"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in comercial.PorDia)
                        {
                            <tr>
                                <td class="text-nowrap">@Formato.Fecha(d.Fecha)</td>
                                <td class="text-end">@d.Ventas.ToString("N0")</td>
                                <td class="text-end">@d.SubTotal.ToString("N2")</td>
                                <td class="text-end">@d.Igv.ToString("N2")</td>
                                <td class="text-end fw-semibold">@d.Total.ToString("N2")</td>
                                <td><div class="bg-primary rounded" style="height: 10px; width: @Ancho(d.Total, maximo);" role="img" aria-label="@($"{d.Total:N2} soles")"></div></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th>Total</th>
                            <th class="text-end">@comercial.PorDia.Sum(d => d.Ventas).ToString("N0")</th>
                            <th class="text-end">@comercial.PorDia.Sum(d => d.SubTotal).ToString("N2")</th>
                            <th class="text-end">@comercial.PorDia.Sum(d => d.Igv).ToString("N2")</th>
                            <th class="text-end">@comercial.PorDia.Sum(d => d.Total).ToString("N2")</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Ventas por vendedor</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Vendedor</th><th class="text-end">Ventas</th><th class="text-end">Total</th></tr></thead>
                        <tbody>
                            @if (comercial.PorVendedor.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">Sin ventas en el periodo.</td></tr>
                            }
                            @foreach (var v in comercial.PorVendedor)
                            {
                                <tr><td>@v.Vendedor <span class="small text-muted">(@v.Usuario)</span></td><td class="text-end">@v.Ventas.ToString("N0")</td><td class="text-end">@v.Total.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Clientes que más compraron (10 primeros)</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Cliente</th><th class="text-end">Ventas</th><th class="text-end">Total</th></tr></thead>
                        <tbody>
                            @if (comercial.PorCliente.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">Sin ventas en el periodo.</td></tr>
                            }
                            @foreach (var c in comercial.PorCliente)
                            {
                                <tr><td>@c.Cliente <div class="small text-muted">@c.NumeroDocumento</div></td><td class="text-end">@c.Ventas.ToString("N0")</td><td class="text-end">@c.Total.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-1">Crédito de clientes</h2>
            <p class="small text-muted mb-3">Situación a hoy, no depende del periodo.</p>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Cliente</th><th>Calificación</th><th class="text-end">Límite</th><th class="text-end">Deuda</th><th class="text-end">Vencido</th><th class="text-end">Días de atraso</th><th class="text-end">Disponible</th></tr>
                </thead>
                <tbody>
                    @if (comercial.Credito.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Ningún cliente tiene línea de crédito ni deuda.</td></tr>
                    }
                    @foreach (var c in comercial.Credito)
                    {
                        <tr>
                            <td>@c.Cliente <div class="small text-muted">@c.NumeroDocumento</div></td>
                            <td>@(c.CalificacionCrediticia is null or "SIN_EVALUAR" ? "—" : c.CalificacionCrediticia)</td>
                            <td class="text-end">@c.LimiteCredito.ToString("N2")</td>
                            <td class="text-end">@c.SaldoPendiente.ToString("N2")</td>
                            <td class="text-end @(c.SaldoVencido > 0 ? "text-danger fw-semibold" : "")">@c.SaldoVencido.ToString("N2")</td>
                            <td class="text-end">@(c.DiasAtraso > 0 ? c.DiasAtraso.ToString("N0") : "—")</td>
                            <td class="text-end @(c.CreditoDisponible < 0 ? "text-danger" : "")">@c.CreditoDisponible.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (reporte == "abastecimiento" && abastecimiento is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Comprado en el periodo</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(abastecimiento.Compras.Sum(c => c.Total))</div>
                <div class="small text-muted">@abastecimiento.Compras.Sum(c => c.Compras).ToString("N0") compras</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Compras por recibir</div>
                <div class="h5 fw-bold mb-0">@abastecimiento.Compras.Sum(c => c.PorRecibir).ToString("N0")</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Inventario al costo promedio</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(abastecimiento.Inventario.Sum(i => i.ValorCosto))</div>
                <div class="small text-muted">a precio de venta @Formato.Soles(abastecimiento.Inventario.Sum(i => i.ValorVenta))</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Productos en su mínimo</div>
                <div class="h5 fw-bold mb-0">@abastecimiento.Inventario.Sum(i => i.EnMinimo).ToString("N0")</div>
                <div class="small"><a href="/almacen/stock-minimo">Ver cuáles</a></div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Compras a proveedores</h2></div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Proveedor</th><th>RUC</th><th class="text-end">Compras</th><th class="text-end">Por recibir</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                    @if (abastecimiento.Compras.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">No hubo compras en el periodo.</td></tr>
                    }
                    @foreach (var c in abastecimiento.Compras)
                    {
                        <tr><td>@c.Proveedor</td><td>@c.Ruc</td><td class="text-end">@c.Compras.ToString("N0")</td><td class="text-end">@c.PorRecibir.ToString("N0")</td><td class="text-end">@c.Total.ToString("N2")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body pb-0">
                    <h2 class="h6 fw-semibold mb-1">Productos de mayor movimiento (10 primeros)</h2>
                    <p class="small text-muted mb-3">Unidades despachadas, menos lo devuelto.</p>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Producto</th><th class="text-end">Salieron</th><th class="text-end">En almacén</th></tr></thead>
                        <tbody>
                            @if (abastecimiento.MayorMovimiento.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">No hubo despachos en el periodo.</td></tr>
                            }
                            @foreach (var p in abastecimiento.MayorMovimiento)
                            {
                                <tr>
                                    <td><strong>@p.CodigoInterno</strong> <div class="small text-muted">@p.Producto</div></td>
                                    <td class="text-end">@Formato.Cantidad(p.Unidades) @TextosAlmacen.Unidad(p.UnidadVenta)</td>
                                    <td class="text-end">@Formato.Cantidad(p.StockActual)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body pb-0">
                    <h2 class="h6 fw-semibold mb-1">Productos sin movimiento</h2>
                    <p class="small text-muted mb-3">Con existencias y sin ninguna salida en el periodo: capital inmovilizado.</p>
                </div>
                <div class="table-responsive" style="max-height: 420px;">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Producto</th><th class="text-end">En almacén</th><th class="text-end">Valor al costo</th><th>Última salida</th></tr></thead>
                        <tbody>
                            @if (abastecimiento.SinMovimiento.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Todos los productos con stock tuvieron salidas.</td></tr>
                            }
                            @foreach (var p in abastecimiento.SinMovimiento)
                            {
                                <tr>
                                    <td><strong>@p.CodigoInterno</strong> <div class="small text-muted">@p.Producto</div></td>
                                    <td class="text-end">@Formato.Cantidad(p.StockActual)</td>
                                    <td class="text-end">@p.ValorInmovilizado.ToString("N2")</td>
                                    <td class="text-nowrap">@(p.UltimaSalida is null ? "Nunca" : Formato.Fecha(p.UltimaSalida))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-1">Inventario valorizado por categoría</h2>
            <p class="small text-muted mb-3">Existencias de hoy al costo promedio ponderado.</p>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Categoría</th><th class="text-end">Productos</th><th class="text-end">En su mínimo</th><th class="text-end">Valor al costo</th><th class="text-end">Valor a precio de venta</th></tr></thead>
                <tbody>
                    @foreach (var i in abastecimiento.Inventario)
                    {
                        <tr><td>@i.Categoria</td><td class="text-end">@i.Productos.ToString("N0")</td><td class="text-end">@i.EnMinimo.ToString("N0")</td><td class="text-end">@i.ValorCosto.ToString("N2")</td><td class="text-end">@i.ValorVenta.ToString("N2")</td></tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th>Total</th>
                        <th class="text-end">@abastecimiento.Inventario.Sum(i => i.Productos).ToString("N0")</th>
                        <th class="text-end">@abastecimiento.Inventario.Sum(i => i.EnMinimo).ToString("N0")</th>
                        <th class="text-end">@abastecimiento.Inventario.Sum(i => i.ValorCosto).ToString("N2")</th>
                        <th class="text-end">@abastecimiento.Inventario.Sum(i => i.ValorVenta).ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
else if (reporte == "caja" && caja is not null)
{
    var vigentes = caja.Cierres.Where(c => c.Estado == "VIGENTE").ToList();
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Cierres vigentes</div>
                <div class="h5 fw-bold mb-0">@vigentes.Count</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Cierres revertidos</div>
                <div class="h5 fw-bold mb-0">@(caja.Cierres.Count - vigentes.Count)</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Diferencia neta (vigentes)</div>
                <div class="h5 fw-bold mb-0 @(vigentes.Sum(c => c.Diferencia) < 0 ? "text-danger" : "")">@Formato.Soles(vigentes.Sum(c => c.Diferencia))</div>
                <div class="small text-muted">negativa = faltó dinero</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body h-100">
                <div class="small text-muted text-uppercase">Ingreso neto en cajas</div>
                <div class="h5 fw-bold mb-0">@Formato.Soles(caja.PorMedioPago.Sum(m => m.Neto))</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Dinero por medio de pago</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Medio</th><th class="text-end">Cobros contado</th><th class="text-end">Cobros crédito</th><th class="text-end">Ingresos</th><th class="text-end">Egresos</th><th class="text-end">Neto</th></tr></thead>
                        <tbody>
                            @if (caja.PorMedioPago.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">No hubo movimientos de caja en el periodo.</td></tr>
                            }
                            @foreach (var m in caja.PorMedioPago)
                            {
                                <tr>
                                    <td>@Formato.Legible(m.MedioPago)</td>
                                    <td class="text-end">@m.CobrosContado.ToString("N2")</td>
                                    <td class="text-end">@m.CobrosCredito.ToString("N2")</td>
                                    <td class="text-end">@m.Ingresos.ToString("N2")</td>
                                    <td class="text-end">@m.Egresos.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@m.Neto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Diferencias por cajero</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Cajero</th><th class="text-end">Cierres</th><th class="text-end">Faltantes</th><th class="text-end">Sobrantes</th></tr></thead>
                        <tbody>
                            @if (caja.PorCajero.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Sin cierres vigentes en el periodo.</td></tr>
                            }
                            @foreach (var c in caja.PorCajero)
                            {
                                <tr>
                                    <td>@c.Cajero</td>
                                    <td class="text-end">@c.Cierres.ToString("N0")</td>
                                    <td class="text-end @(c.Faltantes < 0 ? "text-danger" : "")">@c.Faltantes.ToString("N2")</td>
                                    <td class="text-end">@c.Sobrantes.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-3">Cierres de caja</h2></div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Caja</th><th>Cajero</th><th>Cierre</th><th class="text-end">Calculado</th><th class="text-end">Declarado</th><th class="text-end">Diferencia</th><th>Estado</th></tr>
                </thead>
                <tbody>
                    @if (caja.Cierres.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">No hubo cierres en el periodo.</td></tr>
                    }
                    @foreach (var c in PaginaCierres)
                    {
                        <tr>
                            <td>N.º @c.IdCaja</td>
                            <td>@c.Cajero</td>
                            <td class="text-nowrap">@Formato.FechaHora(c.FechaCierre)</td>
                            <td class="text-end">@c.MontoCalculado.ToString("N2")</td>
                            <td class="text-end">@c.MontoDeclarado.ToString("N2")</td>
                            <td class="text-end fw-semibold @(c.Diferencia < 0 ? "text-danger" : "")">@c.Diferencia.ToString("N2")</td>
                            <td><Estado Texto="@Formato.Legible(c.Estado)" />
                                @if (!string.IsNullOrEmpty(c.UsuarioReapertura))
                                {
                                    <div class="small text-muted">reabrió @c.UsuarioReapertura: @c.MotivoReapertura</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@caja.Cierres.Count" @bind-PaginaActual="paginaCierres" @bind-TamanoPagina="tamanoCierres" />
    </div>
}


@code {
    private DateTime desde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime hasta = DateTime.Today;
    private string reporte = "comercial";
    private ReporteComercial? comercial;
    private ReporteAbastecimiento? abastecimiento;
    private ReporteCaja? caja;
    private bool cargando;
    private string? error;
    private string? csv;
    private int paginaCierres = 1;
    private int tamanoCierres = 10;

    private string nombreCsv => $"sigmeta-{reporte}-{Formato.Iso(desde)}-a-{Formato.Iso(hasta)}.csv";

    // ---------------- Descarga en PDF (RF015, JasperReports en el Java) ----------------

    private bool descargando;

    private bool HayReporte => !string.IsNullOrEmpty(csv) && reporte switch
    {
        "abastecimiento" => abastecimiento is not null,
        "caja" => caja is not null,
        _ => comercial is not null
    };

    // GET /api/reportes/{tipo}/pdf: el Java arma el PDF con JasperReports y aquí solo se descarga el archivo
    private async Task DescargarPdf()
    {
        if (!HayReporte) return;
        error = null;
        descargando = true;
        try
        {
            var pdf = await Api.GetArchivo($"reportes/{reporte}/pdf?desde={Formato.Iso(desde)}&hasta={Formato.Iso(hasta)}");
            var nombre = $"SIGMETA-reporte-{reporte}-{Formato.Iso(desde)}-a-{Formato.Iso(hasta)}.pdf";
            await JS.InvokeVoidAsync("sigmetaDescargar", nombre, "application/pdf", Convert.ToBase64String(pdf));
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        catch (JSException)
        {
            error = "El PDF se generó, pero el navegador no pudo descargarlo. Vuelva a intentarlo.";
        }
        finally
        {
            descargando = false;
        }
    }

    private IEnumerable<CierreReporte> PaginaCierres => tamanoCierres == 0 ? caja!.Cierres
        : caja!.Cierres.Skip((Math.Max(paginaCierres, 1) - 1) * tamanoCierres).Take(tamanoCierres);

    private static string Ancho(double valor, double maximo) =>
        maximo <= 0 ? "0%" : (Math.Max(valor / maximo, 0.01) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override async Task OnInitializedAsync() => await Consultar();

    private async Task Cambiar(string cual)
    {
        reporte = cual;
        await Consultar();
    }

    private async Task Atajo(string cual)
    {
        var hoy = DateTime.Today;
        (desde, hasta) = cual switch
        {
            "hoy" => (hoy, hoy),
            "anterior" => (new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-1), new DateTime(hoy.Year, hoy.Month, 1).AddDays(-1)),
            "90" => (hoy.AddDays(-89), hoy),
            _ => (new DateTime(hoy.Year, hoy.Month, 1), hoy)
        };
        await Consultar();
    }

    private async Task Consultar()
    {
        error = null;
        csv = null;
        if (desde > hasta)
        {
            error = "La fecha de inicio no puede ser posterior a la fecha de fin.";
            return;
        }
        cargando = true;
        var periodo = $"desde={Formato.Iso(desde)}&hasta={Formato.Iso(hasta)}";
        try
        {
            switch (reporte)
            {
                case "abastecimiento":
                    abastecimiento = await Api.Get<ReporteAbastecimiento>($"reportes/abastecimiento?{periodo}");
                    break;
                case "caja":
                    caja = await Api.Get<ReporteCaja>($"reportes/caja?{periodo}");
                    paginaCierres = 1;
                    break;
                default:
                    comercial = await Api.Get<ReporteComercial>($"reportes/comercial?{periodo}");
                    break;
            }
            csv = ArmarCsv();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    // CSV del reporte que se está viendo: separador ";" y números con punto decimal
    private string ArmarCsv()
    {
        static string N(double n) => n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        var filas = new List<string> { Formato.Csv(new[] { "SIGMETA", $"Reporte {reporte}", $"Del {Formato.Iso(desde)} al {Formato.Iso(hasta)}" }), "" };
        if (reporte == "comercial" && comercial is not null)
        {
            filas.Add(Formato.Csv(new[] { "Ventas por día" }));
            filas.Add(Formato.Csv(new[] { "Fecha", "Ventas", "Subtotal", "IGV", "Total" }));
            filas.AddRange(comercial.PorDia.Select(d => Formato.Csv(new[] { d.Fecha, N(d.Ventas), N(d.SubTotal), N(d.Igv), N(d.Total) })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Ventas por vendedor" }));
            filas.Add(Formato.Csv(new[] { "Usuario", "Vendedor", "Ventas", "Total" }));
            filas.AddRange(comercial.PorVendedor.Select(v => Formato.Csv(new[] { v.Usuario, v.Vendedor, N(v.Ventas), N(v.Total) })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Clientes que más compraron" }));
            filas.Add(Formato.Csv(new[] { "Cliente", "Documento", "Ventas", "Total" }));
            filas.AddRange(comercial.PorCliente.Select(c => Formato.Csv(new[] { c.Cliente, c.NumeroDocumento, N(c.Ventas), N(c.Total) })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Crédito de clientes" }));
            filas.Add(Formato.Csv(new[] { "Cliente", "Documento", "Calificación", "Límite", "Deuda", "Vencido", "Días de atraso", "Disponible" }));
            filas.AddRange(comercial.Credito.Select(c => Formato.Csv(new[] { c.Cliente, c.NumeroDocumento, c.CalificacionCrediticia,
                N(c.LimiteCredito), N(c.SaldoPendiente), N(c.SaldoVencido), N(c.DiasAtraso), N(c.CreditoDisponible) })));
        }
        else if (reporte == "abastecimiento" && abastecimiento is not null)
        {
            filas.Add(Formato.Csv(new[] { "Compras a proveedores" }));
            filas.Add(Formato.Csv(new[] { "Proveedor", "RUC", "Compras", "Por recibir", "Total" }));
            filas.AddRange(abastecimiento.Compras.Select(c => Formato.Csv(new[] { c.Proveedor, c.Ruc, N(c.Compras), N(c.PorRecibir), N(c.Total) })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Productos de mayor movimiento" }));
            filas.Add(Formato.Csv(new[] { "Código", "Producto", "Unidades", "Stock" }));
            filas.AddRange(abastecimiento.MayorMovimiento.Select(p => Formato.Csv(new[] { p.CodigoInterno, p.Producto, N(p.Unidades), N(p.StockActual) })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Productos sin movimiento" }));
            filas.Add(Formato.Csv(new[] { "Código", "Producto", "Stock", "Valor al costo", "Última salida" }));
            filas.AddRange(abastecimiento.SinMovimiento.Select(p => Formato.Csv(new[] { p.CodigoInterno, p.Producto, N(p.StockActual), N(p.ValorInmovilizado), p.UltimaSalida })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Inventario valorizado" }));
            filas.Add(Formato.Csv(new[] { "Categoría", "Productos", "En su mínimo", "Valor al costo", "Valor a precio de venta" }));
            filas.AddRange(abastecimiento.Inventario.Select(i => Formato.Csv(new[] { i.Categoria, N(i.Productos), N(i.EnMinimo), N(i.ValorCosto), N(i.ValorVenta) })));
        }
        else if (reporte == "caja" && caja is not null)
        {
            filas.Add(Formato.Csv(new[] { "Cierres de caja" }));
            filas.Add(Formato.Csv(new[] { "Caja", "Cajero", "Cierre", "Calculado", "Declarado", "Diferencia", "Estado", "Reabrió", "Motivo" }));
            filas.AddRange(caja.Cierres.Select(c => Formato.Csv(new[] { c.IdCaja.ToString(), c.Cajero, c.FechaCierre, N(c.MontoCalculado),
                N(c.MontoDeclarado), N(c.Diferencia), c.Estado, c.UsuarioReapertura, c.MotivoReapertura })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Dinero por medio de pago" }));
            filas.Add(Formato.Csv(new[] { "Medio", "Cobros contado", "Cobros crédito", "Ingresos", "Egresos", "Neto" }));
            filas.AddRange(caja.PorMedioPago.Select(m => Formato.Csv(new[] { m.MedioPago, N(m.CobrosContado), N(m.CobrosCredito), N(m.Ingresos), N(m.Egresos), N(m.Neto) })));
            filas.Add("");
            filas.Add(Formato.Csv(new[] { "Diferencias por cajero" }));
            filas.Add(Formato.Csv(new[] { "Cajero", "Cierres", "Con faltante", "Con sobrante", "Faltantes", "Sobrantes", "Diferencia neta" }));
            filas.AddRange(caja.PorCajero.Select(c => Formato.Csv(new[] { c.Cajero, N(c.Cierres), N(c.ConFaltante), N(c.ConSobrante), N(c.Faltantes), N(c.Sobrantes), N(c.DiferenciaNeta) })));
        }
        return string.Join("\r\n", filas);
    }
}

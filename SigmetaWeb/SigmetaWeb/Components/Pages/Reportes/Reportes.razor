@page "/reportes"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Administrador")]
@inject ApiJava Api
@inject IJSRuntime JS
@using SigmetaWeb.Components.Pages.Almacen

<PageTitle>Reportes · SIGMETA</PageTitle>

@* RF015 · Reportes del Administrador sobre un periodo: comercial (ventas y crédito), abastecimiento e inventario, y caja.
   GET /api/reportes/comercial|abastecimiento|caja?desde=&hasta=. Las sumas vienen hechas de la base (RNF003).
   Descargar PDF: GET /api/reportes/{tipo}/pdf?desde=&hasta=. El PDF lo genera el Java con JasperReports
   (plantillas .jrxml en sigmeta-services/src/main/resources/reports) y aquí solo se descarga.
   Descargar Excel (.xlsx) y XML: se arman aquí con las mismas tablas de la pantalla (ExportarReporte.cs).
   Gráficos: cada barra es el porcentaje de la fila sobre el total del bloque (BarraParticipacion). *@

<Encabezado Rf="RF015" Titulo="Reportes" Subtitulo="Reportes comercial, de abastecimiento e inventario y de caja. Importes en soles (S/)." />

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Consultar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Desde" Id="fDesde" Obligatorio="true" Clase="col-sm-6 col-md-2">
            <input id="fDesde" type="date" class="form-control" @bind="desde" />
        </Campo>
        <Campo Etiqueta="Hasta" Id="fHasta" Obligatorio="true" Clase="col-sm-6 col-md-2">
            <input id="fHasta" type="date" class="form-control" @bind="hasta" />
        </Campo>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark" disabled="@cargando">Consultar</button>
        </div>
        <div class="col d-flex flex-wrap gap-1 justify-content-md-end">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("hoy"))">Hoy</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("mes"))">Este mes</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("anterior"))">Mes anterior</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => Atajo("90"))">Últimos 90 días</button>
        </div>
    </form>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(reporte == "comercial" ? "active" : "")" @onclick="@(() => Cambiar("comercial"))">Comercial</button></li>
    <li class="nav-item"><button class="nav-link @(reporte == "abastecimiento" ? "active" : "")" @onclick="@(() => Cambiar("abastecimiento"))">Abastecimiento e inventario</button></li>
    <li class="nav-item"><button class="nav-link @(reporte == "caja" ? "active" : "")" @onclick="@(() => Cambiar("caja"))">Caja</button></li>
</ul>

@if (cargando)
{
    <p class="text-muted">Calculando el reporte...</p>
}
else if (reporte == "comercial" && comercial is not null)
{
    <ReporteComercialVista Datos="comercial" Barra="BarraDescarga" />
}
else if (reporte == "abastecimiento" && abastecimiento is not null)
{
    <ReporteAbastecimientoVista Datos="abastecimiento" Barra="BarraDescarga" />
}
else if (reporte == "caja" && caja is not null)
{
    <ReporteCajaVista Datos="caja" Barra="BarraDescarga" />
}



@* Plantillas de esta página (no pueden ir en el .razor.cs). El resto del código está en Reportes.razor.cs. *@
@code {

    // Barra al final de cada reporte: qué reporte es, de qué periodo, y sus descargas (PDF, Excel y XML)
    private RenderFragment BarraDescarga(string titulo, string contenido) =>
        @<div class="card mb-3 border-primary-subtle">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="fw-semibold">@titulo</div>
                    <div class="small text-muted">
                        @contenido · del @desde.ToString("dd/MM/yyyy") al @hasta.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @* RF015: el Administrador descarga el reporte en PDF (JasperReports, en el Java), Excel y XML *@
                    <button type="button" class="btn btn-primary" disabled="@(cargando || descargando)" @onclick="DescargarPdf">
                        @(descargando ? "Generando PDF..." : "Descargar PDF")
                    </button>
                    <button type="button" class="btn btn-outline-success" disabled="@(!HayReporte)" @onclick="DescargarExcel">Descargar Excel</button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(!HayReporte)" @onclick="DescargarXml">Descargar XML</button>
                </div>
            </div>
        </div>;
}

@page "/despachos"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Almacenero,Administrador")]
@inject ApiJava Api
@using SigmetaWeb.Components.Pages.Almacen

<PageTitle>Despacho de ventas · SIGMETA</PageTitle>

@* RF012 · Ventas con mercadería por entregar y guías de despacho registradas.
   GET /api/almacen/ventas-por-despachar · GET /api/almacen/despachos · POST /api/almacen/despachos/{id}/anular *@
<Encabezado Rf="RF012" Titulo="Despacho de ventas"
            Subtitulo="La mercadería sale con su comprobante emitido y, si la venta es al contado, ya cobrada en caja." />

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<AvisoExito Mensaje="@exito" AlCerrar="() => exito = null" />

<Confirmacion Visible="@(porAnular is not null)" Titulo="Anular despacho" TextoConfirmar="Anular despacho"
              AlConfirmar="ConfirmarAnular" AlCancelar="() => porAnular = null">
    <p class="mb-2">La mercadería de la guía <strong>@porAnular?.Guia</strong> (venta @porAnular?.Venta) volverá al stock
        y la venta quedará otra vez pendiente de entrega.</p>
    <Campo Etiqueta="Motivo" Id="motivoAnu" Obligatorio="true" Error="@errorMotivo">
        <textarea id="motivoAnu" class="form-control" rows="2" maxlength="200" @bind="motivo" @bind:event="oninput"></textarea>
    </Campo>
</Confirmacion>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(pestana == "pendientes" ? "active" : "")" @onclick="@(() => pestana = "pendientes")">
            Ventas por despachar <span class="badge text-bg-secondary ms-1">@(porDespachar?.Count ?? 0)</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(pestana == "registrados" ? "active" : "")" @onclick="@(() => pestana = "registrados")">
            Despachos registrados
        </button>
    </li>
</ul>

@if (porDespachar is null || despachos is null)
{
    <p class="text-muted">Cargando...</p>
}
else if (pestana == "pendientes")
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Venta</th>
                        <th>Cliente</th>
                        <th>Emisión</th>
                        <th>Comprobante</th>
                        <th>Pago</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (porDespachar.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay ventas con mercadería por entregar.</td></tr>
                    }
                    @foreach (var v in porDespachar)
                    {
                        <tr>
                            <td><strong>@v.Numero</strong></td>
                            <td>@v.Cliente<div class="small text-muted">@v.NumeroDocumento</div></td>
                            <td class="text-nowrap">@Formato.Fecha(v.FechaEmision)</td>
                            <td>
                                @if (v.SinComprobante)
                                {
                                    <span class="badge rounded-pill border bg-warning-subtle text-warning-emphasis border-warning-subtle">Falta emitir</span>
                                }
                                else
                                {
                                    @v.Comprobante
                                }
                            </td>
                            <td>
                                @Formato.Legible(v.CondicionPago)
                                @if (v.SinCobro)
                                {
                                    <div><span class="badge rounded-pill border bg-warning-subtle text-warning-emphasis border-warning-subtle">Falta cobrar</span></div>
                                }
                            </td>
                            <td><Estado Texto="@Formato.Legible(v.Estado)" /></td>
                            <td class="text-end">
                                @if (EsAlmacenero)
                                {
                                    @if (v.Lista)
                                    {
                                        <a class="btn btn-sm btn-primary" href="@($"/despachos/{v.Id}")">Despachar</a>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">@(v.SinComprobante ? "Espera comprobante" : "Espera cobro")</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Guía</th>
                        <th>Venta</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Registró</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (despachos.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Todavía no hay despachos registrados.</td></tr>
                    }
                    @foreach (var d in PaginaDespachos)
                    {
                        <tr>
                            <td><strong>@d.Guia</strong></td>
                            <td>@d.Venta</td>
                            <td>@d.Cliente</td>
                            <td class="text-nowrap">@Formato.Fecha(d.FechaDespacho)</td>
                            <td>@d.Usuario</td>
                            <td><Estado Texto="@(d.Anulado ? "Anulado" : "Vigente")" /></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 text-nowrap">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => VerDetalle(d)">
                                        @(detalleDe == d.Id ? "Ocultar" : "Ver detalle")
                                    </button>
                                    @if (!d.Anulado && PuedeAnular)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirAnular(d)">Anular</button>
                                    }
                                </div>
                            </td>
                        </tr>
                        @if (detalleDe == d.Id)
                        {
                            <tr>
                                <td colspan="7" class="bg-body-tertiary">
                                    <div class="small mb-2">
                                        <strong>Entrega:</strong> @(string.IsNullOrEmpty(d.DireccionEntrega) ? "—" : d.DireccionEntrega)
                                        · <strong>Transportista:</strong> @(string.IsNullOrEmpty(d.Transportista) ? "—" : d.Transportista)
                                    </div>
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr><th>Producto</th><th class="text-end">Vendido</th><th class="text-end">En esta guía</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var l in detalle)
                                            {
                                                <tr>
                                                    <td>@l.CodigoInterno · @l.Producto</td>
                                                    <td class="text-end">@Formato.Cantidad(l.CantidadVendida) @TextosAlmacen.Unidad(l.UnidadVenta)</td>
                                                    <td class="text-end">@Formato.Cantidad(l.CantidadDespachada) @TextosAlmacen.Unidad(l.UnidadVenta)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@despachos.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";
    private bool EsAlmacenero => Rol == "Almacenero";
    private bool PuedeAnular => Rol is "Almacenero" or "Administrador";

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<VentaPorDespachar>? porDespachar;
    private List<DespachoFila>? despachos;
    private List<DespachoLinea> detalle = new();
    private int? detalleDe;
    private string pestana = "pendientes";
    private DespachoFila? porAnular;
    private string motivo = "";
    private string? errorMotivo;
    private string? error;
    private string? exito;
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    private IEnumerable<DespachoFila> PaginaDespachos => tamanoPagina == 0 ? despachos!
        : despachos!.Skip((Math.Max(paginaActual, 1) - 1) * tamanoPagina).Take(tamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        if (Guardado == AvisoGuardado.Nuevo)
        {
            exito = $"Se registró el despacho {Referencia}. El stock ya está descontado.";
            pestana = "registrados";
        }
    }

    private async Task Cargar()
    {
        try
        {
            porDespachar = await Api.Get<List<VentaPorDespachar>>("almacen/ventas-por-despachar") ?? new();
            despachos = await Api.Get<List<DespachoFila>>("almacen/despachos") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            porDespachar ??= new();
            despachos ??= new();
        }
    }

    private async Task VerDetalle(DespachoFila d)
    {
        if (detalleDe == d.Id)
        {
            detalleDe = null;
            return;
        }
        try
        {
            detalle = await Api.Get<List<DespachoLinea>>($"almacen/despachos/{d.Id}/lineas") ?? new();
            detalleDe = d.Id;
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private void PedirAnular(DespachoFila d)
    {
        error = exito = errorMotivo = null;
        motivo = "";
        porAnular = d;
    }

    private async Task ConfirmarAnular()
    {
        if (string.IsNullOrWhiteSpace(motivo))
        {
            errorMotivo = "El motivo es obligatorio.";
            return;
        }
        var d = porAnular;
        porAnular = null;
        if (d is null) return;
        try
        {
            await Api.Post<object>($"almacen/despachos/{d.Id}/anular", new { motivo = motivo.Trim() });
            detalleDe = null;
            await Cargar();
            exito = AvisoGuardado.Texto(AvisoGuardado.Anulado, "el despacho", d.Guia);
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

@page "/ordenes"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Administrador")]
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Órdenes de compra de clientes · SIGMETA</PageTitle>

@* RF007 · Órdenes de compra de clientes (Vendedor; el Administrador consulta y anula). PATRÓN UX de listas
   (ver Shared/ComponentesFlujo.cs): chips por estado de atención con su cantidad, búsqueda rápida, filtros en la
   dirección y una acción principal por fila (Registrar venta mientras falte vender).
   Datos reales del Java:
   - GET  /api/ordenes                       lista con el estado de atención (PENDIENTE, ATENDIDA_PARCIAL, ATENDIDA, ANULADA)
   - POST /api/ordenes/{id}/anular {"motivo"} anular (solo PENDIENTE y sin ventas vigentes)
   El estado de atención lo actualiza el BO solo, con los despachos de las ventas de la orden (cantidad entregada). *@
@* La orden se crea solo desde la cotización aceptada (botón "Generar orden" en Cotizaciones) *@
<Encabezado Rf="RF007" Titulo="Órdenes de compra de clientes"
            Subtitulo="Órdenes de compra recibidas de los clientes." />

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />
<Notificacion Mensaje="@exito" AlCerrar="() => exito = null" />

<ModalMotivo Visible="@(anulando is not null)" Titulo="@($"Anular {anulando?.Numero}")" TextoConfirmar="Anular"
             Ocupado="@trabajando" Ejemplo="Ejemplo: el cliente canceló su pedido."
             AlConfirmar="ConfirmarAnulacion" AlCancelar="() => anulando = null">
    <p class="mb-0 text-muted">Ya no se podrán registrar ventas con ella y su cotización queda libre.</p>
</ModalMotivo>

<FiltrosLista @bind-Busqueda="busqueda" @bind-Busqueda:after="AlBuscar" Placeholder="Buscar por número, cliente o cotización"
              Opciones="@Chips" Estado="@filtroEstado" EstadoChanged="CambiarEstado" EtiquetaChips="Filtrar por estado de atención"
              HayFiltros="@HayFiltros" AlLimpiar="Limpiar" />

@if (ordenes is null)
{
    <p class="text-muted">Cargando órdenes...</p>
}
else
{
    var filtradas = Filtradas;
    var pagina = Pagina(filtradas).ToList();
    <div class="card mb-3">
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table table-hover align-middle mb-0 tabla-lista">
                <thead>
                    <tr>
                        <th>Orden</th>
                        <th>Cliente</th>
                        <th>Cotización</th>
                        <th class="text-end">Total (S/)</th>
                        <th>Atención</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                @if (HayFiltros)
                                {
                                    <ListaVacia Titulo="Ninguna orden coincide con los filtros." AlQuitarFiltros="Limpiar" />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Todavía no hay órdenes de clientes."
                                                TextoAccion="@(EsVendedor ? "Ver cotizaciones aceptadas" : null)" Ruta="/cotizaciones?estado=ACEPTADA" />
                                }
                            </td>
                        </tr>
                    }
                    @for (var i = 0; i < pagina.Count; i++)
                    {
                        var o = pagina[i];
                        var haciaArriba = pagina.Count > 3 && i >= pagina.Count - 2;
                        <tr @key="o.Id">
                            <td>
                                <a class="numero" href="@RutaOrden(o)">@o.Numero</a>
                                <div class="sub">@TextosVentas.Fecha(o.FechaEmision)@(string.IsNullOrEmpty(o.NumeroOrdenCliente) ? "" : $" · {o.NumeroOrdenCliente}")</div>
                            </td>
                            <td>@o.Cliente</td>
                            <td>
                                @if (o.IdCotizacion > 0)
                                {
                                    <a class="text-decoration-none" href="@($"/cotizaciones/editar/{o.IdCotizacion}")">@o.NumeroCotizacion</a>
                                }
                                else
                                {
                                    @o.NumeroCotizacion
                                }
                            </td>
                            <td class="text-end fw-semibold">@o.Total.ToString("N2")</td>
                            <td><Estado Texto="@TextosVentas.Texto(EstadoDe(o))" /></td>
                            <td class="acciones">
                                <AccionesFila Principal="@Principal(o)" Otras="@Secundarias(o)" Ocupado="@trabajando" HaciaArriba="@haciaArriba" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" PaginaActual="@paginaActual" PaginaActualChanged="CambiarPagina"
                    @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";
    private bool EsVendedor => Rol == "Vendedor";

    [SupplyParameterFromQuery(Name = "estado")] public string? EstadoQ { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? BusquedaQ { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int? PaginaQ { get; set; }
    // Aviso de éxito con el patrón único (AvisoGuardado): el formulario vuelve aquí con ?guardado=…&ref=…
    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<OrdenDatos>? ordenes;
    private string filtroEstado = "";
    private string busqueda = "";
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private string? urlPropia;

    private string? error;
    private string? exito;
    private bool avisoLeido;
    private bool trabajando;
    private OrdenDatos? anulando;

    private string RutaActual => "/" + Nav.ToBaseRelativePath(Nav.Uri);
    private string RutaOrden(OrdenDatos o) => $"/ordenes/editar/{o.Id}?volver={Volver.Parametro(RutaActual)}";
    private bool HayFiltros => filtroEstado != "" || !string.IsNullOrWhiteSpace(busqueda);
    private static string EstadoDe(OrdenDatos o) => o.Anulado ? "ANULADA" : o.Estado ?? "";

    // Botón principal: registrar la venta mientras falte vender; si no, "Ver"
    private AccionFila Principal(OrdenDatos o) =>
        EsVendedor && EstadoDe(o) is "PENDIENTE" or "ATENDIDA_PARCIAL"
            ? new("Registrar venta", Ruta: $"/ventas/nueva?orden={o.Id}")   // RF008: venta desde la orden
            : new("Ver", Ruta: RutaOrden(o), Destacada: false);

    // Lo llama AccionesFila: la acción corre en esta pantalla para que se redibuje (ventana de anular)
    private Task Ejecutar(AccionFila a) => a.Hacer?.Invoke() ?? Task.CompletedTask;

    // Menú «⋯»
    private List<AccionFila> Secundarias(OrdenDatos o)
    {
        var lista = new List<AccionFila>();
        if (Principal(o).Texto != "Ver")
            lista.Add(new(EsVendedor && EstadoDe(o) == "PENDIENTE" ? "Editar" : "Ver detalle", Ruta: RutaOrden(o)));
        // RF007: anulan el Vendedor y el Administrador (OrdenCompraClienteBOImpl.anular)
        if ((EsVendedor || Rol == "Administrador") && EstadoDe(o) == "PENDIENTE")
            lista.Add(new("Anular", Hacer: () => AbrirAnulacion(o), Peligro: true));
        return lista;
    }

    private List<OrdenDatos> PorBusqueda => (ordenes ?? new())
        .Where(o => Busqueda.Coincide(busqueda, o.Numero, o.NumeroOrdenCliente, o.Cliente, o.DocumentoCliente, o.NumeroCotizacion))
        .ToList();

    private List<OrdenDatos> Filtradas => PorBusqueda
        .Where(o => filtroEstado == "" ? EstadoDe(o) != "ANULADA" : EstadoDe(o) == filtroEstado)
        .OrderByDescending(o => o.FechaEmision).ThenByDescending(o => o.Id)
        .ToList();

    private IReadOnlyList<OpcionChip> Chips
    {
        get
        {
            var base_ = PorBusqueda;
            int Cuantas(string e) => base_.Count(o => EstadoDe(o) == e);
            return new List<OpcionChip>
            {
                new("", "Vigentes", base_.Count(o => EstadoDe(o) != "ANULADA")),
                new("PENDIENTE", "Pendientes", Cuantas("PENDIENTE"), "ambar"),
                new("ATENDIDA_PARCIAL", "Atendidas en parte", Cuantas("ATENDIDA_PARCIAL"), "azul"),
                new("ATENDIDA", "Atendidas", Cuantas("ATENDIDA"), "verde"),
                new("ANULADA", "Anuladas", Cuantas("ANULADA"), "rojo")
            };
        }
    }

    private IEnumerable<OrdenDatos> Pagina(List<OrdenDatos> lista)
    {
        if (tamanoPagina == 0) return lista;
        var total = Math.Max(1, (int)Math.Ceiling((double)lista.Count / tamanoPagina));
        return lista.Skip((Math.Clamp(paginaActual, 1, total) - 1) * tamanoPagina).Take(tamanoPagina);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!avisoLeido)
        {
            avisoLeido = true;
            exito = AvisoGuardado.Texto(Guardado, "la orden", Referencia);
        }
        if (urlPropia is not null && Nav.Uri == urlPropia)
        {
            return;
        }
        filtroEstado = EstadoQ ?? "";
        busqueda = BusquedaQ ?? "";
        paginaActual = Math.Max(1, PaginaQ ?? 1);
        if (ordenes is null) await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            ordenes = await Api.Get<List<OrdenDatos>>("ordenes") ?? new();   // GET /api/ordenes
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            ordenes ??= new();
        }
    }

    private void SincronizarUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["estado"] = filtroEstado == "" ? null : filtroEstado,
            ["q"] = string.IsNullOrWhiteSpace(busqueda) ? null : busqueda.Trim(),
            ["pagina"] = paginaActual > 1 ? paginaActual : (object?)null,
            ["guardado"] = null,
            ["ref"] = null
        });
        if (uri == Nav.Uri) return;
        urlPropia = uri;
        Nav.NavigateTo(uri, replace: true);
    }

    private void CambiarEstado(string estado)
    {
        filtroEstado = estado;
        paginaActual = 1;
        SincronizarUrl();
    }

    private void AlBuscar()
    {
        paginaActual = 1;
        SincronizarUrl();
    }

    private void CambiarPagina(int pagina)
    {
        paginaActual = pagina;
        SincronizarUrl();
    }

    private void Limpiar()
    {
        filtroEstado = "";
        busqueda = "";
        paginaActual = 1;
        SincronizarUrl();
    }

    private Task AbrirAnulacion(OrdenDatos o)
    {
        error = null;
        exito = null;
        anulando = o;
        return Task.CompletedTask;
    }

    // POST /api/ordenes/{id}/anular {"motivo": ...}
    private async Task ConfirmarAnulacion(string motivo)
    {
        if (anulando is null) return;
        trabajando = true;
        try
        {
            await Api.Post<object>($"ordenes/{anulando.Id}/anular", new AnulacionDatos { Motivo = motivo });
            exito = $"Se anuló la orden {anulando.Numero}.";
            anulando = null;
            await Cargar();
        }
        catch (ErrorApi e)
        {
            anulando = null;
            error = e.Message;   // por ejemplo "Anule primero las ventas vigentes de la orden"
        }
        finally
        {
            trabajando = false;
        }
    }
}

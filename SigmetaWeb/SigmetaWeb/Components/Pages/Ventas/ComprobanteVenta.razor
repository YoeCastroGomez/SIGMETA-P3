@page "/ventas/{Id:int}/comprobante"
@inject ApiJava Api
@inject IJSRuntime JS

<PageTitle>Comprobante de la venta · SIGMETA</PageTitle>

@* RF008 · Emisión del comprobante electrónico de una venta y registro de su envío (Vendedor y Cajero). Datos reales del Java:
   - GET  /api/ventas/{Id}                       la venta, sus líneas y su comprobante vigente
   - GET  /api/comprobantes/{id}                 el comprobante con el cliente
   - POST /api/comprobantes {"idVenta", "tipo"}  emitir BOLETA o FACTURA (la serie y el número los pone el BO)
   - POST /api/comprobantes/{id}/envio {"medioEnvio"}  registrar el envío (CORREO, MENSAJERIA o IMPRESO; la fecha la pone el BO)
   - POST /api/comprobantes/{id}/anular {"motivo"}  anular la factura o boleta si la mercadería no se entregó
   - Botón Imprimir: registra el envío IMPRESO y abre la impresión del navegador con la vista .sigmeta-impresion
     (formato imprimible del RF008; en pantalla está oculta y al imprimir es lo único que sale)
   Mensajes del BO: factura a un cliente sin RUC, venta que ya tiene comprobante, venta anulada... *@

<style>
    .sigmeta-impresion { display: none; }

    @@media print {
        @@page { size: A4; margin: 15mm; }
        /* solo se imprime el comprobante: se oculta todo lo que no lo contiene (menú, barra, botones, tarjetas) */
        body *:not(:has(.sigmeta-impresion)):not(.sigmeta-impresion):not(.sigmeta-impresion *) { display: none !important; }
        /* los contenedores del comprobante pierden márgenes y posiciones del diseño de pantalla */
        body, body *:has(.sigmeta-impresion) {
            display: block !important; position: static !important; margin: 0 !important; padding: 0 !important;
            border: 0 !important; box-shadow: none !important; background: #fff !important;
            width: auto !important; max-width: none !important; min-height: 0 !important; overflow: visible !important;
        }
        .sigmeta-impresion { display: block !important; color: #000; font-size: 11pt; }
        .sigmeta-impresion table { width: 100%; border-collapse: collapse; }
        .sigmeta-impresion th, .sigmeta-impresion td { border: 1px solid #999; padding: 4px 6px; }
        .sigmeta-impresion thead th { background: #eee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .sigmeta-impresion .imp-recuadro { border: 2px solid #000; padding: 8px 12px; text-align: center; }
        .sigmeta-impresion .imp-totales td { border: 0; }
    }
</style>
<Encabezado Rf="RF008" Titulo="Comprobante de la venta" Subtitulo="@Subtitulo">
    <a class="btn btn-outline-secondary" href="/ventas">Volver a la lista</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

@* RF008: anular la factura o boleta. Si la mercadería ya se despachó, el BO lo rechaza: se usa nota de crédito *@
<Confirmacion Visible="@pidiendoAnulacion" Titulo="Anular comprobante" TextoConfirmar="Anular comprobante"
              AlConfirmar="ConfirmarAnulacion" AlCancelar="() => pidiendoAnulacion = false">
    <p class="mb-2">Se anula <strong>@comprobante?.Comprobante</strong>. Solo se puede si la mercadería todavía no salió del almacén;
        si ya se entregó, la devolución se hace con una nota de crédito. Después podrá corregir la venta, volver a emitir o anularla.</p>
    <Campo Etiqueta="Motivo" Id="motivoAnulacion" Obligatorio="true" Error="@errorMotivo">
        <textarea id="motivoAnulacion" class="form-control" rows="2" maxlength="200" @bind="motivoAnulacion" @bind:event="oninput"></textarea>
    </Campo>
</Confirmacion>

@if (cargando)
{
    <p class="text-muted">Cargando venta...</p>
}
else if (venta is not null)
{
    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Venta</h2>
        <div class="row">
            <div class="col-sm-6 col-md-3 mb-3">
                <div class="small text-muted text-uppercase">Número</div>
                <div class="fw-semibold">@venta.Numero</div>
            </div>
            <div class="col-sm-6 col-md-3 mb-3">
                <div class="small text-muted text-uppercase">Fecha</div>
                <div class="fw-semibold">@TextosVentas.Fecha(venta.FechaEmision)</div>
            </div>
            <div class="col-sm-6 col-md-3 mb-3">
                <div class="small text-muted text-uppercase">Condición de pago</div>
                <div class="fw-semibold">@TextosVentas.Texto(venta.CondicionPago)</div>
            </div>
            <div class="col-sm-6 col-md-3 mb-3">
                <div class="small text-muted text-uppercase">Total</div>
                <div class="fw-semibold">S/ @venta.Total.ToString("N2")</div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="small text-muted text-uppercase">Cliente</div>
                <div class="fw-semibold">@venta.Cliente <span class="small text-muted">@venta.DocumentoCliente</span></div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="small text-muted text-uppercase">Estado</div>
                <div><Estado Texto="@TextosVentas.Texto(venta.Estado)" /></div>
            </div>
        </div>
    </div>

    @if (venta.Estado == "ANULADA")
    {
        <div class="alert alert-secondary">La venta está anulada: no se emite comprobante.</div>
    }
    else if (comprobante is null)
    {
        @* La venta todavía no tiene comprobante vigente: se emite factura o boleta *@
        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">Emitir comprobante</h2>
            <div class="row">
                <div class="col-md-6">
                    <Campo Etiqueta="Tipo de comprobante" Obligatorio="true"
                           Ayuda="La factura exige que el cliente tenga RUC. Una venta tiene un solo comprobante vigente.">
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipo" id="tipoFactura"
                                       checked="@esFactura" @onchange="ElegirFactura" />
                                <label class="form-check-label" for="tipoFactura">Factura</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipo" id="tipoBoleta"
                                       checked="@(!esFactura)" @onchange="ElegirBoleta" />
                                <label class="form-check-label" for="tipoBoleta">Boleta</label>
                            </div>
                        </div>
                    </Campo>
                </div>
                <div class="col-sm-6 col-md-3 mb-3">
                    <div class="small text-muted text-uppercase">Serie</div>
                    <input class="form-control sigmeta-correlativo" value="@(esFactura ? "F001" : "B001")" disabled />
                </div>
                <div class="col-sm-6 col-md-3 mb-3">
                    <div class="small text-muted text-uppercase">Número</div>
                    <input class="form-control sigmeta-correlativo" value="@numeroPropuesto" disabled />
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
                <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary" href="/ventas">Cancelar</a>
                    @if (Rol == "Vendedor" && venta.Estado == "REGISTRADA" && !venta.CobradaContado)
                    {
                        @* RF008: sin comprobante vigente la venta se puede corregir (por ejemplo, tras anular la factura) *@
                        <a class="btn btn-outline-primary" href="@($"/ventas/editar/{venta.Id}")">Editar venta</a>
                    }
                    <button class="btn btn-primary" disabled="@trabajando" @onclick="Emitir">
                        @(trabajando ? "Emitiendo..." : "Emitir comprobante")
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card card-body mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <h2 class="h6 fw-semibold mb-0">Comprobante emitido</h2>
                <div class="d-flex align-items-center gap-2">
                    <Estado Texto="@TextosVentas.Texto(comprobante.Estado)" />
                    @if (comprobante.Estado != "ANULADO" && (Rol == "Vendedor" || Rol == "Cajero"))
                    {
                        <button class="btn btn-sm btn-outline-danger" disabled="@trabajando" @onclick="PedirAnulacion">Anular comprobante</button>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 col-md-3 mb-3">
                    <div class="small text-muted text-uppercase">Tipo</div>
                    <div class="fw-semibold">@TextosVentas.Texto(comprobante.Tipo)</div>
                </div>
                <div class="col-sm-6 col-md-3 mb-3">
                    <div class="small text-muted text-uppercase">Serie y número</div>
                    <div class="fw-semibold">@comprobante.Comprobante</div>
                </div>
                <div class="col-sm-6 col-md-3 mb-3">
                    <div class="small text-muted text-uppercase">Fecha de emisión</div>
                    <div class="fw-semibold">@TextosVentas.Fecha(comprobante.FechaEmision)</div>
                </div>
                <div class="col-sm-6 col-md-3 mb-3">
                    <div class="small text-muted text-uppercase">Último envío</div>
                    <div class="fw-semibold">
                        @if (comprobante.MedioEnvio is null)
                        {
                            <span class="text-muted">Sin enviar</span>
                        }
                        else
                        {
                            @TextosVentas.Texto(comprobante.MedioEnvio)
                            <div class="small text-muted">@TextosVentas.FechaHora(comprobante.FechaEnvio)</div>
                        }
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="small text-muted text-uppercase">Cliente</div>
                    <div class="fw-semibold">@comprobante.Cliente</div>
                    <div class="small text-muted">@TextosVentas.Texto(comprobante.TipoDocumentoCliente) @comprobante.DocumentoCliente</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="small text-muted text-uppercase">Contacto</div>
                    <div>@(comprobante.CorreoCliente ?? "—")</div>
                    <div class="small text-muted">@comprobante.DireccionCliente</div>
                </div>
                <div class="col-md-12">
                    <div class="d-flex justify-content-end gap-4 border-top pt-2">
                        <span class="text-muted">Subtotal S/ @comprobante.SubTotal.ToString("N2")</span>
                        <span class="text-muted">IGV S/ @comprobante.Igv.ToString("N2")</span>
                        <span class="fw-semibold">Total S/ @comprobante.Total.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        @* RF008: se deja registro del medio y la fecha de envío (ComprobanteBO.registrarEnvio) *@
        @if (comprobante.Estado != "ANULADO")
        {
            <div class="card card-body mb-3">
                <h2 class="h6 fw-semibold mb-3">Entregar al cliente</h2>
                <div class="row align-items-end">
                    <div class="col-md-6">
                        <Campo Etiqueta="Medio de envío" Id="medio" Obligatorio="true"
                               Ayuda="La fecha y hora del envío se registran automáticamente.">
                            <select id="medio" class="form-select" @bind="medioEnvio">
                                <option value="CORREO">Correo electrónico</option>
                                <option value="MENSAJERIA">Mensajería al contacto registrado</option>
                                <option value="IMPRESO">Formato imprimible</option>
                            </select>
                        </Campo>
                    </div>
                    <div class="col-md-6 mb-3 d-flex flex-wrap gap-2 justify-content-md-end">
                        @if (Rol == "Cajero")
                        {
                            @* RF013: la nota de crédito la registra el Cajero (con autorización) sobre un comprobante emitido *@
                            <a class="btn btn-outline-secondary" href="@($"/notas-credito/nueva?comprobante={comprobante.Id}")">Nota de crédito</a>
                        }
                        @* RF008: formato imprimible. Registra el envío IMPRESO y abre la impresión (Vendedor y Cajero) *@
                        <button class="btn btn-outline-primary" disabled="@trabajando" @onclick="Imprimir">Imprimir</button>
                        <button class="btn btn-primary" disabled="@trabajando" @onclick="RegistrarEnvio">
                            @(trabajando ? "Registrando..." : "Registrar envío")
                        </button>
                    </div>
                </div>
            </div>
        }
    }

    @if (comprobante is not null && comprobante.Estado != "ANULADO")
    {
        var lineasImpresas = comprobante.Lineas.Count > 0 ? comprobante.Lineas : venta.Lineas;
        @* RF008 · Representación impresa del comprobante. Oculta en pantalla; es lo único que sale al imprimir *@
        <div class="sigmeta-impresion">
            <table class="mb-3" style="border: 0;">
                <tr>
                    <td style="border: 0; vertical-align: top;">
                        <div style="font-size: 16pt; font-weight: 700;">GRUPO META</div>
                        <div>Ferretería industrial · herramientas y suministros</div>
                    </td>
                    <td style="border: 0; width: 40%;">
                        <div class="imp-recuadro">
                            <div style="font-weight: 700;">@TituloImpreso</div>
                            <div style="font-size: 14pt; font-weight: 700;">@comprobante.Comprobante</div>
                        </div>
                    </td>
                </tr>
            </table>

            <table class="mb-3">
                <tr>
                    <td style="width: 22%;"><strong>Cliente</strong></td>
                    <td>@comprobante.Cliente</td>
                    <td style="width: 18%;"><strong>Fecha de emisión</strong></td>
                    <td style="width: 15%;">@TextosVentas.Fecha(comprobante.FechaEmision)</td>
                </tr>
                <tr>
                    <td><strong>@TextosVentas.Texto(comprobante.TipoDocumentoCliente)</strong></td>
                    <td>@comprobante.DocumentoCliente</td>
                    <td><strong>Condición de pago</strong></td>
                    <td>@TextosVentas.Texto(comprobante.CondicionPago ?? venta.CondicionPago)</td>
                </tr>
                <tr>
                    <td><strong>Dirección</strong></td>
                    <td>@(comprobante.DireccionCliente ?? "—")</td>
                    <td><strong>Venta</strong></td>
                    <td>@(comprobante.NumeroVenta ?? venta.Numero)</td>
                </tr>
            </table>

            <table class="mb-2">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;">#</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th style="text-align: right;">Cantidad</th>
                        <th style="text-align: right;">P. unit. (S/)</th>
                        <th style="text-align: right;">Dscto. (S/)</th>
                        <th style="text-align: right;">Importe (S/)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in lineasImpresas)
                    {
                        <tr>
                            <td>@l.NumeroLinea</td>
                            <td>@l.CodigoProducto</td>
                            <td>@l.Producto</td>
                            <td style="text-align: right;">@l.Cantidad.ToString("0.###")</td>
                            <td style="text-align: right;">@l.PrecioUnitario.ToString("N2")</td>
                            <td style="text-align: right;">@l.Descuento.ToString("N2")</td>
                            <td style="text-align: right;">@l.Importe.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <table class="imp-totales" style="width: 40%; margin-left: auto;">
                <tr><td>Op. gravada</td><td style="text-align: right;">S/ @comprobante.SubTotal.ToString("N2")</td></tr>
                <tr><td>IGV (18 %)</td><td style="text-align: right;">S/ @comprobante.Igv.ToString("N2")</td></tr>
                <tr><td><strong>Importe total</strong></td><td style="text-align: right;"><strong>S/ @comprobante.Total.ToString("N2")</strong></td></tr>
            </table>

            <p style="margin-top: 24px; font-size: 9pt; text-align: center;">
                Representación impresa del comprobante electrónico @comprobante.Comprobante · Generado por SIGMETA
            </p>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-1">Detalle de la venta</h2>
        </div>
        <TablaDetalle Lineas="@venta.Lineas" SubTotal="@venta.SubTotal" Igv="@venta.Igv" Total="@venta.Total" MostrarDespachada="true" />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    private VentaDatos? venta;
    private ComprobanteDatos? comprobante;
    private bool esFactura;
    private string numeroPropuesto = "";
    private sealed class NumeroPropuesto { public string Numero { get; set; } = ""; }
    private string medioEnvio = "CORREO";
    private bool cargando = true;
    private bool trabajando;
    private string? error;
    private string? exito;
    private bool pidiendoAnulacion;
    private string motivoAnulacion = "";
    private string? errorMotivo;

    private string Subtitulo => venta is null ? "" : $"Venta {venta.Numero} · {venta.Cliente}";

    private string TituloImpreso => comprobante?.Tipo == "FACTURA" ? "FACTURA ELECTRÓNICA" : "BOLETA DE VENTA ELECTRÓNICA";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        await Cargar();
        cargando = false;
    }

    private async Task Cargar()
    {
        try
        {
            venta = await Api.Get<VentaDatos>($"ventas/{Id}");          // GET /api/ventas/{Id}
            comprobante = null;
            if (venta is not null && venta.IdComprobante > 0)
            {
                comprobante = await Api.Get<ComprobanteDatos>($"comprobantes/{venta.IdComprobante}");
            }
            // por defecto se propone factura si el cliente tiene RUC (11 dígitos) y boleta si no
            esFactura = venta?.DocumentoCliente?.Length == 11;
            if (comprobante is null && venta is not null) await ObtenerNumeroPropuesto();
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "No existe la venta con id 99"
        }
    }

    private async Task ElegirFactura()
    {
        esFactura = true;
        await ObtenerNumeroPropuesto();
    }

    private async Task ElegirBoleta()
    {
        esFactura = false;
        await ObtenerNumeroPropuesto();
    }

    private async Task ObtenerNumeroPropuesto()
    {
        string serie = esFactura ? "F001" : "B001";
        numeroPropuesto = "";
        try
        {
            var propuesta = await Api.Get<NumeroPropuesto>($"comprobantes/siguiente-numero?serie={serie}");
            if (serie == (esFactura ? "F001" : "B001"))
                numeroPropuesto = propuesta?.Numero ?? "";
        }
        catch (ErrorApi e) { error = e.Message; }
    }

    // POST /api/comprobantes {"idVenta", "tipo"}
    private async Task Emitir()
    {
        error = null;
        exito = null;
        trabajando = true;
        try
        {
            var emitido = await Api.Post<ComprobanteDatos>("comprobantes",
                new ComprobanteDatos { IdVenta = Id, Tipo = esFactura ? "FACTURA" : "BOLETA" });
            exito = $"Se emitió el comprobante {emitido?.Comprobante}.";
            await Cargar();
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "La FACTURA requiere que el cliente cuente con RUC (cliente tiene: DNI)"
        }
        finally
        {
            trabajando = false;
        }
    }

    private void PedirAnulacion()
    {
        error = exito = errorMotivo = null;
        motivoAnulacion = "";
        pidiendoAnulacion = true;
    }

    // POST /api/comprobantes/{id}/anular {"motivo"}
    private async Task ConfirmarAnulacion()
    {
        if (string.IsNullOrWhiteSpace(motivoAnulacion))
        {
            errorMotivo = "El motivo es obligatorio.";
            return;
        }
        pidiendoAnulacion = false;
        if (comprobante is null) return;
        var anulado = comprobante.Comprobante;
        trabajando = true;
        try
        {
            await Api.Post<object>($"comprobantes/{comprobante.Id}/anular", new AnulacionDatos { Motivo = motivoAnulacion.Trim() });
            await Cargar();
            exito = Rol == "Vendedor"
                ? $"Se anuló el comprobante {anulado}. Ahora puede corregir la venta con \"Editar venta\", emitir un comprobante nuevo o anular la venta desde la lista."
                : $"Se anuló el comprobante {anulado}. Puede emitir uno nuevo; la venta la corrige o anula el Vendedor.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "La venta ya tiene mercadería despachada: para devolverla emita una nota de crédito..."
        }
        finally
        {
            trabajando = false;
        }
    }

    // RF008: formato imprimible. Primero registra el envío IMPRESO (si el BO lo rechaza, no se imprime)
    // y luego abre el diálogo de impresión del navegador, que solo muestra la vista .sigmeta-impresion
    private async Task Imprimir()
    {
        if (comprobante is null) return;
        error = null;
        exito = null;
        trabajando = true;
        try
        {
            await Api.Post<ComprobanteDatos>($"comprobantes/{comprobante.Id}/envio",
                new ComprobanteDatos { MedioEnvio = "IMPRESO" });
            await Cargar();
            exito = "Se registró el envío en formato imprimible.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "No se puede registrar el envío de un comprobante anulado"
            return;
        }
        finally
        {
            trabajando = false;
        }

        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch (TaskCanceledException)
        {
            // el diálogo de impresión quedó abierto más que el tiempo de espera de Blazor: no es un error
        }
        catch (JSDisconnectedException)
        {
            // el navegador se desconectó mientras imprimía: el envío IMPRESO ya quedó registrado
        }
    }

    // POST /api/comprobantes/{id}/envio {"medioEnvio"}
    private async Task RegistrarEnvio()
    {
        if (comprobante is null) return;
        error = null;
        exito = null;
        trabajando = true;
        try
        {
            await Api.Post<ComprobanteDatos>($"comprobantes/{comprobante.Id}/envio",
                new ComprobanteDatos { MedioEnvio = medioEnvio });
            exito = $"Se registró el envío por {TextosVentas.Texto(medioEnvio).ToLowerInvariant()}.";
            await Cargar();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            trabajando = false;
        }
    }
}

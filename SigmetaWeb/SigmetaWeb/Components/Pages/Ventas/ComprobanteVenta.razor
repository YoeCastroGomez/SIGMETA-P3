@page "/ventas/{Id:int}/comprobante"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Cajero,Administrador")]
@inject ApiJava Api
@inject IJSRuntime JS

<PageTitle>@(venta?.Numero ?? "Venta") · SIGMETA</PageTitle>

@* RF008 · Centro de la venta: su recorrido, la emisión del comprobante, su entrega al cliente y su anulación.
   Es la pantalla de referencia del PATRÓN UX (ver Shared/ComponentesFlujo.cs):
     - <PasosDocumento>: en qué paso está la venta y a quién le toca lo siguiente.
     - <BotonCondicionado>: lo que no se puede hacer aparece bloqueado y dice por qué (factura sin RUC,
       anular con mercadería entregada...). Las reglas siguen en el BO; aquí solo se anticipan.
     - <SiguientePaso>: después de cada acción, qué sigue y el botón para hacerlo.
     - <ModalMotivo>: la anulación dice qué va a pasar y exige el motivo.
   Datos reales del Java:
   - GET  /api/ventas/{Id}                       la venta, sus líneas, su comprobante vigente y si ya se cobró
   - GET  /api/ordenes/{id}                      (si viene de una orden) para mostrar su cotización en el recorrido
   - GET  /api/comprobantes/{id}                 el comprobante con el cliente
   - GET  /api/comprobantes/siguiente-numero     el número que recibiría
   - POST /api/comprobantes {"idVenta", "tipo"}  emitir BOLETA o FACTURA (la serie y el número los pone el BO)
   - POST /api/comprobantes/{id}/envio {"medioEnvio"}  registrar el envío (CORREO, MENSAJERIA o IMPRESO)
   - POST /api/comprobantes/{id}/anular {"motivo"}  anular si la mercadería no salió del almacén
   - Descargar PDF: GET /api/comprobantes/{id}/pdf (JasperReports en el Java) y registra el envío IMPRESO *@

<Encabezado Rf="RF008" Titulo="@Titulo" Subtitulo="@Subtitulo">
    <a class="btn btn-outline-secondary" href="@VolverA">Volver a ventas</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<SiguientePaso Mensaje="@exito" Detalle="@exitoDetalle" TextoAccion="@exitoAccion" Ruta="@exitoRuta"
               AlAccion="@(exitoImprimir ? EventCallback.Factory.Create(this, Imprimir) : default)"
               AlCerrar="CerrarAviso" />

<ModalMotivo Visible="@pidiendoAnulacion" Titulo="@($"Anular {comprobante?.Comprobante}")" TextoConfirmar="Anular comprobante"
             Ocupado="@trabajando" Ejemplo="Ejemplo: se emitió con el cliente equivocado."
             AlConfirmar="ConfirmarAnulacion" AlCancelar="() => pidiendoAnulacion = false">
    <p class="mb-2">Al anular <strong>@comprobante?.Comprobante</strong>:</p>
    <ul class="small mb-0">
        <li>El comprobante deja de valer (queda registrado como anulado).</li>
        <li>La venta <strong>@venta?.Numero</strong> queda sin comprobante: se puede corregir y volver a emitir, o anular.</li>
        <li>No se toca el stock: la mercadería todavía no salió del almacén.</li>
    </ul>
</ModalMotivo>

@if (cargando)
{
    <p class="text-muted">Cargando venta...</p>
}
else if (venta is not null)
{
    <PasosDocumento Pasos="@pasos" Titulo="Recorrido de la venta" />

    <div class="row g-3">
        <div class="col-lg-8">
            @if (FlujoVentas.EstaAnulada(venta))
            {
                <div class="alert alert-secondary">
                    <strong>Venta anulada.</strong> No se emite comprobante.
                    @if (!string.IsNullOrWhiteSpace(venta.MotivoAnulacion))
                    {
                        <div class="small mt-1">Motivo: @venta.MotivoAnulacion</div>
                    }
                </div>
            }
            else if (comprobante is null)
            {
                @* -------- 1. Emitir el comprobante -------- *@
                <div class="card card-body mb-3">
                    <h2 class="h6 fw-semibold mb-1">Emitir comprobante</h2>
                    <p class="small text-muted mb-3">Elija el tipo. La serie y el número los asigna el sistema al emitir.</p>
                    <div class="row g-2 mb-3" role="radiogroup" aria-label="Tipo de comprobante">
                        <div class="col-sm-6">
                            <button type="button" role="radio" aria-checked="@(esFactura ? "true" : "false")"
                                    class="opcion-tipo w-100 text-start @(esFactura ? "elegida" : "")" disabled="@(!EsRuc)" @onclick="ElegirFactura">
                                <span class="fw-semibold d-block">Factura</span>
                                <span class="small text-muted d-block">Serie F001 · para clientes con RUC</span>
                                @if (!EsRuc)
                                {
                                    <span class="small text-danger d-block mt-1">El cliente no tiene RUC: solo puede recibir boleta.</span>
                                }
                            </button>
                        </div>
                        <div class="col-sm-6">
                            <button type="button" role="radio" aria-checked="@(!esFactura ? "true" : "false")"
                                    class="opcion-tipo w-100 text-start @(!esFactura ? "elegida" : "")" @onclick="ElegirBoleta">
                                <span class="fw-semibold d-block">Boleta</span>
                                <span class="small text-muted d-block">Serie B001 · para cualquier cliente</span>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-top pt-3">
                        <div class="small text-muted">
                            Se emitirá: <strong class="text-body">@(esFactura ? "F001" : "B001")-@(string.IsNullOrEmpty(numeroPropuesto) ? "…" : numeroPropuesto)</strong>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-start">
                            @if (Rol == "Vendedor")
                            {
                                <BotonCondicionado Texto="Editar venta" Clase="btn-outline-secondary" Ruta="@($"/ventas/editar/{venta.Id}?volver={Uri.EscapeDataString(RutaActual)}")"
                                                   Motivo="@FlujoVentas.MotivoNoEditable(venta)" />
                            }
                            <BotonCondicionado Texto="Emitir comprobante" TextoOcupado="Emitiendo..." Ocupado="@trabajando"
                                               Motivo="@((Rol is "Vendedor" or "Cajero") ? null : "Solo el Vendedor o el Cajero emiten comprobantes.")"
                                               AlHacerClic="Emitir" />
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* -------- 2. Comprobante emitido -------- *@
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <div class="small text-muted">@TextosVentas.Texto(comprobante.Tipo)</div>
                                <div class="h5 fw-bold mb-0">@comprobante.Comprobante</div>
                                <div class="small text-muted">Emitido el @TextosVentas.Fecha(comprobante.FechaEmision)</div>
                            </div>
                            <Estado Texto="@TextosVentas.Texto(comprobante.Estado)" />
                        </div>
                        <div class="row small">
                            <div class="col-md-6 mb-2">
                                <div class="text-muted">Cliente</div>
                                <div class="fw-semibold">@comprobante.Cliente</div>
                                <div class="text-muted">@TextosVentas.Texto(comprobante.TipoDocumentoCliente) @comprobante.DocumentoCliente</div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <div class="text-muted">Contacto</div>
                                <div>@(string.IsNullOrWhiteSpace(comprobante.CorreoCliente) ? "Sin correo registrado" : comprobante.CorreoCliente)</div>
                                <div class="text-muted">@comprobante.DireccionCliente</div>
                            </div>
                        </div>
                    </div>
                    @if (comprobante.Estado != "ANULADO")
                    {
                        <div class="card-footer bg-transparent d-flex flex-wrap gap-2 align-items-start">
                            <BotonCondicionado Texto="Descargar PDF" Clase="btn-primary" Ocupado="@trabajando" AlHacerClic="Imprimir"
                                               Motivo="@((Rol is "Vendedor" or "Cajero") ? null : "Solo el Vendedor o el Cajero entregan comprobantes.")" />
                            @if (Rol == "Cajero")
                            {
                                @* RF013: si la mercadería ya se entregó, la devolución va con nota de crédito *@
                                <BotonCondicionado Texto="Nota de crédito" Clase="btn-outline-secondary"
                                                   Ruta="@($"/notas-credito/nueva?comprobante={comprobante.Id}")"
                                                   Motivo="@(FlujoVentas.TieneDespacho(venta) ? null : "Aún no se entregó mercadería: anule el comprobante en su lugar.")" />
                            }
                            @if (Rol is "Vendedor" or "Cajero")
                            {
                                <BotonCondicionado Texto="Anular comprobante" Clase="btn-outline-danger" ClaseContenedor="ms-sm-auto" Ocupado="@trabajando"
                                                   Motivo="@(FlujoVentas.TieneDespacho(venta) ? "Ya salió mercadería: para devolverla use una nota de crédito (Cajero)." : null)"
                                                   AlHacerClic="PedirAnulacion" />
                            }
                        </div>
                    }
                </div>

                @if (comprobante.Estado != "ANULADO" && Rol is "Vendedor" or "Cajero")
                {
                    @* RF008: se deja registro del medio y la fecha de envío (ComprobanteBO.registrarEnvio) *@
                    <div class="card card-body mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h6 fw-semibold mb-0">Enviar al cliente</h2>
                            <span class="small text-muted">
                                Último envío:
                                @if (comprobante.MedioEnvio is null)
                                {
                                    <strong>ninguno</strong>
                                }
                                else
                                {
                                    <strong>@TextosVentas.Texto(comprobante.MedioEnvio)</strong> <span>· @TextosVentas.FechaHora(comprobante.FechaEnvio)</span>
                                }
                            </span>
                        </div>
                        <div class="d-flex flex-wrap gap-3 mb-3" role="radiogroup" aria-label="Medio de envío">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="medio" id="medioCorreo" checked="@(medioEnvio == "CORREO")"
                                       disabled="@SinCorreo" @onchange="@(() => medioEnvio = "CORREO")" />
                                <label class="form-check-label" for="medioCorreo">
                                    Correo electrónico
                                    @if (SinCorreo)
                                    {
                                        <span class="small text-muted d-block">El cliente no tiene correo registrado.</span>
                                    }
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="medio" id="medioMensajeria" checked="@(medioEnvio == "MENSAJERIA")"
                                       @onchange="@(() => medioEnvio = "MENSAJERIA")" />
                                <label class="form-check-label" for="medioMensajeria">
                                    Mensajería
                                    <span class="small text-muted d-block">Al teléfono de contacto del cliente.</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <BotonCondicionado Texto="Registrar envío" TextoOcupado="Registrando..." Clase="btn-outline-primary" Ocupado="@trabajando"
                                               AlHacerClic="RegistrarEnvio" />
                            <span class="small text-muted ms-2">Para entregarlo impreso use «Descargar PDF».</span>
                        </div>
                    </div>
                }
            }

            <div class="card mb-3">
                <div class="card-body pb-0 d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-semibold mb-2">Detalle de la venta</h2>
                    @if (FlujoVentas.TieneDespacho(venta))
                    {
                        <span class="small text-muted mb-2">«Despachada»: lo que ya salió del almacén.</span>
                    }
                </div>
                <TablaDetalle Lineas="@venta.Lineas" SubTotal="@venta.SubTotal" Igv="@venta.Igv" Total="@venta.Total" MostrarDespachada="true" />
            </div>
        </div>

        @* -------- Resumen fijo: lo esencial y lo que sigue -------- *@
        <div class="col-lg-4">
            <div class="card card-body resumen">
                <div class="small text-muted">Total de la venta</div>
                <div class="display-6 fw-bold mb-2">S/ @venta.Total.ToString("N2")</div>
                <dl class="row small mb-0">
                    <dt class="col-5 fw-normal text-muted">Cliente</dt>
                    <dd class="col-7 mb-1">@venta.Cliente<br /><span class="text-muted">@venta.DocumentoCliente</span></dd>
                    <dt class="col-5 fw-normal text-muted">Fecha</dt>
                    <dd class="col-7 mb-1">@TextosVentas.Fecha(venta.FechaEmision)</dd>
                    <dt class="col-5 fw-normal text-muted">Pago</dt>
                    <dd class="col-7 mb-1">
                        @TextosVentas.Texto(venta.CondicionPago)
                        @if (venta.CondicionPago == "CREDITO")
                        {
                            <span class="text-muted"> · @venta.PlazoCreditoDias días</span>
                        }
                    </dd>
                    <dt class="col-5 fw-normal text-muted">Estado</dt>
                    <dd class="col-7 mb-1"><Estado Texto="@TextosVentas.Texto(venta.Estado)" /></dd>
                </dl>
            </div>
        </div>
    </div>

}


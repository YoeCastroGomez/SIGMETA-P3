@page "/ventas/{Id:int}/comprobante"
@inject ApiJava Api
@inject IJSRuntime JS

<PageTitle>@(venta?.Numero ?? "Venta") · SIGMETA</PageTitle>

@* RF008 · Centro de la venta: su recorrido, la emisión del comprobante, su entrega al cliente y su anulación.
   Es la pantalla de referencia del PATRÓN UX (ver Shared/ComponentesFlujo.cs):
     - <PasosDocumento>: en qué paso está la venta y a quién le toca lo siguiente.
     - <BotonCondicionado>: lo que no se puede hacer aparece bloqueado y dice por qué (factura sin RUC,
       anular con mercadería entregada...). Las reglas siguen en el BO; aquí solo se anticipan.
     - <SiguientePaso>: después de cada acción, qué sigue y el botón para hacerlo.
     - <ModalMotivo>: la anulación dice qué va a pasar y exige el motivo.
   Datos reales del Java:
   - GET  /api/ventas/{Id}                       la venta, sus líneas, su comprobante vigente y si ya se cobró
   - GET  /api/ordenes/{id}                      (si viene de una orden) para mostrar su cotización en el recorrido
   - GET  /api/comprobantes/{id}                 el comprobante con el cliente
   - GET  /api/comprobantes/siguiente-numero     el número que recibiría
   - POST /api/comprobantes {"idVenta", "tipo"}  emitir BOLETA o FACTURA (la serie y el número los pone el BO)
   - POST /api/comprobantes/{id}/envio {"medioEnvio"}  registrar el envío (CORREO, MENSAJERIA o IMPRESO)
   - POST /api/comprobantes/{id}/anular {"motivo"}  anular si la mercadería no salió del almacén
   - Imprimir: registra el envío IMPRESO y abre la impresión del navegador con la vista .sigmeta-impresion *@

<style>
    .sigmeta-impresion { display: none; }

    @@media print {
        @@page { size: A4; margin: 15mm; }
        /* solo se imprime el comprobante: se oculta todo lo que no lo contiene (menú, barra, botones, tarjetas) */
        body *:not(:has(.sigmeta-impresion)):not(.sigmeta-impresion):not(.sigmeta-impresion *) { display: none !important; }
        /* los contenedores del comprobante pierden márgenes y posiciones del diseño de pantalla */
        body, body *:has(.sigmeta-impresion) {
            display: block !important; position: static !important; margin: 0 !important; padding: 0 !important;
            border: 0 !important; box-shadow: none !important; background: #fff !important;
            width: auto !important; max-width: none !important; min-height: 0 !important; overflow: visible !important;
        }
        .sigmeta-impresion { display: block !important; color: #000; font-size: 11pt; }
        .sigmeta-impresion table { width: 100%; border-collapse: collapse; }
        .sigmeta-impresion th, .sigmeta-impresion td { border: 1px solid #999; padding: 4px 6px; }
        .sigmeta-impresion thead th { background: #eee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .sigmeta-impresion .imp-recuadro { border: 2px solid #000; padding: 8px 12px; text-align: center; }
        .sigmeta-impresion .imp-totales td { border: 0; }
    }
</style>

<Encabezado Rf="RF008" Titulo="@Titulo" Subtitulo="@Subtitulo">
    <a class="btn btn-outline-secondary" href="@VolverA">← Volver a ventas</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<SiguientePaso Mensaje="@exito" Detalle="@exitoDetalle" TextoAccion="@exitoAccion" Ruta="@exitoRuta"
               AlAccion="@(exitoImprimir ? EventCallback.Factory.Create(this, Imprimir) : default)"
               AlCerrar="CerrarAviso" />

<ModalMotivo Visible="@pidiendoAnulacion" Titulo="@($"Anular {comprobante?.Comprobante}")" TextoConfirmar="Anular comprobante"
             Ocupado="@trabajando" Ejemplo="Ejemplo: se emitió con el cliente equivocado."
             AlConfirmar="ConfirmarAnulacion" AlCancelar="() => pidiendoAnulacion = false">
    <p class="mb-2">Al anular <strong>@comprobante?.Comprobante</strong>:</p>
    <ul class="small mb-0">
        <li>El comprobante deja de valer (queda registrado como anulado).</li>
        <li>La venta <strong>@venta?.Numero</strong> queda sin comprobante: se puede corregir y volver a emitir, o anular.</li>
        <li>No se toca el stock: la mercadería todavía no salió del almacén.</li>
    </ul>
</ModalMotivo>

@if (cargando)
{
    <p class="text-muted">Cargando venta...</p>
}
else if (venta is not null)
{
    <PasosDocumento Pasos="@pasos" Titulo="Recorrido de la venta" />

    <div class="row g-3">
        <div class="col-lg-8">
            @if (FlujoVentas.EstaAnulada(venta))
            {
                <div class="alert alert-secondary">
                    <strong>Venta anulada.</strong> No se emite comprobante.
                    @if (!string.IsNullOrWhiteSpace(venta.MotivoAnulacion))
                    {
                        <div class="small mt-1">Motivo: @venta.MotivoAnulacion</div>
                    }
                </div>
            }
            else if (comprobante is null)
            {
                @* -------- 1. Emitir el comprobante -------- *@
                <div class="card card-body mb-3">
                    <h2 class="h6 fw-semibold mb-1">Emitir comprobante</h2>
                    <p class="small text-muted mb-3">Elija el tipo. La serie y el número los asigna el sistema al emitir.</p>
                    <div class="row g-2 mb-3" role="radiogroup" aria-label="Tipo de comprobante">
                        <div class="col-sm-6">
                            <button type="button" role="radio" aria-checked="@(esFactura ? "true" : "false")"
                                    class="opcion-tipo w-100 text-start @(esFactura ? "elegida" : "")" disabled="@(!EsRuc)" @onclick="ElegirFactura">
                                <span class="fw-semibold d-block">Factura</span>
                                <span class="small text-muted d-block">Serie F001 · para clientes con RUC</span>
                                @if (!EsRuc)
                                {
                                    <span class="small text-danger d-block mt-1">El cliente no tiene RUC: solo puede recibir boleta.</span>
                                }
                            </button>
                        </div>
                        <div class="col-sm-6">
                            <button type="button" role="radio" aria-checked="@(!esFactura ? "true" : "false")"
                                    class="opcion-tipo w-100 text-start @(!esFactura ? "elegida" : "")" @onclick="ElegirBoleta">
                                <span class="fw-semibold d-block">Boleta</span>
                                <span class="small text-muted d-block">Serie B001 · para cualquier cliente</span>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-top pt-3">
                        <div class="small text-muted">
                            Se emitirá: <strong class="text-body">@(esFactura ? "F001" : "B001")-@(string.IsNullOrEmpty(numeroPropuesto) ? "…" : numeroPropuesto)</strong>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-start">
                            @if (Rol == "Vendedor")
                            {
                                <BotonCondicionado Texto="Editar venta" Clase="btn-outline-secondary" Ruta="@($"/ventas/editar/{venta.Id}?volver={Uri.EscapeDataString(RutaActual)}")"
                                                   Motivo="@FlujoVentas.MotivoNoEditable(venta)" />
                            }
                            <BotonCondicionado Texto="Emitir comprobante" TextoOcupado="Emitiendo..." Ocupado="@trabajando"
                                               Motivo="@((Rol is "Vendedor" or "Cajero") ? null : "Solo el Vendedor o el Cajero emiten comprobantes.")"
                                               AlHacerClic="Emitir" />
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* -------- 2. Comprobante emitido -------- *@
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <div class="small text-muted text-uppercase">@TextosVentas.Texto(comprobante.Tipo)</div>
                                <div class="h5 fw-bold mb-0">@comprobante.Comprobante</div>
                                <div class="small text-muted">Emitido el @TextosVentas.Fecha(comprobante.FechaEmision)</div>
                            </div>
                            <Estado Texto="@TextosVentas.Texto(comprobante.Estado)" />
                        </div>
                        <div class="row small">
                            <div class="col-md-6 mb-2">
                                <div class="text-muted">Cliente</div>
                                <div class="fw-semibold">@comprobante.Cliente</div>
                                <div class="text-muted">@TextosVentas.Texto(comprobante.TipoDocumentoCliente) @comprobante.DocumentoCliente</div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <div class="text-muted">Contacto</div>
                                <div>@(string.IsNullOrWhiteSpace(comprobante.CorreoCliente) ? "Sin correo registrado" : comprobante.CorreoCliente)</div>
                                <div class="text-muted">@comprobante.DireccionCliente</div>
                            </div>
                        </div>
                    </div>
                    @if (comprobante.Estado != "ANULADO")
                    {
                        <div class="card-footer bg-transparent d-flex flex-wrap gap-2 align-items-start">
                            <BotonCondicionado Texto="Imprimir o guardar PDF" Clase="btn-primary" Ocupado="@trabajando" AlHacerClic="Imprimir"
                                               Motivo="@((Rol is "Vendedor" or "Cajero") ? null : "Solo el Vendedor o el Cajero entregan comprobantes.")" />
                            @if (Rol == "Cajero")
                            {
                                @* RF013: si la mercadería ya se entregó, la devolución va con nota de crédito *@
                                <BotonCondicionado Texto="Nota de crédito" Clase="btn-outline-secondary"
                                                   Ruta="@($"/notas-credito/nueva?comprobante={comprobante.Id}")"
                                                   Motivo="@(FlujoVentas.TieneDespacho(venta) ? null : "Aún no se entregó mercadería: anule el comprobante en su lugar.")" />
                            }
                            @if (Rol is "Vendedor" or "Cajero")
                            {
                                <BotonCondicionado Texto="Anular comprobante" Clase="btn-outline-danger" ClaseContenedor="ms-sm-auto" Ocupado="@trabajando"
                                                   Motivo="@(FlujoVentas.TieneDespacho(venta) ? "Ya salió mercadería: para devolverla use una nota de crédito (Cajero)." : null)"
                                                   AlHacerClic="PedirAnulacion" />
                            }
                        </div>
                    }
                </div>

                @if (comprobante.Estado != "ANULADO" && Rol is "Vendedor" or "Cajero")
                {
                    @* RF008: se deja registro del medio y la fecha de envío (ComprobanteBO.registrarEnvio) *@
                    <div class="card card-body mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h6 fw-semibold mb-0">Enviar al cliente</h2>
                            <span class="small text-muted">
                                Último envío:
                                @if (comprobante.MedioEnvio is null)
                                {
                                    <strong>ninguno</strong>
                                }
                                else
                                {
                                    <strong>@TextosVentas.Texto(comprobante.MedioEnvio)</strong> <span>· @TextosVentas.FechaHora(comprobante.FechaEnvio)</span>
                                }
                            </span>
                        </div>
                        <div class="d-flex flex-wrap gap-3 mb-3" role="radiogroup" aria-label="Medio de envío">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="medio" id="medioCorreo" checked="@(medioEnvio == "CORREO")"
                                       disabled="@SinCorreo" @onchange="@(() => medioEnvio = "CORREO")" />
                                <label class="form-check-label" for="medioCorreo">
                                    Correo electrónico
                                    @if (SinCorreo)
                                    {
                                        <span class="small text-muted d-block">El cliente no tiene correo registrado.</span>
                                    }
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="medio" id="medioMensajeria" checked="@(medioEnvio == "MENSAJERIA")"
                                       @onchange="@(() => medioEnvio = "MENSAJERIA")" />
                                <label class="form-check-label" for="medioMensajeria">
                                    Mensajería
                                    <span class="small text-muted d-block">Al teléfono de contacto del cliente.</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <BotonCondicionado Texto="Registrar envío" TextoOcupado="Registrando..." Clase="btn-outline-primary" Ocupado="@trabajando"
                                               AlHacerClic="RegistrarEnvio" />
                            <span class="small text-muted ms-2">Para entregarlo impreso use «Imprimir o guardar PDF».</span>
                        </div>
                    </div>
                }
            }

            <div class="card mb-3">
                <div class="card-body pb-0 d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-semibold mb-2">Detalle de la venta</h2>
                    @if (FlujoVentas.TieneDespacho(venta))
                    {
                        <span class="small text-muted mb-2">«Despachada»: lo que ya salió del almacén.</span>
                    }
                </div>
                <TablaDetalle Lineas="@venta.Lineas" SubTotal="@venta.SubTotal" Igv="@venta.Igv" Total="@venta.Total" MostrarDespachada="true" />
            </div>
        </div>

        @* -------- Resumen fijo: lo esencial y lo que sigue -------- *@
        <div class="col-lg-4">
            <div class="card card-body resumen">
                <div class="small text-muted text-uppercase">Total de la venta</div>
                <div class="display-6 fw-bold mb-2">S/ @venta.Total.ToString("N2")</div>
                <dl class="row small mb-0">
                    <dt class="col-5 fw-normal text-muted">Cliente</dt>
                    <dd class="col-7 mb-1">@venta.Cliente<br /><span class="text-muted">@venta.DocumentoCliente</span></dd>
                    <dt class="col-5 fw-normal text-muted">Fecha</dt>
                    <dd class="col-7 mb-1">@TextosVentas.Fecha(venta.FechaEmision)</dd>
                    <dt class="col-5 fw-normal text-muted">Pago</dt>
                    <dd class="col-7 mb-1">
                        @TextosVentas.Texto(venta.CondicionPago)
                        @if (venta.CondicionPago == "CREDITO")
                        {
                            <span class="text-muted"> · @venta.PlazoCreditoDias días</span>
                        }
                    </dd>
                    <dt class="col-5 fw-normal text-muted">Estado</dt>
                    <dd class="col-7 mb-1"><Estado Texto="@TextosVentas.Texto(venta.Estado)" /></dd>
                </dl>
                <div class="siguiente-paso mt-3">
                    <div class="small text-muted text-uppercase">Siguiente paso</div>
                    <div class="fw-semibold">@Siguiente.Que</div>
                    @if (Siguiente.Quien is not null)
                    {
                        <div class="small">Le toca: <strong>@Siguiente.Quien</strong></div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (comprobante is not null && comprobante.Estado != "ANULADO")
    {
        var lineasImpresas = comprobante.Lineas.Count > 0 ? comprobante.Lineas : venta.Lineas;
        @* RF008 · Representación impresa del comprobante. Oculta en pantalla; es lo único que sale al imprimir *@
        <div class="sigmeta-impresion">
            <table class="mb-3" style="border: 0;">
                <tr>
                    <td style="border: 0; vertical-align: top;">
                        <div style="font-size: 16pt; font-weight: 700;">GRUPO META</div>
                        <div>Ferretería industrial · herramientas y suministros</div>
                    </td>
                    <td style="border: 0; width: 40%;">
                        <div class="imp-recuadro">
                            <div style="font-weight: 700;">@TituloImpreso</div>
                            <div style="font-size: 14pt; font-weight: 700;">@comprobante.Comprobante</div>
                        </div>
                    </td>
                </tr>
            </table>

            <table class="mb-3">
                <tr>
                    <td style="width: 22%;"><strong>Cliente</strong></td>
                    <td>@comprobante.Cliente</td>
                    <td style="width: 18%;"><strong>Fecha de emisión</strong></td>
                    <td style="width: 15%;">@TextosVentas.Fecha(comprobante.FechaEmision)</td>
                </tr>
                <tr>
                    <td><strong>@TextosVentas.Texto(comprobante.TipoDocumentoCliente)</strong></td>
                    <td>@comprobante.DocumentoCliente</td>
                    <td><strong>Condición de pago</strong></td>
                    <td>@TextosVentas.Texto(comprobante.CondicionPago ?? venta.CondicionPago)</td>
                </tr>
                <tr>
                    <td><strong>Dirección</strong></td>
                    <td>@(comprobante.DireccionCliente ?? "—")</td>
                    <td><strong>Venta</strong></td>
                    <td>@(comprobante.NumeroVenta ?? venta.Numero)</td>
                </tr>
            </table>

            <table class="mb-2">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;">#</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th style="text-align: right;">Cantidad</th>
                        <th style="text-align: right;">P. unit. (S/)</th>
                        <th style="text-align: right;">Dscto. (S/)</th>
                        <th style="text-align: right;">Importe (S/)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in lineasImpresas)
                    {
                        <tr>
                            <td>@l.NumeroLinea</td>
                            <td>@l.CodigoProducto</td>
                            <td>@l.Producto</td>
                            <td style="text-align: right;">@l.Cantidad.ToString("0.###")</td>
                            <td style="text-align: right;">@l.PrecioUnitario.ToString("N2")</td>
                            <td style="text-align: right;">@l.Descuento.ToString("N2")</td>
                            <td style="text-align: right;">@l.Importe.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <table class="imp-totales" style="width: 40%; margin-left: auto;">
                <tr><td>Op. gravada</td><td style="text-align: right;">S/ @comprobante.SubTotal.ToString("N2")</td></tr>
                <tr><td>IGV (18 %)</td><td style="text-align: right;">S/ @comprobante.Igv.ToString("N2")</td></tr>
                <tr><td><strong>Importe total</strong></td><td style="text-align: right;"><strong>S/ @comprobante.Total.ToString("N2")</strong></td></tr>
            </table>

            <p style="margin-top: 24px; font-size: 9pt; text-align: center;">
                Representación impresa del comprobante electrónico @comprobante.Comprobante · Generado por SIGMETA
            </p>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    // de dónde se vino (la lista de ventas con sus filtros) y si se acaba de registrar la venta
    [SupplyParameterFromQuery(Name = "volver")] public string? VolverQ { get; set; }
    [SupplyParameterFromQuery(Name = "nueva")] public bool Nueva { get; set; }
    // vuelve del formulario de la venta después de modificarla (?guardado=editado&ref=VTA-...)
    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private VentaDatos? venta;
    private OrdenDatos? orden;
    private ComprobanteDatos? comprobante;
    private List<PasoDocumento> pasos = new();
    private bool esFactura;
    private string numeroPropuesto = "";
    private sealed class NumeroPropuesto { public string Numero { get; set; } = ""; }
    private string medioEnvio = "CORREO";
    private bool cargando = true;
    private bool trabajando;
    private string? error;
    private bool pidiendoAnulacion;
    private bool avisoNuevaMostrado;

    // aviso de éxito con el siguiente paso
    private string? exito;
    private string? exitoDetalle;
    private string? exitoAccion;
    private string? exitoRuta;
    private bool exitoImprimir;

    private string VolverA => Volver.A(VolverQ, "/ventas");
    private string RutaActual => "/" + Nav.ToBaseRelativePath(Nav.Uri);
    private string Titulo => venta is null ? "Venta" : $"Venta {venta.Numero}";
    private string Subtitulo => venta is null ? "" : $"{venta.Cliente} · {TextosVentas.Texto(venta.CondicionPago)}";
    private string TituloImpreso => comprobante?.Tipo == "FACTURA" ? "FACTURA ELECTRÓNICA" : "BOLETA DE VENTA ELECTRÓNICA";

    // RUC: 11 dígitos (la factura exige RUC; el BO lo vuelve a validar con el tipo de documento real)
    private bool EsRuc => venta?.DocumentoCliente is { Length: 11 } doc && doc.All(char.IsAsciiDigit);
    private bool SinCorreo => string.IsNullOrWhiteSpace(comprobante?.CorreoCliente);
    private (string Que, string? Quien) Siguiente => venta is null ? ("", null) : FlujoVentas.Siguiente(venta);

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        await Cargar();
        cargando = false;
        if (!avisoNuevaMostrado && venta is not null && comprobante is null)
        {
            if (Nueva)
            {
                avisoNuevaMostrado = true;
                Avisar($"Se registró la venta {venta.Numero}.", "Siguiente: emitir su factura o boleta aquí mismo.");
            }
            else if (AvisoGuardado.Texto(Guardado, "la venta", Referencia) is { } editada)
            {
                avisoNuevaMostrado = true;
                Avisar(editada, "Siguiente: emitir su factura o boleta aquí mismo.");
            }
        }
    }

    private async Task Cargar()
    {
        try
        {
            venta = await Api.Get<VentaDatos>($"ventas/{Id}");          // GET /api/ventas/{Id}
            comprobante = null;
            if (venta is not null && venta.IdComprobante > 0)
            {
                comprobante = await Api.Get<ComprobanteDatos>($"comprobantes/{venta.IdComprobante}");
            }
            if (venta is not null && venta.IdOrden > 0 && orden is null)
            {
                try { orden = await Api.Get<OrdenDatos>($"ordenes/{venta.IdOrden}"); }
                catch (ErrorApi) { orden = null; }   // el recorrido se muestra igual, sin la cotización
            }
            pasos = venta is null ? new() : FlujoVentas.PasosVenta(venta, orden);
            // se propone factura si el cliente tiene RUC y boleta si no
            esFactura = EsRuc;
            if (SinCorreo) medioEnvio = "MENSAJERIA";
            if (comprobante is null && venta is not null && !FlujoVentas.EstaAnulada(venta)) await ObtenerNumeroPropuesto();
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "No existe la venta con id 99"
        }
    }

    private void Avisar(string mensaje, string? detalle = null, string? accion = null, string? ruta = null, bool imprimir = false)
    {
        exito = mensaje;
        exitoDetalle = detalle;
        exitoAccion = accion;
        exitoRuta = ruta;
        exitoImprimir = imprimir;
    }

    private void CerrarAviso() => Avisar(null!);

    private async Task ElegirFactura()
    {
        if (!EsRuc) return;
        esFactura = true;
        await ObtenerNumeroPropuesto();
    }

    private async Task ElegirBoleta()
    {
        esFactura = false;
        await ObtenerNumeroPropuesto();
    }

    private async Task ObtenerNumeroPropuesto()
    {
        string serie = esFactura ? "F001" : "B001";
        numeroPropuesto = "";
        try
        {
            var propuesta = await Api.Get<NumeroPropuesto>($"comprobantes/siguiente-numero?serie={serie}");
            if (serie == (esFactura ? "F001" : "B001"))
                numeroPropuesto = propuesta?.Numero ?? "";
        }
        catch (ErrorApi e) { error = e.Message; }
    }

    // POST /api/comprobantes {"idVenta", "tipo"}
    private async Task Emitir()
    {
        error = null;
        CerrarAviso();
        trabajando = true;
        try
        {
            var emitido = await Api.Post<ComprobanteDatos>("comprobantes",
                new ComprobanteDatos { IdVenta = Id, Tipo = esFactura ? "FACTURA" : "BOLETA" });
            await Cargar();
            var despues = venta?.CondicionPago == "CONTADO"
                ? "Siguiente: entréguelo al cliente. Luego le toca al Cajero cobrar la venta en caja."
                : "Siguiente: entréguelo al cliente. Luego el Almacenero despacha la mercadería.";
            Avisar($"Se emitió la {TextosVentas.Texto(emitido?.Tipo).ToLowerInvariant()} {emitido?.Comprobante}.", despues,
                "Imprimir o guardar PDF", imprimir: true);
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "La FACTURA requiere que el cliente cuente con RUC (cliente tiene: DNI)"
        }
        finally
        {
            trabajando = false;
        }
    }

    private void PedirAnulacion()
    {
        error = null;
        CerrarAviso();
        pidiendoAnulacion = true;
    }

    // POST /api/comprobantes/{id}/anular {"motivo"}
    private async Task ConfirmarAnulacion(string motivo)
    {
        if (comprobante is null) return;
        var anulado = comprobante.Comprobante;
        trabajando = true;
        try
        {
            await Api.Post<object>($"comprobantes/{comprobante.Id}/anular", new AnulacionDatos { Motivo = motivo });
            pidiendoAnulacion = false;
            await Cargar();
            if (Rol == "Vendedor")
            {
                Avisar($"Se anuló el comprobante {anulado}.", "Ahora puede corregir la venta y luego emitir un comprobante nuevo.",
                    "Editar venta", $"/ventas/editar/{Id}?volver={Uri.EscapeDataString(RutaActual)}");
            }
            else
            {
                Avisar($"Se anuló el comprobante {anulado}.", "Puede emitir uno nuevo. La venta solo la corrige o anula el Vendedor.");
            }
        }
        catch (ErrorApi e)
        {
            pidiendoAnulacion = false;
            error = e.Message;   // por ejemplo "La venta ya tiene mercadería despachada: para devolverla emita una nota de crédito..."
        }
        finally
        {
            trabajando = false;
        }
    }

    // RF008: formato imprimible. Primero registra el envío IMPRESO (si el BO lo rechaza, no se imprime)
    // y luego abre el diálogo de impresión del navegador, que solo muestra la vista .sigmeta-impresion
    private async Task Imprimir()
    {
        if (comprobante is null) return;
        error = null;
        trabajando = true;
        try
        {
            await Api.Post<ComprobanteDatos>($"comprobantes/{comprobante.Id}/envio",
                new ComprobanteDatos { MedioEnvio = "IMPRESO" });
            await Cargar();
            Avisar("Se registró la entrega en formato imprimible.", Siguiente.Quien is null ? null : $"Siguiente: {Siguiente.Que.ToLowerInvariant()} ({Siguiente.Quien}).");
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "No se puede registrar el envío de un comprobante anulado"
            return;
        }
        finally
        {
            trabajando = false;
        }

        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("print");
        }
        catch (TaskCanceledException)
        {
            // el diálogo de impresión quedó abierto más que el tiempo de espera de Blazor: no es un error
        }
        catch (JSDisconnectedException)
        {
            // el navegador se desconectó mientras imprimía: el envío IMPRESO ya quedó registrado
        }
    }

    // POST /api/comprobantes/{id}/envio {"medioEnvio"}
    private async Task RegistrarEnvio()
    {
        if (comprobante is null) return;
        error = null;
        CerrarAviso();
        trabajando = true;
        try
        {
            await Api.Post<ComprobanteDatos>($"comprobantes/{comprobante.Id}/envio",
                new ComprobanteDatos { MedioEnvio = medioEnvio });
            await Cargar();
            Avisar($"Se registró el envío por {TextosVentas.Texto(medioEnvio).ToLowerInvariant()}.",
                Siguiente.Quien is null ? null : $"Siguiente: {Siguiente.Que.ToLowerInvariant()} ({Siguiente.Quien}).");
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "El cliente no tiene teléfono de contacto registrado..."
        }
        finally
        {
            trabajando = false;
        }
    }

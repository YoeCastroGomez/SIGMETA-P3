@page "/notas-credito/nueva"
@* RF001/RF013: registrar una nota de crédito es del Cajero (el Administrador la autoriza, la consulta,
   la modifica y la anula desde la lista de notas de crédito, pero no la registra) *@
@attribute [Authorize(Roles = "Cajero")]
@inject ApiJava Api
@inject NavigationManager Nav
@using SigmetaWeb.Components.Pages.Almacen
@using SigmetaWeb.Components.Pages.Seguridad

<PageTitle>Nueva nota de crédito · SIGMETA</PageTitle>

@* RF013 y RF014 · Nota de crédito por devolución. Todo en esta pantalla, en orden:
     1 Preparar: comprobante, motivo y cantidades (la vista previa del total la calcula aquí; el BO la recalcula).
     2 Autorización: "Solicitar autorización" manda ESTA nota (POST /api/notas-credito/solicitar, mismo cuerpo que
       registrarla). El sistema arma lo que ve el Administrador (comprobante, cliente, productos y total).
       Mientras espera, PedirAutorizacion consulta sola cada pocos segundos y los datos quedan bloqueados.
     3 Registrar: con la autorización aprobada, POST /api/notas-credito. El BO exige la autorización de ESA nota
       (mismo comprobante y cantidades) y la consume (un solo uso).
   RF013 exige la autorización ANTES de emitir: la nota mueve stock, deuda y caja apenas se registra.
   GET /api/notas-credito/comprobantes
   · GET /api/notas-credito/comprobantes/{id}/lineas *@
<Encabezado Rf="RF013" Titulo="Nueva nota de crédito">
    <a class="btn btn-outline-secondary" href="/notas-credito">Volver</a>
</Encabezado>

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />
<Notificacion Mensaje="@exito" AlCerrar="() => exito = null" />

@if (!cargado)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <PasosDocumento Pasos="@Pasos" Titulo="Pasos de la nota de crédito" />

    <div class="row g-3">
        <div class="col-lg-8">
            @* -------- 1. Comprobante y motivo -------- *@
            <div class="card card-body mb-3">
                <div class="row">
                    <Campo Etiqueta="Comprobante" Id="comprobante" Obligatorio="true" Error="@E("comprobante")" Clase="col-md-7 mb-3"
                           Ayuda="@(comprobantes.Count == 0 ? "No hay facturas ni boletas con mercadería entregada." : null)">
                        <select id="comprobante" class="form-select @Invalido("comprobante")" @bind="idComprobante" @bind:after="AlElegirComprobante"
                                disabled="@EsperandoOAutorizada">
                            <option value="0">Elija el comprobante</option>
                            @foreach (var c in comprobantes)
                            {
                                <option value="@c.Id">@c.Comprobante · @c.Cliente · @Formato.Soles(c.Total)</option>
                            }
                        </select>
                    </Campo>
                    <Campo Etiqueta="Motivo" Id="motivo" Obligatorio="true" Error="@E("motivo")" Clase="col-md-5 mb-3">
                        <input id="motivo" class="form-control @Invalido("motivo")" maxlength="150" placeholder="Ejemplo: producto con falla"
                               @bind="motivo" @bind:event="oninput" disabled="@EsperandoOAutorizada" />
                    </Campo>
                </div>
                @if (Origen is not null)
                {
                    <div class="small text-muted border-top pt-2">
                        @Origen.Cliente · @Origen.NumeroDocumento · Venta @Origen.Venta · @Formato.Legible(Origen.CondicionPago) · @Formato.Fecha(Origen.FechaEmision)
                    </div>
                }
            </div>

            @* -------- Productos que se devuelven -------- *@
            @if (Origen is not null)
            {
                <div class="card mb-3">
                    <div class="card-body pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h2 class="h6 fw-semibold mb-0">Productos que se devuelven</h2>
                        @if (!EsperandoOAutorizada && lineas.Any(l => l.Devolvible > 0))
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DevolverTodo">Devolver todo</button>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 tabla-lista">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Entregado</th>
                                    <th class="text-end">Ya devuelto</th>
                                    <th class="text-end">Precio (S/)</th>
                                    <th style="width: 9.5rem;">Devolver</th>
                                    <th class="text-end">Importe (S/)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in lineas)
                                {
                                    var problema = Problema(l);
                                    <tr class="@(l.Devolvible <= 0 ? "text-muted" : "")">
                                        <td>@l.Producto</td>
                                        <td class="text-end">@Formato.Cantidad(l.CantidadDespachada)</td>
                                        <td class="text-end">@Formato.Cantidad(l.Acreditado)</td>
                                        <td class="text-end">@l.PrecioEfectivo.ToString("N2")</td>
                                        <td>
                                            @if (l.Devolvible > 0)
                                            {
                                                <div class="input-group input-group-sm">
                                                    <input type="number" min="0" max="@l.Devolvible" step="any" class="form-control text-end @(problema is null ? "" : "is-invalid")"
                                                           aria-label="@($"Cantidad a devolver de {l.Producto}")" title="@($"Máximo {Formato.Cantidad(l.Devolvible)}")"
                                                           @bind="l.Devolver" @bind:event="oninput" disabled="@EsperandoOAutorizada" />
                                                    <span class="input-group-text">@TextosAlmacen.Unidad(l.UnidadVenta).ToLowerInvariant()</span>
                                                </div>
                                                @if (problema is not null)
                                                {
                                                    <div class="small text-danger mt-1">@problema</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="small">@(l.CantidadDespachada <= 0 ? "Sin entregar" : "Ya devuelto")</span>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">@(l.Devolver > 0 ? l.ImporteDevolucion.ToString("N2") : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        @* -------- Resumen: total, efectos, autorización y registrar -------- *@
        <div class="col-lg-4">
            @* RF013: tipo de nota (catálogo 09 SUNAT), mismo criterio que ComprobanteBOImpl.tipoNotaCredito *@
            <ResumenTotal Etiqueta="Total de la nota" Total="@((decimal)Total)" SubTotal="@((decimal)SubTotal)" Igv="@((decimal)Igv)"
                          Detalle="@(Total > 0 ? NotaCreditoDatos.TextoTipo(TipoNota) : null)">
                @if (Origen is not null && Total > 0)
                {
                    @* qué pasará al registrar: mueve stock y dinero, por eso se dice antes *@
                    <ul class="small text-muted ps-3 mb-0">
                        <li>Reingresa al stock.</li>
                        <li>@(Origen.CondicionPago == "CREDITO" ? "Baja la deuda del cliente." : "Si ya se cobró, sale un egreso de su caja.")</li>
                    </ul>
                }
                @if (Faltan.Count > 0)
                {
                    <ul class="lista-pendientes list-unstyled small mb-0" aria-label="Lo que falta">
                        @foreach (var f in Faltan)
                        {
                            <li class="falta"><span class="marca" aria-hidden="true">•</span><span>@f</span></li>
                        }
                    </ul>
                }

                <PedirAutorizacion Listo="@Preparada" Solicitar="SolicitarAutorizacion"
                                   EstadoChanged="e => estadoAutorizacion = e" AlError="m => error = m">
                    <BotonCondicionado Texto="Registrar nota de crédito" TextoOcupado="Registrando..." Bloque="true" Clase="btn-primary w-100"
                                       Ocupado="@guardando" AlHacerClic="Guardar" />
                </PedirAutorizacion>
                <a class="btn btn-outline-secondary w-100" href="/notas-credito">Cancelar</a>
            </ResumenTotal>
        </div>
    </div>
}


@page "/notas-credito/nueva"
@inject ApiJava Api
@inject NavigationManager Nav
@using SigmetaWeb.Components.Pages.Almacen
@using SigmetaWeb.Components.Pages.Seguridad

<PageTitle>Nueva nota de crédito · SIGMETA</PageTitle>

@* RF013 y RF014 · Nota de crédito por devolución (Cajero con autorización del Administrador).
   GET /api/solicitudes/vigente?operacion=EMITIR_NOTA_CREDITO · GET /api/notas-credito/comprobantes
   · GET /api/notas-credito/comprobantes/{id}/lineas · POST /api/notas-credito.
   Los importes de esta pantalla son una vista previa: el Java los vuelve a calcular. *@
<Encabezado Rf="RF013" Titulo="Nueva nota de crédito"
            Subtitulo="Devolución de mercadería ya entregada. Se devuelve el precio que realmente pagó el cliente.">
    <a class="btn btn-outline-secondary" href="/notas-credito">Volver</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (!cargado)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    @if (autorizacion is null)
    {
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Para emitir una nota de crédito necesitas una <strong>autorización vigente del Administrador</strong>. Cada autorización sirve para una nota.</span>
            <a class="btn btn-sm btn-dark" href="@($"/autorizaciones/nueva?operacion={TextosSeguridad.OperacionNotaCredito}&volver=/notas-credito/nueva")">Solicitar autorización</a>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            Autorización vigente hasta las <strong>@Formato.FechaHora(autorizacion.FechaVencimiento)</strong>,
            aprobada por @autorizacion.Administrador. Se usará en esta nota.
        </div>
    }

    <div class="card card-body mb-3">
        <div class="row">
            <Campo Etiqueta="Comprobante de origen" Id="comprobante" Obligatorio="true" Error="@E("comprobante")" Clase="col-md-7 mb-3"
                   Ayuda="Facturas y boletas vigentes que ya tienen mercadería entregada.">
                <select id="comprobante" class="form-select @Invalido("comprobante")" @bind="idComprobante" @bind:after="AlElegirComprobante">
                    <option value="0">Elige el comprobante</option>
                    @foreach (var c in comprobantes)
                    {
                        <option value="@c.Id">@c.Comprobante · @c.Cliente · @Formato.Soles(c.Total)</option>
                    }
                </select>
            </Campo>
            <Campo Etiqueta="Motivo de la devolución" Id="motivo" Obligatorio="true" Error="@E("motivo")" Clase="col-md-5 mb-3">
                <input id="motivo" class="form-control @Invalido("motivo")" maxlength="200" @bind="motivo" @bind:event="oninput" />
            </Campo>
        </div>

        @if (Origen is not null)
        {
            <div class="row border-top pt-3">
                <div class="col-sm-6 col-md-4 mb-2">
                    <div class="small text-muted text-uppercase">Cliente</div>
                    <div class="fw-semibold">@Origen.Cliente</div>
                    <div class="small text-muted">@Origen.NumeroDocumento</div>
                </div>
                <div class="col-sm-6 col-md-3 mb-2">
                    <div class="small text-muted text-uppercase">Venta</div>
                    <div class="fw-semibold">@Origen.Venta</div>
                </div>
                <div class="col-sm-6 col-md-3 mb-2">
                    <div class="small text-muted text-uppercase">Condición de pago</div>
                    <div class="fw-semibold">@Formato.Legible(Origen.CondicionPago)</div>
                </div>
                <div class="col-sm-6 col-md-2 mb-2">
                    <div class="small text-muted text-uppercase">Emisión</div>
                    <div class="fw-semibold">@Formato.Fecha(Origen.FechaEmision)</div>
                </div>
            </div>
        }
    </div>

    @if (Origen is not null)
    {
        <div class="card mb-3">
            <div class="card-body pb-0"><h2 class="h6 fw-semibold mb-0">Mercadería que se devuelve</h2></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Vendido</th>
                            <th class="text-end">Entregado</th>
                            <th class="text-end">Ya devuelto</th>
                            <th class="text-end">Precio cobrado</th>
                            <th style="width: 160px;">Devolver</th>
                            <th class="text-end">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lineas)
                        {
                            var problema = Problema(l);
                            <tr class="@(l.Devolvible <= 0 ? "text-muted" : "")">
                                <td><strong>@l.CodigoInterno</strong> · @l.Producto</td>
                                <td class="text-end">@Formato.Cantidad(l.Cantidad)</td>
                                <td class="text-end">@Formato.Cantidad(l.CantidadDespachada)</td>
                                <td class="text-end">@Formato.Cantidad(l.Acreditado)</td>
                                <td class="text-end">@l.PrecioEfectivo.ToString("N2")</td>
                                <td>
                                    @if (l.Devolvible > 0)
                                    {
                                        <div class="input-group input-group-sm">
                                            <input type="number" min="0" max="@l.Devolvible" step="any" class="form-control @(problema is null ? "" : "is-invalid")"
                                                   aria-label="@($"Cantidad a devolver de {l.Producto}")" @bind="l.Devolver" @bind:event="oninput" />
                                            <span class="input-group-text">@TextosAlmacen.Unidad(l.UnidadVenta)</span>
                                        </div>
                                        <div class="small @(problema is null ? "text-muted" : "text-danger") mt-1">@(problema ?? $"Máximo {Formato.Cantidad(l.Devolvible)}")</div>
                                    }
                                    else
                                    {
                                        <span class="small">@(l.CantidadDespachada <= 0 ? "Sin entregar" : "Ya devuelto")</span>
                                    }
                                </td>
                                <td class="text-end">@(l.Devolver > 0 ? l.ImporteDevolucion.ToString("N2") : "")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr><td colspan="6" class="text-end">Subtotal</td><td class="text-end">@SubTotal.ToString("N2")</td></tr>
                        <tr><td colspan="6" class="text-end">IGV (18 %)</td><td class="text-end">@Igv.ToString("N2")</td></tr>
                        <tr><td colspan="6" class="text-end fw-bold">Total de la nota</td><td class="text-end fw-bold">@Formato.Soles(Total)</td></tr>
                        @if (Total > 0)
                        {
                            @* RF013: tipo de nota (catálogo 09 SUNAT), mismo criterio que ComprobanteBOImpl.tipoNotaCredito *@
                            <tr><td colspan="6" class="text-end text-muted">Tipo de nota</td><td class="text-end text-muted">@NotaCreditoDatos.TextoTipo(TipoNota)</td></tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-2">Qué pasará al registrar</h2>
            <ul class="small mb-3">
                <li>La mercadería devuelta <strong>reingresa al stock</strong>.</li>
                @if (Origen.CondicionPago == "CREDITO")
                {
                    <li>Venta al crédito: <strong>se rebaja la deuda</strong> del cliente por @Formato.Soles(Total). Si ya la había pagado,
                        lo que exceda su saldo se le devuelve en efectivo desde tu caja abierta.</li>
                }
                else
                {
                    <li>Venta al contado: si ya se cobró, se registra un <strong>egreso de @Formato.Soles(Total)</strong> en tu caja abierta
                        por el mismo medio de pago del cobro.</li>
                }
                <li>La autorización queda usada: para otra nota hay que pedir una nueva.</li>
            </ul>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3">
                <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="/notas-credito">Cancelar</a>
                    <button class="btn btn-primary" disabled="@(guardando || autorizacion is null)" @onclick="Guardar">Registrar nota de crédito</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private const double TasaIgv = 0.18;

    private SolicitudDatos? autorizacion;
    private List<ComprobanteParaNota> comprobantes = new();
    private List<LineaDevolvible> lineas = new();
    private int idComprobante;
    private string motivo = "";
    private bool cargado;
    private bool intento;
    private bool guardando;
    private string? error;

    private ComprobanteParaNota? Origen => comprobantes.FirstOrDefault(c => c.Id == idComprobante);
    private double SubTotal => Math.Round(lineas.Where(l => l.Devolver > 0).Sum(l => l.ImporteDevolucion), 2);
    private double Igv => Math.Round(SubTotal * TasaIgv, 2, MidpointRounding.AwayFromZero);
    private double Total => Math.Round(SubTotal + Igv, 2);
    private string TipoNota => Origen is not null && Math.Abs(Total - Origen.Total) <= 0.01 ? "DEVOLUCION_TOTAL" : "DEVOLUCION_POR_ITEM";

    // misma regla que el BO: solo lo entregado y todavía no devuelto
    private static string? Problema(LineaDevolvible l) =>
        l.Devolver < 0 ? "No puede ser negativa."
        : l.Devolver > l.Devolvible + 0.0005 ? $"Máximo {Formato.Cantidad(l.Devolvible)}."
        : null;

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (Origen is null) e["comprobante"] = "Elige el comprobante que se corrige.";
        if (string.IsNullOrWhiteSpace(motivo)) e["motivo"] = "El motivo es obligatorio.";
        return e;
    }

    private string? E(string campo) => intento && Errores().TryGetValue(campo, out var m) ? m : null;
    private string Invalido(string campo) => E(campo) is null ? "" : "is-invalid";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            comprobantes = await Api.Get<List<ComprobanteParaNota>>("notas-credito/comprobantes") ?? new();
            autorizacion = await Api.Get<SolicitudDatos>($"solicitudes/vigente?operacion={TextosSeguridad.OperacionNotaCredito}");
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        cargado = true;
    }

    private async Task AlElegirComprobante()
    {
        lineas = new();
        error = null;
        if (idComprobante == 0) return;
        try
        {
            lineas = await Api.Get<List<LineaDevolvible>>($"notas-credito/comprobantes/{idComprobante}/lineas") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private async Task Guardar()
    {
        intento = true;
        error = null;
        if (Errores().Count > 0 || lineas.Any(l => Problema(l) is not null))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        if (!lineas.Any(l => l.Devolver > 0))
        {
            error = "Escribe la cantidad que se devuelve en al menos un producto.";
            return;
        }
        guardando = true;
        try
        {
            var guardada = await Api.Post<NotaGuardada>("notas-credito", new
            {
                idComprobanteOrigen = idComprobante,
                motivo = motivo.Trim(),
                lineas = lineas.Where(l => l.Devolver > 0).Select(l => new { idLinea = l.IdDetalleVenta, cantidad = l.Devolver })
            });
            Nav.NavigateTo(AvisoGuardado.Ruta("/notas-credito", AvisoGuardado.Nuevo, guardada?.Nota));
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private class NotaGuardada
    {
        public int Id { get; set; }
        public string? Nota { get; set; }
    }
}

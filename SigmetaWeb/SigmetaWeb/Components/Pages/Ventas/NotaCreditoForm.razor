@page "/notas-credito/nueva"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Cajero,Administrador")]
@inject ApiJava Api
@inject NavigationManager Nav
@using SigmetaWeb.Components.Pages.Almacen
@using SigmetaWeb.Components.Pages.Seguridad

<PageTitle>Nueva nota de crédito · SIGMETA</PageTitle>

@* RF013 y RF014 · Nota de crédito por devolución (Cajero con autorización del Administrador).
   PATRÓN UX (ver Shared/ComponentesFlujo.cs):
     - Los requisitos se ven como pasos: 1 Autorización del Administrador (sin pedir / pendiente / vigente,
       con "Actualizar" para ver si ya la aprobó), 2 Comprobante y productos, 3 Registrar.
     - "Registrar" se bloquea y dice qué falta. Antes de registrar se ve qué va a pasar (stock, deuda, caja).
   GET /api/solicitudes/vigente?operacion=EMITIR_NOTA_CREDITO · GET /api/solicitudes/mias · GET /api/notas-credito/comprobantes
   · GET /api/notas-credito/comprobantes/{id}/lineas · POST /api/notas-credito.
   Los importes de esta pantalla son una vista previa: el Java los vuelve a calcular. *@
<Encabezado Rf="RF013" Titulo="Nueva nota de crédito"
            Subtitulo="Devolución de mercadería ya entregada. Se devuelve el precio que realmente pagó el cliente.">

</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (!cargado)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <PasosDocumento Pasos="@Pasos" Titulo="Requisitos de la nota de crédito" />

    @* -------- 1. Autorización (RF014) -------- *@
    @if (autorizacion is not null)
    {
        <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Autorización vigente hasta las <strong>@Formato.FechaHora(autorizacion.FechaVencimiento)</strong>, aprobada por @autorizacion.Administrador.
                Se usará en esta nota (sirve para una sola).</span>
        </div>
    }
    else if (solicitudPendiente)
    {
        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Su solicitud de autorización está <strong>pendiente</strong>. Cuando el Administrador la apruebe, pulse «Actualizar».</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-dark" disabled="@consultando" @onclick="ConsultarAutorizacion">@(consultando ? "Consultando..." : "Actualizar")</button>
                <a class="btn btn-sm btn-outline-dark" href="/autorizaciones/mias">Mis solicitudes</a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Para emitir una nota de crédito necesita una <strong>autorización vigente del Administrador</strong>. Cada autorización sirve para una nota.
                Puede preparar la devolución mientras tanto.</span>
            <a class="btn btn-sm btn-dark" href="@($"/autorizaciones/nueva?operacion={TextosSeguridad.OperacionNotaCredito}&volver={Uri.EscapeDataString(RutaActual)}")">Solicitar autorización</a>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            @* -------- 2. Comprobante y productos -------- *@
            <div class="card card-body mb-3">
                <div class="row">
                    <Campo Etiqueta="Comprobante de origen" Id="comprobante" Obligatorio="true" Error="@E("comprobante")" Clase="col-md-7 mb-3"
                           Ayuda="@(comprobantes.Count == 0 ? "No hay facturas ni boletas con mercadería entregada." : "Facturas y boletas vigentes que ya tienen mercadería entregada.")">
                        <select id="comprobante" class="form-select @Invalido("comprobante")" @bind="idComprobante" @bind:after="AlElegirComprobante">
                            <option value="0">Elija el comprobante</option>
                            @foreach (var c in comprobantes)
                            {
                                <option value="@c.Id">@c.Comprobante · @c.Cliente · @Formato.Soles(c.Total)</option>
                            }
                        </select>
                    </Campo>
                    <Campo Etiqueta="Motivo de la devolución" Id="motivo" Obligatorio="true" Error="@E("motivo")" Clase="col-md-5 mb-3">
                        <input id="motivo" class="form-control @Invalido("motivo")" maxlength="200" placeholder="Ejemplo: producto con falla"
                               @bind="motivo" @bind:event="oninput" />
                    </Campo>
                </div>

                @if (Origen is not null)
                {
                    <div class="row border-top pt-3 small">
                        <div class="col-sm-6 col-md-4 mb-2">
                            <div class="text-muted">Cliente</div>
                            <div class="fw-semibold">@Origen.Cliente</div>
                            <div class="text-muted">@Origen.NumeroDocumento</div>
                        </div>
                        <div class="col-sm-6 col-md-3 mb-2">
                            <div class="text-muted">Venta</div>
                            <div class="fw-semibold">@Origen.Venta</div>
                        </div>
                        <div class="col-sm-6 col-md-3 mb-2">
                            <div class="text-muted">Condición de pago</div>
                            <div class="fw-semibold">@Formato.Legible(Origen.CondicionPago)</div>
                        </div>
                        <div class="col-sm-6 col-md-2 mb-2">
                            <div class="text-muted">Emisión</div>
                            <div class="fw-semibold">@Formato.Fecha(Origen.FechaEmision)</div>
                        </div>
                    </div>
                }
            </div>

            @if (Origen is not null)
            {
                <div class="card mb-3">
                    <div class="card-body pb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h2 class="h6 fw-semibold mb-2">Mercadería que se devuelve</h2>
                        @if (lineas.Any(l => l.Devolvible > 0))
                        {
                            <div class="d-flex gap-2 mb-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DevolverTodo">Devolver todo lo entregado</button>
                                @if (lineas.Any(l => l.Devolver > 0))
                                {
                                    <button type="button" class="btn btn-sm btn-link" @onclick="LimpiarCantidades">Poner en 0</button>
                                }
                            </div>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Vendido</th>
                                    <th class="text-end">Entregado</th>
                                    <th class="text-end">Ya devuelto</th>
                                    <th class="text-end">Precio cobrado</th>
                                    <th style="width: 170px;">Devolver</th>
                                    <th class="text-end">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in lineas)
                                {
                                    var problema = Problema(l);
                                    <tr class="@(l.Devolvible <= 0 ? "text-muted" : "")">
                                        <td><strong>@l.CodigoInterno</strong> · @l.Producto</td>
                                        <td class="text-end">@Formato.Cantidad(l.Cantidad)</td>
                                        <td class="text-end">@Formato.Cantidad(l.CantidadDespachada)</td>
                                        <td class="text-end">@Formato.Cantidad(l.Acreditado)</td>
                                        <td class="text-end">@l.PrecioEfectivo.ToString("N2")</td>
                                        <td>
                                            @if (l.Devolvible > 0)
                                            {
                                                <div class="input-group input-group-sm">
                                                    <input type="number" min="0" max="@l.Devolvible" step="any" class="form-control @(problema is null ? "" : "is-invalid")"
                                                           aria-label="@($"Cantidad a devolver de {l.Producto}")" @bind="l.Devolver" @bind:event="oninput" />
                                                    <button type="button" class="btn btn-outline-secondary" title="Devolver todo lo entregado de este producto"
                                                            @onclick="() => l.Devolver = l.Devolvible">Todo</button>
                                                </div>
                                                <div class="small @(problema is null ? "text-muted" : "text-danger") mt-1">@(problema ?? $"Máximo {Formato.Cantidad(l.Devolvible)} {TextosAlmacen.Unidad(l.UnidadVenta).ToLowerInvariant()}")</div>
                                            }
                                            else
                                            {
                                                <span class="small">@(l.CantidadDespachada <= 0 ? "Sin entregar" : "Ya devuelto")</span>
                                            }
                                        </td>
                                        <td class="text-end">@(l.Devolver > 0 ? l.ImporteDevolucion.ToString("N2") : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        @* -------- 3. Resumen fijo: qué pasará y Registrar -------- *@
        <div class="col-lg-4">
            <div class="card card-body resumen">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="small text-muted text-uppercase">Total de la nota</div>
                    @if (Total > 0)
                    {
                        @* RF013: tipo de nota (catálogo 09 SUNAT), mismo criterio que ComprobanteBOImpl.tipoNotaCredito *@
                        <span class="badge rounded-pill border @Tonos.Clase("azul")">@NotaCreditoDatos.TextoTipo(TipoNota)</span>
                    }
                </div>
                <div class="display-6 fw-bold">@Formato.Soles(Total)</div>
                <div class="d-flex justify-content-between small text-muted mt-1"><span>Subtotal</span><span>@Formato.Soles(SubTotal)</span></div>
                <div class="d-flex justify-content-between small text-muted"><span>IGV (18 %)</span><span>@Formato.Soles(Igv)</span></div>

                @if (Origen is not null && Total > 0)
                {
                    <div class="mt-3">
                        <div class="small text-muted text-uppercase mb-1">Qué pasará al registrar</div>
                        <ul class="small ps-3 mb-0">
                            <li>La mercadería devuelta <strong>reingresa al stock</strong>.</li>
                            @if (Origen.CondicionPago == "CREDITO")
                            {
                                <li>Al crédito: <strong>baja la deuda</strong> del cliente en @Formato.Soles(Total). Lo que pase de su saldo se le devuelve en efectivo desde su caja abierta.</li>
                            }
                            else
                            {
                                <li>Al contado: si ya se cobró, sale un <strong>egreso de @Formato.Soles(Total)</strong> de su caja abierta, por el mismo medio del cobro.</li>
                            }
                            <li>La autorización queda usada.</li>
                        </ul>
                    </div>
                }

                <ul class="lista-pendientes list-unstyled small my-3" aria-label="Lo que falta para registrar">
                    @foreach (var item in Pendientes)
                    {
                        <li class="@(item.Listo ? "listo" : "falta")">
                            <span class="marca" aria-hidden="true">@(item.Listo ? "✓" : "•")</span>
                            <span>@item.Texto</span>
                        </li>
                    }
                </ul>
                <BotonCondicionado Texto="Registrar nota de crédito" TextoOcupado="Registrando..." Bloque="true" Clase="btn-primary w-100"
                                   Ocupado="@guardando" AlHacerClic="Guardar"
                                   Motivo="@(Pendientes.All(p => p.Listo) ? null : "Complete lo marcado con • para registrar.")" />
                <a class="btn btn-link w-100 mt-1" href="/notas-credito">Cancelar</a>
            </div>
        </div>
    </div>
}

@code {
    private const double TasaIgv = 0.18;

    // viene del comprobante de la venta: /notas-credito/nueva?comprobante=ID
    [SupplyParameterFromQuery(Name = "comprobante")] public int? IdComprobanteInicial { get; set; }

    private SolicitudDatos? autorizacion;
    private bool solicitudPendiente;
    private bool consultando;
    private List<ComprobanteParaNota> comprobantes = new();
    private List<LineaDevolvible> lineas = new();
    private int idComprobante;
    private string motivo = "";
    private bool cargado;
    private bool intento;
    private bool guardando;
    private string? error;

    private sealed record Pendiente(string Texto, bool Listo);

    private string RutaActual => "/" + Nav.ToBaseRelativePath(Nav.Uri);
    private ComprobanteParaNota? Origen => comprobantes.FirstOrDefault(c => c.Id == idComprobante);
    private double SubTotal => Math.Round(lineas.Where(l => l.Devolver > 0).Sum(l => l.ImporteDevolucion), 2);
    private double Igv => Math.Round(SubTotal * TasaIgv, 2, MidpointRounding.AwayFromZero);
    private double Total => Math.Round(SubTotal + Igv, 2);
    private string TipoNota => Origen is not null && Math.Abs(Total - Origen.Total) <= 0.01 ? "DEVOLUCION_TOTAL" : "DEVOLUCION_POR_ITEM";

    private bool CantidadesValidas => lineas.Any(l => l.Devolver > 0) && lineas.All(l => Problema(l) is null);

    private List<Pendiente> Pendientes => new()
    {
        new(autorizacion is not null ? "Autorización vigente" : solicitudPendiente ? "Autorización (pendiente de aprobar)" : "Autorización del Administrador", autorizacion is not null),
        new("Comprobante elegido", Origen is not null),
        new("Motivo escrito", !string.IsNullOrWhiteSpace(motivo)),
        new("Cantidades a devolver", CantidadesValidas)
    };

    private List<PasoDocumento> Pasos => new()
    {
        new("Autorización", autorizacion is not null ? EstadoPaso.Hecho : EstadoPaso.Actual,
            autorizacion is not null ? $"Vigente hasta {Formato.FechaHora(autorizacion.FechaVencimiento)}"
            : solicitudPendiente ? "Pendiente de aprobar" : "Sin solicitar",
            solicitudPendiente ? "Administrador" : "Cajero la solicita"),
        new("Comprobante y productos", Origen is not null && CantidadesValidas ? EstadoPaso.Hecho
            : autorizacion is not null ? EstadoPaso.Actual : EstadoPaso.Pendiente,
            Origen?.Comprobante ?? "Por elegir", "Cajero"),
        new("Registrar la nota", EstadoPaso.Pendiente, "Reingresa stock y ajusta deuda o caja", "Cajero")
    };

    // misma regla que el BO: solo lo entregado y todavía no devuelto
    private static string? Problema(LineaDevolvible l) =>
        l.Devolver < 0 ? "No puede ser negativa."
        : l.Devolver > l.Devolvible + 0.0005 ? $"Máximo {Formato.Cantidad(l.Devolvible)}."
        : null;

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (Origen is null) e["comprobante"] = "Elija el comprobante que se corrige.";
        if (string.IsNullOrWhiteSpace(motivo)) e["motivo"] = "El motivo es obligatorio.";
        return e;
    }

    private string? E(string campo) => intento && Errores().TryGetValue(campo, out var m) ? m : null;
    private string Invalido(string campo) => E(campo) is null ? "" : "is-invalid";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            comprobantes = await Api.Get<List<ComprobanteParaNota>>("notas-credito/comprobantes") ?? new();
            await ConsultarAutorizacion();
            if (IdComprobanteInicial is int inicial && comprobantes.Any(c => c.Id == inicial))
            {
                idComprobante = inicial;
                await AlElegirComprobante();
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        cargado = true;
    }

    // RF014: ¿ya tiene una autorización aprobada y vigente? Si no, ¿ya pidió una y espera la aprobación?
    private async Task ConsultarAutorizacion()
    {
        consultando = true;
        try
        {
            autorizacion = await Api.Get<SolicitudDatos>($"solicitudes/vigente?operacion={TextosSeguridad.OperacionNotaCredito}");
            solicitudPendiente = false;
            if (autorizacion is null)
            {
                var mias = await Api.Get<List<SolicitudDatos>>("solicitudes/mias") ?? new();
                solicitudPendiente = mias.Any(s => s.Operacion == TextosSeguridad.OperacionNotaCredito && s.Estado == "PENDIENTE");
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            consultando = false;
        }
    }

    private async Task AlElegirComprobante()
    {
        lineas = new();
        error = null;
        if (idComprobante == 0) return;
        try
        {
            lineas = await Api.Get<List<LineaDevolvible>>($"notas-credito/comprobantes/{idComprobante}/lineas") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private void DevolverTodo()
    {
        foreach (var l in lineas.Where(l => l.Devolvible > 0))
        {
            l.Devolver = l.Devolvible;
        }
    }

    private void LimpiarCantidades()
    {
        foreach (var l in lineas)
        {
            l.Devolver = 0;
        }
    }

    private async Task Guardar()
    {
        intento = true;
        error = null;
        if (Errores().Count > 0 || lineas.Any(l => Problema(l) is not null))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        if (!lineas.Any(l => l.Devolver > 0))
        {
            error = "Escriba la cantidad que se devuelve en al menos un producto.";
            return;
        }
        guardando = true;
        try
        {
            var guardada = await Api.Post<NotaGuardada>("notas-credito", new
            {
                idComprobanteOrigen = idComprobante,
                motivo = motivo.Trim(),
                lineas = lineas.Where(l => l.Devolver > 0).Select(l => new { idLinea = l.IdDetalleVenta, cantidad = l.Devolver })
            });
            Nav.NavigateTo(AvisoGuardado.Ruta("/notas-credito", AvisoGuardado.Nuevo, guardada?.Nota));
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "Para emitir la nota de crédito se necesita una autorización vigente del Administrador"
        }
        finally
        {
            guardando = false;
        }
    }

    private class NotaGuardada
    {
        public int Id { get; set; }
        public string? Nota { get; set; }
    }
}

@page "/ventas/nueva"
@page "/ventas/editar/{Id:int}"
@using SigmetaWeb.Components.Pages.Catalogo
@using SigmetaWeb.Components.Pages.Clientes
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>@Titulo · SIGMETA</PageTitle>

@* RF008 · Registrar o modificar una venta (Vendedor).
   Nueva: POST /api/ventas. Desde una orden (?orden=ID o eligiéndola): GET /api/ordenes/{id} y cada línea de la venta
          apunta a su línea de la orden (idDetalleOrden); directa: productos con el BuscadorProducto de RF005.
   Editar: GET /api/ventas/{Id} y PUT /api/ventas/{Id} (solo REGISTRADA sin comprobante ni despacho;
          la condición de pago y la orden no cambian).
   Stock, línea de crédito, límite, plazo, correlativo, totales y la cuenta por cobrar los maneja el BO;
   sus mensajes salen en el aviso rojo. *@
<Encabezado Rf="RF008" Titulo="@Titulo">
    <a class="btn btn-outline-secondary" href="/ventas">Volver a la lista</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (venta is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    @if (!Editable)
    {
        <div class="alert alert-secondary">
            Esta venta no se puede modificar: solo se modifica una venta registrada sin comprobante ni despacho.
        </div>
    }

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Origen y cliente</h2>

        @if (EsNuevo)
        {
            <Campo Etiqueta="Origen de la venta" Obligatorio="true">
                <div class="d-flex flex-wrap gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="origen" id="origenOrden"
                               checked="@desdeOrden" @onchange="UsarOrden" />
                        <label class="form-check-label" for="origenOrden">Desde una orden de compra de cliente</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="origen" id="origenDirecta"
                               checked="@(!desdeOrden)" @onchange="UsarDirecta" />
                        <label class="form-check-label" for="origenDirecta">Venta directa</label>
                    </div>
                </div>
            </Campo>
        }

        <div class="row">
            @if (desdeOrden)
            {
                <div class="col-md-6">
                    <Campo Etiqueta="Orden de compra de cliente" Id="orden" Obligatorio="true"
                           Ayuda="Solo órdenes pendientes o atendidas parcialmente.">
                        @if (EsNuevo)
                        {
                            <select id="orden" class="form-select" value="@venta.IdOrden" @onchange="CambiarOrden">
                                <option value="0">Seleccione…</option>
                                @foreach (var o in ordenesAbiertas)
                                {
                                    <option value="@o.Id">@o.Numero · @o.NumeroOrdenCliente · @o.Cliente</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input id="orden" class="form-control" value="@venta.NumeroOrden" disabled />
                        }
                    </Campo>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="small text-muted text-uppercase">Cliente</div>
                    <div class="fw-semibold">@(venta.Cliente ?? "—") <span class="small text-muted">@venta.DocumentoCliente</span></div>
                </div>
            }
            else
            {
                <div class="col-md-6">
                    <Campo Etiqueta="Cliente" Id="cliente" Obligatorio="true" Ayuda="Solo clientes activos.">
                        <select id="cliente" class="form-select" @bind="venta.IdCliente" disabled="@(!Editable)">
                            <option value="0">Seleccione…</option>
                            @foreach (var c in clientes)
                            {
                                <option value="@c.Id">@c.NombreMostrado · @Cliente.Texto(c.TipoDocumento) @c.NumeroDocumento</option>
                            }
                        </select>
                    </Campo>
                </div>
            }
        </div>
    </div>

    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Condiciones</h2>
        <div class="row">
            <div class="col-md-4">
                <Campo Etiqueta="Fecha de emisión" Id="fecha" Obligatorio="true">
                    <input id="fecha" type="date" class="form-control"
                           @bind="venta.FechaEmision" @bind:format="yyyy-MM-dd" disabled="@(!Editable)" />
                </Campo>
            </div>
            <div class="col-md-4">
                <Campo Etiqueta="Condición de pago" Id="condicion" Obligatorio="true"
                       Ayuda="@AyudaCondicion">
                    <select id="condicion" class="form-select" @bind="venta.CondicionPago" disabled="@(!EsNuevo)">
                        <option value="CONTADO">Contado</option>
                        <option value="CREDITO">Crédito</option>
                    </select>
                </Campo>
            </div>
            @if (venta.CondicionPago == "CREDITO")
            {
                <div class="col-md-4">
                    <Campo Etiqueta="Plazo de crédito (días)" Id="plazo"
                           Ayuda="No puede superar el plazo autorizado del cliente. En 0 se usa el plazo del cliente.">
                        <input id="plazo" type="number" min="0" class="form-control" @bind="venta.PlazoCreditoDias" disabled="@(!EsNuevo)" />
                    </Campo>
                </div>
            }
            <div class="col-12">
                <Campo Etiqueta="Observaciones" Id="observaciones">
                    <textarea id="observaciones" class="form-control" rows="2" maxlength="300"
                              @bind="venta.Observaciones" disabled="@(!Editable)"></textarea>
                </Campo>
            </div>
        </div>
        @if (EsNuevo && venta.CondicionPago == "CREDITO")
        {
            <div class="alert alert-secondary mb-0">
                Al guardar se genera la cuenta por cobrar. El total no puede superar el crédito disponible del cliente.
            </div>
        }
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-1">Detalle</h2>
            @if (desdeOrden)
            {
                <p class="small text-muted">
                    Líneas de la orden. Puede reducir las cantidades o quitar líneas: no se puede vender más de lo pedido.
                </p>
            }
            else if (Editable)
            {
                <p class="small text-muted mb-2">Agregue los productos de la venta. El sistema valida el stock disponible al guardar.</p>
                <BuscadorProducto Etiqueta="Agregar producto" Id="buscadorVenta" AlElegir="AgregarProducto" />
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 3rem;">#</th>
                        <th>Producto</th>
                        @if (desdeOrden)
                        {
                            <th class="text-end">En la orden</th>
                        }
                        <th style="width: 8rem;">Cantidad</th>
                        <th style="width: 9rem;">Precio unit. (S/)</th>
                        <th style="width: 9rem;">Descuento (S/)</th>
                        <th class="text-end">Importe (S/)</th>
                        @if (Editable) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @if (venta.Lineas.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">@(desdeOrden ? "Elija la orden de compra del cliente." : "Agregue al menos un producto con el buscador.")</td></tr>
                    }
                    @for (var i = 0; i < venta.Lineas.Count; i++)
                    {
                        var l = venta.Lineas[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td><span class="small text-muted">@l.CodigoProducto</span><br />@l.Producto</td>
                            @if (desdeOrden)
                            {
                                <td class="text-end">@CantidadEnOrden(l).ToString("0.###")</td>
                            }
                            @if (Editable)
                            {
                                <td><input type="number" min="0.001" step="0.001" class="form-control form-control-sm text-end" aria-label="Cantidad" @bind="l.Cantidad" /></td>
                                @if (desdeOrden)
                                {
                                    @* desde una orden el precio es el pactado en la orden *@
                                    <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                }
                                else
                                {
                                    <td><input type="number" min="0" step="0.01" class="form-control form-control-sm text-end" aria-label="Precio unitario" @bind="l.PrecioUnitario" /></td>
                                }
                                <td><input type="number" min="0" step="0.01" class="form-control form-control-sm text-end" aria-label="Descuento" @bind="l.Descuento" /></td>
                                <td class="text-end fw-semibold">@l.ImporteCalculado.ToString("N2")</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => Quitar(l)">Quitar</button></td>
                            }
                            else
                            {
                                <td class="text-end">@l.Cantidad.ToString("0.###")</td>
                                <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end">@l.Descuento.ToString("N2")</td>
                                <td class="text-end fw-semibold">@l.Importe.ToString("N2")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body">
            <div class="row justify-content-end">
                <div class="col-sm-6 col-md-4">
                    <div class="d-flex justify-content-between"><span class="text-muted">Subtotal</span><span>S/ @SubTotal.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">IGV (18%)</span><span>S/ @Igv.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between border-top mt-2 pt-2 fw-semibold"><span>Total</span><span>S/ @Total.ToString("N2")</span></div>
                    @if (Editable)
                    {
                        <div class="form-text text-end">Referencial: el sistema calcula los importes al guardar.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card card-body mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="/ventas">Cancelar</a>
                @if (Editable)
                {
                    <button class="btn btn-primary" disabled="@guardando" @onclick="Guardar">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    // viene de la lista de órdenes: /ventas/nueva?orden=ID
    [SupplyParameterFromQuery(Name = "orden")] public int? IdOrdenInicial { get; set; }

    private VentaDatos? venta;
    private List<Cliente> clientes = new();
    private List<OrdenDatos> ordenesAbiertas = new();
    private OrdenDatos? ordenElegida;
    private bool desdeOrden;
    private string? error;
    private bool guardando;

    private bool EsNuevo => Id is null;
    private string Titulo => EsNuevo ? "Nueva venta" : "Editar venta";
    private bool Editable => EsNuevo || (venta?.Estado == "REGISTRADA" && venta.Comprobante is null);
    private string AyudaCondicion => EsNuevo ? "Crédito solo para clientes con línea de crédito autorizada." : "No se cambia al modificar.";

    private decimal SubTotal => Editable ? TextosVentas.SubTotal(venta!.Lineas) : venta!.SubTotal;
    private decimal Igv => Editable ? TextosVentas.Igv(venta!.Lineas) : venta!.Igv;
    private decimal Total => Editable ? TextosVentas.Total(venta!.Lineas) : venta!.Total;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await Api.Get<List<Cliente>>("clientes?estado=true") ?? new();   // solo clientes activos
            if (EsNuevo)
            {
                venta = new VentaDatos { FechaEmision = DateOnly.FromDateTime(DateTime.Today), CondicionPago = "CONTADO" };
                var ordenes = await Api.Get<List<OrdenDatos>>("ordenes") ?? new();
                ordenesAbiertas = ordenes.Where(o => o.Estado is "PENDIENTE" or "ATENDIDA_PARCIAL").ToList();
                desdeOrden = IdOrdenInicial is not null;
                if (IdOrdenInicial is int inicial && ordenesAbiertas.Any(o => o.Id == inicial))
                {
                    await ElegirOrden(inicial);
                }
            }
            else
            {
                venta = await Api.Get<VentaDatos>($"ventas/{Id}");   // GET /api/ventas/{Id}
                desdeOrden = venta is not null && venta.IdOrden > 0;
                if (desdeOrden)
                {
                    ordenElegida = await Api.Get<OrdenDatos>($"ordenes/{venta!.IdOrden}");
                }
                else if (venta is not null && clientes.All(c => c.Id != venta.IdCliente))
                {
                    clientes.Add(new Cliente { Id = venta.IdCliente, TipoPersona = "JURIDICA", RazonSocial = venta.Cliente, NumeroDocumento = venta.DocumentoCliente ?? "" });
                }
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            venta ??= new VentaDatos { FechaEmision = DateOnly.FromDateTime(DateTime.Today) };
        }
    }

    private void UsarOrden()
    {
        desdeOrden = true;
        venta!.Lineas.Clear();
        venta.IdCliente = 0;
        venta.Cliente = null;
        venta.DocumentoCliente = null;
    }

    private void UsarDirecta()
    {
        desdeOrden = false;
        ordenElegida = null;
        venta!.IdOrden = 0;
        venta.NumeroOrden = null;
        venta.Cliente = null;
        venta.DocumentoCliente = null;
        venta.IdCliente = 0;
        venta.Lineas.Clear();
    }

    private async Task CambiarOrden(ChangeEventArgs e)
    {
        var id = int.TryParse(e.Value?.ToString(), out var valor) ? valor : 0;
        await ElegirOrden(id);
    }

    // GET /api/ordenes/{id}: el cliente y las líneas de la venta salen de la orden
    private async Task ElegirOrden(int id)
    {
        venta!.IdOrden = id;
        venta.Lineas.Clear();
        ordenElegida = null;
        if (id <= 0) return;
        try
        {
            ordenElegida = await Api.Get<OrdenDatos>($"ordenes/{id}");
            if (ordenElegida is null) return;
            venta.IdCliente = ordenElegida.IdCliente;
            venta.Cliente = ordenElegida.Cliente;
            venta.DocumentoCliente = ordenElegida.DocumentoCliente;
            venta.NumeroOrden = ordenElegida.Numero;
            foreach (var lo in ordenElegida.Lineas)
            {
                // se propone lo que falta entregar; el BO valida contra lo ya vendido de la orden
                var cantidad = lo.Cantidad - lo.CantidadAtendida;
                if (cantidad <= 0) continue;
                venta.Lineas.Add(new LineaDatos
                {
                    IdProducto = lo.IdProducto,
                    Producto = lo.Producto,
                    CodigoProducto = lo.CodigoProducto,
                    Cantidad = cantidad,
                    PrecioUnitario = lo.PrecioUnitario,
                    // el descuento de la línea de la orden en proporción a la cantidad propuesta
                    Descuento = lo.Cantidad > 0 ? Math.Round(lo.Descuento * cantidad / lo.Cantidad, 2) : 0,
                    IdDetalleOrden = lo.IdLinea
                });
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private decimal CantidadEnOrden(LineaDatos l) =>
        ordenElegida?.Lineas.FirstOrDefault(o => o.IdLinea == l.IdDetalleOrden)?.Cantidad ?? 0;

    // Lo llama el BuscadorProducto con el producto elegido (venta directa)
    private void AgregarProducto(Producto p)
    {
        venta!.Lineas.Add(new LineaDatos
        {
            IdProducto = p.Id,
            Producto = p.Nombre,
            CodigoProducto = p.CodigoInterno,
            Cantidad = 1,
            PrecioUnitario = p.PrecioVenta,
            Descuento = 0
        });
    }

    private void Quitar(LineaDatos l) => venta!.Lineas.Remove(l);

    private async Task Guardar()
    {
        error = null;
        if (EsNuevo && desdeOrden && venta!.IdOrden <= 0)
        {
            error = "Elija la orden de compra del cliente.";
            return;
        }
        guardando = true;
        try
        {
            for (var i = 0; i < venta!.Lineas.Count; i++)
            {
                venta.Lineas[i].NumeroLinea = i + 1;
            }

            if (EsNuevo)
            {
                var nueva = await Api.Post<VentaDatos>("ventas", venta);           // POST /api/ventas
                // siguiente paso del flujo: emitir su comprobante
                Nav.NavigateTo(nueva is not null ? $"/ventas/{nueva.Id}/comprobante" : "/ventas");
            }
            else
            {
                await Api.Put<VentaDatos>($"ventas/{Id}", venta);                  // PUT /api/ventas/{Id}
                Nav.NavigateTo("/ventas");
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "Stock insuficiente para ..." o "El cliente no tiene linea de credito autorizada"
        }
        finally
        {
            guardando = false;
        }
    }
}

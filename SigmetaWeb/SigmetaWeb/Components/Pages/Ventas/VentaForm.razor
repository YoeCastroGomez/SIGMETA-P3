@page "/ventas/nueva"
@page "/ventas/editar/{Id:int}"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Administrador")]
@using SigmetaWeb.Components.Pages.Catalogo
@using SigmetaWeb.Components.Pages.Clientes
@using SigmetaWeb.Components.Pages.Seguridad
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>@Titulo · SIGMETA</PageTitle>

@* RF008 · Registrar o modificar una venta (Vendedor). PATRÓN UX de formularios (ver Shared/ComponentesFlujo.cs):
     - Secciones numeradas en el orden en que se llenan: 1 Origen y cliente, 2 Productos, 3 Condiciones.
     - Resumen fijo a la derecha: totales, LISTA DE LO QUE FALTA y el botón Guardar, que se bloquea hasta que
       todo esté completo (y dice qué falta).
     - Información útil al decidir: línea de crédito del cliente (y "Crédito" bloqueado si no tiene),
       stock en almacén de cada producto, lo pendiente en la orden.
     - Al guardar va al siguiente paso (emitir el comprobante) o vuelve a donde estaba, con sus filtros.
   Nueva: POST /api/ventas. Desde una orden (?orden=ID o eligiéndola): GET /api/ordenes/{id} y cada línea de la venta
          apunta a su línea de la orden (idDetalleOrden); directa: productos con el BuscadorProducto de RF005.
   Editar: GET /api/ventas/{Id} y PUT /api/ventas/{Id} (solo REGISTRADA sin comprobante, despacho ni cobro en caja;
          la condición de pago y la orden no cambian).
   Stock disponible, línea de crédito, límite, plazo, correlativo, totales y la cuenta por cobrar los valida el BO;
   sus mensajes salen en el aviso rojo. *@
<Encabezado Rf="RF008" Titulo="@Titulo" Subtitulo="@Subtitulo">
    @if (venta is not null && !Editable)
    {
    <a class="btn btn-outline-secondary" href="@VolverA">← Volver</a>
    }
</Encabezado>

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />

@if (venta is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    @if (!EsNuevo)
    {
        <PasosDocumento Pasos="@FlujoVentas.PasosVenta(venta, ordenElegida)" Titulo="Recorrido de la venta" />
    }
    @* se deja solo cuando dice algo que no está en otro lugar: por qué el Vendedor ya no puede corregirla y qué hacer
       (por ejemplo, "anule primero el comprobante"). Si está anulada, el recorrido y el total ya lo dicen. *@
    @if (!Editable && Rol == "Vendedor" && !FlujoVentas.EstaAnulada(venta) && FlujoVentas.MotivoNoEditable(venta) is { } motivoNoEditable)
    {
        <div class="alert alert-secondary">@motivoNoEditable</div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            @* RF014: mientras la autorización del precio espera o está aprobada, la venta no se cambia (se autorizó lo que se mandó) *@
            <fieldset disabled="@BloqueadaPorAutorizacion" style="min-width: 0;">
            @* -------- 1. Origen y cliente -------- *@
            <div class="card card-body mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
                    <h2 class="h6 fw-semibold mb-0"><span class="seccion">1</span> Origen y cliente</h2>
                    <span class="small text-muted">
                        N.º <strong class="text-body">@(EsNuevo ? (string.IsNullOrEmpty(numeroPropuesto) ? "…" : numeroPropuesto) : venta.Numero)</strong>
                    </span>
                </div>

                @if (EsNuevo)
                {
                    <div class="row g-2 mb-3" role="radiogroup" aria-label="Origen de la venta">
                        <div class="col-sm-6">
                            <button type="button" role="radio" aria-checked="@(desdeOrden ? "true" : "false")"
                                    class="opcion w-100 text-start @(desdeOrden ? "elegida" : "")" @onclick="UsarOrden">
                                <span class="fw-semibold d-block">Desde una orden del cliente</span>
                                <span class="small text-muted d-block">@(ordenesAbiertas.Count) por vender</span>
                            </button>
                        </div>
                        <div class="col-sm-6">
                            <button type="button" role="radio" aria-checked="@(!desdeOrden ? "true" : "false")"
                                    class="opcion w-100 text-start @(!desdeOrden ? "elegida" : "")" @onclick="UsarDirecta">
                                <span class="fw-semibold d-block">Venta directa</span>
                                <span class="small text-muted d-block">Cliente y productos a elección</span>
                            </button>
                        </div>
                    </div>
                }

                <div class="row">
                    @if (desdeOrden)
                    {
                        <div class="col-md-6">
                            @* Estándar RNF004: cada error sale en rojo debajo de su cuadro mientras se escribe (ValidacionEnVivo);
                               los del BO (stock insuficiente, límite de crédito...) en el aviso rojo de arriba. *@
                            <Campo Etiqueta="Orden de compra del cliente" Id="orden" Obligatorio="true" Error="@(v.Error("orden", Errores()))"
                                   Ayuda="@(ordenesAbiertas.Count == 0 && EsNuevo ? "No hay órdenes por vender." : null)">
                                @if (EsNuevo)
                                {
                                    <select id="orden" class="@(v.Clase("orden", Errores(), "form-select"))" value="@venta.IdOrden" @onchange="CambiarOrden">
                                        <option value="0">Seleccione…</option>
                                        @foreach (var o in ordenesAbiertas)
                                        {
                                            <option value="@o.Id">@(o.Numero + " · " + o.Cliente + (string.IsNullOrEmpty(o.NumeroOrdenCliente) ? "" : " · OC " + o.NumeroOrdenCliente))</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input id="orden" class="form-control" value="@venta.NumeroOrden" disabled />
                                }
                            </Campo>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="small fw-semibold">Cliente</div>
                            <div class="mt-2">@(venta.Cliente ?? "Se toma de la orden")</div>
                            <div class="small text-muted">@venta.DocumentoCliente</div>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-8">
                            <Campo Etiqueta="Cliente" Id="cliente" Obligatorio="true" Error="@(v.Error("cliente", Errores()))">
                                <BuscadorCliente Id="cliente" Clientes="clientes" IdCliente="venta.IdCliente" IdClienteChanged="ElegirCliente"
                                                 ClaseCaja="@(v.Clase("cliente", Errores(), "form-control"))" Deshabilitado="@(!Editable)" />
                            </Campo>
                        </div>
                    }
                </div>
            </div>

            @* -------- 2. Productos -------- *@
            <div class="card mb-3">
                <div class="card-body pb-0">
                    <h2 class="h6 fw-semibold mb-1"><span class="seccion">2</span> Productos</h2>
                    @* desde una orden se propone lo que falta entregar (se puede reducir o quitar, no aumentar) *@
                    @if (!desdeOrden && Editable)
                    {
                        <SelectorProducto Id="buscadorVenta" AlElegir="AgregarProducto" />
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 tabla-lineas">
                        <thead class="table-light">
                            <tr>
                                <th class="text-muted" style="width: 2.5rem;">#</th>
                                <th>Producto</th>
                                @if (desdeOrden)
                                {
                                    <th class="text-end">En la orden</th>
                                }
                                <th style="width: 9.5rem;">Cantidad</th>
                                <th class="text-end" style="width: 7rem;">Precio unit.</th>
                                <th style="width: 8rem;">Descuento</th>
                                <th class="text-end">Importe</th>
                                @if (Editable) { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @if (venta.Lineas.Count == 0)
                            {
                                <tr><td colspan="8" class="text-center text-muted py-4">@(desdeOrden ? "Elija la orden del cliente." : "Aún no hay productos: búsquelos arriba por nombre, código o categoría.")</td></tr>
                            }
                            @for (var i = 0; i < venta.Lineas.Count; i++)
                            {
                                var l = venta.Lineas[i];
                                var n = v.Clave(l);
                                var hayStock = stock.TryGetValue(l.IdProducto, out var enAlmacen);
                                <tr @key="l" class="@(Editable && AvisoLinea(l) is not null ? "con-aviso" : null)">
                                    <td class="text-muted small">@(i + 1)</td>
                                    <td>
                                        <div class="producto-nombre">@l.Producto</div>
                                        @if (hayStock && Editable)
                                        {
                                            <div class="small @(l.Cantidad > enAlmacen ? "text-danger fw-semibold" : "text-muted")">
                                                Stock: @enAlmacen.ToString("0.###") @l.UnidadCorta@(l.Cantidad > enAlmacen ? " · no alcanza" : "")
                                            </div>
                                        }
                                    </td>
                                    @if (desdeOrden)
                                    {
                                        <td class="text-end">@CantidadEnOrden(l).ToString("0.###")</td>
                                    }
                                    @if (Editable)
                                    {
                                        <td>
                                            @* las flechas suben y bajan de 1 en 1; kg, m y L aceptan decimales escritos *@
                                            <div class="input-group input-group-sm cantidad">
                                                @* el valor no válido (0, negativo, más de 3 decimales) no se deja escribir: LineaDatos.Validar *@
                                                <input type="number" step="1" min="@l.MinimoCantidad" data-positivo="1"
                                                       class="@(v.Clase(n + "cantidad", Errores(), "form-control text-end"))" aria-label="Cantidad"
                                                       onkeydown="@l.TeclasCantidad" oninput="@LineaDatos.Validar" onfocusout="@LineaDatos.Restaurar"
                                                       @bind="l.Cantidad" @bind:after="@(() => v.Tocado(n + "cantidad"))" @onblur="l.Ajustar" />
                                                <span class="input-group-text">@l.UnidadCorta</span>
                                            </div>
                                        </td>
                                        @* RF005: precio de lista (o el pactado en la orden); no se edita, el BO lo vuelve a poner *@
                                        <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                        <td>
                                            <div class="input-group input-group-sm descuento">
                                                <span class="input-group-text">S/</span>
                                                @* no se deja escribir un descuento mayor que el importe de la línea ni con más de 2 decimales *@
                                                <input type="number" step="1" min="0" max="@l.DescuentoMaximo" data-decimales="2"
                                                       class="@(v.Clase(n + "descuento", Errores(), "form-control text-end", n + "cantidad", n + "precio"))" aria-label="Descuento en soles"
                                                       onkeydown="@l.TeclasDescuento" oninput="@LineaDatos.Validar" onfocusout="@LineaDatos.Restaurar"
                                                       @bind="l.Descuento" @bind:after="@(() => v.Tocado(n + "descuento"))" @onblur="l.Ajustar" />
                                            </div>
                                        </td>
                                        <td class="text-end fw-semibold">@l.ImporteCalculado.ToString("N2")</td>
                                        <td class="text-end"><button type="button" class="btn btn-sm btn-quitar" title="Quitar" aria-label="@($"Quitar {l.Producto}")" @onclick="() => Quitar(l)"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M6.5 1h3a1 1 0 0 1 1 1v1H13a.5.5 0 0 1 0 1h-.6l-.7 9.1A1.5 1.5 0 0 1 10.2 14.5H5.8a1.5 1.5 0 0 1-1.5-1.4L3.6 4H3a.5.5 0 0 1 0-1h2.5V2a1 1 0 0 1 1-1Zm0 2h3V2h-3v1ZM4.6 4l.7 9a.5.5 0 0 0 .5.5h4.4a.5.5 0 0 0 .5-.5l.7-9H4.6Zm2 1.5a.5.5 0 0 1 .5.5v5.5a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.8 0a.5.5 0 0 1 .5.5v5.5a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Z"/></svg></button></td>
                                    }
                                    else
                                    {
                                        <td class="text-end">@l.Cantidad.ToString("0.###") <span class="text-muted small">@l.UnidadCorta</span></td>
                                        <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">@l.Descuento.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@l.Importe.ToString("N2")</td>
                                    }
                                </tr>
                                @* los avisos de la línea van en una fila aparte, a todo lo ancho: no deforman las columnas *@
                                @if (Editable && AvisoLinea(l) is { } aviso)
                                {
                                    <tr @key="(l, 1)" class="fila-aviso">
                                        <td></td>
                                        <td colspan="@(desdeOrden ? 7 : 6)"><span class="aviso">⚠ @aviso</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (v.Error("lineas", Errores()) is { } errorLineas)
                {
                    <div class="card-body pt-2"><div class="small text-danger">@errorLineas</div></div>
                }
            </div>

            @* -------- 3. Condiciones -------- *@
            <div class="card card-body mb-3">
                <h2 class="h6 fw-semibold mb-3"><span class="seccion">3</span> Condiciones</h2>
                <div class="row">
                    <div class="col-md-4">
                        <Campo Etiqueta="Fecha de emisión" Id="fecha" Obligatorio="true" Error="@(v.Error("fecha", Errores()))"
                               Ayuda="@(EsNuevo ? $"Desde {FechaMinima:dd/MM} hasta hoy." : null)">
                            <input id="fecha" type="date" class="@(v.Clase("fecha", Errores()))"
                                   min="@(EsNuevo ? FechaMinima.ToString("yyyy-MM-dd") : null)" max="@(EsNuevo ? Hoy.ToString("yyyy-MM-dd") : null)"
                                   @bind="venta.FechaEmision" @bind:format="yyyy-MM-dd" @bind:after="@(() => v.Tocado("fecha"))" disabled="@(!Editable)" />
                        </Campo>
                    </div>
                    <div class="col-md-4">
                        <Campo Etiqueta="Condición de pago" Id="condicion" Obligatorio="true" Ayuda="@AyudaCondicion">
                            <select id="condicion" class="form-select" @bind="venta.CondicionPago" disabled="@(!EsNuevo)">
                                <option value="CONTADO">Contado</option>
                                <option value="CREDITO" disabled="@(EsNuevo && !TieneLinea)">@(EsNuevo && !TieneLinea ? "Crédito (el cliente no tiene línea)" : "Crédito")</option>
                            </select>
                        </Campo>
                    </div>
                    @if (venta.CondicionPago == "CREDITO")
                    {
                        <div class="col-md-4">
                            <Campo Etiqueta="Plazo de crédito (días)" Id="plazo" Error="@(v.Error("plazo", Errores()))"
                                   Ayuda="@(ClienteActual is { } cp ? $"En 0 se usa el plazo del cliente ({cp.PlazoCreditoDias} días)." : "En 0 se usa el plazo del cliente.")">
                                <input id="plazo" type="number" class="@(v.Clase("plazo", Errores()))" onkeydown="@ValidacionEnVivo.SoloPositivos"
                                       @bind="venta.PlazoCreditoDias" @bind:event="oninput" @bind:after="@(() => v.Tocado("plazo"))" disabled="@(!EsNuevo)" />
                            </Campo>
                        </div>
                    }
                    <div class="col-12">
                        <Campo Etiqueta="Observaciones" Id="observaciones" Clase="mb-0">
                            <textarea id="observaciones" class="form-control observaciones" rows="2" maxlength="300"
                                      placeholder="Opcional: indicaciones de entrega o de pago"
                                      @bind="venta.Observaciones" @bind:event="oninput" disabled="@(!Editable)"></textarea>
                        </Campo>
                    </div>
                </div>
                @if (EsNuevo && venta.CondicionPago == "CREDITO" && ClienteActual is { } cl)
                {
                    <div class="alert alert-light border small mt-3 mb-0">
                        <strong>Línea de crédito:</strong> hasta S/ @cl.LimiteCredito.ToString("N2") a @cl.PlazoCreditoDias días.
                    </div>
                }
            </div>
            </fieldset>
        </div>

        @* -------- Resumen fijo: total, desglose, lo que falta y Guardar (ResumenTotal) -------- *@
        <div class="col-lg-4">
            <ResumenTotal Total="@Total" SubTotal="@SubTotal" Igv="@Igv"
                          EstadoTexto="@(EsNuevo ? null : TextosVentas.Texto(FlujoVentas.EstaAnulada(venta) ? "ANULADA" : venta.Estado))"
                          Detalle="@(EsNuevo ? null : TextosVentas.Texto(venta.CondicionPago))">
                @if (Editable)
                {
                    @if (Pendientes.Any(p => !p.Listo))
                    {
                        <ul class="lista-pendientes list-unstyled small mb-0" aria-label="Lo que falta para guardar">
                            @foreach (var item in Pendientes.Where(p => !p.Listo))
                            {
                                <li class="falta"><span class="marca" aria-hidden="true">•</span><span>@item.Texto</span></li>
                            }
                        </ul>
                    }
                    @if (requiereAutorizacion)
                    {
                        @* RF014: una línea queda bajo el costo. Se pide la autorización de ESTA venta (el Administrador ve
                           el cliente, el total y las líneas bajo el costo) y, aprobada, se guarda la misma venta. *@
                        <PedirAutorizacion Solicitar="SolicitarAutorizacion" Listo="@Pendientes.All(p => p.Listo)"
                                           EstadoChanged="e => estadoAutorizacion = e" AlError="m => error = m">
                            <BotonCondicionado Texto="@(EsNuevo ? "Registrar venta" : "Guardar cambios")" TextoOcupado="Guardando..." Bloque="true"
                                               Clase="btn-primary w-100" Ocupado="@guardando" AlHacerClic="Guardar" />
                        </PedirAutorizacion>
                    }
                    else
                    {
                        <BotonCondicionado Texto="@(EsNuevo ? "Registrar venta" : "Guardar cambios")" TextoOcupado="Guardando..." Bloque="true"
                                           Clase="btn-primary w-100" Ocupado="@guardando" AlHacerClic="Guardar"
                                           Motivo="@(Pendientes.All(p => p.Listo) ? null : "Falta completar lo indicado.")" MostrarMotivo="false" />
                    }
                    <a class="btn btn-outline-secondary w-100" href="@VolverA">Cancelar</a>
                }
                else
                {
                    <a class="btn btn-primary w-100" href="@($"/ventas/{venta.Id}/comprobante")">Ir a la venta</a>
                }
            </ResumenTotal>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    // viene de la lista de órdenes: /ventas/nueva?orden=ID
    [SupplyParameterFromQuery(Name = "orden")] public int? IdOrdenInicial { get; set; }
    // a dónde volver (la lista con sus filtros o la página de la venta)
    [SupplyParameterFromQuery(Name = "volver")] public string? VolverQ { get; set; }

    private VentaDatos? venta;
    private List<Cliente> clientes = new();
    private List<OrdenDatos> ordenesAbiertas = new();
    private OrdenDatos? ordenElegida;
    private bool desdeOrden;
    private string? error;
    private bool guardando;
    private string numeroPropuesto = "";
    // RF014: el BO respondió que una línea queda bajo el costo y hace falta la autorización del Administrador
    private bool requiereAutorizacion;
    private string? estadoAutorizacion;
    private bool BloqueadaPorAutorizacion => estadoAutorizacion is "PENDIENTE" or "APROBADA";
    // stock en almacén de los productos agregados con el buscador (referencial: el BO descuenta lo ya comprometido)
    private readonly Dictionary<int, decimal> stock = new();

    private sealed class NumeroPropuesto
    {
        public string Numero { get; set; } = "";
    }

    private sealed record Pendiente(string Texto, bool Listo);

    private bool EsNuevo => Id is null;
    // RF008: rango de la fecha de una venta nueva (VentaBOImpl.DIAS_ATRASO_MAXIMO = 7)
    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);
    private static DateOnly FechaMinima => Hoy.AddDays(-7);
    private string Titulo => EsNuevo ? "Nueva venta" : Editable ? $"Editar venta {venta?.Numero}" : $"Venta {venta?.Numero}";
    private string? Subtitulo => EsNuevo ? null : venta?.Cliente;
    private string VolverA => Volver.A(VolverQ, "/ventas");
    // RF008: venta REGISTRADA, sin comprobante vigente, sin despacho y (al contado) sin cobro en caja; las reglas reales están en el BO
    private bool Editable => EsNuevo || (Rol == "Vendedor" && venta is not null && FlujoVentas.MotivoNoEditable(venta) is null);
    private string AyudaCondicion => !EsNuevo ? "No se cambia al modificar."
        : TieneLinea ? "El cliente tiene línea de crédito." : "Crédito solo para clientes con línea de crédito autorizada.";

    // Cliente elegido (directo o el de la orden) con su línea de crédito
    private Cliente? ClienteActual => venta is null ? null : clientes.FirstOrDefault(c => c.Id == venta.IdCliente);
    // Mismo criterio que VentaBOImpl.registrar: condición CREDITO con límite y plazo mayores a 0
    private bool TieneLinea => ClienteActual is { } c && c.CondicionPago == "CREDITO" && c.LimiteCredito > 0 && c.PlazoCreditoDias > 0;

    private decimal SubTotal => Editable ? TextosVentas.SubTotal(venta!.Lineas) : venta!.SubTotal;
    private decimal Igv => Editable ? TextosVentas.Igv(venta!.Lineas) : venta!.Igv;
    private decimal Total => Editable ? TextosVentas.Total(venta!.Lineas) : venta!.Total;

    // Lista de lo que falta, a partir de las mismas reglas de Errores()
    private List<Pendiente> Pendientes
    {
        get
        {
            var e = Errores();
            var lista = new List<Pendiente>
            {
                new(desdeOrden ? "Orden del cliente elegida" : "Cliente elegido", !e.ContainsKey("orden") && !e.ContainsKey("cliente")),
                new("Al menos un producto", !e.ContainsKey("lineas")),
                new("Fecha de emisión válida", !e.ContainsKey("fecha"))
            };
            if (venta?.CondicionPago == "CREDITO")
            {
                lista.Add(new("Plazo de crédito válido", !e.ContainsKey("plazo")));
            }
            return lista;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await Api.Get<List<Cliente>>("clientes?estado=true") ?? new();   // solo clientes activos
            if (EsNuevo)
            {
                venta = new VentaDatos { FechaEmision = DateOnly.FromDateTime(DateTime.Today), CondicionPago = "CONTADO" };
                var propuesto = await Api.Get<NumeroPropuesto>("ventas/siguiente-numero");
                numeroPropuesto = propuesto?.Numero ?? "";
                var ordenes = await Api.Get<List<OrdenDatos>>("ordenes") ?? new();
                ordenesAbiertas = ordenes.Where(o => o.Estado is "PENDIENTE" or "ATENDIDA_PARCIAL").ToList();
                desdeOrden = IdOrdenInicial is not null;
                if (IdOrdenInicial is int inicial && ordenesAbiertas.Any(o => o.Id == inicial))
                {
                    await ElegirOrden(inicial);
                }
            }
            else
            {
                venta = await Api.Get<VentaDatos>($"ventas/{Id}");   // GET /api/ventas/{Id}
                desdeOrden = venta is not null && venta.IdOrden > 0;
                if (desdeOrden)
                {
                    ordenElegida = await Api.Get<OrdenDatos>($"ordenes/{venta!.IdOrden}");
                }
                else if (venta is not null && clientes.All(c => c.Id != venta.IdCliente))
                {
                    clientes.Add(new Cliente { Id = venta.IdCliente, TipoPersona = "JURIDICA", RazonSocial = venta.Cliente, NumeroDocumento = venta.DocumentoCliente ?? "" });
                }
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            venta ??= new VentaDatos { FechaEmision = DateOnly.FromDateTime(DateTime.Today) };
        }
    }

    private void UsarOrden()
    {
        if (desdeOrden) return;
        desdeOrden = true;
        venta!.Lineas.Clear();
        venta.IdCliente = 0;
        venta.Cliente = null;
        venta.DocumentoCliente = null;
        AjustarCondicion();
    }

    private void UsarDirecta()
    {
        if (!desdeOrden) return;
        desdeOrden = false;
        ordenElegida = null;
        venta!.IdOrden = 0;
        venta.NumeroOrden = null;
        venta.Cliente = null;
        venta.DocumentoCliente = null;
        venta.IdCliente = 0;
        venta.Lineas.Clear();
        AjustarCondicion();
    }

    private void ElegirCliente(int id)
    {
        venta!.IdCliente = id;
        AlCambiarCliente();
    }

    private void AlCambiarCliente()
    {
        v.Tocado("cliente");
        AjustarCondicion();
    }

    // si el cliente nuevo no tiene línea de crédito, la venta vuelve a contado (la opción Crédito queda bloqueada)
    private void AjustarCondicion()
    {
        if (EsNuevo && venta is not null && venta.CondicionPago == "CREDITO" && !TieneLinea)
        {
            venta.CondicionPago = "CONTADO";
        }
    }

    private async Task CambiarOrden(ChangeEventArgs e)
    {
        v.Tocado("orden");
        var id = int.TryParse(e.Value?.ToString(), out var valor) ? valor : 0;
        await ElegirOrden(id);
    }

    // GET /api/ordenes/{id}: el cliente y las líneas de la venta salen de la orden
    private async Task ElegirOrden(int id)
    {
        venta!.IdOrden = id;
        venta.Lineas.Clear();
        ordenElegida = null;
        if (id <= 0) return;
        try
        {
            ordenElegida = await Api.Get<OrdenDatos>($"ordenes/{id}");
            if (ordenElegida is null) return;
            venta.IdCliente = ordenElegida.IdCliente;
            venta.Cliente = ordenElegida.Cliente;
            venta.DocumentoCliente = ordenElegida.DocumentoCliente;
            venta.NumeroOrden = ordenElegida.Numero;
            foreach (var lo in ordenElegida.Lineas)
            {
                // se propone lo que falta entregar; el BO valida contra lo ya vendido de la orden
                var cantidad = lo.Cantidad - lo.CantidadAtendida;
                if (cantidad <= 0) continue;
                venta.Lineas.Add(new LineaDatos
                {
                    IdProducto = lo.IdProducto,
                    Producto = lo.Producto,
                    CodigoProducto = lo.CodigoProducto,
                    UnidadVenta = lo.UnidadVenta,
                    Cantidad = cantidad,
                    PrecioUnitario = lo.PrecioUnitario,
                    // el descuento de la línea de la orden en proporción a la cantidad propuesta
                    Descuento = lo.Cantidad > 0 ? Math.Round(lo.Descuento * cantidad / lo.Cantidad, 2) : 0,
                    IdDetalleOrden = lo.IdLinea
                });
            }
            AjustarCondicion();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private decimal CantidadEnOrden(LineaDatos l) =>
        ordenElegida?.Lineas.FirstOrDefault(o => o.IdLinea == l.IdDetalleOrden)?.Cantidad ?? 0;

    // Lo llama el BuscadorProducto con el producto elegido (venta directa). Si ya estaba, suma 1 a su cantidad.
    private void AgregarProducto(Producto p)
    {
        stock[p.Id] = p.StockActual;
        var existente = venta!.Lineas.FirstOrDefault(l => l.IdProducto == p.Id && l.IdDetalleOrden == 0);
        if (existente is not null)
        {
            existente.Cantidad += 1;
            return;
        }
        venta.Lineas.Add(new LineaDatos
        {
            IdProducto = p.Id,
            Producto = p.Nombre,
            CodigoProducto = p.CodigoInterno,
            UnidadVenta = p.UnidadVenta,
            Cantidad = 1,
            PrecioUnitario = p.PrecioVenta,
            Descuento = 0
        });
    }

    private void Quitar(LineaDatos l) => venta!.Lineas.Remove(l);

    // Avisos de una línea (cantidad y descuento) en una sola frase, para la fila de avisos de la tabla
    private string? AvisoLinea(LineaDatos l)
    {
        var e = Errores();
        var n = v.Clave(l);
        var partes = new List<string>();
        if (v.Error(n + "cantidad", e) is { } c) partes.Add("Cantidad: " + c);
        if (v.Error(n + "descuento", e, n + "cantidad", n + "precio") is { } d) partes.Add("Descuento: " + d);
        return partes.Count == 0 ? null : string.Join("  ·  ", partes);
    }

    // ---------------- Validación en pantalla (RNF004) ----------------
    // Mismas reglas que VentaBOImpl. Lo que solo sabe el BO (stock disponible, deuda del cliente) sale en el aviso rojo.
    private readonly ValidacionEnVivo v = new();

    // Lo que falta entregar de la línea de la orden (no se puede vender más)
    private decimal PendienteEnOrden(LineaDatos l) =>
        ordenElegida?.Lineas.FirstOrDefault(o => o.IdLinea == l.IdDetalleOrden) is { } lo
            ? lo.Cantidad - lo.CantidadAtendida
            : decimal.MaxValue;

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (venta is null || !Editable)
        {
            return e;
        }
        if (desdeOrden)
        {
            if (EsNuevo && venta.IdOrden <= 0)
            {
                e["orden"] = "Elija la orden de compra del cliente.";
            }
        }
        else if (venta.IdCliente <= 0)
        {
            e["cliente"] = "Seleccione el cliente.";
        }
        if (venta.FechaEmision is null)
        {
            e["fecha"] = "La fecha de emisión es obligatoria.";
        }
        else if (EsNuevo && (venta.FechaEmision > Hoy || venta.FechaEmision < FechaMinima))
        {
            // misma regla que VentaBOImpl: ni futura ni con más de 7 días de atraso
            e["fecha"] = $"La fecha debe estar entre {FechaMinima:dd/MM/yyyy} y hoy.";
        }
        if (venta.CondicionPago == "CREDITO")
        {
            if (venta.PlazoCreditoDias < 0)
            {
                e["plazo"] = "El plazo no puede ser negativo.";
            }
            else if (EsNuevo && ClienteActual is { } c && venta.PlazoCreditoDias > c.PlazoCreditoDias)
            {
                e["plazo"] = $"Máximo {c.PlazoCreditoDias} días (plazo autorizado del cliente).";
            }
        }
        if (venta.Lineas.Count == 0)
        {
            e["lineas"] = desdeOrden ? "La orden elegida no tiene nada pendiente de vender." : "Agregue al menos un producto con el buscador.";
        }
        foreach (var l in venta.Lineas)
        {
            var n = v.Clave(l);
            ValidacionEnVivo.ErroresLinea(e, n, l.Cantidad, l.PrecioUnitario, l.Descuento);
            if (l.CantidadNoEntera && !e.ContainsKey(n + "cantidad"))
            {
                e[n + "cantidad"] = "Solo cantidades enteras.";
            }
            // en una venta nueva desde una orden, no más de lo que falta entregar de esa línea
            if (EsNuevo && desdeOrden && !e.ContainsKey(n + "cantidad") && l.Cantidad > PendienteEnOrden(l))
            {
                e[n + "cantidad"] = $"No puede pasar de lo pendiente en la orden ({PendienteEnOrden(l):0.###}).";
            }
        }
        return e;
    }

    private async Task Guardar()
    {
        error = null;
        if (!v.Intentar(Errores()))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        guardando = true;
        try
        {
            for (var i = 0; i < venta!.Lineas.Count; i++)
            {
                venta.Lineas[i].NumeroLinea = i + 1;
            }

            if (EsNuevo)
            {
                var nueva = await Api.Post<VentaDatos>("ventas", venta);           // POST /api/ventas
                // siguiente paso del flujo: emitir su comprobante (allí se avisa que se registró)
                Nav.NavigateTo(nueva is not null
                    ? $"/ventas/{nueva.Id}/comprobante?nueva=true&volver={Volver.Parametro(VolverA)}"
                    : VolverA);
            }
            else
            {
                var guardada = await Api.Put<VentaDatos>($"ventas/{Id}", venta);   // PUT /api/ventas/{Id}
                Nav.NavigateTo(Volver.ConAviso(VolverA, AvisoGuardado.Editado, guardada?.Numero ?? venta.Numero));
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "Stock insuficiente para ..." o "La venta supera el límite de crédito del cliente"
            if (e.Message.Contains("requiere autorización del Administrador") || e.Message.Contains("en espera del Administrador"))
            {
                requiereAutorizacion = true;
            }
        }
        finally
        {
            guardando = false;
        }
    }

    // RF014: pide la autorización de ESTA venta con sus datos (mismo cuerpo que guardarla)
    private async Task<SolicitudDatos?> SolicitarAutorizacion()
    {
        error = null;
        for (var i = 0; i < venta!.Lineas.Count; i++)
        {
            venta.Lineas[i].NumeroLinea = i + 1;
        }
        try
        {
            return await Api.Post<SolicitudDatos>("ventas/solicitar-autorizacion", venta);
        }
        catch (ErrorApi e) when (e.Message.Contains("no hace falta autorización"))
        {
            // el Vendedor corrigió el descuento: ya puede guardar sin autorización
            requiereAutorizacion = false;
            error = "Ya ninguna línea queda bajo el costo: puede guardar.";
            return null;
        }
    }
}

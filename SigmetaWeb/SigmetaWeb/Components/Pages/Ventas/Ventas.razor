@page "/ventas"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Cajero,Administrador")]
@using SigmetaWeb.Components.Pages.Clientes
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Ventas y comprobantes · SIGMETA</PageTitle>

@* RF008 · Lista de ventas (Vendedor y Cajero). PATRÓN UX de listas (ver Shared/ComponentesFlujo.cs):
     - Cada fila dice su SITUACIÓN (lo primero que le falta) y a QUIÉN le toca: FlujoVentas.Situacion / Siguiente.
     - Chips con la cantidad por situación + búsqueda rápida (número, cliente, documento, comprobante).
     - Filtros y página quedan en la dirección (?situacion=…&q=…): al volver de una venta la lista está igual.
     - Una acción principal por fila según el rol y la situación (Emitir, Cobrar o Ver); el resto, como enlaces.
   Datos reales del Java:
   - GET  /api/ventas (?cliente=ID)            listarTodos / listarPorCliente, con comprobante vigente y si ya se cobró
   - POST /api/ventas/{id}/anular {"motivo"}   anular (no con comprobante o despacho vigente) *@
<Encabezado Rf="RF008" Titulo="Ventas y comprobantes">
    @if (Rol == "Vendedor")
    {
        @* RF008: la venta la registra el Vendedor (VentaBOImpl.registrar exige el rol VENDEDOR) *@
        <a class="btn btn-primary" href="/ventas/nueva">+ Nueva venta</a>
    }
</Encabezado>

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />
<Notificacion Mensaje="@exito" AlCerrar="() => exito = null" />

@* Lo que pasa al anular cambia según la venta (stock, cuenta por cobrar, caja, orden): se dice solo lo que aplica *@
<ModalMotivo Visible="@(anulando is not null)" Titulo="@($"Anular {anulando?.Numero}")" TextoConfirmar="Anular"
             Ocupado="@trabajando" AlConfirmar="ConfirmarAnulacion" AlCancelar="() => anulando = null">
    <ul class="small text-muted mb-0 ps-3">
        <li>Libera el stock reservado.</li>
        @if (anulando?.CondicionPago == "CREDITO")
        {
            <li>Se retira su cuenta por cobrar.</li>
        }
        @if (anulando?.CobradaContado == true)
        {
            <li>Se devuelve el cobro con un egreso de caja.</li>
        }
        @if (!string.IsNullOrEmpty(anulando?.NumeroOrden))
        {
            <li>La orden @anulando.NumeroOrden vuelve a quedar pendiente.</li>
        }
    </ul>
</ModalMotivo>

<FiltrosLista @bind-Busqueda="busqueda" @bind-Busqueda:after="AlBuscar" Placeholder="Número, cliente o comprobante"
              Opciones="@Chips" Estado="@situacion" EstadoChanged="CambiarSituacion" EtiquetaEstado="Situación"
              HayFiltros="@HayFiltros" AlLimpiar="Limpiar">
    <Campo Etiqueta="Cliente" Id="fCliente" Clase="col-sm-6 col-md-3">
        <select id="fCliente" class="form-select" value="@filtroCliente" @onchange="CambiarCliente">
            <option value="0">Todos</option>
            @foreach (var c in clientes)
            {
                <option value="@c.Id">@c.NombreMostrado</option>
            }
        </select>
    </Campo>
</FiltrosLista>

@if (ventas is null)
{
    <p class="text-muted">Cargando ventas...</p>
}
else
{
    var filtradas = Filtradas;
    var pagina = Pagina(filtradas).ToList();
    <div class="card mb-3">
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table table-hover align-middle mb-0 tabla-lista">
                <thead>
                    <tr>
                        <th>Venta</th>
                        <th>Cliente</th>
                        <th>Pago</th>
                        <th class="text-end">Total (S/)</th>
                        <th>Situación</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                @if (HayFiltros)
                                {
                                    <ListaVacia Titulo="Ninguna venta coincide con los filtros." AlQuitarFiltros="Limpiar" />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Todavía no hay ventas registradas."
                                                TextoAccion="@(Rol == "Vendedor" ? "Registrar la primera venta" : null)" Ruta="/ventas/nueva" />
                                }
                            </td>
                        </tr>
                    }
                    @for (var i = 0; i < pagina.Count; i++)
                    {
                        var v = pagina[i];
                        var sit = FlujoVentas.Situacion(v);
                        var haciaArriba = pagina.Count > 3 && i >= pagina.Count - 2;
                        <tr @key="v.Id">
                            <td>
                                <a class="numero" href="@RutaVenta(v)">@v.Numero</a>
                                <div class="sub">@TextosVentas.Fecha(v.FechaEmision)</div>
                            </td>
                            <td>@v.Cliente</td>
                            <td>@TextosVentas.Texto(v.CondicionPago)</td>
                            <td class="text-end fw-semibold">@v.Total.ToString("N2")</td>
                            <td>
                                <span class="badge rounded-pill border @Tonos.Clase(FlujoVentas.TonoSituacion(sit))">@FlujoVentas.TextoSituacion(sit)</span>
                                @if (v.Comprobante is not null)
                                {
                                    <div class="sub">@v.Comprobante</div>
                                }
                            </td>
                            <td class="acciones">
                                <AccionesFila Principal="@Principal(v)" Otras="@Secundarias(v)" Ocupado="@trabajando" HaciaArriba="@haciaArriba" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" PaginaActual="@paginaActual" PaginaActualChanged="CambiarPagina"
                    @bind-TamanoPagina="tamanoPagina" />
    </div>
}


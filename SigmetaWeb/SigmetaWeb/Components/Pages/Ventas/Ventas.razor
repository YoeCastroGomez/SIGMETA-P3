@page "/ventas"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Cajero,Administrador")]
@using SigmetaWeb.Components.Pages.Clientes
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Ventas y comprobantes · SIGMETA</PageTitle>

@* RF008 · Lista de ventas (Vendedor y Cajero). PATRÓN UX de listas (ver Shared/ComponentesFlujo.cs):
     - Cada fila dice su SITUACIÓN (lo primero que le falta) y a QUIÉN le toca: FlujoVentas.Situacion / Siguiente.
     - Chips con la cantidad por situación + búsqueda rápida (número, cliente, documento, comprobante).
     - Filtros y página quedan en la dirección (?situacion=…&q=…): al volver de una venta la lista está igual.
     - Una acción principal por fila según el rol y la situación (Emitir, Cobrar o Ver); el resto, como enlaces.
   Datos reales del Java:
   - GET  /api/ventas (?cliente=ID)            listarTodos / listarPorCliente, con comprobante vigente y si ya se cobró
   - POST /api/ventas/{id}/anular {"motivo"}   anular (no con comprobante o despacho vigente) *@
<Encabezado Rf="RF008" Titulo="Ventas y comprobantes"
            Subtitulo="Cada venta muestra qué le falta y a quién le toca: comprobante, cobro en caja y despacho.">
    @if (Rol == "Vendedor")
    {
        @* RF008: la venta la registra el Vendedor (VentaBOImpl.registrar exige el rol VENDEDOR) *@
        <a class="btn btn-primary" href="/ventas/nueva">+ Nueva venta</a>
    }
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<SiguientePaso Mensaje="@exito" Detalle="@exitoDetalle" AlCerrar="() => exito = null" />

<ModalMotivo Visible="@(anulando is not null)" Titulo="@($"Anular la venta {anulando?.Numero}")" TextoConfirmar="Anular venta"
             Ocupado="@trabajando" AlConfirmar="ConfirmarAnulacion" AlCancelar="() => anulando = null">
    <p class="mb-2">Al anular la venta <strong>@anulando?.Numero</strong> (S/ @anulando?.Total.ToString("N2")):</p>
    <ul class="small mb-0">
        <li>Deja de valer y libera el stock que tenía reservado.</li>
        @if (anulando?.CondicionPago == "CREDITO")
        {
            <li>Se retira su cuenta por cobrar.</li>
        }
        @if (anulando?.CobradaContado == true)
        {
            <li>El cobro en caja se devuelve con un egreso en la caja donde se cobró.</li>
        }
        @if (!string.IsNullOrEmpty(anulando?.NumeroOrden))
        {
            <li>Lo vendido vuelve a estar pendiente en la orden @anulando.NumeroOrden.</li>
        }
    </ul>
</ModalMotivo>

<div class="card card-body mb-3">
    <div class="row g-2 align-items-end sigmeta-filtros">
        <div class="col-md-6 col-lg-5">
            <label class="form-label fw-semibold small" for="buscarVenta">Buscar</label>
            <input id="buscarVenta" type="search" class="form-control" maxlength="80" autocomplete="off"
                   placeholder="Número, cliente, documento o comprobante"
                   @bind="busqueda" @bind:event="oninput" @bind:after="AlBuscar" />
        </div>
        <div class="col-md-6 col-lg-4">
            <label class="form-label fw-semibold small" for="fCliente">Cliente</label>
            <select id="fCliente" class="form-select" value="@filtroCliente" @onchange="CambiarCliente">
                <option value="0">Todos los clientes</option>
                @foreach (var c in clientes)
                {
                    <option value="@c.Id">@c.NombreMostrado · @c.NumeroDocumento</option>
                }
            </select>
        </div>
        <div class="col-lg-3 text-lg-end">
            @if (HayFiltros)
            {
                <button type="button" class="btn btn-link px-0" @onclick="Limpiar">Quitar filtros</button>
            }
        </div>
    </div>
    <div class="mt-3">
        <ChipsFiltro Opciones="@Chips" Seleccionado="@situacion" SeleccionadoChanged="CambiarSituacion" Etiqueta="Filtrar por situación" />
    </div>
</div>

@if (ventas is null)
{
    <p class="text-muted">Cargando ventas...</p>
}
else
{
    var filtradas = Filtradas;
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Venta</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th class="text-end">Total (S/)</th>
                        <th>Situación y siguiente paso</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                @if (HayFiltros)
                                {
                                    <ListaVacia Titulo="Ninguna venta coincide con los filtros." Detalle="Pruebe con otra situación, otro cliente u otro texto."
                                                AlQuitarFiltros="Limpiar" />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Todavía no hay ventas registradas."
                                                TextoAccion="@(Rol == "Vendedor" ? "Registrar la primera venta" : null)" Ruta="/ventas/nueva" />
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var v in Pagina(filtradas))
                    {
                        var sit = FlujoVentas.Situacion(v);
                        var sig = FlujoVentas.Siguiente(v);
                        <tr @key="v.Id">
                            <td>
                                <a class="fw-semibold text-decoration-none" href="@RutaVenta(v)">@v.Numero</a>
                                <div class="small text-muted">
                                    @(string.IsNullOrEmpty(v.NumeroOrden) ? "Venta directa" : $"Orden {v.NumeroOrden}") · @TextosVentas.Texto(v.CondicionPago)
                                </div>
                            </td>
                            <td>@v.Cliente<div class="small text-muted">@v.DocumentoCliente</div></td>
                            <td class="text-nowrap">@TextosVentas.Fecha(v.FechaEmision)</td>
                            <td class="text-end fw-semibold">@v.Total.ToString("N2")</td>
                            <td>
                                <span class="badge rounded-pill border @Tonos.Clase(FlujoVentas.TonoSituacion(sit))">@FlujoVentas.TextoSituacion(sit)</span>
                                @if (v.Comprobante is not null)
                                {
                                    <span class="small text-muted ms-1">@v.Comprobante</span>
                                }
                                @if (sig.Quien is not null)
                                {
                                    <div class="small mt-1">@sig.Que · <span class="text-muted">@sig.Quien</span></div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center justify-content-end gap-1 text-nowrap">
                                    @if (Rol == "Cajero" && v.CondicionPago == "CONTADO" && !v.CobradaContado && !FlujoVentas.EstaAnulada(v))
                                    {
                                        @* RF010 (Adriano): el Cajero cobra la venta al contado; queda como movimiento COBRO_CONTADO de su caja *@
                                        <a class="btn btn-sm btn-primary" href="@($"/ventas/{v.Id}/cobro?volver=/ventas")">Cobrar</a>
                                    }
                                    else if (sit == FlujoVentas.SinComprobante && Rol is "Vendedor" or "Cajero")
                                    {
                                        <a class="btn btn-sm btn-primary" href="@RutaVenta(v)">Emitir</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@RutaVenta(v)">Ver</a>
                                    }
                                    @if (Rol == "Vendedor" && FlujoVentas.MotivoNoEditable(v) is null)
                                    {
                                        <a class="btn btn-sm btn-link px-2" href="@($"/ventas/editar/{v.Id}?volver={Volver.Parametro(RutaActual)}")">Editar</a>
                                    }
                                    @if (Rol == "Vendedor" && FlujoVentas.MotivoNoAnulable(v) is null)
                                    {
                                        <button type="button" class="btn btn-sm btn-link link-danger px-2" @onclick="() => AbrirAnulacion(v)">Anular</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" PaginaActual="@paginaActual" PaginaActualChanged="CambiarPagina"
                    @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    // Filtros en la dirección: /ventas?cliente=3&situacion=POR_COBRAR&q=acme&pagina=2
    [SupplyParameterFromQuery(Name = "cliente")] public int? ClienteQ { get; set; }
    [SupplyParameterFromQuery(Name = "situacion")] public string? SituacionQ { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? BusquedaQ { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int? PaginaQ { get; set; }
    // Aviso de éxito con el patrón único (AvisoGuardado): el formulario vuelve aquí con ?guardado=…&ref=…
    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<VentaDatos>? ventas;
    private List<Cliente> clientes = new();
    private int filtroCliente;
    private int? clienteCargado;
    private string situacion = "";
    private string busqueda = "";
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private string? urlPropia;

    private string? error;
    private string? exito;
    private string? exitoDetalle;
    private bool avisoLeido;
    private bool trabajando;
    private VentaDatos? anulando;

    private string RutaActual => "/" + Nav.ToBaseRelativePath(Nav.Uri);
    private string RutaVenta(VentaDatos v) => $"/ventas/{v.Id}/comprobante?volver={Volver.Parametro(RutaActual)}";
    private bool HayFiltros => filtroCliente > 0 || situacion != "" || !string.IsNullOrWhiteSpace(busqueda);

    // ---------------- Filtrado (en la pantalla, sobre lo que ya devolvió el Java) ----------------

    private List<VentaDatos> PorBusqueda => (ventas ?? new())
        .Where(v => Busqueda.Coincide(busqueda, v.Numero, v.Cliente, v.DocumentoCliente, v.Comprobante, v.NumeroOrden))
        .ToList();

    private List<VentaDatos> Filtradas => PorBusqueda
        .Where(v => situacion == "" || FlujoVentas.Situacion(v) == situacion)
        .OrderByDescending(v => v.FechaEmision).ThenByDescending(v => v.Id)
        .ToList();

    private IReadOnlyList<OpcionChip> Chips
    {
        get
        {
            var base_ = PorBusqueda;
            int Cuantas(string s) => base_.Count(v => FlujoVentas.Situacion(v) == s);
            return new List<OpcionChip>
            {
                new("", "Todas", base_.Count),
                new(FlujoVentas.SinComprobante, "Sin comprobante", Cuantas(FlujoVentas.SinComprobante), "ambar"),
                new(FlujoVentas.PorCobrar, "Por cobrar", Cuantas(FlujoVentas.PorCobrar), "ambar"),
                new(FlujoVentas.PorDespachar, "Por despachar", Cuantas(FlujoVentas.PorDespachar), "azul"),
                new(FlujoVentas.Completa, "Completas", Cuantas(FlujoVentas.Completa), "verde"),
                new(FlujoVentas.Anulada, "Anuladas", Cuantas(FlujoVentas.Anulada), "rojo")
            };
        }
    }

    private IEnumerable<VentaDatos> Pagina(List<VentaDatos> lista)
    {
        if (tamanoPagina == 0) return lista;
        var total = Math.Max(1, (int)Math.Ceiling((double)lista.Count / tamanoPagina));
        return lista.Skip((Math.Clamp(paginaActual, 1, total) - 1) * tamanoPagina).Take(tamanoPagina);
    }

    // ---------------- Carga y filtros en la dirección ----------------

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await Api.Get<List<Cliente>>("clientes") ?? new();   // para el filtro por cliente
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!avisoLeido)
        {
            avisoLeido = true;
            exito = AvisoGuardado.Texto(Guardado, "la venta", Referencia);
            if (exito is not null && Guardado == AvisoGuardado.Editado)
            {
                exitoDetalle = "Siguiente: emitir su comprobante (botón «Emitir» de la fila).";
            }
        }
        if (urlPropia is not null && Nav.Uri == urlPropia)
        {
            return;   // el cambio de dirección lo hizo esta misma pantalla: ya tiene los filtros
        }
        filtroCliente = ClienteQ ?? 0;
        situacion = SituacionQ ?? "";
        busqueda = BusquedaQ ?? "";
        paginaActual = Math.Max(1, PaginaQ ?? 1);
        if (ventas is null || clienteCargado != filtroCliente)
        {
            await Cargar();
        }
    }

    private async Task Cargar()
    {
        try
        {
            var ruta = filtroCliente > 0 ? $"ventas?cliente={filtroCliente}" : "ventas";   // listarPorCliente / listarTodos
            ventas = await Api.Get<List<VentaDatos>>(ruta) ?? new();
            clienteCargado = filtroCliente;
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            ventas ??= new();
        }
    }

    private void SincronizarUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["cliente"] = filtroCliente > 0 ? filtroCliente : (object?)null,
            ["situacion"] = situacion == "" ? null : situacion,
            ["q"] = string.IsNullOrWhiteSpace(busqueda) ? null : busqueda.Trim(),
            ["pagina"] = paginaActual > 1 ? paginaActual : (object?)null,
            ["guardado"] = null,
            ["ref"] = null
        });
        if (uri == Nav.Uri) return;
        urlPropia = uri;
        Nav.NavigateTo(uri, replace: true);
    }

    private async Task CambiarCliente(ChangeEventArgs e)
    {
        filtroCliente = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        paginaActual = 1;
        await Cargar();
        SincronizarUrl();
    }

    private void CambiarSituacion(string valor)
    {
        situacion = valor;
        paginaActual = 1;
        SincronizarUrl();
    }

    private void AlBuscar()
    {
        paginaActual = 1;
        SincronizarUrl();
    }

    private void CambiarPagina(int pagina)
    {
        paginaActual = pagina;
        SincronizarUrl();
    }

    private async Task Limpiar()
    {
        var recargar = filtroCliente > 0;
        filtroCliente = 0;
        situacion = "";
        busqueda = "";
        paginaActual = 1;
        if (recargar) await Cargar();
        SincronizarUrl();
    }

    // ---------------- Anular (RF008) ----------------

    private void AbrirAnulacion(VentaDatos v)
    {
        error = null;
        exito = null;
        anulando = v;
    }

    // POST /api/ventas/{id}/anular {"motivo": ...}
    private async Task ConfirmarAnulacion(string motivo)
    {
        if (anulando is null) return;
        trabajando = true;
        try
        {
            await Api.Post<object>($"ventas/{anulando.Id}/anular", new AnulacionDatos { Motivo = motivo });
            exito = $"Se anuló la venta {anulando.Numero}.";
            exitoDetalle = "El stock que tenía reservado quedó libre para otras ventas.";
            anulando = null;
            await Cargar();
        }
        catch (ErrorApi e)
        {
            anulando = null;
            error = e.Message;   // por ejemplo "No se puede anular una venta con comprobantes vigentes"
        }
        finally
        {
            trabajando = false;
        }
    }
}

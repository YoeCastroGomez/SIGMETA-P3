@page "/ventas/{Id:int}/cobro"
@using SigmetaWeb.Components.Pages.Caja
@inject NavigationManager Nav

<PageTitle>Cobrar venta al contado · SIGMETA</PageTitle>

@* RF010 · Cobro de una venta al contado (Cajero, con su caja abierta).
   En el BO es un movimiento COBRO_CONTADO que registra el Cajero indicando la venta de origen
   (documentoOrigen = VENTA y su id; MovimientoCajaBOImpl.registrarMovimiento).
   Solo visual (Lab 9): Guardar no registra nada, solo vuelve a la caja. *@
<Encabezado Rf="RF010" Titulo="Cobrar venta al contado" Subtitulo="El cobro entra como movimiento de tu caja abierta.">
    <a class="btn btn-outline-secondary" href="@Volver">Volver</a>
</Encabezado>

<div class="card card-body mb-3" style="max-width: 760px;">
    <h2 class="h6 fw-semibold mb-3">Caja abierta</h2>
    <div class="row">
        <div class="col-sm-4 mb-3">
            <div class="small text-muted text-uppercase">Caja</div>
            <div class="fw-semibold">N.º @caja.Id</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="small text-muted text-uppercase">Cajero</div>
            <div class="fw-semibold">@caja.UsuarioApertura</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="small text-muted text-uppercase">Apertura</div>
            <div class="fw-semibold">@caja.FechaApertura.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <hr />

    <h2 class="h6 fw-semibold mb-3">Venta</h2>
    <div class="row">
        <div class="col-sm-4 mb-3">
            <div class="small text-muted text-uppercase">Venta</div>
            <div class="fw-semibold">@venta.Numero</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="small text-muted text-uppercase">Comprobante</div>
            <div class="fw-semibold">@(venta.Comprobante ?? "Sin emitir")</div>
        </div>
        <div class="col-sm-4 mb-3">
            <div class="small text-muted text-uppercase">Condición de pago</div>
            <div class="fw-semibold">@MuestrasVentas.Texto(venta.CondicionPago)</div>
        </div>
        <div class="col-12 mb-3">
            <div class="small text-muted text-uppercase">Cliente</div>
            <div class="fw-semibold">@venta.Cliente</div>
        </div>
    </div>

    @if (venta.CondicionPago != "CONTADO" || venta.Estado == "ANULADA")
    {
        <div class="alert alert-warning mb-0">
            Solo se cobran aquí las ventas al contado vigentes. Las ventas al crédito se cobran desde su cuenta por cobrar (RF009).
        </div>
    }
    else if (MuestrasVentas.CobradaAlContado(venta.Id))
    {
        <div class="alert alert-secondary mb-0">Esta venta ya tiene su cobro al contado registrado en la caja.</div>
    }
    else
    {
        <hr />

        <div class="row">
            <div class="col-md-6">
                <Campo Etiqueta="Monto (S/)" Id="monto" Obligatorio="true" Ayuda="Total de la venta con IGV.">
                    <input id="monto" class="form-control" readonly value="@total.ToString("N2")" />
                </Campo>
            </div>
            <div class="col-md-6">
                <Campo Etiqueta="Medio de pago" Id="medio" Obligatorio="true">
                    <select id="medio" class="form-select">
                        @foreach (var m in MuestrasCaja.MediosPago)
                        {
                            <option value="@m">@MuestrasCaja.Texto(m)</option>
                        }
                    </select>
                </Campo>
            </div>
            <div class="col-12">
                <Campo Etiqueta="Concepto" Id="concepto" Ayuda="Se registra con el movimiento de caja.">
                    <input id="concepto" class="form-control" readonly
                           value="@($"Cobro al contado venta {venta.Numero}{(venta.Comprobante is null ? "" : $" ({venta.Comprobante})")}")" />
                </Campo>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
            <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="@Volver">Cancelar</a>
                <button class="btn btn-primary" @onclick="Guardar">Registrar cobro</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    // Pantalla a la que se vuelve: la caja (por defecto) o la lista de ventas
    [SupplyParameterFromQuery(Name = "volver")] public string? VolverA { get; set; }
    private string Volver => VolverA == "/ventas" ? "/ventas" : "/caja";

    private readonly CajaFila caja = MuestrasCaja.CajaActual;
    private VentaFila venta = MuestrasVentas.Ventas[0];
    private decimal total;

    protected override void OnParametersSet()
    {
        venta = MuestrasVentas.Venta(Id) ?? MuestrasVentas.Ventas[0];
        total = MuestrasVentas.Total(venta.Detalles);
    }

    // Lab 9: no se registra nada; al guardar vuelve a la caja (RF010).
    private void Guardar() => Nav.NavigateTo("/caja");
}

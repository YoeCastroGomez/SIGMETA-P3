@page "/ventas/{Id:int}/cobro"
@using SigmetaWeb.Components.Pages.Caja
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Cobrar venta al contado · SIGMETA</PageTitle>

@* RF010 · Cobro de una venta al contado (Cajero, con su caja abierta). Datos reales del Java:
   - GET  /api/cajas/abierta                 caja abierta del usuario de la sesión
   - GET  /api/cajas/ventas-por-cobrar       ventas al contado vigentes que aún no tienen cobro
   - POST /api/cajas/{id}/cobros-contado     {"idVenta": ..., "medioPago": ...}
   En el BO es un movimiento COBRO_CONTADO con la venta de origen (MovimientoCajaBO.registrarMovimiento).
   El monto no lo digita el cajero: el BO usa el total de la venta y rechaza una venta anulada, al crédito o ya cobrada. *@
<Encabezado Rf="RF010" Titulo="Cobrar venta al contado" Subtitulo="El cobro entra como movimiento de tu caja abierta.">
    <a class="btn btn-outline-secondary" href="@Volver">Volver</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (cargando)
{
    <p class="text-muted">Cargando...</p>
}
else if (caja is null)
{
    <div class="alert alert-secondary">Para cobrar necesitas tu caja abierta. <a href="/caja">Abrir caja</a></div>
}
else
{
    <div class="card card-body mb-3" style="max-width: 760px;">
        <h2 class="h6 fw-semibold mb-3">Caja abierta</h2>
        <div class="row">
            <div class="col-sm-4 mb-3">
                <div class="small text-muted text-uppercase">Caja</div>
                <div class="fw-semibold">N.º @caja.Id</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="small text-muted text-uppercase">Cajero</div>
                <div class="fw-semibold">@caja.UsuarioApertura</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="small text-muted text-uppercase">Apertura</div>
                <div class="fw-semibold">@TextosCaja.FechaHora(caja.FechaApertura)</div>
            </div>
        </div>

        <hr />

        @if (venta is null)
        {
            <div class="alert alert-warning mb-0">
                La venta no está pendiente de cobro al contado: ya fue cobrada, está anulada o es al crédito
                (las ventas al crédito se cobran desde su cuenta por cobrar, RF009).
            </div>
        }
        else
        {
            <h2 class="h6 fw-semibold mb-3">Venta</h2>
            <div class="row">
                <div class="col-sm-4 mb-3">
                    <div class="small text-muted text-uppercase">Venta</div>
                    <div class="fw-semibold">@venta.Numero</div>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="small text-muted text-uppercase">Comprobante</div>
                    <div class="fw-semibold">@(venta.Comprobante ?? "Sin emitir")</div>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="small text-muted text-uppercase">Emisión</div>
                    <div class="fw-semibold">@TextosCaja.Fecha(venta.FechaEmision)</div>
                </div>
                <div class="col-12 mb-3">
                    <div class="small text-muted text-uppercase">Cliente</div>
                    <div class="fw-semibold">@venta.Cliente <span class="small text-muted">@venta.DocumentoCliente</span></div>
                </div>
            </div>

            <hr />

            <div class="row">
                <div class="col-md-6">
                    <Campo Etiqueta="Monto (S/)" Id="monto" Ayuda="Total de la venta con IGV. Lo toma el sistema.">
                        <input id="monto" class="form-control" readonly value="@venta.Total.ToString("N2")" />
                    </Campo>
                </div>
                <div class="col-md-6">
                    <Campo Etiqueta="Medio de pago" Id="medio" Obligatorio="true">
                        <select id="medio" class="form-select" @bind="medioPago">
                            @foreach (var m in TextosCaja.MediosPago)
                            {
                                <option value="@m">@TextosCaja.Texto(m)</option>
                            }
                        </select>
                    </Campo>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
                <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="@Volver">Cancelar</a>
                    <button class="btn btn-primary" disabled="@guardando" @onclick="Guardar">Registrar cobro</button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Pantalla a la que se vuelve: la caja (por defecto) o la lista de ventas
    [SupplyParameterFromQuery(Name = "volver")] public string? VolverA { get; set; }
    private string Volver => VolverA == "/ventas" ? "/ventas" : "/caja";

    private CajaDatos? caja;
    private VentaPorCobrar? venta;
    private string medioPago = "EFECTIVO";
    private bool cargando = true;
    private bool guardando;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            caja = await Api.Get<CajaDatos>("cajas/abierta");
            if (caja is not null)
            {
                var porCobrar = await Api.Get<List<VentaPorCobrar>>("cajas/ventas-por-cobrar") ?? new();
                venta = porCobrar.FirstOrDefault(v => v.Id == Id);
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        cargando = false;
    }

    private async Task Guardar()
    {
        if (caja is null || venta is null) return;
        error = null;
        guardando = true;
        try
        {
            await Api.Post<MovimientoDatos>($"cajas/{caja.Id}/cobros-contado", new CobroContado { IdVenta = venta.Id, MedioPago = medioPago });
            Nav.NavigateTo(Volver);
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        guardando = false;
    }
}

@page "/notas-credito"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Cajero,Administrador")]
@inject ApiJava Api
@using SigmetaWeb.Components.Pages.Almacen

<PageTitle>Notas de crédito · SIGMETA</PageTitle>

@* RF013 · Notas de crédito por devolución. Las emite el Cajero con autorización; el Cajero y el Administrador
   las modifican (motivo), anulan y consultan. PATRÓN UX (ver Shared/ComponentesFlujo.cs): chips por estado,
   búsqueda por fechas y texto (la hace el Java: sp_nota_credito_buscar), y <ModalMotivo> para modificar y
   anular, que dice qué va a pasar.
   GET /api/notas-credito?desde=&hasta=&texto= · GET /api/notas-credito/{id}/lineas · POST /api/notas-credito/{id}/anular
   PUT /api/notas-credito/{id} {"motivo"}: modificar el motivo (Cajero o Administrador; el BO valida el rol y que no esté anulada) *@
<Encabezado Rf="RF013" Titulo="Notas de crédito">
    @if (EsCajero)
    {
        <a class="btn btn-primary" href="/notas-credito/nueva">+ Nueva nota de crédito</a>
    }
</Encabezado>

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />
<Notificacion Mensaje="@exito" AlCerrar="() => exito = null" />

<ModalMotivo Visible="@(porAnular is not null)" Titulo="@($"Anular {porAnular?.Nota}")" TextoConfirmar="Anular"
             Ocupado="@trabajando" Ejemplo="Ejemplo: se registró sobre el comprobante equivocado."
             AlConfirmar="ConfirmarAnular" AlCancelar="() => porAnular = null">
    <p class="mb-0 text-muted">Se revierten el stock y la deuda o la caja del cliente.</p>
</ModalMotivo>

@* RF013: modificar la nota. Solo el motivo: los productos y montos ya movieron stock, deuda y caja *@
<ModalMotivo Visible="@(porEditar is not null)" Titulo="@($"Modificar el motivo de {porEditar?.Nota}")" TextoConfirmar="Guardar motivo"
             ClaseConfirmar="btn-primary" EtiquetaMotivo="Nuevo motivo" MotivoInicial="@porEditar?.Motivo" Ejemplo="@((string?)null)"
             Ocupado="@trabajando" AlConfirmar="ConfirmarEditar" AlCancelar="() => porEditar = null">
    <p class="small text-muted mb-0">Los productos y montos no cambian.</p>
</ModalMotivo>

@* La búsqueda la hace el Java (sp_nota_credito_buscar): se consulta al dejar de escribir o al cambiar una fecha *@
<FiltrosLista @bind-Busqueda="texto" @bind-Busqueda:after="BuscarAlEscribir" Placeholder="Buscar por cliente, documento o comprobante"
              Opciones="@Chips" Estado="@filtroEstado" EstadoChanged="CambiarEstado"
              HayFiltros="@(HayFiltros || filtroEstado != "")" AlLimpiar="Limpiar">
    <div class="input-group filtro-fecha">
        <span class="input-group-text">Desde</span>
        <input type="date" class="form-control" aria-label="Desde" @bind="desde" @bind:after="Buscar" />
    </div>
    <div class="input-group filtro-fecha" title="@ValidacionEnVivo.ErrorRango(desde, hasta)">
        <span class="input-group-text">Hasta</span>
        <input type="date" class="@ValidacionEnVivo.ClaseRango(desde, hasta)" aria-label="Hasta" @bind="hasta" @bind:after="Buscar" />
    </div>
</FiltrosLista>

@if (notas is null)
{
    <p class="text-muted">Cargando notas de crédito...</p>
}
else
{
    var filtradas = Filtradas;
    var pagina = Pagina(filtradas).ToList();
    <div class="card mb-3">
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table table-hover align-middle mb-0 tabla-lista">
                <thead>
                    <tr>
                        <th>Nota</th>
                        <th>Comprobante</th>
                        <th>Cliente</th>
                        <th class="text-end">Total (S/)</th>
                        <th>Estado</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                @if (HayFiltros || filtroEstado != "")
                                {
                                    <ListaVacia Titulo="Ninguna nota coincide con la búsqueda." AlQuitarFiltros="Limpiar" />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Todavía no hay notas de crédito."
                                                TextoAccion="@(EsCajero ? "Emitir una nota de crédito" : null)" Ruta="/notas-credito/nueva" />
                                }
                            </td>
                        </tr>
                    }
                    @for (var i = 0; i < pagina.Count; i++)
                    {
                        var n = pagina[i];
                        var anulada = n.Estado == "ANULADO";
                        var haciaArriba = pagina.Count > 3 && i >= pagina.Count - 2 && detalleDe != n.Id;
                        <tr @key="n.Id" class="@(anulada ? "text-muted" : "")">
                            <td>
                                <span class="numero">@n.Nota</span>
                                <div class="sub">@Formato.Fecha(n.FechaEmision)</div>
                            </td>
                            <td>@n.Origen<div class="sub">Venta @n.Venta</div></td>
                            <td>@n.Cliente</td>
                            <td class="text-end text-nowrap fw-semibold">@n.Total.ToString("N2")</td>
                            <td><Estado Texto="@(anulada ? "Anulada" : "Vigente")" /></td>
                            <td class="acciones">
                                <AccionesFila Principal="@(new AccionFila(detalleDe == n.Id ? "Ocultar" : "Ver", Hacer: () => VerDetalle(n), Destacada: false))"
                                              Otras="@Secundarias(n)" Ocupado="@trabajando" HaciaArriba="@haciaArriba" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                        @if (detalleDe == n.Id)
                        {
                            <tr>
                                <td colspan="6" class="bg-body-tertiary">
                                    <div class="small mb-2"><strong>Motivo:</strong> @n.Motivo
                                        · <strong>Autorizó:</strong> @(string.IsNullOrEmpty(n.Autorizo) ? "—" : n.Autorizo)
                                        · @NotaCreditoDatos.TextoTipo(n.TipoNota) · @Formato.Legible(n.CondicionPago)</div>
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr><th>Producto devuelto</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Descuento</th><th class="text-end">Importe</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var l in detalle)
                                            {
                                                <tr>
                                                    <td>@l.CodigoInterno · @l.Producto</td>
                                                    <td class="text-end">@Formato.Cantidad(l.Cantidad) @TextosAlmacen.Unidad(l.UnidadVenta)</td>
                                                    <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                                    <td class="text-end">@l.Descuento.ToString("N2")</td>
                                                    <td class="text-end">@l.Importe.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr><td colspan="4" class="text-end">Valor de venta</td><td class="text-end">@n.SubTotal.ToString("N2")</td></tr>
                                            <tr><td colspan="4" class="text-end">IGV (18 %)</td><td class="text-end">@n.Igv.ToString("N2")</td></tr>
                                            <tr><td colspan="4" class="text-end fw-bold">Total</td><td class="text-end fw-bold">@Formato.Soles(n.Total)</td></tr>
                                        </tfoot>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";
    private bool EsCajero => Rol == "Cajero";
    // RF013: modifican y anulan la nota el Cajero y el Administrador (igual que ComprobanteBOImpl)
    private bool PuedeModificar => Rol == "Cajero" || Rol == "Administrador";

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<NotaCreditoDatos>? notas;
    private List<NotaCreditoLinea> detalle = new();
    private int? detalleDe;
    private DateTime? desde;
    private DateTime? hasta;
    private string texto = "";
    private string filtroEstado = "";
    private NotaCreditoDatos? porAnular;
    private NotaCreditoDatos? porEditar;
    private bool cargando;
    private bool trabajando;
    private string? error;
    private string? exito;
    private CancellationTokenSource? esperaBusqueda;
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    private bool HayFiltros => desde is not null || hasta is not null || !string.IsNullOrWhiteSpace(texto);

    // Lo llama AccionesFila: la acción corre en esta pantalla para que se redibuje (detalle, ventanas de motivo y anular)
    private Task Ejecutar(AccionFila a) => a.Hacer?.Invoke() ?? Task.CompletedTask;

    // Menú «⋯»: modificar el motivo y anular (Cajero o Administrador, solo vigentes)
    private List<AccionFila> Secundarias(NotaCreditoDatos n) =>
        n.Estado == "ANULADO" || !PuedeModificar
            ? new()
            : new()
            {
                new("Editar motivo", Hacer: () => PedirEditar(n)),
                new("Anular", Hacer: () => PedirAnular(n), Peligro: true)
            };

    // El Java busca por texto: se espera a que se deje de escribir para no consultar en cada tecla
    private async Task BuscarAlEscribir()
    {
        esperaBusqueda?.Cancel();
        var espera = esperaBusqueda = new CancellationTokenSource();
        try
        {
            await Task.Delay(350, espera.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        await Buscar();
    }

    private List<NotaCreditoDatos> Filtradas => (notas ?? new())
        .Where(n => filtroEstado == "" || (filtroEstado == "ANULADO") == (n.Estado == "ANULADO"))
        .ToList();

    private IReadOnlyList<OpcionChip> Chips => new List<OpcionChip>
    {
        new("", "Todas", notas?.Count),
        new("VIGENTE", "Vigentes", notas?.Count(n => n.Estado != "ANULADO"), "verde"),
        new("ANULADO", "Anuladas", notas?.Count(n => n.Estado == "ANULADO"), "rojo")
    };

    private IEnumerable<NotaCreditoDatos> Pagina(List<NotaCreditoDatos> lista)
    {
        if (tamanoPagina == 0) return lista;
        var total = Math.Max(1, (int)Math.Ceiling((double)lista.Count / tamanoPagina));
        return lista.Skip((Math.Clamp(paginaActual, 1, total) - 1) * tamanoPagina).Take(tamanoPagina);
    }

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
        if (Guardado == AvisoGuardado.Nuevo)
        {
            exito = $"Se registró la nota de crédito {Referencia}.";
        }
    }

    private async Task Buscar()
    {
        error = null;
        if (ValidacionEnVivo.ErrorRango(desde, hasta) is not null)
        {
            return;
        }
        cargando = true;
        try
        {
            notas = await Api.Get<List<NotaCreditoDatos>>(
                $"notas-credito?desde={Formato.Iso(desde)}&hasta={Formato.Iso(hasta)}&texto={Uri.EscapeDataString(texto.Trim())}") ?? new();
            paginaActual = 1;
            detalleDe = null;
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            notas ??= new();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Limpiar()
    {
        desde = hasta = null;
        texto = "";
        filtroEstado = "";
        exito = null;
        await Buscar();
    }

    private void CambiarEstado(string estado)
    {
        filtroEstado = estado;
        paginaActual = 1;
    }

    private async Task VerDetalle(NotaCreditoDatos n)
    {
        if (detalleDe == n.Id)
        {
            detalleDe = null;
            return;
        }
        try
        {
            detalle = await Api.Get<List<NotaCreditoLinea>>($"notas-credito/{n.Id}/lineas") ?? new();
            detalleDe = n.Id;
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private Task PedirEditar(NotaCreditoDatos n)
    {
        error = exito = null;
        porEditar = n;
        return Task.CompletedTask;
    }

    // PUT /api/notas-credito/{id} {"motivo"}
    private async Task ConfirmarEditar(string motivo)
    {
        var n = porEditar;
        if (n is null) return;
        trabajando = true;
        try
        {
            await Api.Put<object>($"notas-credito/{n.Id}", new { motivo });
            porEditar = null;
            await Buscar();
            exito = $"Se modificó el motivo de la nota de crédito {n.Nota}.";
        }
        catch (ErrorApi e)
        {
            porEditar = null;
            error = e.Message;   // por ejemplo "No se puede modificar una nota de crédito anulada"
        }
        finally
        {
            trabajando = false;
        }
    }

    private Task PedirAnular(NotaCreditoDatos n)
    {
        error = exito = null;
        porAnular = n;
        return Task.CompletedTask;
    }

    private async Task ConfirmarAnular(string motivo)
    {
        var n = porAnular;
        if (n is null) return;
        trabajando = true;
        try
        {
            await Api.Post<object>($"notas-credito/{n.Id}/anular", new { motivo });
            porAnular = null;
            await Buscar();
            exito = AvisoGuardado.Texto(AvisoGuardado.Anulado, "la nota de crédito", n.Nota);
        }
        catch (ErrorApi e)
        {
            porAnular = null;
            error = e.Message;   // por ejemplo "Stock insuficiente para revertir la nota de crédito..."
        }
        finally
        {
            trabajando = false;
        }
    }
}

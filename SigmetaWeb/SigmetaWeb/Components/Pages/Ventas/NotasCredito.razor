@page "/notas-credito"
@inject ApiJava Api
@using SigmetaWeb.Components.Pages.Almacen

<PageTitle>Notas de crédito · SIGMETA</PageTitle>

@* RF013 · Notas de crédito por devolución. Las emite el Cajero con autorización; las consulta el Administrador.
   GET /api/notas-credito?desde=&hasta=&texto= · GET /api/notas-credito/{id}/lineas · POST /api/notas-credito/{id}/anular *@
<Encabezado Rf="RF013" Titulo="Notas de crédito"
            Subtitulo="Cada nota devuelve mercadería al stock y rebaja la deuda del cliente o le devuelve su dinero por caja.">
    @if (EsCajero)
    {
        <a class="btn btn-primary" href="/notas-credito/nueva">Nueva nota de crédito</a>
    }
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

<Confirmacion Visible="@(porAnular is not null)" Titulo="Anular nota de crédito" TextoConfirmar="Anular nota"
              AlConfirmar="ConfirmarAnular" AlCancelar="() => porAnular = null">
    <p class="mb-2">Al anular la nota <strong>@porAnular?.Nota</strong> se deshace todo lo que hizo: la mercadería vuelve a salir
        del stock, la deuda del cliente vuelve a subir y, si se devolvió dinero, se registra su ingreso en la misma caja.</p>
    <Campo Etiqueta="Motivo" Id="motivoAnu" Obligatorio="true" Error="@errorMotivo">
        <textarea id="motivoAnu" class="form-control" rows="2" maxlength="200" @bind="motivo" @bind:event="oninput"></textarea>
    </Campo>
</Confirmacion>

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Desde" Id="fDesde" Clase="col-sm-6 col-md-2">
            <input id="fDesde" type="date" class="form-control" @bind="desde" />
        </Campo>
        <Campo Etiqueta="Hasta" Id="fHasta" Clase="col-sm-6 col-md-2">
            <input id="fHasta" type="date" class="form-control" @bind="hasta" />
        </Campo>
        <Campo Etiqueta="Cliente, documento o comprobante" Id="fTexto" Clase="col-md">
            <input id="fTexto" class="form-control" maxlength="100" placeholder="Ej.: Constructora, 20548963217, F001-00000049" @bind="texto" />
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark" disabled="@cargando">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" disabled="@cargando" @onclick="Limpiar">Limpiar</button>
        </div>
    </form>
</div>

@if (notas is null)
{
    <p class="text-muted">Cargando notas de crédito...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nota</th>
                        <th>Emisión</th>
                        <th>Comprobante de origen</th>
                        <th>Cliente</th>
                        <th class="text-end">Total</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (notas.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron notas de crédito.</td></tr>
                    }
                    @foreach (var n in Pagina)
                    {
                        <tr>
                            <td><strong>@n.Nota</strong></td>
                            <td class="text-nowrap">@Formato.Fecha(n.FechaEmision)</td>
                            <td>@n.Origen<div class="small text-muted">@Formato.Legible(n.TipoOrigen) · venta @n.Venta (@Formato.Legible(n.CondicionPago).ToLower())</div></td>
                            <td>@n.Cliente<div class="small text-muted">@n.NumeroDocumento</div></td>
                            <td class="text-end text-nowrap">@Formato.Soles(n.Total)</td>
                            <td><Estado Texto="@(n.Estado == "ANULADO" ? "Anulada" : "Vigente")" /></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 text-nowrap">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => VerDetalle(n)">
                                        @(detalleDe == n.Id ? "Ocultar" : "Ver detalle")
                                    </button>
                                    @if (n.Estado != "ANULADO")
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirAnular(n)">Anular</button>
                                    }
                                </div>
                            </td>
                        </tr>
                        @if (detalleDe == n.Id)
                        {
                            <tr>
                                <td colspan="7" class="bg-body-tertiary">
                                    <div class="small mb-2"><strong>Motivo:</strong> @n.Motivo
                                        · <strong>Autorizó:</strong> @(string.IsNullOrEmpty(n.Autorizo) ? "—" : n.Autorizo)</div>
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr><th>Producto devuelto</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Descuento</th><th class="text-end">Importe</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var l in detalle)
                                            {
                                                <tr>
                                                    <td>@l.CodigoInterno · @l.Producto</td>
                                                    <td class="text-end">@Formato.Cantidad(l.Cantidad) @TextosAlmacen.Unidad(l.UnidadVenta)</td>
                                                    <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                                    <td class="text-end">@l.Descuento.ToString("N2")</td>
                                                    <td class="text-end">@l.Importe.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr><td colspan="4" class="text-end">Subtotal</td><td class="text-end">@n.SubTotal.ToString("N2")</td></tr>
                                            <tr><td colspan="4" class="text-end">IGV (18 %)</td><td class="text-end">@n.Igv.ToString("N2")</td></tr>
                                            <tr><td colspan="4" class="text-end fw-bold">Total</td><td class="text-end fw-bold">@Formato.Soles(n.Total)</td></tr>
                                        </tfoot>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@notas.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";
    private bool EsCajero => Rol == "Cajero";

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<NotaCreditoDatos>? notas;
    private List<NotaCreditoLinea> detalle = new();
    private int? detalleDe;
    private DateTime? desde;
    private DateTime? hasta;
    private string texto = "";
    private NotaCreditoDatos? porAnular;
    private string motivo = "";
    private string? errorMotivo;
    private bool cargando;
    private string? error;
    private string? exito;
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    private IEnumerable<NotaCreditoDatos> Pagina => tamanoPagina == 0 ? notas!
        : notas!.Skip((Math.Max(paginaActual, 1) - 1) * tamanoPagina).Take(tamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
        if (Guardado == AvisoGuardado.Nuevo)
        {
            exito = $"Se registró la nota de crédito {Referencia}. La mercadería ya reingresó al stock.";
        }
    }

    private async Task Buscar()
    {
        error = null;
        if (desde is not null && hasta is not null && desde > hasta)
        {
            error = "La fecha de inicio no puede ser posterior a la fecha de fin.";
            return;
        }
        cargando = true;
        try
        {
            notas = await Api.Get<List<NotaCreditoDatos>>(
                $"notas-credito?desde={Formato.Iso(desde)}&hasta={Formato.Iso(hasta)}&texto={Uri.EscapeDataString(texto.Trim())}") ?? new();
            paginaActual = 1;
            detalleDe = null;
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            notas ??= new();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Limpiar()
    {
        desde = hasta = null;
        texto = "";
        exito = null;
        await Buscar();
    }

    private async Task VerDetalle(NotaCreditoDatos n)
    {
        if (detalleDe == n.Id)
        {
            detalleDe = null;
            return;
        }
        try
        {
            detalle = await Api.Get<List<NotaCreditoLinea>>($"notas-credito/{n.Id}/lineas") ?? new();
            detalleDe = n.Id;
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private void PedirAnular(NotaCreditoDatos n)
    {
        error = exito = errorMotivo = null;
        motivo = "";
        porAnular = n;
    }

    private async Task ConfirmarAnular()
    {
        if (string.IsNullOrWhiteSpace(motivo))
        {
            errorMotivo = "El motivo es obligatorio.";
            return;
        }
        var n = porAnular;
        porAnular = null;
        if (n is null) return;
        try
        {
            await Api.Post<object>($"notas-credito/{n.Id}/anular", new { motivo = motivo.Trim() });
            await Buscar();
            exito = AvisoGuardado.Texto(AvisoGuardado.Anulado, "la nota de crédito", n.Nota);
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

            new("Órdenes abiertas", TextoConteo(OrdenesAbiertas), "Pendientes de atención", "OC", "/ordenes"),
            new("Clientes activos", TextoConteo(clientes?.Count(c => c.Activo)), "Clientes habilitados", "CL", "/clientes"),

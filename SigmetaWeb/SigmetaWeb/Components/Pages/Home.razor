@page "/"
@using System.Globalization
@using SigmetaWeb.Components.Pages.Compras
@using SigmetaWeb.Components.Pages.Catalogo
@using SigmetaWeb.Components.Pages.Clientes
@using SigmetaWeb.Components.Pages.Caja
@using SigmetaWeb.Components.Pages.Ventas
@inject ApiJava Api

<PageTitle>Panel de control · SIGMETA</PageTitle>

<div class="sg-dashboard">
    <header class="sg-hero">
        <div class="sg-hero-content">
            <div class="sg-eyebrow">SIGMETA / PANEL DE CONTROL</div>
            <h1>Bienvenido(a), @(string.IsNullOrWhiteSpace(Rol) ? "SIGMETA" : Rol)</h1>
            <p>@DescripcionRol</p>
            <div class="sg-hero-tags">
                <span class="sg-tag"><span class="sg-punto"></span>@(AccesosActuales.Length == 0 ? "Sin rol asignado" : Rol)</span>
                <span class="sg-tag">@DateTime.Today.ToString("dd 'de' MMMM 'de' yyyy", Cultura)</span>
            </div>
        </div>
        <div class="sg-hero-arte" aria-hidden="true">
            <div class="sg-hero-circulo">SM</div>
            <div class="sg-hero-barras"><i></i><i></i><i></i><i></i><i></i></div>
        </div>
    </header>

    @if (AccesosActuales.Length == 0)
    {
        <section class="sg-panel sg-sin-datos mt-3">
            Tu cuenta no tiene uno de los cuatro roles habilitados. Solicita al administrador que revise tus permisos.
        </section>
    }
    else
    {
        <div class="sg-seccion-cabecera">
            <div>
                <h2>@TituloResumen</h2>
                <p>Indicadores actualizados de la operación de la empresa.</p>
            </div>
            <button type="button" class="sg-actualizar" disabled="@cargando" @onclick="CargarDashboard">
                <span aria-hidden="true">↻</span> @(cargando ? "Actualizando..." : "Actualizar datos")
            </button>
        </div>

        @if (cargando && rolCargado is null)
        {
            <div class="sg-cargando" role="status">Consultando indicadores del sistema...</div>
        }

        @if (Errores.Count > 0)
        {
            <div class="alert alert-warning sg-alerta" role="alert">
                No se pudieron obtener algunos datos (@string.Join(", ", Errores)). Los indicadores afectados se muestran con —.
            </div>
        }

        <section class="sg-kpis" aria-label="Indicadores principales">
            @foreach (var kpi in Indicadores)
            {
                <a class="sg-kpi" href="@kpi.Ruta" @key="kpi.Titulo">
                    <div class="sg-kpi-encabezado">
                        <span>@kpi.Titulo</span>
                        <span class="sg-kpi-icono" aria-hidden="true">@kpi.Icono</span>
                    </div>
                    <div class="sg-kpi-valor">@kpi.Valor</div>
                    <div class="sg-kpi-ayuda">@kpi.Detalle</div>
                </a>
            }
        </section>

        @if (EsComercial)
        {
            <div class="sg-panel-grid sg-grid-principal">
                <section class="sg-panel sg-panel-grafico">
                    <div class="sg-panel-cabecera">
                        <div>
                            <h2>@(EsAdministrador ? "Ventas por mes" : "Evolución de ventas")</h2>
                            <p>@(EsAdministrador ? "Total de ventas no anuladas · últimos 12 meses." : "Ventas no anuladas de los últimos siete días.")</p>
                        </div>
                        <span class="sg-chip">S/</span>
                    </div>
                    @if (ventas is null)
                    {
                        <div class="sg-sin-datos">Los datos de ventas no están disponibles.</div>
                    }
                    else if (EsAdministrador)
                    {
                        <div class="sg-columnas-contenedor">
                            <div class="sg-columnas">
                                @foreach (var mes in SerieMensual)
                                {
                                    <div class="sg-columna-contenedor" title="@($"{mes.Etiqueta}: {Dinero(mes.Valor)}")" @key="mes.Etiqueta">
                                        <span class="sg-columna-valor">@mes.Valor.ToString("N0")</span>
                                        <div class="sg-columna-eje">
                                            <div class="sg-columna" style="height:@(Porcentaje(mes.Valor, MaximoMensual))%"></div>
                                        </div>
                                        <small>@mes.Etiqueta</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="sg-linea-grafico">
                            <svg viewBox="0 0 540 185" role="img" aria-label="Ventas diarias en soles de los últimos siete días">
                                <line x1="28" y1="150" x2="514" y2="150" class="sg-eje" />
                                <line x1="28" y1="100" x2="514" y2="100" class="sg-cuadricula" />
                                <line x1="28" y1="50" x2="514" y2="50" class="sg-cuadricula" />
                                <polyline fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" points="@PuntosLinea" />
                                @foreach (var punto in PuntosGrafico)
                                {
                                    <circle cx="@punto.X" cy="@punto.Y" r="5" class="sg-punto-linea">
                                        <title>@punto.Etiqueta: @Dinero(punto.Valor)</title>
                                    </circle>
                                }
                            </svg>
                            <div class="sg-eje-fechas">
                                @foreach (var dia in SerieDiaria)
                                {
                                    <span @key="dia.Etiqueta">@dia.Etiqueta</span>
                                }
                            </div>
                            <div class="sg-nota">Total de la última semana: <strong>@Dinero(SerieDiaria.Sum(x => x.Valor))</strong></div>
                        </div>
                    }
                </section>

                <section class="sg-panel sg-panel-grafico">
                    <div class="sg-panel-cabecera">
                        <div>
                            <h2>Productos más vendidos</h2>
                            <p>Por importe · detalle de hasta 8 ventas recientes.</p>
                        </div>
                        <span class="sg-chip">Top 5</span>
                    </div>
                    @if (ventas is null)
                    {
                        <div class="sg-sin-datos">No fue posible consultar las ventas.</div>
                    }
                    else if (TopProductos.Count == 0)
                    {
                        <div class="sg-sin-datos">No hay líneas de ventas recientes disponibles para calcular este ranking.</div>
                    }
                    else
                    {
                        <div class="sg-ranking">
                            @foreach (var producto in TopProductos)
                            {
                                <div class="sg-ranking-fila" @key="producto.Etiqueta">
                                    <div class="sg-ranking-encabezado"><span title="@producto.Etiqueta">@producto.Etiqueta</span><strong>@Dinero(producto.Valor)</strong></div>
                                    <div class="sg-barra-pista"><div class="sg-barra-relleno" style="width:@(Porcentaje(producto.Valor, MaximoProducto))%"></div></div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>

            <div class="sg-panel-grid sg-grid-secundario">
                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Distribución comercial</h2><p>Cantidad de cotizaciones, órdenes y ventas.</p></div></div>
                    @if (cotizaciones is null || ordenes is null || ventas is null)
                    {
                        <div class="sg-sin-datos">La distribución todavía no está disponible.</div>
                    }
                    else
                    {
                        <div class="sg-distribucion">
                            <div class="sg-anillo" style="@EstiloAnillo">
                                <div class="sg-anillo-centro"><strong>@TotalOperaciones</strong><small>registros</small></div>
                            </div>
                            <div class="sg-leyenda">
                                @foreach (var grupo in Distribucion)
                                {
                                    <div class="sg-leyenda-fila" @key="grupo.Etiqueta">
                                        <span class="sg-leyenda-nombre"><i class="@grupo.Clase"></i>@grupo.Etiqueta</span>
                                        <strong>@grupo.Valor.ToString("N0")</strong>
                                    </div>
                                }
                            </div>
                        </div>
                        <p class="sg-nota">Volúmenes de cada módulo; no representan una tasa de conversión.</p>
                    }
                </section>

                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Embudo comercial</h2><p>Seguimiento de las operaciones registradas.</p></div></div>
                    @if (cotizaciones is null || ordenes is null || ventas is null)
                    {
                        <div class="sg-sin-datos">El embudo requiere los tres servicios comerciales.</div>
                    }
                    else
                    {
                        <div class="sg-embudo">
                            <div class="sg-embudo-nivel uno"><span>Cotizaciones</span><strong>@cotizaciones.Count</strong></div>
                            <div class="sg-embudo-nivel dos"><span>Órdenes</span><strong>@ordenes.Count</strong></div>
                            <div class="sg-embudo-nivel tres"><span>Ventas desde orden</span><strong>@ventas.Count(v => !v.Anulado && v.IdOrden > 0)</strong></div>
                        </div>
                        <p class="sg-nota">Las ventas directas no se cuentan en la última etapa.</p>
                    }
                </section>

                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Alertas comerciales</h2><p>Operaciones que necesitan seguimiento.</p></div></div>
                    <div class="sg-alertas">
                        <a href="/cotizaciones" class="sg-alerta-fila"><span><span class="sg-alerta-icono">!</span>Cotizaciones por vencer <small>Vigencia dentro de tres días</small></span><strong>@TextoConteo(CotizacionesPorVencer)</strong></a>
                        <a href="/ordenes" class="sg-alerta-fila"><span><span class="sg-alerta-icono">!</span>Órdenes sin atender <small>Pendientes por más de 48 horas</small></span><strong>@TextoConteo(OrdenesAtrasadas)</strong></a>
                        <a href="/ventas" class="sg-alerta-fila"><span><span class="sg-alerta-icono">↗</span>Ventas del mes <small>Operaciones no anuladas</small></span><strong>@TextoConteo(VentasMesCantidad)</strong></a>
                    </div>
                </section>
            </div>

            <section class="sg-panel sg-panel-tabla">
                <div class="sg-panel-cabecera">
                    <div><h2>Últimas ventas</h2><p>Registros recientes en el sistema.</p></div>
                    <a href="/ventas" class="sg-enlace">Ver todas ↗</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Venta</th><th>Cliente</th><th>Fecha</th><th class="text-end">Importe</th><th>Estado</th></tr></thead>
                        <tbody>
                            @if (ventas is null || ventas.Count == 0)
                            {
                                <tr><td colspan="5" class="sg-celda-vacia">@(ventas is null ? "Ventas no disponibles." : "No hay ventas registradas.")</td></tr>
                            }
                            else
                            {
                                @foreach (var venta in UltimasVentas)
                                {
                                    <tr @key="venta.Id">
                                        <td class="fw-semibold">@venta.Numero</td>
                                        <td>@venta.Cliente</td>
                                        <td>@TextoFecha(venta.FechaEmision)</td>
                                        <td class="text-end">@Dinero(venta.Total)</td>
                                        <td><span class="sg-estado @(venta.Anulado ? "sg-estado-anulado" : "")">@TextosVentas.Texto(venta.Estado)</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else if (Rol == "Cajero")
        {
            <div class="sg-panel-grid sg-grid-principal">
                <section class="sg-panel sg-panel-grafico">
                    <div class="sg-panel-cabecera"><div><h2>Cobros de los últimos siete días</h2><p>Importes efectivamente registrados, excluyendo anulaciones.</p></div><span class="sg-chip">S/</span></div>
                    @if (cobros is null)
                    {
                        <div class="sg-sin-datos">No hay datos de cobros disponibles.</div>
                    }
                    else
                    {
                        <div class="sg-columnas-contenedor">
                            <div class="sg-columnas sg-columnas-siete">
                                @foreach (var dia in SerieCobros)
                                {
                                    <div class="sg-columna-contenedor" title="@($"{dia.Etiqueta}: {Dinero(dia.Valor)}")" @key="dia.Etiqueta">
                                        <span class="sg-columna-valor">@dia.Valor.ToString("N0")</span>
                                        <div class="sg-columna-eje"><div class="sg-columna" style="height:@(Porcentaje(dia.Valor, MaximoCobros))%"></div></div>
                                        <small>@dia.Etiqueta</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>
                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Medios de pago</h2><p>Distribución del importe cobrado.</p></div></div>
                    @if (cobros is null)
                    {
                        <div class="sg-sin-datos">No se pudo obtener la distribución.</div>
                    }
                    else if (MediosPago.Count == 0)
                    {
                        <div class="sg-sin-datos">Todavía no hay cobros vigentes.</div>
                    }
                    else
                    {
                        <div class="sg-ranking">
                            @foreach (var medio in MediosPago)
                            {
                                <div class="sg-ranking-fila" @key="medio.Etiqueta">
                                    <div class="sg-ranking-encabezado"><span>@TextosCaja.Texto(medio.Etiqueta)</span><strong>@Dinero(medio.Valor)</strong></div>
                                    <div class="sg-barra-pista"><div class="sg-barra-relleno" style="width:@(Porcentaje(medio.Valor, MaximoMedio))%"></div></div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
            <div class="sg-panel-grid sg-grid-doble">
                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Cuentas por cobrar</h2><p>Clientes con mayor saldo pendiente.</p></div><a href="/cobranzas" class="sg-enlace">Abrir módulo ↗</a></div>
                    @if (cuentas is null)
                    {
                        <div class="sg-sin-datos">Las cuentas por cobrar no están disponibles.</div>
                    }
                    else if (MayoresDeudas.Count == 0)
                    {
                        <div class="sg-sin-datos">No existen cuentas con saldo pendiente.</div>
                    }
                    else
                    {
                        <div class="sg-ranking">
                            @foreach (var deuda in MayoresDeudas)
                            {
                                <div class="sg-ranking-fila" @key="deuda.Etiqueta">
                                    <div class="sg-ranking-encabezado"><span>@deuda.Etiqueta</span><strong>@Dinero(deuda.Valor)</strong></div>
                                    <div class="sg-barra-pista"><div class="sg-barra-relleno" style="width:@(Porcentaje(deuda.Valor, MaximoDeuda))%"></div></div>
                                </div>
                            }
                        </div>
                    }
                </section>
                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Resumen de caja</h2><p>Situación de la jornada y cuentas vencidas.</p></div></div>
                    <div class="sg-alertas">
                        <a href="/caja" class="sg-alerta-fila"><span><span class="sg-alerta-icono">↗</span>Estado de caja</span><strong>@(cajaConsultada ? cajaAbierta is null ? "Sin abrir" : "Abierta" : "—")</strong></a>
                        <a href="/caja" class="sg-alerta-fila"><span><span class="sg-alerta-icono">S/</span>Monto esperado</span><strong>@(cajaAbierta is null ? "—" : Dinero(cajaAbierta.MontoEsperado))</strong></a>
                        <a href="/cobranzas" class="sg-alerta-fila"><span><span class="sg-alerta-icono">!</span>Cuentas vencidas</span><strong>@TextoConteo(CuentasVencidas)</strong></a>
                    </div>
                </section>
            </div>
        }
        else if (Rol == "Almacenero")
        {
            <div class="sg-panel-grid sg-grid-principal">
                <section class="sg-panel sg-panel-grafico">
                    <div class="sg-panel-cabecera"><div><h2>Productos por categoría</h2><p>Cantidad de referencias activas por categoría, no unidades mezcladas.</p></div></div>
                    @if (productos is null)
                    {
                        <div class="sg-sin-datos">El catálogo de productos no está disponible.</div>
                    }
                    else if (ProductosPorCategoria.Count == 0)
                    {
                        <div class="sg-sin-datos">No existen productos activos.</div>
                    }
                    else
                    {
                        <div class="sg-ranking">
                            @foreach (var grupo in ProductosPorCategoria)
                            {
                                <div class="sg-ranking-fila" @key="grupo.Etiqueta">
                                    <div class="sg-ranking-encabezado"><span>@grupo.Etiqueta</span><strong>@grupo.Valor.ToString("N0") productos</strong></div>
                                    <div class="sg-barra-pista"><div class="sg-barra-relleno" style="width:@(Porcentaje(grupo.Valor, MaximoCategoria))%"></div></div>
                                </div>
                            }
                        </div>
                    }
                </section>
                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Productos con stock crítico</h2><p>Existencias iguales o inferiores al mínimo.</p></div><a href="/almacen/stock-minimo" class="sg-enlace">Consultar ↗</a></div>
                    @if (productos is null)
                    {
                        <div class="sg-sin-datos">No se pudieron consultar existencias.</div>
                    }
                    else if (StockCritico.Count == 0)
                    {
                        <div class="sg-sin-datos">No hay productos activos bajo el mínimo.</div>
                    }
                    else
                    {
                        <div class="sg-stock-lista">
                            @foreach (var producto in StockCritico)
                            {
                                <div class="sg-stock-fila" @key="producto.Id">
                                    <span><strong>@producto.CodigoInterno</strong> · @producto.Nombre</span>
                                    <small>@producto.StockActual.ToString("0.###") / @producto.StockMinimo.ToString("0.###") @Producto.TextoUnidad(producto.UnidadVenta)</small>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
            <div class="sg-panel-grid sg-grid-doble">
                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Estado de inventario</h2><p>Proporción de referencias activas.</p></div></div>
                    @if (productos is null)
                    {
                        <div class="sg-sin-datos">Sin información del inventario.</div>
                    }
                    else
                    {
                        <div class="sg-distribucion">
                            <div class="sg-anillo" style="@EstiloAnilloInventario"><div class="sg-anillo-centro"><strong>@productos.Count(p => p.Activo)</strong><small>activos</small></div></div>
                            <div class="sg-leyenda">
                                <div class="sg-leyenda-fila"><span class="sg-leyenda-nombre"><i class="sg-color-a"></i>Sobre el mínimo</span><strong>@productos.Count(p => p.Activo && p.StockActual > p.StockMinimo)</strong></div>
                                <div class="sg-leyenda-fila"><span class="sg-leyenda-nombre"><i class="sg-color-b"></i>En o bajo el mínimo</span><strong>@productos.Count(p => p.Activo && p.StockActual <= p.StockMinimo)</strong></div>
                            </div>
                        </div>
                    }
                </section>
                <section class="sg-panel">
                    <div class="sg-panel-cabecera"><div><h2>Operaciones del almacén</h2><p>Accesos para atender pendientes y verificar movimientos.</p></div></div>
                    <div class="sg-alertas">
                        <a href="/recepciones" class="sg-alerta-fila"><span><span class="sg-alerta-icono">↓</span>Recepciones <small>Consultar compras por recibir</small></span><span>↗</span></a>
                        <a href="/despachos" class="sg-alerta-fila"><span><span class="sg-alerta-icono">↑</span>Despachos <small>Consultar ventas por despachar</small></span><span>↗</span></a>
                        <a href="/almacen/kardex" class="sg-alerta-fila"><span><span class="sg-alerta-icono">≡</span>Kardex <small>Consultar movimientos históricos</small></span><span>↗</span></a>
                    </div>
                    <p class="sg-nota">Los conteos de almacén se mostrarán aquí en una próxima versión.</p>
                </section>
            </div>
        }

        <section class="sg-accesos">
            <div class="sg-panel-cabecera"><div><h2>Accesos rápidos</h2><p>Herramientas disponibles para el rol @Rol.</p></div></div>
            <div class="sg-accesos-grid">
                @foreach (var acceso in AccesosActuales)
                {
                    <a class="sg-acceso" href="@acceso.Ruta" @key="acceso.Ruta">
                        <div class="sg-acceso-cabecera"><span class="sg-acceso-icono" aria-hidden="true">@acceso.Icono</span><span aria-hidden="true">↗</span></div>
                        <strong>@acceso.Titulo</strong>
                        <small>@acceso.Descripcion</small>
                    </a>
                }
            </div>
        </section>
    }
</div>

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";
    private static readonly CultureInfo Cultura = new("es-PE");

    private record Kpi(string Titulo, string Valor, string Detalle, string Icono, string Ruta);
    private record Acceso(string Icono, string Titulo, string Descripcion, string Ruta);
    private record Dato(string Etiqueta, decimal Valor, string Clase = "");
    private record PuntoGrafico(string X, string Y, string Etiqueta, decimal Valor);

    private bool EsAdministrador => Rol == "Administrador";
    private bool EsComercial => Rol is "Administrador" or "Vendedor";
    private bool cargando;
    private string? rolCargado;
    private readonly List<string> Errores = new();

    private List<VentaDatos>? ventas;
    private List<VentaDatos> ventasConDetalle = new();
    private List<CotizacionDatos>? cotizaciones;
    private List<OrdenDatos>? ordenes;
    private List<Cliente>? clientes;
    private List<CompraRest>? compras;
    private List<Proveedor>? proveedores;
    private List<Producto>? productos;
    private List<CobroDatos>? cobros;
    private List<CuentaDatos>? cuentas;
    private CajaDatos? cajaAbierta;
    private bool cajaConsultada;

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);
    private static bool VentaVigente(VentaDatos venta) => !venta.Anulado && venta.Estado != "ANULADA";
    private static decimal Porcentaje(decimal valor, decimal maximo) => maximo <= 0 ? 0 : Math.Clamp(valor * 100m / maximo, 0, 100);
    private static string Dinero(decimal valor) => "S/ " + valor.ToString("N2", Cultura);
    private static string Dinero(decimal? valor) => valor.HasValue ? Dinero(valor.Value) : "—";
    private static string TextoConteo(int? valor) => valor?.ToString("N0", Cultura) ?? "—";
    private static string TextoFecha(DateOnly? fecha) => fecha?.ToString("dd/MM/yyyy") ?? "—";

    private string DescripcionRol => Rol switch
    {
        "Administrador" => "Supervisa las ventas, las compras y el desempeño del negocio con información actualizada.",
        "Vendedor" => "Tus ventas, cotizaciones y órdenes de clientes desde un solo lugar.",
        "Cajero" => "Consulta los cobros, saldos y el estado de la caja de tu jornada.",
        "Almacenero" => "Controla el catálogo, las existencias y los productos que necesitan reposición.",
        _ => "Tu espacio de trabajo en SIGMETA."
    };

    private string TituloResumen => Rol switch
    {
        "Administrador" => "Resumen ejecutivo",
        "Vendedor" => "Panorama comercial",
        "Cajero" => "Panorama de caja y cobranza",
        "Almacenero" => "Panorama de inventario",
        _ => "Resumen"
    };

    private decimal TotalMes(int mesesAtras) => ventas?.Where(v => VentaVigente(v) && v.FechaEmision.HasValue &&
            v.FechaEmision.Value.Year == Hoy.AddMonths(-mesesAtras).Year &&
            v.FechaEmision.Value.Month == Hoy.AddMonths(-mesesAtras).Month)
        .Sum(v => v.Total) ?? 0;

    private int? VentasMesCantidad => ventas is null ? null :
        ventas.Count(v => VentaVigente(v) && v.FechaEmision.HasValue &&
                          v.FechaEmision.Value.Year == Hoy.Year && v.FechaEmision.Value.Month == Hoy.Month);

    private string CrecimientoMes
    {
        get
        {
            if (ventas is null) return "—";
            var anterior = TotalMes(1);
            if (anterior <= 0) return "Sin base";
            var variacion = (TotalMes(0) - anterior) * 100m / anterior;
            return variacion.ToString("+0.0;-0.0;0.0", Cultura) + "%";
        }
    }

    private decimal? TicketPromedio => ventas is null ? null :
        VentasMesCantidad > 0 ? TotalMes(0) / VentasMesCantidad.Value : 0m;

    private int? CotizacionesActivas => cotizaciones is null ? null :
        cotizaciones.Count(c => !c.Anulado && c.Estado is "REGISTRADA" or "ENVIADA");

    private int? OrdenesAbiertas => ordenes is null ? null :
        ordenes.Count(o => !o.Anulado && o.Estado is "PENDIENTE" or "ATENDIDA_PARCIAL");

    private int? CotizacionesPorVencer => cotizaciones is null ? null :
        cotizaciones.Count(c => !c.Anulado && c.Estado is "REGISTRADA" or "ENVIADA" &&
                               c.FechaVigencia.HasValue && c.FechaVigencia.Value >= Hoy &&
                               c.FechaVigencia.Value <= Hoy.AddDays(3));

    private int? OrdenesAtrasadas => ordenes is null ? null :
        ordenes.Count(o => !o.Anulado && o.Estado is "PENDIENTE" or "ATENDIDA_PARCIAL" &&
                           o.FechaEmision.HasValue && o.FechaEmision.Value < Hoy.AddDays(-2));


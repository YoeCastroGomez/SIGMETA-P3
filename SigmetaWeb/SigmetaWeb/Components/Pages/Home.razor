    private List<Dato> SerieMensual => ventas is null ? new() :
        Enumerable.Range(0, 12).Select(n => Hoy.AddMonths(n - 11))
            .Select(m => new Dato(m.ToString("MMM", Cultura),
                ventas.Where(v => VentaVigente(v) && v.FechaEmision.HasValue && v.FechaEmision.Value.Year == m.Year && v.FechaEmision.Value.Month == m.Month)
                    .Sum(v => v.Total))).ToList();

    private List<Dato> SerieDiaria => ventas is null ? new() :
        Enumerable.Range(0, 7).Select(n => Hoy.AddDays(n - 6))
            .Select(d => new Dato(d.ToString("dd MMM", Cultura),
                ventas.Where(v => VentaVigente(v) && v.FechaEmision == d).Sum(v => v.Total))).ToList();

    private decimal MaximoMensual => Math.Max(1m, SerieMensual.Select(m => m.Valor).DefaultIfEmpty(0).Max());
    private decimal MaximoCobros => Math.Max(1m, SerieCobros.Select(m => m.Valor).DefaultIfEmpty(0).Max());
    private decimal MaximoProducto => Math.Max(1m, TopProductos.Select(p => p.Valor).DefaultIfEmpty(0).Max());
    private decimal MaximoMedio => Math.Max(1m, MediosPago.Select(p => p.Valor).DefaultIfEmpty(0).Max());
    private decimal MaximoDeuda => Math.Max(1m, MayoresDeudas.Select(p => p.Valor).DefaultIfEmpty(0).Max());
    private decimal MaximoCategoria => Math.Max(1m, ProductosPorCategoria.Select(p => p.Valor).DefaultIfEmpty(0).Max());

    private List<PuntoGrafico> PuntosGrafico => SerieDiaria.Select((d, i) =>
        new PuntoGrafico((44 + i * 75).ToString(CultureInfo.InvariantCulture),
            (150m - Porcentaje(d.Valor, Math.Max(1m, SerieDiaria.Max(x => x.Valor))) * 1.22m).ToString("0.0", CultureInfo.InvariantCulture),
            d.Etiqueta, d.Valor)).ToList();
    private string PuntosLinea => string.Join(" ", PuntosGrafico.Select(p => p.X + "," + p.Y));

    private List<Dato> TopProductos => ventasConDetalle.SelectMany(v => v.Lineas ?? new())
        .GroupBy(l => l.IdProducto)
        .Select(g => new Dato(g.Select(l => string.IsNullOrWhiteSpace(l.Producto) ? $"Producto #{l.IdProducto}" : l.Producto!).First(), g.Sum(l => l.Importe)))
        .OrderByDescending(x => x.Valor).Take(5).ToList();

    private List<VentaDatos> UltimasVentas => ventas is null ? new() :
        ventas.OrderByDescending(v => v.FechaEmision).ThenByDescending(v => v.Id).Take(5).ToList();

    private List<Dato> Distribucion => new()
    {
        new("Cotizaciones", cotizaciones?.Count ?? 0, "sg-color-a"),
        new("Órdenes", ordenes?.Count ?? 0, "sg-color-b"),
        new("Ventas", ventas?.Count ?? 0, "sg-color-c")
    };
    private int TotalOperaciones => (cotizaciones?.Count ?? 0) + (ordenes?.Count ?? 0) + (ventas?.Count ?? 0);

    private string EstiloAnillo
    {
        get
        {
            if (TotalOperaciones == 0) return "background:conic-gradient(#78675f 0 100%)";
            var a = Porcentaje(cotizaciones?.Count ?? 0, TotalOperaciones);
            var b = a + Porcentaje(ordenes?.Count ?? 0, TotalOperaciones);
            return $"background:conic-gradient(#e87f23 0 {a.ToString(CultureInfo.InvariantCulture)}%, #f4b26c {a.ToString(CultureInfo.InvariantCulture)}% {b.ToString(CultureInfo.InvariantCulture)}%, #ffe0bc {b.ToString(CultureInfo.InvariantCulture)}% 100%)";
        }
    }

    private List<Dato> SerieCobros => cobros is null ? new() :
        Enumerable.Range(0, 7).Select(n => Hoy.AddDays(n - 6))
            .Select(d => new Dato(d.ToString("dd MMM", Cultura), cobros.Where(c => !c.Anulado && c.FechaCobro == d).Sum(c => c.Monto))).ToList();

    private List<Dato> MediosPago => cobros is null ? new() :
        cobros.Where(c => !c.Anulado).GroupBy(c => c.MedioPago)
            .Select(g => new Dato(g.Key, g.Sum(c => c.Monto))).OrderByDescending(g => g.Valor).ToList();

    private List<Dato> MayoresDeudas => cuentas is null ? new() :
        cuentas.Where(c => c.SaldoPendiente > 0)
            .GroupBy(c => c.Cliente ?? $"Cliente #{c.IdCliente}")
            .Select(g => new Dato(g.Key, g.Sum(c => c.SaldoPendiente)))
            .OrderByDescending(g => g.Valor).Take(5).ToList();

    private int? CuentasVencidas => cuentas is null ? null :
        cuentas.Count(c => c.SaldoPendiente > 0 && (c.Vencida || (c.FechaVencimiento.HasValue && c.FechaVencimiento.Value < Hoy)));

    private List<Dato> ProductosPorCategoria => productos is null ? new() :
        productos.Where(p => p.Activo).GroupBy(p => p.Categoria?.Nombre ?? "Sin categoría")
            .Select(g => new Dato(g.Key, g.Count())).OrderByDescending(g => g.Valor).Take(7).ToList();

    private List<Producto> StockCritico => productos is null ? new() :
        productos.Where(p => p.Activo && p.StockActual <= p.StockMinimo)
            .OrderBy(p => p.StockMinimo <= 0 ? 0 : p.StockActual / p.StockMinimo)
            .Take(7).ToList();

    private string EstiloAnilloInventario
    {
        get
        {
            var activos = productos?.Count(p => p.Activo) ?? 0;
            if (activos == 0) return "background:conic-gradient(#78675f 0 100%)";
            var bien = productos!.Count(p => p.Activo && p.StockActual > p.StockMinimo);
            var p = Porcentaje(bien, activos).ToString(CultureInfo.InvariantCulture);
            return $"background:conic-gradient(#e87f23 0 {p}%, #f4b26c {p}% 100%)";
        }
    }


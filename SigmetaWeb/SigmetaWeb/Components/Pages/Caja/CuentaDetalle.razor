@page "/cobranzas/{Id:int}"
@inject ApiJava Api

<PageTitle>Detalle de cuenta por cobrar · SIGMETA</PageTitle>

@* RF009 · Detalle de una cuenta por cobrar con sus cobros. Datos reales del Java:
   - GET    /api/cuentas-por-cobrar/{id}   la cuenta con sus cobros
   - DELETE /api/cobros/{id}               anular un cobro (CobroBO.eliminar): el saldo vuelve a la cuenta y en la caja
                                           queda un egreso que compensa el ingreso; no se puede si la caja ya cerró.
   Un cobro no se borra: queda marcado como anulado (baja lógica). Modificar corrige la fecha y la referencia. *@
<Encabezado Rf="RF009" Titulo="Cuenta por cobrar" Subtitulo="@(cuenta is null ? "" : $"{cuenta.Venta} · {cuenta.Cliente}")">
    <a class="btn btn-outline-secondary" href="/cobranzas">Volver a la lista</a>
    <a class="btn btn-outline-secondary" href="/cobros">Todos los cobros</a>
    @if (Rol == "Cajero" && cuenta is { SaldoPendiente: > 0 })
    {
        <a class="btn btn-primary" href="@($"/cobranzas/{Id}/cobro")">Registrar cobro</a>
    }
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

@if (cuenta is null)
{
    @if (error is null)
    {
        <p class="text-muted">Cargando la cuenta...</p>
    }
}
else
{
    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Datos de la cuenta</h2>
        <div class="row">
            <div class="col-sm-6 col-md-4 mb-3">
                <div class="small text-muted text-uppercase">Cliente</div>
                <div class="fw-semibold">@cuenta.Cliente</div>
                <div class="small text-muted">@cuenta.DocumentoCliente</div>
            </div>
            <div class="col-sm-6 col-md-4 mb-3">
                <div class="small text-muted text-uppercase">Venta</div>
                <div class="fw-semibold">@cuenta.Venta</div>
            </div>
            <div class="col-sm-6 col-md-4 mb-3">
                <div class="small text-muted text-uppercase">Comprobante</div>
                <div class="fw-semibold">@(cuenta.Comprobante ?? "Sin comprobante")</div>
            </div>
            <div class="col-sm-6 col-md-4 mb-3">
                <div class="small text-muted text-uppercase">Emisión</div>
                <div class="fw-semibold">@TextosCaja.Fecha(cuenta.FechaEmision)</div>
            </div>
            <div class="col-sm-6 col-md-4 mb-3">
                <div class="small text-muted text-uppercase">Vencimiento</div>
                <div class="fw-semibold @(cuenta.Vencida ? "text-danger" : "")">@TextosCaja.Fecha(cuenta.FechaVencimiento)</div>
            </div>
            <div class="col-sm-6 col-md-4 mb-3">
                <div class="small text-muted text-uppercase">Estado</div>
                <div><Estado Texto="@TextosCaja.Texto(cuenta.Estado)" /></div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="small text-muted text-uppercase">Monto original</div>
                <div class="fw-semibold">S/ @cuenta.MontoOriginal.ToString("N2")</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="small text-muted text-uppercase">Pagado</div>
                <div class="fw-semibold">S/ @cuenta.MontoPagado.ToString("N2")</div>
            </div>
            <div class="col-sm-4 mb-3">
                <div class="small text-muted text-uppercase">Saldo pendiente</div>
                <div class="fw-semibold">S/ @cuenta.SaldoPendiente.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body pb-0">
            <h2 class="h6 fw-semibold mb-3">Cobros</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th class="text-end">Monto</th>
                        <th>Medio de pago</th>
                        <th>Referencia</th>
                        <th>Registrado por</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cuenta.Cobros is null || cuenta.Cobros.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">La cuenta todavía no tiene cobros.</td></tr>
                    }
                    @foreach (var c in cuenta.Cobros ?? new())
                    {
                        <tr>
                            <td class="text-nowrap">@TextosCaja.Fecha(c.FechaCobro)</td>
                            <td class="text-end text-nowrap">S/ @c.Monto.ToString("N2")</td>
                            <td>@TextosCaja.Texto(c.MedioPago)</td>
                            <td>@(c.Referencia ?? "—")</td>
                            <td>
                                @c.UsuarioRegistro
                                <div class="small text-muted">@TextosCaja.FechaHora(c.FechaRegistro)</div>
                            </td>
                            <td>
                                <Estado Texto="@(c.Anulado ? "Anulado" : "Vigente")" />
                                @if (c.Anulado)
                                {
                                    <div class="small text-muted">@TextosCaja.FechaHora(c.FechaAnulacion)</div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 text-nowrap">
                                    @if (!c.Anulado && (Rol == "Cajero" || Rol == "Administrador"))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"/cobranzas/{cuenta.Id}/cobros/{c.Id}")">Modificar</a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Anular(c)">Anular</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert alert-secondary">
        Modificar un cobro solo corrige su fecha y su referencia. Para cambiar el monto o el medio de pago se anula y se registra uno nuevo.
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    private CuentaDatos? cuenta;
    private string? error;
    private string? exito;

    protected override async Task OnParametersSetAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            cuenta = await Api.Get<CuentaDatos>($"cuentas-por-cobrar/{Id}");
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private async Task Anular(CobroDatos c)
    {
        error = null;
        exito = null;
        try
        {
            await Api.Delete($"cobros/{c.Id}");
            exito = $"Se anuló el cobro de S/ {c.Monto:N2}. El monto volvió al saldo de la cuenta.";
            await Cargar();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

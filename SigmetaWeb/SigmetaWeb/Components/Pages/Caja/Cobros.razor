@page "/cobros"
@inject ApiJava Api

<PageTitle>Cobros · SIGMETA</PageTitle>

@* RF009 · Consulta de cobros (Cajero y Administrador). Datos reales del Java (las búsquedas las hace el BO):
   - GET    /api/cobros                       todos (CobroBO.listarTodos)
   - GET    /api/cobros?cliente={id}          por cliente (CobroBO.listarPorCliente)
   - GET    /api/cobros?desde=...&hasta=...   por rango de fechas de cobro (CobroBO.buscarPorRangoFechas)
   - DELETE /api/cobros/{id}                  anular (CobroBO.eliminar) *@
<Encabezado Rf="RF009" Titulo="Cobros"
            Subtitulo="Cobros registrados sobre las cuentas por cobrar. Importes en soles.">
    <a class="btn btn-outline-secondary" href="/cobranzas">Cuentas por cobrar</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

<div class="card card-body mb-3">
    <form class="row g-3 align-items-end" @onsubmit="Buscar" @onsubmit:preventDefault>
        <Campo Etiqueta="Cliente" Id="fCliente" Clase="col-sm-6 col-md">
            <select id="fCliente" class="form-select" @bind="fCliente">
                <option value="0">Todos</option>
                @foreach (var c in clientes)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
        </Campo>
        <Campo Etiqueta="Cobrado desde" Id="fDesde" Clase="col-sm-6 col-md-3">
            <input id="fDesde" type="date" class="form-control" @bind="fDesde" />
        </Campo>
        <Campo Etiqueta="Cobrado hasta" Id="fHasta" Clase="col-sm-6 col-md-3">
            <input id="fHasta" type="date" class="form-control" @bind="fHasta" />
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </form>
    <div class="form-text">Se busca por cliente; si es "Todos", por rango de fechas (las dos son obligatorias).</div>
</div>

@if (cobros is null)
{
    <p class="text-muted">Cargando cobros...</p>
}
else
{
    <div class="row">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body mb-3">
                <div class="small text-muted text-uppercase">Cobros encontrados</div>
                <div class="h5 fw-bold mb-0">@cobros.Count</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body mb-3">
                <div class="small text-muted text-uppercase">Total vigente</div>
                <div class="h5 fw-bold mb-0">S/ @cobros.Where(c => !c.Anulado).Sum(c => c.Monto).ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha de cobro</th>
                        <th>Cliente</th>
                        <th>Venta / comprobante</th>
                        <th class="text-end">Monto</th>
                        <th>Medio de pago</th>
                        <th>Referencia</th>
                        <th>Registrado por</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cobros.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No hay cobros que coincidan con la búsqueda.</td></tr>
                    }
                    @foreach (var c in cobros)
                    {
                        <tr>
                            <td class="text-nowrap">@TextosCaja.Fecha(c.FechaCobro)</td>
                            <td>@c.Cliente</td>
                            <td class="text-nowrap">
                                @c.Venta
                                <div class="small text-muted">@(c.Comprobante ?? "Sin comprobante")</div>
                            </td>
                            <td class="text-end text-nowrap">S/ @c.Monto.ToString("N2")</td>
                            <td>@TextosCaja.Texto(c.MedioPago)</td>
                            <td>@(c.Referencia ?? "—")</td>
                            <td>
                                @c.UsuarioRegistro
                                <div class="small text-muted">@TextosCaja.FechaHora(c.FechaRegistro)</div>
                            </td>
                            <td><Estado Texto="@(c.Anulado ? "Anulado" : "Vigente")" /></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/cobranzas/{c.IdCuentaPorCobrar}")">Ver cuenta</a>
                                    @if (!c.Anulado && (Rol == "Cajero" || Rol == "Administrador"))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"/cobranzas/{c.IdCuentaPorCobrar}/cobros/{c.Id}")">Modificar</a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Anular(c)">Anular</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    private record ClienteOpcion(int Id, string Nombre);

    private List<CobroDatos>? cobros;
    private List<ClienteOpcion> clientes = new();
    private int fCliente;
    private DateOnly? fDesde, fHasta;
    private string? error;
    private string? exito;

    protected override async Task OnInitializedAsync()
    {
        await Cargar("cobros");
        try
        {
            // clientes del filtro: los que tienen cuentas por cobrar
            var cuentas = await Api.Get<List<CuentaDatos>>("cuentas-por-cobrar") ?? new();
            clientes = cuentas.GroupBy(c => c.IdCliente)
                .Select(g => new ClienteOpcion(g.Key, g.First().Cliente ?? $"Cliente {g.Key}"))
                .OrderBy(c => c.Nombre)
                .ToList();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private async Task Buscar()
    {
        exito = null;
        if (fCliente > 0)
        {
            await Cargar($"cobros?cliente={fCliente}");
        }
        else if (fDesde is not null || fHasta is not null)
        {
            await Cargar($"cobros?desde={fDesde:yyyy-MM-dd}&hasta={fHasta:yyyy-MM-dd}");
        }
        else
        {
            await Cargar("cobros");
        }
    }

    private async Task Limpiar()
    {
        fCliente = 0;
        fDesde = fHasta = null;
        exito = null;
        await Cargar("cobros");
    }

    private async Task Cargar(string ruta)
    {
        error = null;
        try
        {
            cobros = (await Api.Get<List<CobroDatos>>(ruta) ?? new())
                .OrderByDescending(c => c.FechaCobro).ThenByDescending(c => c.Id).ToList();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            cobros ??= new();
        }
    }

    private async Task Anular(CobroDatos c)
    {
        error = null;
        exito = null;
        try
        {
            await Api.Delete($"cobros/{c.Id}");
            await Buscar();
            exito = $"Se anuló el cobro de S/ {c.Monto:N2} de {c.Cliente}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

@page "/cobros"

<PageTitle>Cobros · SIGMETA</PageTitle>

@* RF009 · Consulta de cobros (Cajero y Administrador): todos los cobros de todas las cuentas,
   con búsqueda por cliente, comprobante y rango de fechas de cobro.
   Solo visual (Lab 9): filtra en memoria los datos de ejemplo; Anular no hace nada. *@
<Encabezado Rf="RF009" Titulo="Cobros"
            Subtitulo="Cobros registrados sobre las cuentas por cobrar. Importes en soles.">
    <a class="btn btn-outline-secondary" href="/cobranzas">Cuentas por cobrar</a>
</Encabezado>

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <Campo Etiqueta="Cliente" Id="fCliente" Clase="col-sm-6 col-md">
            <input id="fCliente" class="form-control" maxlength="150" placeholder="Razón social, nombre o documento" @bind="fCliente" />
        </Campo>
        <Campo Etiqueta="Comprobante" Id="fComprobante" Clase="col-sm-6 col-md-2">
            <input id="fComprobante" class="form-control" maxlength="13" placeholder="F001-00000123" @bind="fComprobante" />
        </Campo>
        <Campo Etiqueta="Cobrado desde" Id="fDesde" Clase="col-sm-6 col-md-2">
            <input id="fDesde" type="date" class="form-control" @bind="fDesde" />
        </Campo>
        <Campo Etiqueta="Cobrado hasta" Id="fHasta" Clase="col-sm-6 col-md-2">
            <input id="fHasta" type="date" class="form-control" @bind="fHasta" />
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-2">
            <select id="fEstado" class="form-select" @bind="fEstado">
                <option value="">Todos</option>
                <option value="VIGENTE">Vigente</option>
                <option value="ANULADO">Anulado</option>
            </select>
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button class="btn btn-dark" @onclick="Buscar">Buscar</button>
            <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </div>
    @if (error is not null)
    {
        <div class="text-danger small mt-2">@error</div>
    }
</div>

<div class="row">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-body mb-3">
            <div class="small text-muted text-uppercase">Cobros encontrados</div>
            <div class="h5 fw-bold mb-0">@resultado.Length</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-body mb-3">
            <div class="small text-muted text-uppercase">Total vigente</div>
            <div class="h5 fw-bold mb-0">S/ @resultado.Where(f => !f.Cobro.Anulado).Sum(f => f.Cobro.Monto).ToString("N2")</div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha de cobro</th>
                    <th>Cliente</th>
                    <th>Venta / comprobante</th>
                    <th class="text-end">Monto</th>
                    <th>Medio de pago</th>
                    <th>Referencia</th>
                    <th>Registrado por</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (resultado.Length == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No hay cobros que coincidan con la búsqueda.</td></tr>
                }
                @foreach (var f in resultado)
                {
                    var c = f.Cobro;
                    <tr>
                        <td class="text-nowrap">@c.FechaCobro.ToString("dd/MM/yyyy")</td>
                        <td>@f.Cuenta.Cliente</td>
                        <td class="text-nowrap">
                            @f.Cuenta.Venta
                            <div class="small text-muted">@(f.Cuenta.Comprobante ?? "Sin comprobante")</div>
                        </td>
                        <td class="text-end text-nowrap">S/ @c.Monto.ToString("N2")</td>
                        <td>@MuestrasCaja.Texto(c.MedioPago)</td>
                        <td>@(c.Referencia ?? "—")</td>
                        <td>
                            @c.UsuarioRegistro
                            <div class="small text-muted">@c.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
                        </td>
                        <td><Estado Texto="@(c.Anulado ? "Anulado" : "Vigente")" /></td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/cobranzas/{c.IdCuenta}")">Ver cuenta</a>
                                @if (!c.Anulado && (Rol == "Cajero" || Rol == "Administrador"))
                                {
                                    @* RF009: Cajero o Administrador modifican (fecha y referencia) o anulan un cobro *@
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/cobranzas/{c.IdCuenta}/cobros/{c.Id}")">Modificar</a>
                                    <button class="btn btn-sm btn-outline-danger">Anular</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "Administrador";

    private record FilaCobro(CobroFila Cobro, CuentaFila Cuenta);

    // Cada cobro con su cuenta (cliente, venta y comprobante), del más reciente al más antiguo.
    private static readonly FilaCobro[] Todos = MuestrasCaja.Cobros
        .Select(c => new FilaCobro(c, MuestrasCaja.Cuenta(c.IdCuenta)))
        .OrderByDescending(f => f.Cobro.FechaCobro)
        .ToArray();

    private string? fCliente, fComprobante, fEstado;
    private DateOnly? fDesde, fHasta;
    private string? error;
    private FilaCobro[] resultado = Todos;

    private void Buscar()
    {
        error = null;
        if (fDesde is not null && fHasta is not null && fDesde > fHasta)
        {
            error = "La fecha Desde no puede ser posterior a Hasta.";
            return;
        }
        resultado = Todos.Where(f =>
            (string.IsNullOrWhiteSpace(fCliente) || f.Cuenta.Cliente.Contains(fCliente.Trim(), StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(fComprobante) || (f.Cuenta.Comprobante ?? "").Contains(fComprobante.Trim(), StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(fEstado) || (fEstado == "ANULADO") == f.Cobro.Anulado)
            && (fDesde is null || f.Cobro.FechaCobro >= fDesde)
            && (fHasta is null || f.Cobro.FechaCobro <= fHasta)).ToArray();
    }

    private void Limpiar()
    {
        fCliente = fComprobante = fEstado = null;
        fDesde = fHasta = null;
        error = null;
        resultado = Todos;
    }
}

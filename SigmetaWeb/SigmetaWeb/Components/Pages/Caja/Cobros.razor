@page "/cobros"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Cajero,Administrador")]
@inject ApiJava Api

<PageTitle>Cobros · SIGMETA</PageTitle>

@* RF009 · Consulta de cobros (Cajero y Administrador). Datos reales del Java (las búsquedas las hace el BO):
   - GET    /api/cobros                       todos (CobroBO.listarTodos)
   - GET    /api/cobros?cliente={id}          por cliente (CobroBO.listarPorCliente)
   - GET    /api/cobros?desde=...&hasta=...   por rango de fechas de cobro (CobroBO.buscarPorRangoFechas)
   - DELETE /api/cobros/{id}?motivo=...       anular con motivo (CobroBO.anular, RNF001) *@
<Encabezado Rf="RF009" Titulo="Cobros"
            Subtitulo="Cobros registrados sobre las cuentas por cobrar. Importes en soles.">
    <a class="btn btn-outline-secondary" href="/cobranzas">Cuentas por cobrar</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<AvisoExito Mensaje="@exito" AlCerrar="() => exito = null" />

@* RF009 + RNF001: anular un cobro pide el motivo; queda con el usuario y la fecha en el historial de la cuenta
   y en el reporte de caja (Reportes > Caja > Anulaciones) *@
<ModalMotivo Visible="@(porAnular is not null)" Titulo="@($"Anular el cobro de S/ {porAnular?.Monto:N2}")" TextoConfirmar="Anular cobro"
             Ocupado="@anulando" Ejemplo="Ejemplo: se registró en la cuenta equivocada."
             AlConfirmar="ConfirmarAnular" AlCancelar="() => porAnular = null">
    <p class="mb-0">El monto vuelve al saldo de la cuenta y en la caja queda un egreso que compensa el cobro.
        La anulación queda registrada con su motivo, usuario y fecha.</p>
</ModalMotivo>


<div class="card card-body mb-3">
    <form class="row g-3 align-items-end sigmeta-filtros" @onsubmit="Buscar" @onsubmit:preventDefault novalidate>
        <Campo Etiqueta="Cliente" Id="fCliente" Clase="col-sm-6 col-md">
            <select id="fCliente" class="form-select" @bind="fCliente">
                <option value="0">Todos</option>
                @foreach (var c in clientes)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
        </Campo>
        <Campo Etiqueta="Cobrado desde" Id="fDesde" Clase="col-sm-6 col-md-3">
            <input id="fDesde" type="date" class="form-control" @bind="fDesde" />
        </Campo>
        <Campo Etiqueta="Cobrado hasta" Id="fHasta" Error="@(ValidacionEnVivo.ErrorRango(fDesde, fHasta))" Clase="col-sm-6 col-md-3">
            <input id="fHasta" type="date" class="@(ValidacionEnVivo.ClaseRango(fDesde, fHasta))" @bind="fHasta" />
        </Campo>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
        </div>
    </form>
    <div class="form-text">Se busca por cliente; si es "Todos", por rango de fechas (las dos son obligatorias).</div>
</div>

@if (cobros is null)
{
    <p class="text-muted">Cargando cobros...</p>
}
else
{
    <div class="row">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body mb-3">
                <div class="small text-muted">Cobros encontrados</div>
                <div class="h5 fw-bold mb-0">@cobros.Count</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-body mb-3">
                <div class="small text-muted">Total vigente</div>
                <div class="h5 fw-bold mb-0">S/ @cobros.Where(c => !c.Anulado).Sum(c => c.Monto).ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha de cobro</th>
                        <th>Cliente</th>
                        <th>Venta / comprobante</th>
                        <th class="text-end">Monto</th>
                        <th>Medio de pago</th>
                        <th>Referencia</th>
                        <th>Registrado por</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cobros.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No hay cobros que coincidan con la búsqueda.</td></tr>
                    }
                    @foreach (var c in Paginar(cobros, paginaActual, tamanoPagina))
                    {
                        <tr>
                            <td class="text-nowrap">@TextosCaja.Fecha(c.FechaCobro)</td>
                            <td>@c.Cliente</td>
                            <td class="text-nowrap">
                                @c.Venta
                                <div class="small text-muted">@(c.Comprobante ?? "Sin comprobante")</div>
                            </td>
                            <td class="text-end text-nowrap">S/ @c.Monto.ToString("N2")</td>
                            <td>@TextosCaja.Texto(c.MedioPago)</td>
                            <td>@(c.Referencia ?? "—")</td>
                            <td>
                                @c.UsuarioRegistro
                                <div class="small text-muted">@TextosCaja.FechaHora(c.FechaRegistro)</div>
                            </td>
                            <td><Estado Texto="@(c.Anulado ? "Anulado" : "Vigente")" /></td>
                            <td class="text-end">
                                <AccionesFila Principal="@(new AccionFila("Ver cuenta", Ruta: $"/cobranzas/{c.IdCuentaPorCobrar}", Destacada: false))"
                                              Otras="@(!c.Anulado && (Rol == "Cajero" || Rol == "Administrador")
                                                  ? new List<AccionFila> { new("Modificar", Ruta: $"/cobranzas/{c.IdCuentaPorCobrar}/cobros/{c.Id}"), new("Anular", Hacer: () => Anular(c), Peligro: true) }
                                                  : new List<AccionFila>())" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@((cobros)?.Count ?? 0)" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    // UI/UX: una acción visible por fila y el resto en «⋯» (mismo patrón en todas las listas)
    private Task Ejecutar(AccionFila a) => a.Hacer?.Invoke() ?? Task.CompletedTask;

    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T>? registros, int pagina, int tamano)
    {
        if (registros is null) return Enumerable.Empty<T>();
        if (tamano == 0) return registros;
        int total = registros.Count();
        int paginaSegura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((paginaSegura - 1) * tamano).Take(tamano);
    }

    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    private record ClienteOpcion(int Id, string Nombre);

    private List<CobroDatos>? cobros;
    private List<ClienteOpcion> clientes = new();
    private int fCliente;
    private DateOnly? fDesde, fHasta;
    private string? error;
    private string? exito;

    protected override async Task OnInitializedAsync()
    {
        await Cargar("cobros");
        try
        {
            // clientes del filtro: los que tienen cuentas por cobrar
            var cuentas = await Api.Get<List<CuentaDatos>>("cuentas-por-cobrar") ?? new();
            clientes = cuentas.GroupBy(c => c.IdCliente)
                .Select(g => new ClienteOpcion(g.Key, g.First().Cliente ?? $"Cliente {g.Key}"))
                .OrderBy(c => c.Nombre)
                .ToList();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private async Task Buscar()
    {
        exito = null;
        if (fCliente > 0)
        {
            await Cargar($"cobros?cliente={fCliente}");
        }
        else if (fDesde is not null || fHasta is not null)
        {
            await Cargar($"cobros?desde={fDesde:yyyy-MM-dd}&hasta={fHasta:yyyy-MM-dd}");
        }
        else
        {
            await Cargar("cobros");
        }
    }

    private async Task Limpiar()
    {
        fCliente = 0;
        fDesde = fHasta = null;
        exito = null;
        await Cargar("cobros");
    }

    private async Task Cargar(string ruta)
    {
        error = null;
        try
        {
            cobros = (await Api.Get<List<CobroDatos>>(ruta) ?? new())
                .OrderByDescending(c => c.FechaCobro).ThenByDescending(c => c.Id).ToList();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            cobros ??= new();
        }
    }

    // RF009 + RNF001: primero se pide el motivo (ModalMotivo); DELETE /api/cobros/{id}?motivo=...
    private CobroDatos? porAnular;
    private bool anulando;

    private Task Anular(CobroDatos c)
    {
        porAnular = c;
        return Task.CompletedTask;
    }

    private async Task ConfirmarAnular(string motivo)
    {
        if (porAnular is null) return;
        var c = porAnular;
        error = null;
        exito = null;
        anulando = true;
        try
        {
            await Api.Delete($"cobros/{c.Id}?motivo={Uri.EscapeDataString(motivo)}");
            porAnular = null;
            await Buscar();
            exito = $"Se anuló el cobro de S/ {c.Monto:N2} de {c.Cliente}. Motivo: {motivo}";
        }
        catch (ErrorApi e)
        {
            porAnular = null;
            error = e.Message;
        }
        finally
        {
            anulando = false;
        }
    }
}

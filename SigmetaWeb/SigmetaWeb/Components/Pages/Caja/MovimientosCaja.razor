@page "/caja/movimientos"

<PageTitle>Movimientos de caja · SIGMETA</PageTitle>

@* RF010 · Movimientos de la caja abierta (Cajero). Solo visual (Lab 9): Guardar y Eliminar no registran nada.
   Los cobros entran solos desde la venta al contado o desde el cobro de una cuenta (RF009);
   aquí el Cajero solo registra ingresos y egresos manuales con su concepto. *@
<Encabezado Rf="RF010" Titulo="Movimientos de caja"
            Subtitulo="@($"Caja N.º {caja.Id} · abierta el {caja.FechaApertura:dd/MM/yyyy HH:mm} por {caja.UsuarioApertura}")">
    <a class="btn btn-outline-secondary" href="/caja">Volver a la caja</a>
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary" @onclick="() => mostrarFormulario = true">Ingreso o egreso manual</button>
    }
</Encabezado>

@if (mostrarFormulario)
{
    <div class="card card-body mb-3">
        <h2 class="h6 fw-semibold mb-3">Nuevo movimiento manual</h2>
        <div class="row">
            <div class="col-md-4">
                <Campo Etiqueta="Tipo" Id="tipo" Obligatorio="true">
                    <select id="tipo" class="form-select">
                        <option value="INGRESO_MANUAL">Ingreso manual</option>
                        <option value="EGRESO_MANUAL">Egreso manual</option>
                    </select>
                </Campo>
            </div>
            <div class="col-md-4">
                <Campo Etiqueta="Medio de pago" Id="medio" Obligatorio="true">
                    <select id="medio" class="form-select">
                        @foreach (var m in MuestrasCaja.MediosPago)
                        {
                            <option value="@m">@MuestrasCaja.Texto(m)</option>
                        }
                    </select>
                </Campo>
            </div>
            <div class="col-md-4">
                <Campo Etiqueta="Monto (S/)" Id="monto" Obligatorio="true" Ayuda="Mayor a 0.">
                    <input id="monto" type="number" min="0.01" step="0.01" class="form-control" />
                </Campo>
            </div>
            <div class="col-12">
                <Campo Etiqueta="Concepto" Id="concepto" Obligatorio="true" Ayuda="Motivo del ingreso o egreso.">
                    <input id="concepto" class="form-control" maxlength="150" />
                </Campo>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
            <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="() => mostrarFormulario = false">Cancelar</button>
                @* Lab 9: no se registra nada, solo se cierra el formulario. *@
                <button class="btn btn-primary" @onclick="() => mostrarFormulario = false">Guardar</button>
            </div>
        </div>
    </div>
}

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <Campo Etiqueta="Tipo" Id="fTipo" Clase="col-sm-6 col-md-3">
            <select id="fTipo" class="form-select">
                <option>Todos</option>
                <option>Cobro al contado</option>
                <option>Cobro de crédito</option>
                <option>Ingreso manual</option>
                <option>Egreso manual</option>
            </select>
        </Campo>
        <Campo Etiqueta="Medio de pago" Id="fMedio" Clase="col-sm-6 col-md-3">
            <select id="fMedio" class="form-select">
                <option>Todos</option>
                @foreach (var m in MuestrasCaja.MediosPago)
                {
                    <option>@MuestrasCaja.Texto(m)</option>
                }
            </select>
        </Campo>
        <div class="col-auto">
            <button class="btn btn-dark">Buscar</button>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Medio de pago</th>
                    <th>Concepto</th>
                    <th class="text-end">Monto</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in MuestrasCaja.Movimientos)
                {
                    <tr>
                        <td class="text-nowrap">@m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@MuestrasCaja.Texto(m.Tipo)</td>
                        <td>@MuestrasCaja.Texto(m.MedioPago)</td>
                        <td>
                            @m.Concepto
                            @if (!string.IsNullOrEmpty(m.DocumentoOrigen))
                            {
                                <div class="small text-muted">Origen: @m.DocumentoOrigen</div>
                            }
                        </td>
                        <td class="text-end text-nowrap @(m.EsEgreso ? "text-danger" : "")">
                            @(m.EsEgreso ? "− " : "")S/ @m.Monto.ToString("N2")
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 text-nowrap">
                                @if (m.EsManual)
                                {
                                    @* Solo se elimina un movimiento manual de una caja abierta; los cobros se anulan desde su origen. *@
                                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private bool mostrarFormulario;   // solo muestra u oculta el formulario
    private readonly CajaFila caja = MuestrasCaja.CajaActual;
}

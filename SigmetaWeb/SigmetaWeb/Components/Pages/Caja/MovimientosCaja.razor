@page "/caja/movimientos"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Cajero")]
@inject ApiJava Api

<PageTitle>Movimientos de caja · SIGMETA</PageTitle>

@* RF010 · Movimientos de la caja abierta del Cajero. Datos reales del Java:
   - GET    /api/cajas/abierta                       la caja abierta del usuario de la sesión
   - GET    /api/cajas/{id}/movimientos              movimientos de la caja
   - POST   /api/cajas/{id}/movimientos              ingreso o egreso manual (MovimientoCajaBO.registrarMovimiento)
   - PUT    /api/cajas/{id}/movimientos/{idMov}      corregir el concepto de un ingreso o egreso manual (MovimientoCajaBO.modificar)
   - POST   /api/cajas/{id}/movimientos/{idMov}/anular  anular un ingreso o egreso manual (MovimientoCajaBO.anular)
   RNF002: ningún movimiento se borra. Anular registra el movimiento contrario en la misma caja; el monto, el tipo y
   el medio de pago no se cambian (para corregirlos se anula y se registra otro).
   Los cobros no se anulan aquí: el de crédito se anula desde el cobro (RF009) y el de contado anulando la venta.
   Las devoluciones (venta anulada, nota de crédito, cobro anulado) las registra el sistema. *@
<Encabezado Rf="RF010" Titulo="Movimientos de caja"
            Subtitulo="@(caja is null ? "" : $"Caja N.º {caja.Id} · abierta el {TextosCaja.FechaHora(caja.FechaApertura)} por {caja.UsuarioApertura}")">
    <a class="btn btn-outline-secondary" href="/caja">Volver a la caja</a>
    @if (caja is not null && formulario is null)
    {
        <button class="btn btn-primary" @onclick="Nuevo">Ingreso o egreso manual</button>
    }
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<AvisoExito Mensaje="@exito" AlCerrar="() => exito = null" />

<Confirmacion Visible="@(porAnular is not null)" Titulo="Anular movimiento" TextoConfirmar="Anular"
              AlConfirmar="ConfirmarAnular" AlCancelar="() => porAnular = null">
    ¿Anular <strong>@porAnular?.Concepto</strong> (S/ @porAnular?.Monto.ToString("N2"))?
    <div class="small text-muted mt-2">
        El movimiento no se borra: se registra el @(porAnular?.EsEgreso == true ? "ingreso" : "egreso") contrario en esta caja.
    </div>
</Confirmacion>

@if (cargando)
{
    <p class="text-muted">Cargando movimientos...</p>
}
else if (caja is null)
{
    <div class="alert alert-secondary">
        No tienes una caja abierta. <a href="/caja">Abre tu caja</a> para registrar movimientos.
    </div>
}
else
{
    @if (formulario is not null)
    {
        <div class="card card-body mb-3">
            <h2 class="h6 fw-semibold mb-3">@(formulario.Id == 0 ? "Nuevo movimiento manual" : "Corregir el concepto")</h2>
            @if (formulario.Id != 0)
            {
                <p class="small text-muted">El tipo, el medio de pago y el monto no se cambian. Si están mal, anule el movimiento y registre otro.</p>
            }
            <div class="row">
                <div class="col-md-4">
                    <Campo Etiqueta="Tipo" Id="tipo" Obligatorio="true">
                        <select id="tipo" class="form-select" disabled="@(formulario.Id != 0)" @bind="formulario.Tipo">
                            <option value="INGRESO_MANUAL">Ingreso manual</option>
                            <option value="EGRESO_MANUAL">Egreso manual</option>
                        </select>
                    </Campo>
                </div>
                <div class="col-md-4">
                    <Campo Etiqueta="Medio de pago" Id="medio" Obligatorio="true">
                        <select id="medio" class="form-select" disabled="@(formulario.Id != 0)" @bind="formulario.MedioPago">
                            @foreach (var m in TextosCaja.MediosPago)
                            {
                                <option value="@m">@TextosCaja.Texto(m)</option>
                            }
                        </select>
                    </Campo>
                </div>
                <div class="col-md-4">
                    @* Estándar RNF004: cada error sale en rojo debajo de su cuadro; los del BO, en el aviso de arriba *@
                    <Campo Etiqueta="Monto (S/)" Id="monto" Obligatorio="true" Ayuda="Mayor a 0." Error="@(v.Error("monto", Errores()))">
                        <input id="monto" type="number" step="0.01" class="@(v.Clase("monto", Errores()))" onkeydown="@ValidacionEnVivo.SoloPositivos"
                               disabled="@(formulario.Id != 0)"
                               @bind="formulario.Monto" @bind:event="oninput" @bind:after="@(() => v.Tocado("monto"))" />
                    </Campo>
                </div>
                <div class="col-12">
                    <Campo Etiqueta="Concepto" Id="concepto" Obligatorio="true" Ayuda="Motivo del ingreso o egreso." Error="@(v.Error("concepto", Errores()))">
                        <input id="concepto" class="@(v.Clase("concepto", Errores()))" maxlength="150"
                               @bind="formulario.Concepto" @bind:event="oninput" @bind:after="@(() => v.Tocado("concepto"))" />
                    </Campo>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
                <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="() => formulario = null">Cancelar</button>
                    <button class="btn btn-primary" disabled="@guardando" @onclick="Guardar">Guardar</button>
                </div>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Medio de pago</th>
                        <th>Concepto</th>
                        <th>Registrado por</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (movimientos.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Todavía no hay movimientos en esta caja.</td></tr>
                    }
                    @foreach (var m in Paginar(movimientos, paginaActual, tamanoPagina))
                    {
                        <tr>
                            <td class="text-nowrap">@TextosCaja.FechaHora(m.FechaMovimiento)</td>
                            <td>@TextosCaja.Texto(m.Tipo)</td>
                            <td>@TextosCaja.Texto(m.MedioPago)</td>
                            <td>
                                @m.Concepto
                                @if (m.DocumentoOrigen is not null)
                                {
                                    <div class="small text-muted">Origen: @TextosCaja.Texto(m.DocumentoOrigen)</div>
                                }
                                @if (m.EsDevolucion)
                                {
                                    <div><span class="badge rounded-pill border bg-secondary-subtle text-secondary-emphasis border-secondary-subtle">no cuenta como cobro</span></div>
                                }
                                @if (m.Anulado)
                                {
                                    <div><Estado Texto="Anulado" /></div>
                                }
                            </td>
                            <td>@m.UsuarioRegistro</td>
                            <td class="text-end text-nowrap @(m.EsEgreso ? "text-danger" : "")">
                                @(m.EsEgreso ? "− " : "")S/ @m.Monto.ToString("N2")
                            </td>
                            <td class="text-end">
                                @if (m.Manual && !m.Anulado)
                                {
                                    <AccionesFila Principal="@(new AccionFila("Corregir concepto", Hacer: () => { Editar(m); return Task.CompletedTask; }, Destacada: false))"
                                                  Otras="@(new List<AccionFila> { new("Anular", Hacer: () => { PedirAnular(m); return Task.CompletedTask; }, Peligro: true) })" AlElegir="Ejecutar" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@((movimientos)?.Count ?? 0)" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}


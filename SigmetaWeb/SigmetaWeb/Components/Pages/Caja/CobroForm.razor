@page "/cobranzas/{Id:int}/cobro"
@page "/cobranzas/{Id:int}/cobros/{IdCobro:int}"
@inject NavigationManager Nav

<PageTitle>@(Editando ? "Modificar cobro" : "Registrar cobro") · SIGMETA</PageTitle>

@* RF009 · Registro (Cajero, con su caja abierta) o modificación (Cajero o Administrador) de un cobro
   sobre una cuenta por cobrar. Al modificar, el monto y el medio de pago no cambian porque ya impactaron
   la cuenta y la caja: solo se corrigen la fecha y la referencia (CobroBOImpl.modificar).
   Solo visual (Lab 9): Guardar no registra, solo vuelve al detalle de la cuenta. *@
<Encabezado Rf="RF009" Titulo="@(Editando ? "Modificar cobro" : "Registrar cobro")"
            Subtitulo="@(Editando ? "Se corrigen la fecha y la referencia del cobro." : "El cobro entra a la caja abierta del cajero.")">
    <a class="btn btn-outline-secondary" href="@($"/cobranzas/{Id}")">Volver a la cuenta</a>
</Encabezado>

<div class="card card-body mb-3" style="max-width: 760px;">
    <div class="row">
        <div class="col-sm-7 mb-3">
            <div class="small text-muted text-uppercase">Cliente</div>
            <div class="fw-semibold">@cuenta.Cliente</div>
        </div>
        <div class="col-sm-5 mb-3">
            <div class="small text-muted text-uppercase">Venta</div>
            <div class="fw-semibold">@cuenta.Venta</div>
        </div>
        <div class="col-sm-7 mb-3">
            <div class="small text-muted text-uppercase">Vencimiento</div>
            <div class="fw-semibold">@cuenta.FechaVencimiento.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="col-sm-5 mb-3">
            <div class="small text-muted text-uppercase">Saldo pendiente</div>
            <div class="fw-semibold">S/ @cuenta.SaldoPendiente.ToString("N2")</div>
        </div>
        @if (cobro is not null)
        {
            <div class="col-sm-7 mb-3">
                <div class="small text-muted text-uppercase">Registrado por</div>
                <div class="fw-semibold">@cobro.UsuarioRegistro · @cobro.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        }
    </div>

    <hr />

    @if (cobro is { Anulado: true })
    {
        <div class="alert alert-warning mb-0">No se puede modificar un cobro anulado.</div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <Campo Etiqueta="Monto (S/)" Id="monto" Obligatorio="true"
                       Ayuda="@(Editando ? "No se modifica: para cambiarlo anule el cobro y registre uno nuevo." : "Mayor a 0 y no mayor al saldo pendiente.")">
                    <input id="monto" type="number" min="0.01" step="0.01" class="form-control"
                           value="@cobro?.Monto.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" readonly="@Editando" />
                </Campo>
            </div>
            <div class="col-md-6">
                <Campo Etiqueta="Medio de pago" Id="medio" Obligatorio="true"
                       Ayuda="@(Editando ? "No se modifica: para cambiarlo anule el cobro y registre uno nuevo." : null)">
                    <select id="medio" class="form-select" disabled="@Editando">
                        @foreach (var m in MuestrasCaja.MediosPago)
                        {
                            <option value="@m" selected="@(cobro?.MedioPago == m)">@MuestrasCaja.Texto(m)</option>
                        }
                    </select>
                </Campo>
            </div>
            <div class="col-md-6">
                <Campo Etiqueta="Fecha del cobro" Id="fecha" Obligatorio="true" Ayuda="No puede ser futura.">
                    <input id="fecha" type="date" class="form-control" value="@cobro?.FechaCobro.ToString("yyyy-MM-dd")" />
                </Campo>
            </div>
            <div class="col-md-6">
                <Campo Etiqueta="Referencia" Id="referencia" Ayuda="N.º de operación, depósito o cheque.">
                    <input id="referencia" class="form-control" maxlength="50" value="@cobro?.Referencia" />
                </Campo>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
            <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="@($"/cobranzas/{Id}")">Cancelar</a>
                <button class="btn btn-primary" @onclick="Volver">@(Editando ? "Guardar cambios" : "Guardar")</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int? IdCobro { get; set; }

    private bool Editando => IdCobro is not null;

    // Cuenta y cobro de ejemplo (Lab 9: sin consultas, se buscan en los datos fijos).
    private CuentaFila cuenta = MuestrasCaja.Cuentas[0];
    private CobroFila? cobro;

    protected override void OnParametersSet()
    {
        cuenta = MuestrasCaja.Cuenta(Id);
        cobro = IdCobro is int idCobro ? MuestrasCaja.Cobro(idCobro) : null;
    }

    // Lab 9: no se registra nada, solo se navega.
    private void Volver() => Nav.NavigateTo($"/cobranzas/{Id}");
}

@page "/cobranzas/{Id:int}/cobro"
@page "/cobranzas/{Id:int}/cobros/{IdCobro:int}"
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>@(Editando ? "Modificar cobro" : "Registrar cobro") · SIGMETA</PageTitle>

@* RF009 · Registro (Cajero, con su caja abierta) o modificación (Cajero o Administrador) de un cobro. Datos reales del Java:
   - GET  /api/cuentas-por-cobrar/{id}   datos y saldo de la cuenta
   - GET  /api/cobros/{idCobro}          el cobro a modificar
   - POST /api/cobros                    registrar (CobroBO.registrarCobro): baja el saldo y registra el ingreso en la caja
   - PUT  /api/cobros/{idCobro}          modificar fecha y referencia (CobroBO.modificar)
   Las reglas (cuenta ya pagada, cobro mayor al saldo, caja no abierta, fecha futura) y sus mensajes son del BO. *@
<Encabezado Rf="RF009" Titulo="@(Editando ? "Modificar cobro" : "Registrar cobro")"
            Subtitulo="@(Editando ? "Se corrigen la fecha y la referencia del cobro." : "El cobro entra a la caja abierta del cajero.")">
    <a class="btn btn-outline-secondary" href="@($"/cobranzas/{Id}")">Volver a la cuenta</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

@if (cuenta is null)
{
    @if (error is null)
    {
        <p class="text-muted">Cargando la cuenta...</p>
    }
}
else
{
    <div class="card card-body mb-3" style="max-width: 760px;">
        <div class="row">
            <div class="col-sm-7 mb-3">
                <div class="small text-muted text-uppercase">Cliente</div>
                <div class="fw-semibold">@cuenta.Cliente</div>
            </div>
            <div class="col-sm-5 mb-3">
                <div class="small text-muted text-uppercase">Venta</div>
                <div class="fw-semibold">@cuenta.Venta <span class="small text-muted">@cuenta.Comprobante</span></div>
            </div>
            <div class="col-sm-7 mb-3">
                <div class="small text-muted text-uppercase">Vencimiento</div>
                <div class="fw-semibold">@TextosCaja.Fecha(cuenta.FechaVencimiento)</div>
            </div>
            <div class="col-sm-5 mb-3">
                <div class="small text-muted text-uppercase">Saldo pendiente</div>
                <div class="fw-semibold">S/ @cuenta.SaldoPendiente.ToString("N2")</div>
            </div>
            @if (Editando)
            {
                <div class="col-sm-7 mb-3">
                    <div class="small text-muted text-uppercase">Registrado por</div>
                    <div class="fw-semibold">@cobro.UsuarioRegistro · @TextosCaja.FechaHora(cobro.FechaRegistro)</div>
                </div>
            }
        </div>

        <hr />

        @if (cobro.Anulado)
        {
            <div class="alert alert-warning mb-0">No se puede modificar un cobro anulado.</div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    @* Estándar RNF004: cada error sale en rojo debajo de su cuadro; los del BO (caja no abierta...), arriba *@
                    <Campo Etiqueta="Monto (S/)" Id="monto" Obligatorio="true" Error="@(v.Error("monto", Errores()))"
                           Ayuda="@(Editando ? "No se modifica: para cambiarlo anule el cobro y registre uno nuevo." : "Mayor a 0 y no mayor al saldo pendiente.")">
                        <input id="monto" type="number" step="0.01" class="@(v.Clase("monto", Errores()))" onkeydown="@ValidacionEnVivo.SoloPositivos"
                               @bind="cobro.Monto" @bind:event="oninput" @bind:after="@(() => v.Tocado("monto"))" readonly="@Editando" />
                    </Campo>
                </div>
                <div class="col-md-6">
                    <Campo Etiqueta="Medio de pago" Id="medio" Obligatorio="true"
                           Ayuda="@(Editando ? "No se modifica: para cambiarlo anule el cobro y registre uno nuevo." : null)">
                        <select id="medio" class="form-select" @bind="cobro.MedioPago" disabled="@Editando">
                            @foreach (var m in TextosCaja.MediosPago)
                            {
                                <option value="@m">@TextosCaja.Texto(m)</option>
                            }
                        </select>
                    </Campo>
                </div>
                <div class="col-md-6">
                    <Campo Etiqueta="Fecha del cobro" Id="fecha" Obligatorio="true" Ayuda="No puede ser futura." Error="@(v.Error("fecha", Errores()))">
                        <input id="fecha" type="date" class="@(v.Clase("fecha", Errores()))"
                               @bind="cobro.FechaCobro" @bind:after="@(() => v.Tocado("fecha"))" />
                    </Campo>
                </div>
                <div class="col-md-6">
                    <Campo Etiqueta="Referencia" Id="referencia" Ayuda="N.º de operación, depósito o cheque.">
                        <input id="referencia" class="form-control" maxlength="50" @bind="cobro.Referencia" />
                    </Campo>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-2">
                <span class="small text-muted"><span class="text-danger">*</span> Campo obligatorio</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="@($"/cobranzas/{Id}")">Cancelar</a>
                    <button class="btn btn-primary" disabled="@guardando" @onclick="Guardar">@(Editando ? "Guardar cambios" : "Guardar")</button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int? IdCobro { get; set; }

    private bool Editando => IdCobro is not null;

    private CuentaDatos? cuenta;
    private CobroDatos cobro = new();
    private bool guardando;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        error = null;
        try
        {
            cuenta = await Api.Get<CuentaDatos>($"cuentas-por-cobrar/{Id}");
            if (IdCobro is int idCobro)
            {
                cobro = await Api.Get<CobroDatos>($"cobros/{idCobro}") ?? new();
            }
            else
            {
                // por defecto se propone cobrar todo el saldo, con fecha de hoy
                cobro = new CobroDatos
                {
                    IdCuentaPorCobrar = Id,
                    Monto = cuenta?.SaldoPendiente ?? 0,
                    FechaCobro = DateOnly.FromDateTime(DateTime.Today)
                };
            }
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    // ---------------- Validación en pantalla (RNF004) ----------------
    // Mismas reglas que CobroBOImpl: monto mayor a 0 y no mayor al saldo, fecha obligatoria y no futura.
    private readonly ValidacionEnVivo v = new();

    private Dictionary<string, string> Errores()
    {
        var e = new Dictionary<string, string>();
        if (!Editando)
        {
            if (cobro.Monto <= 0)
            {
                e["monto"] = "El monto debe ser mayor a 0.";
            }
            else if (ValidacionEnVivo.MasDecimales(cobro.Monto, 2))
            {
                e["monto"] = "Máximo 2 decimales.";
            }
            else if (cuenta is not null && cobro.Monto > cuenta.SaldoPendiente)
            {
                e["monto"] = $"No puede pasar del saldo pendiente (S/ {cuenta.SaldoPendiente:N2}).";
            }
        }
        if (cobro.FechaCobro is null)
        {
            e["fecha"] = "La fecha del cobro es obligatoria.";
        }
        else if (cobro.FechaCobro > DateOnly.FromDateTime(DateTime.Today))
        {
            e["fecha"] = "La fecha del cobro no puede ser futura.";
        }
        return e;
    }

    private async Task Guardar()
    {
        error = null;
        if (!v.Intentar(Errores()))
        {
            error = "Revise los campos marcados en rojo.";
            return;
        }
        guardando = true;
        try
        {
            if (Editando)
            {
                await Api.Put<CobroDatos>($"cobros/{IdCobro}", new { cobro.FechaCobro, cobro.Referencia });
            }
            else
            {
                await Api.Post<CobroDatos>("cobros", new
                {
                    IdCuentaPorCobrar = Id, cobro.Monto, cobro.MedioPago, cobro.FechaCobro, cobro.Referencia
                });
            }
            Nav.NavigateTo($"/cobranzas/{Id}");
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        guardando = false;
    }
}

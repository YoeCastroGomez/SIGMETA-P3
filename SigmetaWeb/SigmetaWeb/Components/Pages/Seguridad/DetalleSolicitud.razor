@page "/autorizaciones/detalle/{Id:int}"
@inject ApiJava Api

<PageTitle>Detalle de solicitud · SIGMETA</PageTitle>

@* RF014 · GET /api/solicitudes/{id}. Solo lectura. La ve su solicitante o el Administrador.
   Si la operación quedó a medias, su solicitante vuelve a ella desde aquí (Continuar / Completar / Corregir). *@
<Encabezado Rf="RF014" Titulo="Detalle de la solicitud">
    @if (solicitud is not null && Rol != "Administrador" && TextosSeguridad.RutaRetomar(solicitud) is string ruta)
    {
        <a class="btn btn-primary" href="@ruta">@TextosSeguridad.TextoRetomar(solicitud)</a>
    }
    <a class="btn btn-outline-secondary" href="@Volver">Volver</a>
</Encabezado>

<AvisoError Mensaje="@error" />

@if (solicitud is not null)
{
    <div class="card card-body mb-3" style="max-width: 760px;">
        <DatosSolicitud Solicitud="solicitud" />
        <div class="alert @(solicitud.Estado is "APROBADA" ? "alert-success" : solicitud.Estado is "PENDIENTE" ? "alert-warning" : "alert-secondary") small mb-0">
            @TextosSeguridad.QuePasa(solicitud)
        </div>
    </div>
}
else if (error is null)
{
    <p class="text-muted">Cargando solicitud...</p>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    private SolicitudDatos? solicitud;
    private string? error;
    private string Volver => Rol == "Administrador" ? "/autorizaciones" : "/autorizaciones/mias";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            solicitud = await Api.Get<SolicitudDatos>($"solicitudes/{Id}");
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

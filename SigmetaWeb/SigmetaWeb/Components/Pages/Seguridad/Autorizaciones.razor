@page "/autorizaciones"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Administrador")]
@inject ApiJava Api

<PageTitle>Solicitudes de autorización · SIGMETA</PageTitle>

@* RF014 · Solicitudes de todos los usuarios, vista del Administrador.
   PATRÓN UX (ver Shared/ComponentesFlujo.cs): chips por estado con su cantidad; si hay pendientes la pantalla
   abre en "Pendientes" y siempre van primero, porque son lo único que el Administrador tiene que hacer aquí.
   Estados: Pendiente → Aprobada o Rechazada → Usada (se completó la operación) o Vencida (pasó su vigencia o
   se revocó). Cancelada = la retiró su propio solicitante.
   GET /api/solicitudes (?estado=PENDIENTE) · POST /api/solicitudes/{id}/anular para revocar una aprobada. *@
<Encabezado Rf="RF014" Titulo="Solicitudes de autorización">
    <button class="btn btn-outline-secondary" @onclick="Cargar" disabled="@cargando">@(cargando ? "Actualizando..." : "Actualizar")</button>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<SiguientePaso Mensaje="@exito" Detalle="@exitoDetalle" AlCerrar="() => exito = null" />

<Confirmacion Visible="@(porRevocar is not null)" Titulo="Revocar autorización" TextoConfirmar="Revocar"
              AlConfirmar="ConfirmarRevocar" AlCancelar="() => porRevocar = null">
    <p class="mb-2">¿Seguro que desea revocar la autorización de <strong>@porRevocar?.Solicitante</strong>
        para <strong>@TextosSeguridad.Texto(porRevocar?.Operacion)</strong>?</p>
    <p class="small text-muted mb-0">Quedará vencida y el usuario ya no podrá usarla.</p>
</Confirmacion>

@* Indicadores: lo que hay que resolver primero y cómo terminan las autorizaciones *@
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <button type="button" class="card card-body h-100 w-100 text-start indicador" @onclick="@(() => CambiarEstado("PENDIENTE"))">
            <div class="small text-muted">Pendientes de resolver</div>
            <div class="h4 fw-bold mb-0 @(Pendientes > 0 ? "text-warning-emphasis" : "")">@Pendientes</div>
        </button>
    </div>
    <div class="col-sm-6 col-lg-3">
        <button type="button" class="card card-body h-100 w-100 text-start indicador" @onclick="@(() => CambiarEstado("APROBADA"))">
            <div class="small text-muted">Aprobadas sin usar</div>
            <div class="h4 fw-bold mb-0">@Vigentes</div>
        </button>
    </div>
    <div class="col-sm-6 col-lg-3">
        <button type="button" class="card card-body h-100 w-100 text-start indicador" @onclick="@(() => CambiarEstado("USADA"))">
            <div class="small text-muted">Usadas</div>
            <div class="h4 fw-bold mb-0">@CuantasEn("USADA")</div>
        </button>
    </div>
    <div class="col-sm-6 col-lg-3">
        <button type="button" class="card card-body h-100 w-100 text-start indicador" @onclick="@(() => CambiarEstado(""))">
            <div class="small text-muted">Total registradas</div>
            <div class="h4 fw-bold mb-0">@(solicitudes?.Count ?? 0)</div>
        </button>
    </div>
</div>

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end sigmeta-filtros">
        <Campo Etiqueta="Buscar" Id="fTexto" Clase="col-12">
            <input id="fTexto" type="search" class="form-control" maxlength="60" placeholder="Usuario, operación, comprobante, cliente o motivo"
                   @bind="filtroTexto" @bind:event="oninput" @bind:after="AlFiltrar" />
        </Campo>
    </div>
    <div class="mt-3">
        <ChipsFiltro Opciones="@Chips" Seleccionado="@filtroEstado" SeleccionadoChanged="CambiarEstado" />
    </div>
</div>

@if (solicitudes is null)
{
    <p class="text-muted">Cargando solicitudes...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table table-hover align-middle mb-0 tabla-lista tabla-solicitudes">
                <thead>
                    <tr>
                        <th>Operación</th>
                        <th>Solicitante</th>
                        <th>Qué se autoriza</th>
                        <th>Pedida</th>
                        <th>Estado</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <ListaVacia Titulo="@(filtroEstado == "PENDIENTE" ? "No hay solicitudes pendientes." : "No hay solicitudes con ese filtro.")" />
                            </td>
                        </tr>
                    }
                    @foreach (var s in Pagina)
                    {
                        <tr @key="s.Id" class="@(s.Estado == "PENDIENTE" ? "por-resolver" : null)">
                            <td class="col-operacion">
                                <span class="fw-semibold">@TextosSeguridad.Texto(s.Operacion)</span>
                                @if (!string.IsNullOrEmpty(s.Referencia))
                                {
                                    <div class="sub">@s.Referencia</div>
                                }
                            </td>
                            <td class="text-nowrap">
                                @(s.NombreSolicitante ?? s.Solicitante)
                                <div class="sub">@s.Solicitante · @TextosSeguridad.Texto(s.RolSolicitante)</div>
                            </td>
                            <td class="col-autoriza">
                                @if (Resumen(s) is { Length: > 0 } dato)
                                {
                                    <div class="dato">@dato</div>
                                }
                                <div class="sub motivo" title="@s.Motivo">@s.Motivo</div>
                            </td>
                            <td class="text-nowrap">
                                @Formato.FechaHora(s.FechaSolicitud)
                                <div class="sub @(s.Estado == "PENDIENTE" ? "espera" : null)">@TextosSeguridad.Hace(s.FechaSolicitud)</div>
                            </td>
                            <td class="text-nowrap">
                                <Estado Texto="@TextosSeguridad.TextoEstado(s)" />
                                @if (s.Vigente)
                                {
                                    <div class="sub">Hasta @Formato.FechaHora(s.FechaVencimiento)</div>
                                }
                                else if (s.Estado is "RECHAZADA" or "USADA" or "VENCIDA" && !string.IsNullOrEmpty(s.Administrador))
                                {
                                    <div class="sub">@s.Administrador</div>
                                }
                            </td>
                            <td class="acciones">
                                @if (s.Estado == "PENDIENTE")
                                {
                                    <AccionesFila Principal="@(new AccionFila("Resolver", Ruta: $"/autorizaciones/aprobar/{s.Id}"))" AlElegir="Ejecutar" />
                                }
                                else
                                {
                                    <AccionesFila Principal="@(new AccionFila("Ver", Ruta: $"/autorizaciones/detalle/{s.Id}", Destacada: false))"
                                                  Otras="@(s.Vigente ? new List<AccionFila> { new("Revocar", Hacer: () => { error = exito = null; porRevocar = s; return Task.CompletedTask; }, Peligro: true) } : new List<AccionFila>())"
                                                  AlElegir="Ejecutar" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@Filtradas.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    // UI/UX: una acción visible por fila y el resto en «⋯» (mismo patrón en todas las listas)
    private Task Ejecutar(AccionFila a) => a.Hacer?.Invoke() ?? Task.CompletedTask;

    private List<SolicitudDatos>? solicitudes;
    private string filtroEstado = "";
    private string filtroTexto = "";
    private string? error;
    private string? exito;
    private string? exitoDetalle;
    private bool cargando;
    private SolicitudDatos? porRevocar;
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private int Pendientes => solicitudes?.Count(s => s.Estado == "PENDIENTE") ?? 0;
    private int Vigentes => solicitudes?.Count(s => s.Vigente) ?? 0;

    private List<SolicitudDatos> PorTexto => (solicitudes ?? new())
        .Where(s => Busqueda.Coincide(filtroTexto, s.Solicitante, s.NombreSolicitante, TextosSeguridad.Texto(s.Operacion),
            s.Referencia, s.Motivo, s.Detalle))
        .ToList();

    private int CuantasEn(string clave) => solicitudes?.Count(s => TextosSeguridad.ClaveEstado(s) == clave) ?? 0;

    // el dato que más pesa de lo que se autoriza (la diferencia de un ajuste, el total de una nota o venta);
    // el producto o el comprobante ya van debajo de la operación
    private static string Resumen(SolicitudDatos s)
    {
        var datos = TextosSeguridad.LeerDetalle(s.Detalle).Where(d => d.Clave is not null && d.Valor is not null).ToList();
        var dato = datos.FirstOrDefault(d => d.Clave!.StartsWith("Diferencia"))
                   ?? datos.FirstOrDefault(d => d.Clave!.StartsWith("Total"))
                   ?? datos.FirstOrDefault(d => d.Clave!.StartsWith("Cliente"));
        return dato is null ? "" : $"{dato.Clave}: {dato.Valor}";
    }

    // las pendientes primero (son lo que hay que resolver), luego las más recientes
    private List<SolicitudDatos> Filtradas => PorTexto
        .Where(s => filtroEstado == "" || TextosSeguridad.ClaveEstado(s) == filtroEstado)
        .OrderByDescending(s => s.Estado == "PENDIENTE").ThenByDescending(s => s.FechaSolicitud)
        .ToList();

    private IReadOnlyList<OpcionChip> Chips
    {
        get
        {
            var base_ = PorTexto;
            int Cuantas(string e) => base_.Count(s => TextosSeguridad.ClaveEstado(s) == e);
            return new List<OpcionChip>
            {
                new("", "Todas", base_.Count),
                new("PENDIENTE", "Pendientes", Cuantas("PENDIENTE"), "ambar"),
                new("APROBADA", "Aprobadas", Cuantas("APROBADA"), "verde"),
                new("RECHAZADA", "Rechazadas", Cuantas("RECHAZADA"), "rojo"),
                new("USADA", "Usadas", Cuantas("USADA")),
                new("VENCIDA", "Vencidas", Cuantas("VENCIDA"), "rojo"),
                new("CANCELADA", "Canceladas", Cuantas("CANCELADA"))
            };
        }
    }

    private void CambiarEstado(string estado)
    {
        filtroEstado = estado;
        paginaActual = 1;
    }

    private IEnumerable<SolicitudDatos> Pagina => tamanoPagina == 0 ? Filtradas
        : Filtradas.Skip((Math.Max(paginaActual, 1) - 1) * tamanoPagina).Take(tamanoPagina);

    private void AlFiltrar() => paginaActual = 1;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        exito = Guardado switch
        {
            "aprobada" => $"Se aprobó la solicitud de {Referencia}.",
            "rechazada" => $"Se rechazó la solicitud de {Referencia}.",
            _ => null
        };
        // si hay algo por resolver, se abre directo en las pendientes
        if (Pendientes > 0)
        {
            filtroEstado = "PENDIENTE";
        }
    }

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            solicitudes = await Api.Get<List<SolicitudDatos>>("solicitudes") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            solicitudes ??= new();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ConfirmarRevocar()
    {
        var s = porRevocar;
        porRevocar = null;
        if (s is null) return;
        try
        {
            await Api.Post<object>($"solicitudes/{s.Id}/anular", null);
            await Cargar();
            exito = $"Se revocó la autorización de {s.Solicitante} para {TextosSeguridad.Texto(s.Operacion).ToLower()}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

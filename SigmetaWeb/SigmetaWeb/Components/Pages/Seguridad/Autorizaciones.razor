@page "/autorizaciones"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Administrador")]
@inject ApiJava Api

<PageTitle>Solicitudes de autorización · SIGMETA</PageTitle>

@* RF014 · Solicitudes de todos los usuarios, vista del Administrador.
   PATRÓN UX (ver Shared/ComponentesFlujo.cs): chips por estado con su cantidad; si hay pendientes la pantalla
   abre en "Pendientes" y siempre van primero, porque son lo único que el Administrador tiene que hacer aquí.
   GET /api/solicitudes (?estado=PENDIENTE) · POST /api/solicitudes/{id}/anular para revocar una aprobada. *@
<Encabezado Rf="RF014" Titulo="Solicitudes de autorización"
            Subtitulo="Cada autorización sirve para la operación que se pidió y una sola vez." />

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
<SiguientePaso Mensaje="@exito" Detalle="@exitoDetalle" AlCerrar="() => exito = null" />

<Confirmacion Visible="@(porRevocar is not null)" Titulo="Revocar autorización" TextoConfirmar="Revocar"
              AlConfirmar="ConfirmarRevocar" AlCancelar="() => porRevocar = null">
    <p class="mb-2">¿Seguro que desea revocar la autorización de <strong>@porRevocar?.Solicitante</strong>
        para <strong>@TextosSeguridad.Texto(porRevocar?.Operacion)</strong>?</p>
    <p class="small text-muted mb-0">Quedará vencida y el usuario ya no podrá usarla.</p>
</Confirmacion>

<div class="row g-3 mb-3">
    <div class="col-sm-4">
        <div class="card card-body h-100">
            <div class="small text-muted text-uppercase">Pendientes de resolver</div>
            <div class="h4 fw-bold mb-0 @(Pendientes > 0 ? "text-warning-emphasis" : "")">@Pendientes</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-body h-100">
            <div class="small text-muted text-uppercase">Aprobadas vigentes</div>
            <div class="h4 fw-bold mb-0">@Vigentes</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-body h-100">
            <div class="small text-muted text-uppercase">Total registradas</div>
            <div class="h4 fw-bold mb-0">@(solicitudes?.Count ?? 0)</div>
        </div>
    </div>
</div>

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end sigmeta-filtros">
        <Campo Etiqueta="Buscar" Id="fTexto" Clase="col-sm-8 col-md">
            <input id="fTexto" type="search" class="form-control" maxlength="60" placeholder="Usuario, operación o comprobante"
                   @bind="filtroTexto" @bind:event="oninput" @bind:after="AlFiltrar" />
        </Campo>
        <div class="col-auto">
            <button class="btn btn-outline-secondary" @onclick="Cargar" disabled="@cargando">@(cargando ? "Actualizando..." : "Actualizar")</button>
        </div>
    </div>
    <div class="mt-3">
        <ChipsFiltro Opciones="@Chips" Seleccionado="@filtroEstado" SeleccionadoChanged="CambiarEstado" />
    </div>
</div>

@if (solicitudes is null)
{
    <p class="text-muted">Cargando solicitudes...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Solicitante</th>
                        <th>Operación</th>
                        <th>Qué se autoriza</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <ListaVacia Titulo="@(filtroEstado == "PENDIENTE" ? "No hay solicitudes pendientes: nada por resolver." : "No hay solicitudes con ese filtro.")" />
                            </td>
                        </tr>
                    }
                    @foreach (var s in Pagina)
                    {
                        <tr>
                            <td><strong>@s.Solicitante</strong><div class="small text-muted">@TextosSeguridad.Texto(s.RolSolicitante)</div></td>
                            <td>@TextosSeguridad.Texto(s.Operacion)</td>
                            <td style="max-width: 320px;">
                                @if (!string.IsNullOrEmpty(s.Referencia))
                                {
                                    <strong>@s.Referencia</strong>
                                }
                                <div class="small text-muted">@s.Motivo</div>
                            </td>
                            <td class="text-nowrap">@Formato.FechaHora(s.FechaSolicitud)</td>
                            <td>
                                <Estado Texto="@TextosSeguridad.Texto(s.Estado)" />
                                @if (s.Vigente)
                                {
                                    <div class="small text-muted">hasta @Formato.FechaHora(s.FechaVencimiento)</div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 text-nowrap">
                                    @if (s.Estado == "PENDIENTE")
                                    {
                                        <a class="btn btn-sm btn-primary" href="@($"/autorizaciones/aprobar/{s.Id}")">Resolver</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"/autorizaciones/detalle/{s.Id}")">Ver</a>
                                        @if (s.Vigente)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => { error = exito = null; porRevocar = s; }">Revocar</button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@Filtradas.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    private List<SolicitudDatos>? solicitudes;
    private string filtroEstado = "";
    private string filtroTexto = "";
    private string? error;
    private string? exito;
    private string? exitoDetalle;
    private bool cargando;
    private SolicitudDatos? porRevocar;
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private int Pendientes => solicitudes?.Count(s => s.Estado == "PENDIENTE") ?? 0;
    private int Vigentes => solicitudes?.Count(s => s.Vigente) ?? 0;

    private List<SolicitudDatos> PorTexto => (solicitudes ?? new())
        .Where(s => Busqueda.Coincide(filtroTexto, s.Solicitante, s.NombreSolicitante, TextosSeguridad.Texto(s.Operacion), s.Referencia))
        .ToList();

    // las pendientes primero (son lo que hay que resolver), luego las más recientes
    private List<SolicitudDatos> Filtradas => PorTexto
        .Where(s => filtroEstado == "" || s.Estado == filtroEstado)
        .OrderByDescending(s => s.Estado == "PENDIENTE").ThenByDescending(s => s.FechaSolicitud)
        .ToList();

    private IReadOnlyList<OpcionChip> Chips
    {
        get
        {
            var base_ = PorTexto;
            int Cuantas(string e) => base_.Count(s => s.Estado == e);
            return new List<OpcionChip>
            {
                new("", "Todas", base_.Count),
                new("PENDIENTE", "Pendientes", Cuantas("PENDIENTE"), "ambar"),
                new("APROBADA", "Aprobadas", Cuantas("APROBADA"), "verde"),
                new("RECHAZADA", "Rechazadas", Cuantas("RECHAZADA"), "rojo"),
                new("VENCIDA", "Vencidas o usadas", Cuantas("VENCIDA"))
            };
        }
    }

    private void CambiarEstado(string estado)
    {
        filtroEstado = estado;
        paginaActual = 1;
    }

    private IEnumerable<SolicitudDatos> Pagina => tamanoPagina == 0 ? Filtradas
        : Filtradas.Skip((Math.Max(paginaActual, 1) - 1) * tamanoPagina).Take(tamanoPagina);

    private void AlFiltrar() => paginaActual = 1;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        exito = Guardado switch
        {
            "aprobada" => $"Se aprobó la solicitud de {Referencia}.",
            "rechazada" => $"Se rechazó la solicitud de {Referencia}.",
            _ => null
        };
        exitoDetalle = Guardado == "aprobada" ? "El solicitante ya puede completar esa operación dentro de la vigencia." : null;
        // si hay algo por resolver, se abre directo en las pendientes
        if (Pendientes > 0)
        {
            filtroEstado = "PENDIENTE";
        }
    }

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            solicitudes = await Api.Get<List<SolicitudDatos>>("solicitudes") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            solicitudes ??= new();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ConfirmarRevocar()
    {
        var s = porRevocar;
        porRevocar = null;
        if (s is null) return;
        try
        {
            await Api.Post<object>($"solicitudes/{s.Id}/anular", null);
            await Cargar();
            exito = $"Se revocó la autorización de {s.Solicitante} para {TextosSeguridad.Texto(s.Operacion).ToLower()}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

@page "/autorizaciones"

<PageTitle>Solicitudes de autorización · SIGMETA</PageTitle>

@* RF014 · Solicitudes, vista del Administrador. Solo visual (Lab 9): los filtros y botones no hacen nada. *@
<Encabezado Rf="RF014" Titulo="Solicitudes de autorización"
            Subtitulo="Solicitudes de todos los usuarios. Aprobar o rechazar se hace desde Resolver." />

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end sigmeta-filtros">
        <Campo Etiqueta="Mostrar" Id="fMostrar" Clase="col-sm-6 col-md-3">
            <select id="fMostrar" class="form-select">
                <option>Todas</option>
                <option>Solo pendientes</option>
            </select>
        </Campo>
        <div class="col-auto">
            <button class="btn btn-dark">Buscar</button>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Solicitante</th>
                    <th>Operación</th>
                    <th>Motivo</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Paginar(MuestrasSeguridad.Solicitudes, paginaActual, tamanoPagina))
                {
                    <tr>
                        <td><strong>@s.Solicitante</strong><div class="small text-muted">@MuestrasSeguridad.Texto(s.Rol)</div></td>
                        <td>@s.OperacionRestringida</td>
                        <td>@s.Motivo</td>
                        <td>@s.FechaSolicitud</td>
                        <td><Estado Texto="@MuestrasSeguridad.Texto(s.Estado)" /></td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 text-nowrap">
                                @if (s.Estado == "PENDIENTE")
                                {
                                    <a class="btn btn-sm btn-primary" href="@($"/autorizaciones/aprobar/{s.Id}")">Resolver</a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/autorizaciones/detalle/{s.Id}")">Ver</a>
                                    @if (s.Estado == "APROBADA")
                                    {
                                        <button class="btn btn-sm btn-outline-danger">Revocar</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
        <Paginacion TotalRegistros="@(MuestrasSeguridad.Solicitudes.Count())" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
</div>

@code {
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T> registros, int pagina, int tamano)
    {
        if (tamano == 0) return registros;
        int total = registros.Count();
        int segura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((segura - 1) * tamano).Take(tamano);
    }
}

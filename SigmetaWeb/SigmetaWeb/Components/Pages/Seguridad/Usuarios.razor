@page "/usuarios"
@inject ApiJava Api

<PageTitle>Usuarios · SIGMETA</PageTitle>

@* RF002 · Usuarios del sistema (solo el Administrador). GET /api/usuarios · DELETE /api/usuarios/{id}. *@
<Encabezado Rf="RF002" Titulo="Usuarios"
            Subtitulo="Cada usuario tiene un solo rol. Un usuario desactivado no puede iniciar sesión, pero conserva su historial.">
    <a class="btn btn-primary" href="/usuarios/nuevo">Nuevo usuario</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />
@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success">@exito</div>
}

<Confirmacion Visible="@(porDesactivar is not null)" Titulo="Desactivar usuario" TextoConfirmar="Desactivar"
              AlConfirmar="ConfirmarDesactivar" AlCancelar="() => porDesactivar = null">
    <p class="mb-2">¿Seguro que desea desactivar a <strong>@porDesactivar?.NombreUsuario</strong>
        (@porDesactivar?.Nombres @porDesactivar?.Apellidos)?</p>
    <p class="small text-muted mb-0">Si está conectado, su sesión se cerrará en su siguiente operación.</p>
</Confirmacion>

<div class="card card-body mb-3">
    <div class="row g-3 align-items-end sigmeta-filtros">
        <Campo Etiqueta="Usuario o nombre" Id="fTexto" Clase="col-sm-6 col-md">
            <input id="fTexto" class="form-control" maxlength="100" @bind="filtroTexto" @bind:event="oninput" @bind:after="AlFiltrar" />
        </Campo>
        <Campo Etiqueta="Rol" Id="fRol" Clase="col-sm-6 col-md-3">
            <select id="fRol" class="form-select" @bind="filtroRol" @bind:after="AlFiltrar">
                <option value="">Todos</option>
                <option value="ADMINISTRADOR">Administrador</option>
                <option value="VENDEDOR">Vendedor</option>
                <option value="CAJERO">Cajero</option>
                <option value="ALMACENERO">Almacenero</option>
            </select>
        </Campo>
        <Campo Etiqueta="Estado" Id="fEstado" Clase="col-sm-6 col-md-3">
            <select id="fEstado" class="form-select" @bind="filtroEstado" @bind:after="AlFiltrar">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
            </select>
        </Campo>
    </div>
</div>

@if (usuarios is null)
{
    <p class="text-muted">Cargando usuarios...</p>
}
else
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Nombres y apellidos</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Registrado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Filtrados.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron usuarios.</td></tr>
                    }
                    @foreach (var u in Pagina)
                    {
                        <tr>
                            <td><strong>@u.NombreUsuario</strong></td>
                            <td>@u.Nombres @u.Apellidos</td>
                            <td>@(string.IsNullOrEmpty(u.Correo) ? "—" : u.Correo)</td>
                            <td>@TextosSeguridad.Texto(u.Rol)</td>
                            <td><Estado Texto="@(u.Estado ? "Activo" : "Inactivo")" /></td>
                            <td class="text-nowrap">@Formato.Fecha(u.FechaRegistro)</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/usuarios/editar/{u.Id}")">Editar</a>
                                    @* RF002: nadie se desactiva a sí mismo; lo hace otro Administrador (el BO también lo rechaza) *@
                                    @if (u.Estado && !EsYoMismo(u))
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => { error = exito = null; porDesactivar = u; }">Desactivar</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@Filtrados.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    private List<UsuarioDatos>? usuarios;
    private UsuarioDatos? porDesactivar;

    // usuario en sesión (sale de la cookie del login), para no ofrecerle desactivarse a sí mismo
    [CascadingParameter] private Task<AuthenticationState>? EstadoSesion { get; set; }
    private string? miUsuario;

    protected override async Task OnParametersSetAsync()
    {
        if (miUsuario is null && EstadoSesion is not null)
        {
            miUsuario = (await EstadoSesion).User.Identity?.Name;
        }
    }

    private bool EsYoMismo(UsuarioDatos u) =>
        miUsuario is not null && string.Equals(u.NombreUsuario, miUsuario, StringComparison.OrdinalIgnoreCase);
    private string filtroTexto = "";
    private string filtroRol = "";
    private string filtroEstado = "";
    private string? error;
    private string? exito;
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<UsuarioDatos> Filtrados => (usuarios ?? new())
        .Where(u => filtroRol == "" || u.Rol == filtroRol)
        .Where(u => filtroEstado == "" || u.Estado == (filtroEstado == "true"))
        .Where(u => string.IsNullOrWhiteSpace(filtroTexto)
                    || u.NombreUsuario.Contains(filtroTexto.Trim(), StringComparison.OrdinalIgnoreCase)
                    || $"{u.Nombres} {u.Apellidos}".Contains(filtroTexto.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IEnumerable<UsuarioDatos> Pagina => tamanoPagina == 0 ? Filtrados
        : Filtrados.Skip((Math.Max(paginaActual, 1) - 1) * tamanoPagina).Take(tamanoPagina);

    private void AlFiltrar() => paginaActual = 1;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        exito = Guardado == "clave"
            ? $"Se restableció la clave del usuario {Referencia}."
            : AvisoGuardado.Texto(Guardado, "el usuario", Referencia);
    }

    private async Task Cargar()
    {
        try
        {
            usuarios = await Api.Get<List<UsuarioDatos>>("usuarios") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            usuarios ??= new();
        }
    }

    private async Task ConfirmarDesactivar()
    {
        var u = porDesactivar;
        porDesactivar = null;
        if (u is null) return;
        try
        {
            await Api.Delete($"usuarios/{u.Id}");
            await Cargar();
            exito = AvisoGuardado.Texto(AvisoGuardado.Desactivado, "el usuario", u.NombreUsuario);
        }
        catch (ErrorApi e)
        {
            error = e.Message;   // por ejemplo "No se puede quitar al único Administrador activo del sistema"
        }
    }
}

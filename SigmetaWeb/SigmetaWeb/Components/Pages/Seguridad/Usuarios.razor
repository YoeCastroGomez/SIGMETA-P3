@page "/usuarios"

<PageTitle>Usuarios · SIGMETA</PageTitle>

@* RF002 · Lista de usuarios. Solo visual (Lab 9): los filtros y botones no hacen nada. *@
<Encabezado Rf="RF002" Titulo="Usuarios" Subtitulo="Cada usuario tiene un único rol. Un usuario desactivado no puede iniciar sesión.">
    <a class="btn btn-primary" href="/usuarios/nuevo">Nuevo usuario</a>
</Encabezado>

<div class="panel">
    <div class="filtros">
        <Campo Etiqueta="Estado" Id="fEstado" Clase="angosto">
            <select id="fEstado" class="form-select">
                <option>Todos</option>
                <option>Activos</option>
                <option>Inactivos</option>
            </select>
        </Campo>
        <div class="campo">
            <button class="btn btn-oscuro">Buscar</button>
        </div>
    </div>
</div>

<div class="panel p-0">
    <div class="tabla-envoltura">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in MuestrasSeguridad.Usuarios)
                {
                    <tr>
                        <td><strong>@u.NombreUsuario</strong></td>
                        <td>@u.Nombres</td>
                        <td>@u.Apellidos</td>
                        <td>@(u.Correo ?? "—")</td>
                        <td>@MuestrasSeguridad.Texto(u.Rol)</td>
                        <td><Estado Texto="@(u.Estado ? "Activo" : "Inactivo")" /></td>
                        <td class="acciones-fila">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/usuarios/editar/{u.Id}")">Editar</a>
                            @if (u.Estado)
                            {
                                <button class="btn btn-sm btn-outline-danger">Desactivar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

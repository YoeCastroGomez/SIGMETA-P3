@page "/autorizaciones/nueva"
@attribute [Authorize(Roles = "Vendedor,Cajero,Almacenero")]
@inject NavigationManager Nav

@* RF014 · Ya no hay solicitudes "sueltas": la autorización se pide desde la operación que la necesita
   (nota de crédito, venta bajo el costo, ajuste de inventario y su reversión), con los datos de esa operación.
   Esta ruta se conserva solo para enlaces antiguos y lleva al historial. *@

@code {
    protected override void OnInitialized() => Nav.NavigateTo("/autorizaciones/mias", replace: true);
}

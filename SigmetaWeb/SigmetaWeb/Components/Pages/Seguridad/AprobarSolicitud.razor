@page "/autorizaciones/aprobar/{Id:int}"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Administrador")]
@inject ApiJava Api
@inject NavigationManager Nav

<PageTitle>Resolver solicitud · SIGMETA</PageTitle>

@* RF014 · POST /api/solicitudes/{id}/aprobar {"vigenciaMinutos": 30} · POST /api/solicitudes/{id}/rechazar.
   Solo el Administrador y solo una solicitud PENDIENTE. A la izquierda lo que se autoriza (lo arma el sistema
   desde la operación); a la derecha la decisión, con lo que pasa en cada caso. *@
<Encabezado Rf="RF014" Titulo="Resolver solicitud">
    <a class="btn btn-outline-secondary" href="/autorizaciones">Volver a la lista</a>
</Encabezado>

<AvisoError Mensaje="@error" AlCerrar="() => error = null" />

<Confirmacion Visible="@confirmarRechazo" Titulo="Rechazar la solicitud" TextoConfirmar="Rechazar"
              AlConfirmar="Rechazar" AlCancelar="() => confirmarRechazo = false">
    <p class="mb-0">@solicitud?.NombreSolicitante no podrá @(Accion(solicitud?.Operacion)) con estos datos.</p>
</Confirmacion>

@if (solicitud is not null)
{
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card card-body h-100">
                <DatosSolicitud Solicitud="solicitud" />
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card card-body decision">
                @if (solicitud.Estado == "PENDIENTE")
                {
                    <h2 class="h6 fw-semibold mb-3">Su decisión</h2>

                    <Campo Etiqueta="Vigencia" Id="vigencia" Obligatorio="true" Error="@ErrorVigencia">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            @foreach (var m in new[] { 15, 30, 60, 120 })
                            {
                                <button type="button" class="btn btn-sm @(vigencia == m ? "btn-dark" : "btn-outline-secondary")"
                                        @onclick="() => vigencia = m">@m min</button>
                            }
                            <div class="input-group input-group-sm" style="max-width: 9rem;">
                                <input id="vigencia" type="number" min="1" max="1440" class="form-control @(ErrorVigencia is null ? "" : "is-invalid")"
                                       aria-label="Otro tiempo en minutos" @bind="vigencia" @bind:event="oninput" />
                                <span class="input-group-text">min</span>
                            </div>
                        </div>
                    </Campo>

                    @if (ErrorVigencia is null && vigencia > 0)
                    {
                        <div class="small text-muted mb-3">Vence a las @DateTime.Now.AddMinutes(vigencia).ToString("dd/MM HH:mm")</div>
                    }

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" disabled="@guardando" @onclick="Aprobar">@(guardando ? "Guardando..." : $"Aprobar por {vigencia} min")</button>
                        <button class="btn btn-outline-danger" disabled="@guardando" @onclick="() => confirmarRechazo = true">Rechazar</button>
                    </div>
                    <div class="small text-muted mt-2"><span class="text-danger">*</span> Obligatorio para aprobar</div>
                }
                else
                {
                    <h2 class="h6 fw-semibold mb-3">Ya resuelta</h2>
                    <a class="btn btn-outline-secondary" href="/autorizaciones">Ver las demás solicitudes</a>
                }
            </div>
        </div>
    </div>
}
else if (error is null)
{
    <p class="text-muted">Cargando solicitud...</p>
}

@code {
    [Parameter] public int Id { get; set; }

    private SolicitudDatos? solicitud;
    private int vigencia = 30;
    private bool intento;
    private bool guardando;
    private bool confirmarRechazo;
    private string? error;

    // lo que podrá hacer el solicitante con la autorización
    private static string Accion(string? operacion) => operacion switch
    {
        TextosSeguridad.OperacionNotaCredito => "registrar esta nota de crédito",
        TextosSeguridad.OperacionDescuento => "registrar esta venta con el precio bajo el costo",
        TextosSeguridad.OperacionAjuste => "registrar este ajuste de inventario",
        _ => "completar esta operación"
    };

    // misma regla que el BO: la vigencia debe ser mayor a 0
    private string? ErrorVigencia => !intento && vigencia > 0 && vigencia <= 1440 ? null
        : vigencia <= 0 ? "La vigencia debe ser mayor a 0 minutos."
        : vigencia > 1440 ? "La vigencia no puede pasar de 1440 minutos (un día)."
        : null;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            solicitud = await Api.Get<SolicitudDatos>($"solicitudes/{Id}");
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    private async Task Aprobar()
    {
        intento = true;
        error = null;
        if (ErrorVigencia is not null) return;
        guardando = true;
        try
        {
            await Api.Post<SolicitudDatos>($"solicitudes/{Id}/aprobar", new { vigenciaMinutos = vigencia });
            Nav.NavigateTo(AvisoGuardado.Ruta("/autorizaciones", "aprobada", solicitud?.Solicitante));
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Rechazar()
    {
        confirmarRechazo = false;
        error = null;
        guardando = true;
        try
        {
            await Api.Post<SolicitudDatos>($"solicitudes/{Id}/rechazar", null);
            Nav.NavigateTo(AvisoGuardado.Ruta("/autorizaciones", "rechazada", solicitud?.Solicitante));
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}

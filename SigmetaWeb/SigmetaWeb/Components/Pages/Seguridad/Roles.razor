@page "/roles"

<PageTitle>Roles · SIGMETA</PageTitle>

@* RF002 · Lista de roles (solo consulta). Solo visual (Lab 9). *@
<Encabezado Rf="RF002" Titulo="Roles" Subtitulo="Los cuatro roles del sistema. Se asignan al registrar o editar un usuario." />

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Rol</th><th>Descripción</th><th>Estado</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Paginar(MuestrasSeguridad.RolesDetalle, paginaActual, tamanoPagina))
                {
                    <tr>
                        <td><strong>@MuestrasSeguridad.Texto(r.Tipo)</strong></td>
                        <td>@r.Descripcion</td>
                        <td><Estado Texto="@(r.Estado ? "Activo" : "Inactivo")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
        <Paginacion TotalRegistros="@(MuestrasSeguridad.RolesDetalle.Count())" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
</div>

@code {
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T> registros, int pagina, int tamano)
    {
        if (tamano == 0) return registros;
        int total = registros.Count();
        int segura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((segura - 1) * tamano).Take(tamano);
    }
}

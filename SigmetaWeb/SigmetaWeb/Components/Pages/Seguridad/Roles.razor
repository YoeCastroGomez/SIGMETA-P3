@page "/roles"
@inject ApiJava Api

<PageTitle>Roles · SIGMETA</PageTitle>

@* RF002 · Los cuatro roles fijos del sistema y cuántos usuarios tiene cada uno. GET /api/usuarios/roles. *@
<Encabezado Rf="RF002" Titulo="Roles"
            Subtitulo="Los roles son fijos: definen qué menú ve cada usuario y qué operaciones le permite el sistema.">
    <a class="btn btn-outline-secondary" href="/usuarios">Ver usuarios</a>
</Encabezado>

<AvisoError Mensaje="@error" />

@if (roles is null)
{
    @if (error is null)
    {
        <p class="text-muted">Cargando roles...</p>
    }
}
else
{
    <div class="row g-3">
        @foreach (var r in roles)
        {
            <div class="col-md-6">
                <div class="card card-body h-100">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h2 class="h6 fw-bold mb-0">@TextosSeguridad.Texto(r.Tipo)</h2>
                        <Estado Texto="@(r.Estado ? "Activo" : "Inactivo")" />
                    </div>
                    <p class="text-muted small mb-3">@(string.IsNullOrWhiteSpace(r.Descripcion) ? "Sin descripción." : r.Descripcion)</p>
                    <ul class="small mb-3 ps-3">
                        @foreach (var p in Permisos(r.Tipo))
                        {
                            <li>@p</li>
                        }
                    </ul>
                    <div class="mt-auto small text-muted border-top pt-2">
                        <strong>@r.UsuariosActivos</strong> @(r.UsuariosActivos == 1 ? "usuario activo" : "usuarios activos")
                        @if (r.Usuarios > r.UsuariosActivos)
                        {
                            <span> · @(r.Usuarios - r.UsuariosActivos) inactivos</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<RolDatos>? roles;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            roles = await Api.Get<List<RolDatos>>("usuarios/roles") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }

    // Resumen de lo que el sistema le permite a cada rol (lo verifica el BO en cada operación)
    private static string[] Permisos(string tipo) => tipo switch
    {
        "ADMINISTRADOR" => new[]
        {
            "Usuarios, roles, productos, categorías y proveedores",
            "Compras a proveedores y líneas de crédito de clientes",
            "Aprueba las solicitudes de autorización",
            "Reabre y corrige cajas; consulta los reportes"
        },
        "VENDEDOR" => new[]
        {
            "Clientes, cotizaciones y órdenes de clientes",
            "Ventas y emisión de comprobantes",
            "Con autorización: descuento especial bajo el costo"
        },
        "CAJERO" => new[]
        {
            "Abre y cierra su caja; registra ingresos y egresos",
            "Cobros al contado y de cuentas por cobrar",
            "Con autorización: notas de crédito"
        },
        "ALMACENERO" => new[]
        {
            "Recepción de compras y despacho de ventas",
            "Kardex y stock mínimo",
            "Con autorización: ajuste de inventario por conteo"
        },
        _ => Array.Empty<string>()
    };
}

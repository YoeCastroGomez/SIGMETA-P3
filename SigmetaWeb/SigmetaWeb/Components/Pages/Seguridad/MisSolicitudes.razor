@page "/autorizaciones/mias"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Cajero,Almacenero")]
@inject ApiJava Api

<PageTitle>Mis solicitudes · SIGMETA</PageTitle>

@* RF014 · Solicitudes del usuario conectado. GET /api/solicitudes/mias · POST /api/solicitudes/{id}/anular.
   Solo historial: la autorización se pide desde la operación (nota de crédito, venta bajo el costo, ajuste),
   con sus datos. Mismo patrón de listas que ventas: FiltrosLista, AccionesFila y Notificacion. *@
<Encabezado Rf="RF014" Titulo="Mis solicitudes de autorización"
            Subtitulo="Se piden desde la operación que las necesita." />

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />
<Notificacion Mensaje="@exito" AlCerrar="() => exito = null" />

<Confirmacion Visible="@(porAnular is not null)" Titulo="Anular solicitud" TextoConfirmar="Anular"
              AlConfirmar="ConfirmarAnular" AlCancelar="() => porAnular = null">
    <p class="mb-0 text-muted">Ya no podrás usar esta autorización.</p>
</Confirmacion>

<FiltrosLista @bind-Busqueda="busqueda" @bind-Busqueda:after="AlBuscar" Placeholder="Comprobante, motivo u operación"
              Opciones="@Chips" Estado="@filtroEstado" EstadoChanged="CambiarEstado"
              HayFiltros="@(filtroEstado != "" || !string.IsNullOrWhiteSpace(busqueda))" AlLimpiar="Limpiar" />

@if (solicitudes is null)
{
    <p class="text-muted">Cargando solicitudes...</p>
}
else
{
    var filtradas = Filtradas;
    var pagina = Pagina(filtradas).ToList();
    <div class="card mb-3">
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table table-hover align-middle mb-0 tabla-lista">
                <thead>
                    <tr>
                        <th>Operación</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="4">
                                @if (solicitudes.Count == 0)
                                {
                                    <ListaVacia Titulo="Todavía no has pedido ninguna autorización." />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Ninguna solicitud coincide con los filtros." AlQuitarFiltros="Limpiar" />
                                }
                            </td>
                        </tr>
                    }
                    @for (var i = 0; i < pagina.Count; i++)
                    {
                        var s = pagina[i];
                        var haciaArriba = pagina.Count > 3 && i >= pagina.Count - 2;
                        <tr @key="s.Id">
                            <td>
                                <span class="numero">@(string.IsNullOrEmpty(s.Referencia) ? TextosSeguridad.Texto(s.Operacion) : s.Referencia)</span>
                                <div class="sub">
                                    @if (!string.IsNullOrEmpty(s.Referencia))
                                    {
                                        @(TextosSeguridad.Texto(s.Operacion) + " · ")
                                    }
                                    @Formato.FechaHora(s.FechaSolicitud)
                                </div>
                            </td>
                            <td class="motivo">@s.Motivo</td>
                            <td>
                                <Estado Texto="@TextosSeguridad.Texto(s.Estado)" />
                                @if (s.Vigente)
                                {
                                    <div class="sub">Hasta @Formato.FechaHora(s.FechaVencimiento)</div>
                                }
                            </td>
                            <td class="acciones">
                                <AccionesFila Principal="@(new AccionFila("Ver", Ruta: $"/autorizaciones/detalle/{s.Id}", Destacada: false))"
                                              Otras="@Secundarias(s)" HaciaArriba="@haciaArriba" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    private List<SolicitudDatos>? solicitudes;
    private SolicitudDatos? porAnular;
    private string? error;
    private string? exito;
    private string busqueda = "";
    private string filtroEstado = "";
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<SolicitudDatos> PorBusqueda => (solicitudes ?? new())
        .Where(s => Busqueda.Coincide(busqueda, s.Motivo, TextosSeguridad.Texto(s.Operacion), s.Referencia))
        .ToList();

    private List<SolicitudDatos> Filtradas => PorBusqueda
        .Where(s => filtroEstado == "" || s.Estado == filtroEstado)
        .ToList();

    private IReadOnlyList<OpcionChip> Chips
    {
        get
        {
            var base_ = PorBusqueda;
            int Cuantas(string e) => base_.Count(s => s.Estado == e);
            return new List<OpcionChip>
            {
                new("", "Todas", base_.Count),
                new("PENDIENTE", "Pendientes", Cuantas("PENDIENTE"), "ambar"),
                new("APROBADA", "Aprobadas", Cuantas("APROBADA"), "verde"),
                new("RECHAZADA", "Rechazadas", Cuantas("RECHAZADA"), "rojo"),
                new("VENCIDA", "Vencidas o usadas", Cuantas("VENCIDA"))
            };
        }
    }

    private IEnumerable<SolicitudDatos> Pagina(List<SolicitudDatos> lista)
    {
        if (tamanoPagina == 0) return lista;
        var total = Math.Max(1, (int)Math.Ceiling((double)lista.Count / tamanoPagina));
        return lista.Skip((Math.Clamp(paginaActual, 1, total) - 1) * tamanoPagina).Take(tamanoPagina);
    }

    // Menú «⋯»: anular mientras esté pendiente o aprobada sin usar
    private List<AccionFila> Secundarias(SolicitudDatos s) =>
        s.Estado == "PENDIENTE" || s.Vigente
            ? new() { new("Anular", Hacer: () => PedirAnular(s), Peligro: true) }
            : new();

    // Lo llama AccionesFila: la acción corre en esta pantalla para que se redibuje (ventana de anular)
    private Task Ejecutar(AccionFila a) => a.Hacer?.Invoke() ?? Task.CompletedTask;

    private Task PedirAnular(SolicitudDatos s)
    {
        error = exito = null;
        porAnular = s;
        return Task.CompletedTask;
    }

    private void AlBuscar() => paginaActual = 1;

    private void CambiarEstado(string estado)
    {
        filtroEstado = estado;
        paginaActual = 1;
    }

    private void Limpiar()
    {
        filtroEstado = "";
        busqueda = "";
        paginaActual = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        if (Guardado == AvisoGuardado.Nuevo)
        {
            exito = $"Se envió la solicitud de {TextosSeguridad.Texto(Referencia).ToLower()}.";
        }
    }

    private async Task Cargar()
    {
        try
        {
            solicitudes = await Api.Get<List<SolicitudDatos>>("solicitudes/mias") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            solicitudes ??= new();
        }
    }

    private async Task ConfirmarAnular()
    {
        var s = porAnular;
        porAnular = null;
        if (s is null) return;
        try
        {
            await Api.Post<object>($"solicitudes/{s.Id}/anular", null);
            await Cargar();
            exito = $"Se anuló la solicitud de {TextosSeguridad.Texto(s.Operacion).ToLower()}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

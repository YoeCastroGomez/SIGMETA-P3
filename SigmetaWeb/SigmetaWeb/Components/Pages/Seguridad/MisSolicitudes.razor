@page "/autorizaciones/mias"
@* RF001: solo estos roles abren esta pantalla *@
@attribute [Authorize(Roles = "Vendedor,Cajero,Almacenero")]
@inject ApiJava Api

<PageTitle>Mis solicitudes · SIGMETA</PageTitle>

@* RF014 · Solicitudes del usuario conectado: el historial de lo que le pidió al Administrador.
   GET /api/solicitudes/mias · POST /api/solicitudes/{id}/descartar (cancelar o dejar de retomar).
   La autorización se pide desde la operación (nota de crédito, venta bajo el costo, ajuste), con sus datos, y
   desde aquí se vuelve a esa operación para completarla o corregirla (Continuar / Completar / Corregir).
   Estados: Pendiente → Aprobada o Rechazada → Usada (se completó la operación) o Vencida (pasó su vigencia).
   Mismo patrón de listas que ventas: FiltrosLista, AccionesFila y Notificacion. *@
<Encabezado Rf="RF014" Titulo="Mis solicitudes de autorización"
            Subtitulo="Se piden desde la operación que las necesita." />

<Notificacion Mensaje="@error" Error="true" AlCerrar="() => error = null" />
<Notificacion Mensaje="@exito" AlCerrar="() => exito = null" />

<Confirmacion Visible="@(porAnular is not null)" Titulo="@(porAnular?.Estado is "PENDIENTE" or "APROBADA" ? "Cancelar la solicitud" : "Descartar la solicitud")"
              TextoConfirmar="@(porAnular?.Estado is "PENDIENTE" or "APROBADA" ? "Cancelar solicitud" : "Descartar")"
              AlConfirmar="ConfirmarAnular" AlCancelar="() => porAnular = null">
    <p class="mb-0 text-muted">@(porAnular?.Estado is "PENDIENTE" or "APROBADA" ? "Ya no podrás usar esta autorización." : "Ya no aparecerá para corregirla.")</p>
</Confirmacion>

<FiltrosLista @bind-Busqueda="busqueda" @bind-Busqueda:after="AlBuscar" Placeholder="Comprobante, motivo u operación"
              Opciones="@Chips" Estado="@filtroEstado" EstadoChanged="CambiarEstado"
              HayFiltros="@(filtroEstado != "" || !string.IsNullOrWhiteSpace(busqueda))" AlLimpiar="Limpiar" />

@if (solicitudes is null)
{
    <p class="text-muted">Cargando solicitudes...</p>
}
else
{
    var filtradas = Filtradas;
    var pagina = Pagina(filtradas).ToList();
    <div class="card mb-3">
        <div class="table-responsive tabla-lista-contenedor">
            <table class="table table-hover align-middle mb-0 tabla-lista">
                <thead>
                    <tr>
                        <th>Operación</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtradas.Count == 0)
                    {
                        <tr>
                            <td colspan="4">
                                @if (solicitudes.Count == 0)
                                {
                                    <ListaVacia Titulo="Todavía no has pedido ninguna autorización." />
                                }
                                else
                                {
                                    <ListaVacia Titulo="Ninguna solicitud coincide con los filtros." AlQuitarFiltros="Limpiar" />
                                }
                            </td>
                        </tr>
                    }
                    @for (var i = 0; i < pagina.Count; i++)
                    {
                        var s = pagina[i];
                        var haciaArriba = pagina.Count > 3 && i >= pagina.Count - 2;
                        <tr @key="s.Id">
                            <td>
                                @* RF014: el tipo de operación es lo principal; el documento o producto va debajo *@
                                <span class="fw-semibold">@TextosSeguridad.Texto(s.Operacion)</span>
                                <div class="sub">
                                    @if (!string.IsNullOrEmpty(s.Referencia))
                                    {
                                        @(s.Referencia + " · ")
                                    }
                                    @Formato.FechaHora(s.FechaSolicitud)
                                </div>
                            </td>
                            <td class="motivo">@s.Motivo</td>
                            <td>
                                <Estado Texto="@TextosSeguridad.TextoEstado(s)" />
                                <div class="sub">@SubEstado(s)</div>
                            </td>
                            <td class="acciones">
                                <AccionesFila Principal="@Principal(s)" Otras="@Secundarias(s)" HaciaArriba="@haciaArriba" AlElegir="Ejecutar" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion TotalRegistros="@filtradas.Count" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
    </div>
}

@code {
    private List<SolicitudDatos>? solicitudes;
    private SolicitudDatos? porAnular;
    private string? error;
    private string? exito;
    private string busqueda = "";
    private string filtroEstado = "";
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    [SupplyParameterFromQuery(Name = "guardado")] public string? Guardado { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] public string? Referencia { get; set; }

    private List<SolicitudDatos> PorBusqueda => (solicitudes ?? new())
        .Where(s => Busqueda.Coincide(busqueda, s.Motivo, TextosSeguridad.Texto(s.Operacion), s.Referencia, TextosSeguridad.TextoEstado(s)))
        .ToList();

    private List<SolicitudDatos> Filtradas => PorBusqueda
        .Where(s => filtroEstado == "" || TextosSeguridad.ClaveEstado(s) == filtroEstado)
        .ToList();

    // una línea bajo el estado: hasta cuándo sirve, cuánto lleva esperando o quién la resolvió
    private static string SubEstado(SolicitudDatos s) => s.Cancelada ? "" : s.Estado switch
    {
        "PENDIENTE" => TextosSeguridad.Hace(s.FechaSolicitud),
        "APROBADA" => $"Hasta {Formato.FechaHora(s.FechaVencimiento)}",
        "RECHAZADA" => string.IsNullOrEmpty(s.Administrador) ? "" : $"Por {s.Administrador}",
        _ => ""
    };

    // botón visible: volver a la operación si se puede retomar; si no, ver el detalle
    private static AccionFila Principal(SolicitudDatos s) => TextosSeguridad.RutaRetomar(s) is string ruta
        ? new(TextosSeguridad.TextoRetomar(s), Ruta: ruta, Destacada: s.Estado == "APROBADA")
        : new("Ver", Ruta: $"/autorizaciones/detalle/{s.Id}", Destacada: false);

    private IReadOnlyList<OpcionChip> Chips
    {
        get
        {
            var base_ = PorBusqueda;
            int Cuantas(string e) => base_.Count(s => TextosSeguridad.ClaveEstado(s) == e);
            return new List<OpcionChip>
            {
                new("", "Todas", base_.Count),
                new("PENDIENTE", "Pendientes", Cuantas("PENDIENTE"), "ambar"),
                new("APROBADA", "Aprobadas", Cuantas("APROBADA"), "verde"),
                new("RECHAZADA", "Rechazadas", Cuantas("RECHAZADA"), "rojo"),
                new("USADA", "Usadas", Cuantas("USADA")),
                new("VENCIDA", "Vencidas", Cuantas("VENCIDA"), "rojo"),
                new("CANCELADA", "Canceladas", Cuantas("CANCELADA"))
            };
        }
    }

    private IEnumerable<SolicitudDatos> Pagina(List<SolicitudDatos> lista)
    {
        if (tamanoPagina == 0) return lista;
        var total = Math.Max(1, (int)Math.Ceiling((double)lista.Count / tamanoPagina));
        return lista.Skip((Math.Clamp(paginaActual, 1, total) - 1) * tamanoPagina).Take(tamanoPagina);
    }

    // Menú «⋯»: ver el detalle (si el botón retoma la operación), cancelar mientras esté pendiente o aprobada
    // sin usar, y descartar una rechazada o vencida que todavía aparece para corregir
    private List<AccionFila> Secundarias(SolicitudDatos s)
    {
        var lista = new List<AccionFila>();
        if (TextosSeguridad.RutaRetomar(s) is not null)
        {
            lista.Add(new("Ver detalle", Ruta: $"/autorizaciones/detalle/{s.Id}"));
        }
        if (s.Estado == "PENDIENTE" || s.Vigente)
        {
            lista.Add(new("Cancelar solicitud", Hacer: () => PedirAnular(s), Peligro: true));
        }
        else if (s.SePuedeRetomar)
        {
            lista.Add(new("Descartar", Hacer: () => PedirAnular(s), Peligro: true));
        }
        return lista;
    }

    // Lo llama AccionesFila: la acción corre en esta pantalla para que se redibuje (ventana de anular)
    private Task Ejecutar(AccionFila a) => a.Hacer?.Invoke() ?? Task.CompletedTask;

    private Task PedirAnular(SolicitudDatos s)
    {
        error = exito = null;
        porAnular = s;
        return Task.CompletedTask;
    }

    private void AlBuscar() => paginaActual = 1;

    private void CambiarEstado(string estado)
    {
        filtroEstado = estado;
        paginaActual = 1;
    }

    private void Limpiar()
    {
        filtroEstado = "";
        busqueda = "";
        paginaActual = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        if (Guardado == AvisoGuardado.Nuevo)
        {
            exito = $"Se envió la solicitud de {TextosSeguridad.Texto(Referencia).ToLower()}.";
        }
    }

    private async Task Cargar()
    {
        try
        {
            solicitudes = await Api.Get<List<SolicitudDatos>>("solicitudes/mias") ?? new();
        }
        catch (ErrorApi e)
        {
            error = e.Message;
            solicitudes ??= new();
        }
    }

    private async Task ConfirmarAnular()
    {
        var s = porAnular;
        porAnular = null;
        if (s is null) return;
        try
        {
            // RF014: descartar cancela la pendiente o aprobada y deja de mostrar la operación para retomarla
            await Api.Post<object>($"solicitudes/{s.Id}/descartar", null);
            await Cargar();
            exito = s.Estado is "PENDIENTE" or "APROBADA"
                ? $"Se canceló la solicitud de {TextosSeguridad.Texto(s.Operacion).ToLower()}."
                : $"Se descartó la solicitud de {TextosSeguridad.Texto(s.Operacion).ToLower()}.";
        }
        catch (ErrorApi e)
        {
            error = e.Message;
        }
    }
}

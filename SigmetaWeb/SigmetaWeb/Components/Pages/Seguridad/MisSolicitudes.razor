@page "/autorizaciones/mias"

<PageTitle>Mis solicitudes · SIGMETA</PageTitle>

@* RF014 · Mis solicitudes, vista del solicitante. Datos de ejemplo fijos por rol. Solo visual (Lab 9). *@
<Encabezado Rf="RF014" Titulo="Mis solicitudes de autorización"
            Subtitulo="Operaciones restringidas que pediste al Administrador.">
    <a class="btn btn-primary" href="/autorizaciones/nueva">Nueva solicitud</a>
</Encabezado>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Operación</th>
                    <th>Motivo</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Vence</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Paginar(MuestrasSeguridad.MisSolicitudes.GetValueOrDefault(Rol, Array.Empty<SolicitudFila>()), paginaActual, tamanoPagina))
                {
                    <tr>
                        <td>@s.OperacionRestringida</td>
                        <td>@s.Motivo</td>
                        <td>@s.FechaSolicitud</td>
                        <td><Estado Texto="@MuestrasSeguridad.Texto(s.Estado)" /></td>
                        <td>@(s.FechaVencimiento ?? "—")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 text-nowrap">
                                @if (s.Estado == "PENDIENTE" || s.Estado == "APROBADA")
                                {
                                    <button class="btn btn-sm btn-outline-danger">Anular</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
        <Paginacion TotalRegistros="@(MuestrasSeguridad.MisSolicitudes.GetValueOrDefault(Rol, Array.Empty<SolicitudFila>()).Count())" @bind-PaginaActual="paginaActual" @bind-TamanoPagina="tamanoPagina" />
</div>

@code {
    private int paginaActual = 1;
    private int tamanoPagina = 10;
    private IEnumerable<T> Paginar<T>(IEnumerable<T> registros, int pagina, int tamano)
    {
        if (tamano == 0) return registros;
        int total = registros.Count();
        int segura = Math.Clamp(pagina, 1, Math.Max(1, (total + tamano - 1) / tamano));
        return registros.Skip((segura - 1) * tamano).Take(tamano);
    }

    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "Vendedor";
}

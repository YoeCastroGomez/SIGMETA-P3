@page "/login"
@layout LoginLayout
@inject NavigationManager Nav

<PageTitle>Iniciar sesión · SIGMETA</PageTitle>

@* RF001 · Login. Solo visual (Lab 9): no se valida la clave, "Ingresar" solo navega. *@
<div class="card shadow-sm p-4 w-100" style="max-width: 380px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <span class="sigmeta-logo rounded d-flex align-items-center justify-content-center text-white fw-bold">SM</span>
        <div>
            <div class="fw-bold">SIGMETA</div>
            <div class="small text-muted">Grupo Meta · Sistema comercial</div>
        </div>
    </div>

    <h1 class="h5 mb-3">Iniciar sesión</h1>

    <Campo Etiqueta="Usuario" Id="usuario" Obligatorio="true">
        <input id="usuario" class="form-control" autocomplete="username" />
    </Campo>

    <Campo Etiqueta="Clave" Id="clave" Obligatorio="true">
        <input id="clave" type="password" class="form-control" autocomplete="current-password" />
    </Campo>

    <button class="btn btn-primary w-100 mt-2" @onclick="@(() => Entrar("Administrador"))">Ingresar</button>

    <p class="small text-muted mt-3 mb-0">Si olvidaste tu clave, solicita al Administrador que la restablezca.</p>

    @* Solo para la demostración: entra con el menú de cada rol. *@
    <div class="border-top mt-4 pt-3">
        <div class="small text-muted text-uppercase mb-2">Demostración: entrar como</div>
        <div class="row g-2">
            @foreach (var r in new[] { "Administrador", "Vendedor", "Cajero", "Almacenero" })
            {
                <div class="col-6">
                    <button class="btn btn-sm btn-outline-secondary w-100" @onclick="@(() => Entrar(r))">@r</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // forceLoad recrea el layout para que tome el rol elegido.
    private void Entrar(string rol) => Nav.NavigateTo($"/?rol={Uri.EscapeDataString(rol)}", forceLoad: true);
}

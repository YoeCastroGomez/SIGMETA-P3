<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <title>SIGMETA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SigmetaWeb.styles.css"]" />
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["descargas.js"]"></script>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        // RF008: mientras el diálogo de impresión está abierto la página no puede responder al servidor.
        // Se espera hasta 5 minutos antes de dar la conexión por perdida (igual que ClientTimeoutInterval en Program.cs).
        Blazor.start({
            circuit: {
                configureSignalR: function (builder) {
                    builder.withServerTimeout(300000).withKeepAliveInterval(15000);
                }
            }
        });
    </script>
</body>

</html>

@inherits LayoutComponentBase
@inject NavigationManager Nav

<CascadingValue Value="rol" Name="Rol">
    <div class="d-flex min-vh-100">
        <aside class="sigmeta-sidebar d-flex flex-column @(menuAbierto ? "abierto" : "")">
            <div class="d-flex align-items-center gap-2 px-3 py-3 border-bottom border-secondary">
                <span class="sigmeta-logo rounded d-flex align-items-center justify-content-center text-white fw-bold">SM</span>
                <div>
                    <div class="text-white fw-bold">SIGMETA</div>
                    <div class="small text-white-50">Grupo Meta</div>
                </div>
            </div>
            <NavMenu Rol="@rol" AlNavegar="() => menuAbierto = false" />
        </aside>

        <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
            <header class="d-flex align-items-center gap-3 bg-white border-bottom px-4 py-2">
                <button class="btn btn-sm btn-outline-secondary d-xl-none" @onclick="() => menuAbierto = !menuAbierto">Menú</button>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <a class="small text-decoration-none" href="/mi-clave" title="Cambiar mi clave">
                        <strong>@usuario</strong>
                        <span class="text-muted d-none d-sm-inline">· @nombreCompleto · @rol</span>
                    </a>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CerrarSesion">Cerrar sesión</button>
                </div>
            </header>

            <main class="container-fluid p-3 p-md-4" style="max-width: 1200px;">
                @Body
            </main>
        </div>
    </div>
</CascadingValue>

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">×</a>
</div>

@code {
    // RF001: el usuario y su rol salen de la sesión iniciada (cookie creada en ServicioSesionAuth),
    // no de la dirección. El rol decide cuál de los cuatro menús fijos se ve;
    // los permisos de cada operación los valida el BO en el Java.
    [CascadingParameter] private Task<AuthenticationState> EstadoAuth { get; set; } = default!;

    private bool menuAbierto;
    private string usuario = "";
    private string nombreCompleto = "";
    private string rol = "";

    protected override async Task OnParametersSetAsync()
    {
        var estado = await EstadoAuth;
        var user = estado.User;
        usuario = user.Identity?.Name ?? "";
        nombreCompleto = $"{user.FindFirst(ClaimTypes.GivenName)?.Value} {user.FindFirst(ClaimTypes.Surname)?.Value}";
        rol = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
    }

    // /auth/logout cierra la sesión del Java y borra la cookie (AuthEndpoints)
    private void CerrarSesion() => Nav.NavigateTo("/auth/logout", forceLoad: true);
}

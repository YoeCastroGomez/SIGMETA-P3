@* Mensaje de éxito de una acción en una ventana modal, con un botón opcional para la acción que sigue
   (por ejemplo, después de aceptar una cotización: «Generar orden»).
   Uso:
       <SiguientePaso Mensaje="Se aceptó la cotización COT-2026-0012."
                      TextoAccion="Generar orden" Ruta="/ordenes/nueva?cotizacion=12"
                      AlCerrar="() => exito = null" /> *@
<MensajeModal Tipo="TipoMensaje.Exito" Mensaje="@Mensaje" Detalle="@Detalle" TextoAccion="@TextoAccion" Ruta="@Ruta"
              AlAccion="AlAccion" AlCerrar="AlCerrar" />

@code {
    [Parameter] public string? Mensaje { get; set; }
    [Parameter] public string? Detalle { get; set; }
    [Parameter] public string? TextoAccion { get; set; }
    [Parameter] public string? Ruta { get; set; }
    [Parameter] public EventCallback AlAccion { get; set; }
    [Parameter] public EventCallback AlCerrar { get; set; }
}

@implements IDisposable
@inject ApiJava Api
@inject NavigationManager Nav
@using SigmetaWeb.Components.Pages.Seguridad

@* RF014 · Autorización de ESTA operación. La pantalla que la usa manda los datos de la operación
   (Solicitar: POST notas-credito/solicitar, ventas/solicitar-autorizacion, almacen/ajustes/solicitar...)
   y el sistema arma lo que ve el Administrador. Aquí solo se sigue su estado (GET solicitudes/{id} cada 8 s)
   y, cuando está aprobada, se muestra el botón de la pantalla (ChildContent) para completar la operación.
   Pedirla otra vez con los mismos datos devuelve la misma solicitud (no se duplica).
   La solicitud queda guardada con los datos de la pantalla: si el usuario sale, la retoma después
   (la pantalla la recibe en Retomar, por ejemplo /notas-credito/nueva?solicitud=ID) sin volver a pedirla.
   Con una solicitud enviada: "Volver" sale y la deja guardada; "Cancelar solicitud" la descarta
   (POST solicitudes/{id}/descartar), no se registra la operación y se vuelve a la lista.
   "Corregir y volver a pedir" (rechazada o vencida) la descarta y deja corregir los datos. *@
<Confirmacion Visible="@confirmarCancelar" Titulo="Cancelar la solicitud" TextoConfirmar="Cancelar solicitud"
              AlConfirmar="Cancelar" AlCancelar="() => confirmarCancelar = false">
    <p class="mb-0">No se registrará @QueSeCancela.</p>
</Confirmacion>

<div class="pedir-autorizacion">
    @if (solicitud is null)
    {
        <BotonCondicionado Texto="@TextoSolicitar" TextoOcupado="Enviando..." Bloque="true" Clase="btn-primary w-100"
                           Ocupado="@ocupado" AlHacerClic="Pedir" Motivo="@(Listo ? null : "Falta completar lo indicado.")" MostrarMotivo="false" />
    }
    else if (solicitud.Estado == "PENDIENTE")
    {
        <div class="estado espera" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>
                Solicitud enviada al Administrador
                <span class="d-block fw-normal small">@TextosSeguridad.Hace(solicitud.FechaSolicitud)</span>
            </span>
        </div>
    }
    else if (solicitud.Estado == "APROBADA")
    {
        <div class="estado aprobada" role="status">
            <span>
                Autorizada@(string.IsNullOrEmpty(solicitud.Administrador) ? "" : $" por {solicitud.Administrador}")
                <span class="d-block fw-normal small">Vence @Formato.FechaHora(solicitud.FechaVencimiento)</span>
            </span>
        </div>
        @ChildContent
    }
    else
    {
        <div class="estado rechazada" role="status">
            <span>@TituloCerrada</span>
        </div>
        @if (solicitud.Estado != "USADA")
        {
            <button type="button" class="btn btn-outline-secondary w-100" disabled="@ocupado" @onclick="Corregir">Corregir y volver a pedir</button>
        }
    }
    @if (solicitud is not null)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary flex-fill" href="@Volver">Volver</a>
            @if (solicitud.Estado != "USADA")
            {
                <button type="button" class="btn btn-outline-danger flex-fill" disabled="@ocupado" @onclick="() => confirmarCancelar = true">
                    @(solicitud.Estado is "PENDIENTE" or "APROBADA" ? "Cancelar solicitud" : "Descartar")
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Hace el POST de la operación (con sus datos) y devuelve la solicitud creada o la que ya existía.</summary>
    [Parameter, EditorRequired] public Func<Task<SolicitudDatos?>> Solicitar { get; set; } = default!;
    /// <summary>Los datos de la operación están completos (si no, el botón queda deshabilitado).</summary>
    [Parameter] public bool Listo { get; set; } = true;
    [Parameter] public string TextoSolicitar { get; set; } = "Solicitar autorización";
    /// <summary>Botón para completar la operación; se muestra con la autorización aprobada.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Avisa el estado (null, PENDIENTE, APROBADA, RECHAZADA, VENCIDA o USADA) para que la pantalla bloquee sus campos.</summary>
    [Parameter] public EventCallback<string?> EstadoChanged { get; set; }
    [Parameter] public EventCallback<string> AlError { get; set; }
    /// <summary>Solicitud ya enviada que se retoma (la pantalla ya cargó sus datos).</summary>
    [Parameter] public SolicitudDatos? Retomar { get; set; }
    /// <summary>Lista a la que se vuelve ("Volver" deja la solicitud guardada; "Cancelar solicitud" la descarta).</summary>
    [Parameter] public string Volver { get; set; } = "/";

    private bool confirmarCancelar;
    private string QueSeCancela => solicitud?.Operacion switch
    {
        TextosSeguridad.OperacionNotaCredito => "la nota de crédito",
        TextosSeguridad.OperacionDescuento => "la venta",
        TextosSeguridad.OperacionAjuste => "el ajuste",
        _ => "la operación"
    };
    private SolicitudDatos? solicitud;
    private int idRetomada;
    private bool ocupado;
    private CancellationTokenSource? consultaPeriodica;

    /// <summary>Mientras espera o está aprobada, la operación no se cambia: se autorizó lo que se mandó.</summary>
    public bool Bloquea => solicitud?.Estado is "PENDIENTE" or "APROBADA";

    private string TituloCerrada => solicitud!.Cancelada ? "Solicitud cancelada" : solicitud.Estado switch
    {
        "RECHAZADA" => $"Rechazada{(string.IsNullOrEmpty(solicitud.Administrador) ? "" : $" por {solicitud.Administrador}")}",
        "USADA" => "La autorización ya se usó",
        _ => "La autorización venció sin usarse"
    };

    protected override async Task OnParametersSetAsync()
    {
        // se retoma una solicitud ya enviada: se sigue su estado sin pedirla otra vez
        if (Retomar is not null && Retomar.Id != idRetomada)
        {
            idRetomada = Retomar.Id;
            solicitud = Retomar;
            await Avisar();
        }
    }

    private async Task Pedir()
    {
        if (!Listo) return;
        ocupado = true;
        try
        {
            var creada = await Solicitar();
            if (creada is not null && creada.Id > 0)
            {
                solicitud = await Api.Get<SolicitudDatos>($"solicitudes/{creada.Id}") ?? creada;
                await Avisar();
            }
        }
        catch (ErrorApi e)
        {
            await AlError.InvokeAsync(e.Message);
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task Consultar()
    {
        if (solicitud is null) return;
        ocupado = true;
        try
        {
            var antes = solicitud.Estado;
            solicitud = await Api.Get<SolicitudDatos>($"solicitudes/{solicitud.Id}") ?? solicitud;
            if (solicitud.Estado != antes) await Avisar();
        }
        catch (ErrorApi e)
        {
            await AlError.InvokeAsync(e.Message);
        }
        finally
        {
            ocupado = false;
        }
    }

    // rechazada o vencida: se descarta (ya no aparece para retomar) y se vuelve a preparar la operación
    private Task Corregir() => Descartar();

    // la operación ya no se hace: la solicitud se descarta y se vuelve a la lista (no se registra nada)
    private async Task Cancelar()
    {
        confirmarCancelar = false;
        if (solicitud is null) return;
        ocupado = true;
        try
        {
            await Api.Post<object>($"solicitudes/{solicitud.Id}/descartar", null);
            consultaPeriodica?.Cancel();
            Nav.NavigateTo(Volver);
        }
        catch (ErrorApi e)
        {
            await AlError.InvokeAsync(e.Message);
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task Descartar()
    {
        if (solicitud is null) return;
        ocupado = true;
        try
        {
            await Api.Post<object>($"solicitudes/{solicitud.Id}/descartar", null);
        }
        catch (ErrorApi e)
        {
            await AlError.InvokeAsync(e.Message);
        }
        finally
        {
            ocupado = false;
        }
        await Reiniciar();
    }

    /// <summary>Vuelve al inicio (sin solicitud), por ejemplo al cambiar de documento.</summary>
    public async Task Reiniciar()
    {
        consultaPeriodica?.Cancel();
        solicitud = null;
        await Avisar();
    }

    private async Task Avisar()
    {
        if (solicitud?.Estado == "PENDIENTE") IniciarConsultaPeriodica();
        await EstadoChanged.InvokeAsync(solicitud?.Estado);
    }

    private void IniciarConsultaPeriodica()
    {
        if (consultaPeriodica is not null) return;
        consultaPeriodica = new CancellationTokenSource();
        _ = ConsultarCadaRato(consultaPeriodica.Token);
    }

    private async Task ConsultarCadaRato(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && solicitud?.Estado == "PENDIENTE")
            {
                await Task.Delay(TimeSpan.FromSeconds(8), token);
                await InvokeAsync(async () =>
                {
                    await Consultar();
                    StateHasChanged();
                });
            }
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            consultaPeriodica = null;
        }
    }

    public void Dispose() => consultaPeriodica?.Cancel();
}

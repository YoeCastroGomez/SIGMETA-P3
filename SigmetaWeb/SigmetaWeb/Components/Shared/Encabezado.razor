@* Título de cada pantalla: RF, título, subtítulo y botones a la derecha. *@
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        @if (!string.IsNullOrEmpty(Rf))
        {
            <div class="small fw-semibold text-primary">@Rf</div>
        }
        <h1 class="h4 fw-bold mb-0">@Titulo</h1>
        @if (!string.IsNullOrEmpty(Subtitulo))
        {
            <p class="text-muted mb-0">@Subtitulo</p>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public string? Rf { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

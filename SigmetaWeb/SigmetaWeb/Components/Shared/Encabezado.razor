@* Título de cada pantalla: título, subtítulo, el RF como nota al pie del título y botones a la derecha. *@
<div class="sigmeta-encabezado d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1 class="mb-0">@Titulo</h1>
        @if (!string.IsNullOrEmpty(Subtitulo))
        {
            <p class="sigmeta-encabezado-sub">@Subtitulo</p>
        }
        @if (!string.IsNullOrEmpty(Rf))
        {
            <p class="sigmeta-encabezado-rf">@Rf</p>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public string? Rf { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

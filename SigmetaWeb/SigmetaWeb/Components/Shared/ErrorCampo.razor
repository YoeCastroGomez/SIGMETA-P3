@* Error de un campo fuera de Campo (por ejemplo en una celda de una tabla de líneas): mismo estándar RNF004,
   texto rojo en español debajo del cuadro. Si Mensaje está vacío no muestra nada. *@
@if (!string.IsNullOrEmpty(Mensaje))
{
    <div class="small text-danger mt-1">@Mensaje</div>
}

@code {
    [Parameter] public string? Mensaje { get; set; }
}

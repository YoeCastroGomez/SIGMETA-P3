@* Etiqueta + control + ayuda. El * marca los obligatorios (RNF004).
   Clase: clases de Bootstrap para el contenedor (por defecto "mb-3"; en filas de filtros, una columna "col-…"). *@
<div class="@(Clase ?? "mb-3")">
    <label class="form-label fw-semibold small" for="@Id">@Etiqueta @if (Obligatorio) {<span class="text-danger" title="Obligatorio">*</span>}</label>
    @ChildContent
    @if (!string.IsNullOrEmpty(Ayuda))
    {
        <div class="form-text">@Ayuda</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = "";
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Obligatorio { get; set; }
    [Parameter] public string? Ayuda { get; set; }
    [Parameter] public string? Clase { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

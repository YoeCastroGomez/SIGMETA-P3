@* Etiqueta + control + ayuda. El asterisco marca los obligatorios (RNF004). *@
<div class="campo @Clase">
    <label class="form-label" for="@Id">@Etiqueta @if (Obligatorio) {<span class="req" title="Obligatorio">*</span>}</label>
    @ChildContent
    @if (!string.IsNullOrEmpty(Ayuda))
    {
        <div class="form-text">@Ayuda</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = "";
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Obligatorio { get; set; }
    [Parameter] public string? Ayuda { get; set; }
    [Parameter] public string? Clase { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@* PATRÓN UX · Recorrido de un documento en una sola línea: pasos hechos (✓), el actual (resaltado) y los que vienen.
   Solo lo necesario: el título del paso y, si aporta, el número del documento o un dato corto.
   "Le toca: X" aparece solo en el paso actual y solo si lo hace OTRO rol (al Vendedor no se le dice que le toca a él).
   Uso:
       <PasosDocumento Pasos="@pasos" />
       pasos = new() {
           new("Cotización", EstadoPaso.Hecho, "COT-2026-0004", Ruta: "/cotizaciones/editar/4"),
           new("Comprobante", EstadoPaso.Actual, null, "Vendedor o Cajero"),
           new("Despacho", EstadoPaso.Pendiente, null, "Almacenero") };
   Los pasos los arma cada módulo con sus datos (ver Pages/Ventas/FlujoVentas.cs). *@
@if (Pasos.Count > 0)
{
    <nav class="card pasos mb-3" aria-label="@Titulo">
        <ol>
            @for (var i = 0; i < Pasos.Count; i++)
            {
                var p = Pasos[i];
                var numero = i + 1;
                <li class="paso @Clase(p.Estado)" aria-current="@(p.Estado == EstadoPaso.Actual ? "step" : null)">
                    <span class="marca" aria-hidden="true">@Marca(p.Estado, numero)</span>
                    <span class="texto">
                        <span class="titulo">@p.Titulo</span>
                        @if (!string.IsNullOrEmpty(p.Detalle) && p.Estado != EstadoPaso.Pendiente)
                        {
                            @if (!string.IsNullOrEmpty(p.Ruta) && p.Estado == EstadoPaso.Hecho)
                            {
                                <a class="detalle" href="@p.Ruta">@p.Detalle</a>
                            }
                            else
                            {
                                <span class="detalle">@p.Detalle</span>
                            }
                        }
                        @if (LeTocaAOtro(p))
                        {
                            <span class="quien">Le toca: @p.Responsable</span>
                        }
                    </span>
                </li>
            }
        </ol>
    </nav>
}

@code {
    [Parameter] public IReadOnlyList<PasoDocumento> Pasos { get; set; } = Array.Empty<PasoDocumento>();
    [Parameter] public string Titulo { get; set; } = "Recorrido del documento";
    [CascadingParameter(Name = "Rol")] public string Rol { get; set; } = "";

    private bool LeTocaAOtro(PasoDocumento p) =>
        p.Estado == EstadoPaso.Actual && !string.IsNullOrEmpty(p.Responsable)
        && (string.IsNullOrEmpty(Rol) || !p.Responsable.Contains(Rol, StringComparison.OrdinalIgnoreCase));

    private static string Clase(EstadoPaso e) => e switch
    {
        EstadoPaso.Hecho => "hecho",
        EstadoPaso.Actual => "actual",
        EstadoPaso.Omitido => "omitido",
        EstadoPaso.Anulado => "anulado",
        _ => "pendiente"
    };

    private static string Marca(EstadoPaso e, int numero) => e switch
    {
        EstadoPaso.Hecho => "✓",
        EstadoPaso.Omitido => "–",
        EstadoPaso.Anulado => "✕",
        _ => numero.ToString()
    };
}
